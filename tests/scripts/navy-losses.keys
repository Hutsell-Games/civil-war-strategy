# Civil War Strategy: the Rebels lose their fleet and cannot build another. The game is loaded
# from a prepared save (tests/data/navy-losses/cws1.save): May 1862, the Rebels play, with one
# ship off Philadelphia, one army in Richmond and no sea port. The computer is passive.
# The seed is one with which the shore battery sinks the ship at the first shot.
#! seed 2
#! cfg side=2 bold=0
#! data navy-losses

rule 1 key space
rule 2:E text y

# The title menu: Resume Saved Game; the Load menu: the one save.
play until 2:V
text r
play until 2:L
key enter
play until 2:M
digest

# UTILITY, End Cond. Victory Conditions starts on Time: down and Enter turn off each of the
# four others. Esc there, and Esc at the Utility menu.
text u
prompt
text e
prompt
key down
prompt
key enter
prompt
key down
prompt
key enter
prompt
key down
prompt
key enter
prompt
key down
prompt
key enter
prompt
key esc
prompt
key esc
prompt

# May 1862. Ships, Attack: Philadelphia's shore battery sinks the one ship, "fleet eliminated".
text s
prompt
digest
text a
prompt
digest

# Moves: the one army, from Richmond to Raleigh, which the Union holds with a fort and no
# army. Moves again: no army is free, and Moves becomes "-".
text m
prompt
digest
key enter
prompt
digest
text r
prompt
digest
text m
prompt
digest

# UTILITY, Balance: the menu shows a face beside each entry, in the Rebels' colors. Esc.
text u
prompt
text b
prompt
digest
key down
prompt
digest
key esc
prompt

# END TURN. The army takes Raleigh without a fight: the Raze menu, Yes.
text e
play until 2:R
digest
text y

# July 1862. Ships, Build, Wooden: "NO SHIPYARDS AVAILABLE !".
play until 2:M
digest
text s
prompt
digest
text b
prompt
digest
text w
prompt
digest

# Files, Quit to DOS, Yes, and a key for END's "Press any key to continue".
text f
prompt
text q
prompt
text y
repeat space
