# Civil War Strategy: entries of the Commands menu that the game refuses. The game is loaded
# from a prepared save (tests/data/refusals-rebel/cws1.save): May 1862, the Rebels play, with
# 150 in cash and two armies. The computer is passive.
# A refusal shows as a message on the bottom line under the next menu.
#! seed 6
#! cfg side=2 bold=0
#! data refusals-rebel

rule 1 key space

# The title menu: Resume Saved Game; the Load menu: the one save.
play until 2:C
text r
play until 2:L
key enter
play until 2:M
digest

# COMMANDS: Fortify and Capital are "-". The "-" key takes the first, Fortify: "Not enough
# money for fort", and the main menu.
text c
prompt
digest
text -
prompt
digest

# COMMANDS, four rows down to Capital: "Cannot move capital", and the main menu.
text c
prompt
key down
prompt
key down
prompt
key down
prompt
key down
prompt
digest
key enter
prompt
digest

# COMMANDS, Detach: the army in Richmond is too small to detach, so the list offers only Front
# Royal. Esc gives Detach up: the main menu.
text c
prompt
text d
prompt
digest
key esc
prompt
digest

# COMMANDS, Army Drill: the army in Richmond has drilled as far as it can, so the list offers
# only Front Royal.
text c
prompt
text a
prompt
digest

# The army in Front Royal: it drills. The Commands menu comes back on Army Drill, now "-": the
# army in Richmond is the only one still free, and it cannot drill.
text f
prompt
digest

# Enter on the "-": "No armies remain eligible for drills in May", and the main menu. Moves:
# the army in Richmond, to the first city offered.
key enter
prompt
digest
text m
prompt
key enter
prompt
key enter
prompt
digest

# COMMANDS: Army Drill is "-". Detach: no army is free, "No armies remain eligible to detach
# in May", and the main menu.
text c
prompt
digest
text d
prompt
digest

# COMMANDS, Supply: Johnston's army and Jackson's are short of supplies. Esc gives the menu up:
# the main menu.
text c
prompt
text s
prompt
digest
key esc
prompt
digest

# COMMANDS, Supply again. Down to Jackson's army: it gets supplies and the cash is spent, so
# Supply can give no more, and the main menu comes back.
text c
prompt
text s
prompt
key down
prompt
key enter
prompt
digest

# COMMANDS: Supply is "-". Three rows down to it: "Not enough funds in the Treasury for
# supplies", and the main menu.
text c
prompt
digest
key down
prompt
key down
prompt
key down
prompt
key enter
prompt
digest

# Files, Quit, Yes, and a key for END's "Press any key to continue".
text f
prompt
text q
prompt
text y
repeat space
