# Civil War Strategy: the Union computer starts its first fleet at Philadelphia (ai_fleet_orders,
# AI_UNION_FLEET_CITY) and finds no shipyard. The game is loaded from a prepared save
# (tests/data/navy-first-fleet/cws1.save): May 1862, the Rebels play, with one ship off
# Philadelphia, the Union's only sea port. The Union has no fleet. The computer is passive.
#! seed 1
#! cfg side=2 bold=0
#! data navy-first-fleet

rule 1 key space
rule 2:E text y

# The title menu: Resume Saved Game; the Load menu: the one save.
play until 2:C
text r
play until 2:L
key enter
play until 2:M
digest

# UTILITY, End Cond. Victory Conditions starts on Time: down and Enter turn off each of the
# four others, so that the month ends without a victory. Esc there, and Esc at the Utility menu.
text u
prompt
text e
prompt
key down
prompt
key enter
prompt
key down
prompt
key enter
prompt
key down
prompt
key enter
prompt
key down
prompt
key enter
prompt
key esc
prompt
key esc
prompt

# END TURN. The Union computer tries to build a ship twice: first before it recruits
# (ai_raise_forces), then at Philadelphia (ai_fleet_orders). Both times it has no shipyard.
text e
play until 2:M
digest

# Files, Quit, Yes, and a key for END's "Press any key to continue".
text f
prompt
text q
prompt
text y
repeat space
