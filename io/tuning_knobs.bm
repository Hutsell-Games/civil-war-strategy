' Sets the knob named key$ to value#. why$ is "" when it was set; otherwise it says why
' not: no knob of that name, a value outside the knob's least and most, or a fraction for
' a knob that takes whole numbers.
SUB tuning_set (key$, value#, why$)
    why$ = ""
    SELECT CASE key$
        CASE "cost_recruit"
            why$ = tuning_check$(key$, value#, 0, 19999, TRUE)
            IF why$ = "" THEN
                cost_recruit = value#
            END IF
        CASE "cost_ship"
            why$ = tuning_check$(key$, value#, 0, 5000, TRUE)
            IF why$ = "" THEN
                cost_ship = value#
            END IF
        CASE "ironclad_cost_times"
            why$ = tuning_check$(key$, value#, 1, 4, TRUE)
            IF why$ = "" THEN
                ironclad_cost_times = value#
            END IF
        CASE "cost_fort"
            why$ = tuning_check$(key$, value#, 0, 19999, TRUE)
            IF why$ = "" THEN
                cost_fort = value#
            END IF
        CASE "cost_move_capital"
            why$ = tuning_check$(key$, value#, 0, 19999, TRUE)
            IF why$ = "" THEN
                cost_move_capital = value#
            END IF
        CASE "capital_income"
            why$ = tuning_check$(key$, value#, 0, 5000, TRUE)
            IF why$ = "" THEN
                capital_income = value#
            END IF
        CASE "upkeep_per_size"
            why$ = tuning_check$(key$, value#, 0, 10, FALSE)
            IF why$ = "" THEN
                upkeep_per_size# = value#
            END IF
        CASE "start_cash_per_balance"
            why$ = tuning_check$(key$, value#, 0, 2000, TRUE)
            IF why$ = "" THEN
                start_cash_per_balance = value#
            END IF
        CASE "start_cash_spread"
            why$ = tuning_check$(key$, value#, 0, 2000, TRUE)
            IF why$ = "" THEN
