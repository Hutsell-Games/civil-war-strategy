            why$ = tuning_check$(key$, value#, 0, 19999, TRUE)
            IF why$ = "" THEN
                ai_fortify_cash = value#
            END IF
        CASE ELSE
            why$ = "unknown knob: " + key$
    END SELECT
END SUB

