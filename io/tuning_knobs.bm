' The rules between knobs: "" when the knobs keep them all; otherwise the first one broken.
FUNCTION tuning_relations$
    tuning_relations$ = ""
    IF NOT (huge_army_size > large_army_size) THEN
        tuning_relations$ = "huge_army_size must be above large_army_size"
        EXIT FUNCTION
    END IF
    IF NOT (cities_big_bonus_above > cities_bonus_above) THEN
        tuning_relations$ = "cities_big_bonus_above must be above cities_bonus_above"
        EXIT FUNCTION
    END IF
    IF NOT (new_army_supply + new_army_supply_spread + union_new_army_supply <= MAX_SUPPLY) THEN
        tuning_relations$ = "new_army_supply, new_army_supply_spread and union_new_army_supply may add up to 10 at most"
        EXIT FUNCTION
    END IF
    IF NOT (small_army_size < max_army_size) THEN
        tuning_relations$ = "small_army_size must be below max_army_size"
        EXIT FUNCTION
    END IF
    IF NOT (min_detach_size <= max_army_size) THEN
        tuning_relations$ = "min_detach_size may not be above max_army_size"
        EXIT FUNCTION
    END IF
    IF NOT (new_army_size <= max_army_size) THEN
        tuning_relations$ = "new_army_size may not be above max_army_size"
        EXIT FUNCTION
    END IF
    IF NOT (new_army_size + 2 * balance_recruits <= max_army_size) THEN
        tuning_relations$ = "new_army_size plus 2 times balance_recruits may not be above max_army_size"
        EXIT FUNCTION
    END IF
    IF NOT (min_detach_size * detach_share# >= 1) THEN
        tuning_relations$ = "min_detach_size times detach_share must be 1 or more"
        EXIT FUNCTION
    END IF
    IF NOT (reinforce_size <= max_army_size) THEN
        tuning_relations$ = "reinforce_size may not be above max_army_size"
        EXIT FUNCTION
    END IF
    IF NOT (invasion_army_size <= max_army_size) THEN
        tuning_relations$ = "invasion_army_size may not be above max_army_size"
        EXIT FUNCTION
    END IF
    IF NOT ((points_per_income# * (capital_income + 5 * union_bonus_per_balance + 640) + cities_bonus + cities_big_bonus) / (1 - points_kept#) <= 15000) THEN
        tuning_relations$ = "a side's victory points may grow to 15000 at most: lower points_per_income, the bonuses or points_kept"
        EXIT FUNCTION
    END IF
    IF NOT (ironclad_cost_times * cost_ship <= MAX_CASH) THEN
        tuning_relations$ = "an ironclad (ironclad_cost_times times cost_ship) may cost 19999 at most"
        EXIT FUNCTION
    END IF
END FUNCTION
