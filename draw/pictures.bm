    LINE -(510, 160)
    LINE -(520, 145)
    LINE -(525, 120)
    LINE -(525, 115)
    LINE -(515, 85)
    LINE -(527, 95)
    PAINT (500, 400), 1, 10
    PAINT (510, 110), 2
END SUB

' Loads a .PNG picture file of the 16 colors of SCREEN 12 and returns its image handle, for
' _PUTIMAGE. The 256 asks for a picture of color numbers, which SCREEN 12 can take; the pictures'
' palette is the one of QB64pe, so each pixel keeps its number. Free the handle with _FREEIMAGE.
FUNCTION load_picture& (file$)
    load_picture = _LOADIMAGE(file$, 256)
END FUNCTION

' Draws a picture file with its top left corner at x, y, and frees it.
SUB draw_picture (x, y, file$)
    DIM picture AS LONG
    picture = load_picture(file$)
    _PUTIMAGE (x, y), picture
    _FREEIMAGE picture
END SUB

' The title screen. It also takes the capital's star from the icon file, for draw_cities.
SUB draw_title
    SCREEN 12
    CALL draw_picture(100, 100, GFXDIR + "CWSICON.PNG")
    GET (101, 101)-(113, 113), pic_capital()
    CLS
    COLOR COLOR_LIGHT_CYAN
    LOCATE 14, 29
    PRINT "CIVIL WAR STRATEGY GAME"
    COLOR COLOR_YELLOW
    LOCATE 28, 1
    PRINT TAB(8); "(c) 1998-2026 W. R. Hutsell, David Mackey"
    LOCATE 28, 60
    PRINT "v1.7"
    LINE (190, 170)-(440, 260), 1, B
    LINE (180, 180)-(450, 250), 7, B
    CALL draw_large_flag(SIDE_UNION, -440, 0)
    CALL draw_large_flag(SIDE_REBEL, -100, 0)
END SUB
