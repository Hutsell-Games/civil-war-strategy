' Pictures drawn line by line: the cannon of the battle screen, the shore of the Chesapeake
' on the map, and the title screen; and load_picture and draw_picture, for the .PNG files.

' PAINT at the pen, the point the last DRAW or PSET left: fill up to the border color. Its
' point is rounded to whole pixels, as the callers did. A PAINT without a border takes the
' fill color as its border, so those callers pass the fill twice.
SUB paint_at_pen (fill, border)
    DIM x AS INTEGER
    DIM y AS INTEGER
    x = POINT(0)
    y = POINT(1)
    PAINT (x, y), fill, border
END SUB

SUB draw_cannon
    DIM x AS INTEGER
    DIM y AS INTEGER
    CALL clear_right_panel
    LINE (528, 80)-(639, 310), 3, BF
    LINE (528, 310)-(639, 435), 2, BF
    LINE (528, 405)-(639, 420), 0, BF
    PSET (580, 380), 0

    DRAW "BR15"
    x = POINT(0)
    y = POINT(1)
    CIRCLE (x, y), 25, 1, , , 1.4
    CIRCLE (x + 5, y), 27, 1, 4, 1.5, 1.4
    CIRCLE (x, y), 29, 1, , , 1.4
    DRAW "BR20"
    CALL paint_at_pen(3, 1)
    DRAW "BR3BU7"
    CALL paint_at_pen(5, 1)
    DRAW "BL15C7G4L50H1L12H1L7H3U1H1U4E5R6E1R13E1R52F3D2R1E1R1F2D5G3H2G2BL2"
    DRAW "BH2C6"
    CALL paint_at_pen(7, 7)
    DRAW "BD2R4C0G4L50H1L12H1L7H3U1H1U4E5R6E1R13E1R52F3D2R1E1R1F2D5G3H2G2BR5U3"
    DRAW "C8G2H2G6L15G1L32H1L1H1L19H3E2R2F1R6"
    DRAW "E2R4F1R6E1R58F1G2BL9BH2BU5BR3C15H1L48G1L13G1L4"
    DRAW "BD3BF3BR9"
    CALL paint_at_pen(8, 8)
    DRAW "BR34BE1BR7BL5BD8C6R16F5D1F4D6F7R17D7L30H18L8H4L18H3U5R33BR17BD5"
    CALL paint_at_pen(6, 6)
    DRAW "BU5C8F8D7F6R1F1R16D7E3U7G3E2BE2C8L16H6U8C8G3BE3C8H8G6BR5"
    CALL paint_at_pen(8, 8)
    DRAW "BL38"
    x = POINT(0)
    y = POINT(1)
    CIRCLE (x, y), 30, 4, , , 1.4
    CIRCLE (x + 5, y), 35, 4, 4, 1.5, 1.4
    CIRCLE (x, y), 35, 4, , , 1.4
    CIRCLE (x, y), 8, 4, , , 1.4
    PAINT (x, y), 1, 4
    PAINT (x, y), 0, 4
    DRAW "BR23"
    CALL paint_at_pen(1, 4)
    CALL paint_at_pen(4, 4)
    DRAW "BR5BU7"
    CALL paint_at_pen(1, 4)
    CALL paint_at_pen(0, 4)
    DRAW "BU22BL28"
    DRAW "C4D20R1U19BD37C4D20L1U21BH2BL1BH1C4G12F1E11BU3BH2"
    DRAW "BU3BL1C4L13U1R15BR1BU3C4H12E1F11BF5BE4C4E11F1G11BD3C4R13D1L10D3BL3BD1C4"
    DRAW "F12G1H12BL33BH13BU3BH2BU1BE1BR2BU1BE1BR1"
    DRAW "BL5BU5C8E4U1"
    DRAW "H4E3H3U3E3H6L3G7F1H7E2U2E2H7L7G9D6F8G3L1H3L5G7D4F4R2D3F3R2G5D4L4G4D5F8D2"
    DRAW "R5F9E3F5R6E6H4E2F6R3E8F1E4H5U2H3U1H1U7E4H7BL5"
    CALL paint_at_pen(8, 8)
    DRAW "BR9BD6C15H8L1H2L12G1F5L8G4F4R3G3D1G2D3F2E5G1D8R4E3D6F3E12H1U1H1U6E5BH6BU4"
    DRAW "BD15"
    CALL paint_at_pen(14, 15)
END SUB

