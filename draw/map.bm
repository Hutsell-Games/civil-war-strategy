SUB draw_map_marker (from_city, to_city, mark)
    DIM x AS INTEGER: DIM y AS INTEGER: DIM x1 AS INTEGER: DIM y1 AS INTEGER: DIM i AS INTEGER: DIM j AS INTEGER
    IF from_city < 1 OR from_city > MAX_CITIES THEN EXIT SUB
    IF to_city < 0 THEN EXIT SUB
    x = city_x(from_city) - 12
    y = city_y(from_city) - 11
    x1 = city_x(to_city)
    y1 = city_y(to_city)
    SELECT CASE mark
        CASE MARK_MOVE_LINE
            LINE (x, y)-(x1, y1), 15, , &HF0F0

        CASE MARK_RECRUIT
            FOR i = 6 TO 8
                LINE (x - i, y - i + 3)-(x + i, y + i - 3), 14, B
            NEXT i
            CALL wait_seconds(.1)

        CASE MARK_EXPLOSION
            x = city_x(from_city): y = city_y(from_city)
            CALL screen_snapshot(x, y, SNAP_SAVE)
            FOR j = 1 TO 3
                FOR i = 4 TO 10 STEP 1
                    CIRCLE (x, y), i, 4
                    PAINT (x, y), 14, 4
                    IF opt_sound >= SOUND_EFFECTS THEN SOUND 37 + 50 * RND, .03
                NEXT i
                CALL wait_seconds(.1)
                CALL screen_snapshot(x, y, SNAP_RESTORE)
            NEXT j

        CASE MARK_ERASE_ARMY
            IF city_army(from_city) = 0 THEN LINE (x - 8, y - 6)-(x + 10, y + 8), 2, BF
            IF x1 + y1 > 0 THEN LINE (x, y)-(x1, y1), 2, , &HF0F0
            IF from_city = 27 OR from_city = 28 THEN CALL draw_map_touchup

        CASE MARK_ERASE_LINE
            IF x1 + y1 > 0 THEN LINE (x, y)-(x1, y1), 2, , &HF0F0

        CASE MARK_FLASH_FRAME
            x = city_x(from_city): y = city_y(from_city)
            CALL screen_snapshot(x, y, SNAP_SAVE)
            LINE (x - 9, y - 9)-(x + 9, y + 9), 15, B
            LINE (x - 10, y - 10)-(x + 10, y + 10), 15, B
            IF opt_sound >= SOUND_EFFECTS THEN SOUND 3999, .3
            CALL wait_seconds(opt_pause! - .5)
            CALL screen_snapshot(x, y, SNAP_RESTORE)
        CASE MARK_BOX          ' draw white box
            GET (x - 8, y - 8)-(x + 8, y + 8), saved_under_marker
            LINE (x - 7, y - 7)-(x + 7, y + 7), 15, B
            LINE (x - 8, y - 6)-(x + 8, y + 6), 15, B
        CASE MARK_RESTORE     ' replace old image
            IF x > 0 THEN PUT (x - 8, y - 8), saved_under_marker, PSET

        CASE MARK_POINTER          ' draw arrow pointer
            GET (x - 8, y - 8)-(x + 10, y + 7), saved_under_marker
            x = x + 7: y = y + 5
            LINE (x + 2, y)-(x + 2, y - 8), 12
            LINE -(x, y - 6), 12
            LINE -(x - 5, y - 11), 12
            LINE -(x - 10, y - 6), 12
            LINE -(x - 6, y - 2), 12
            LINE -(x - 10, y), 12
            LINE -(x + 1, y), 12
            PAINT (x - 2, y - 1), 15, 12

        CASE MARK_ROAD
            LINE (x + 12, y + 11)-(x1, y1), 0, , &H1111

        CASE ELSE
    END SELECT
END SUB

SUB draw_cities
    DIM x AS INTEGER: DIM y AS INTEGER: DIM j AS INTEGER
    DIM i AS INTEGER: DIM dot_color AS INTEGER
    FOR i = 1 TO MAX_CITIES
        dot_color = 9
        IF city_owner(i) = SIDE_REBEL THEN dot_color = 7
        IF city_owner(i) = SIDE_NONE THEN dot_color = 12
        x = city_x(i)
        y = city_y(i)
        IF i = side_capital(SIDE_UNION) OR i = side_capital(SIDE_REBEL) THEN
            PUT (x - 6, y - 6), pic_capital, PSET
            LINE (x + 9, y - 4)-(x + 15, y + 4), 0, BF
            LINE (x + 8, y - 5)-(x + 13, y + 2), 3, BF
            PSET (x + 8, y - 4)
            IF city_fort(i) = 1 THEN DRAW "BR2C0e1D6BL1R2"
            IF city_fort(i) = MAX_FORT THEN DRAW "C0e1R1F1D1G3R3"
        ELSE
            IF city_fort(i) = 1 THEN LINE (x - 5, y - 5)-(x + 5, y + 5), 0, B
            IF city_fort(i) >= MAX_FORT THEN LINE (x - 5, y - 5)-(x + 5, y + 5), 0, BF
            CALL draw_city_dot(i, dot_color)
        END IF
        IF opt_graphics = GRAPHICS_OFF THEN _CONTINUE
        FOR j = 1 TO MAX_ROADS
            IF city_road(i, j) > 0 THEN CALL draw_map_marker(i, city_road(i, j), MARK_ROAD)
        NEXT j
    NEXT i
END SUB

' A city's dot in dot_color, without its fort mark.
SUB draw_city_dot (city, dot_color)
    CIRCLE (city_x(city), city_y(city)), 4, 0
    CIRCLE (city_x(city), city_y(city)), 3, dot_color
    PAINT (city_x(city), city_y(city)), dot_color, dot_color
END SUB

' Erases a city's fort mark and draws the cities again, after its fort level changed.
SUB city_redraw_fort (city)
    DIM x AS INTEGER: DIM y AS INTEGER
    x = city_x(city)
    y = city_y(city)
    LINE (x - 5, y - 5)-(x + 5, y + 5), 2, BF
    CALL draw_cities
END SUB

SUB draw_city_names
    DIM k AS INTEGER: DIM j AS INTEGER: DIM letter_x AS INTEGER: DIM letter AS INTEGER
    FOR k = 1 TO MAX_CITIES
        FOR j = 1 TO LEN(city_name$(k))
            letter_x = city_x(k) + 6 * (j - 4) - 3
            letter = ASC(MID$(UCASE$(city_name$(k)), j, 1)) - 64
            IF letter_x > 527 THEN EXIT FOR
            PSET (letter_x, city_y(k) + 12), 10

            IF city_port_type(k) < PORT_RIVER THEN
                IF opt_alt_colors = 0 THEN DRAW "S4C0" ELSE DRAW "S4C7"
            ELSE
                DRAW "C10"
            END IF
            IF letter > 0 AND letter < 27 THEN DRAW map_font$(letter)
        NEXT j
    NEXT k
END SUB

SUB draw_fleets
    DIM side AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER: DIM ship_type AS INTEGER
    FOR side = SIDE_UNION TO SIDE_REBEL
        IF fleet_size(side) = 0 OR fleet_city(side) = 0 THEN fleet_city(side) = 0: _CONTINUE
        SELECT CASE fleet_city(side)
            CASE 30: x = 515: y = 268
            CASE 28: x = 517: y = 172
            CASE 17: x = 380: y = 425
            CASE FLEET_AT_SEA: x = 495: y = 310
            CASE ELSE
                x = city_x(fleet_city(side)) + 25: y = city_y(fleet_city(side)) + 25
                IF fleet_city(side) = 24 THEN y = y + 5: x = x - 5
        END SELECT
        PSET (x, y), 1
        ship_type = 1: IF LEFT$(fleet_ships$(side), 1) = "I" THEN ship_type = 2
        CALL draw_ship_icon(side, ship_type)
    NEXT side
END SUB

SUB draw_stack_markers (side)
    DIM y AS INTEGER
    DIM i AS INTEGER: DIM city AS INTEGER: DIM x AS INTEGER
    FOR i = side_first_army(side) TO side_last_army(side)
        IF army_size(i) > 0 AND city_army(army_city(i)) <> i THEN
            city = army_city(i)
            x = city_x(city) - 12: y = city_y(city) - 12
            CIRCLE (x, y), 3, 14
        END IF
    NEXT i
END SUB

