    CALL draw_fleets
    CALL draw_train_box
    COLOR COLOR_LIGHT_MAGENTA
    LOCATE 24, 51: PRINT " "; UCASE$(LEFT$(month_name$(turn_month), 3)); ","; turn_year
END SUB
