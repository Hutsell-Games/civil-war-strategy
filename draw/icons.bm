SUB animate_army (army, background_saved)
DIM y AS INTEGER: DIM y1 AS INTEGER
DIM from AS INTEGER: DIM to2 AS INTEGER: DIM x AS INTEGER: DIM i AS INTEGER: DIM x1 AS INTEGER
from = army_city(army): to2 = army_order(army): army_city(army) = 0
x = city_x(from) - 12
y = city_y(from) - 11
x1 = .5 * (city_x(to2) + city_x(from))
y1 = .5 * (city_y(to2) + city_y(from))

CALL city_update_occupier(from): IF city_army(from) > 0 THEN CALL draw_army_flag(city_army(from))
       
IF background_saved > 0 GOTO already
	GET (x - 9, y - 7)-(x + 9, y + 6), saved_under_army
	IF city_army(from) = 0 THEN LINE (x - 9, y - 8)-(x + 10, y + 8), 2, BF
already:

	FOR i = 2 TO 8
	x1 = .1 * (i * city_x(to2) + (10 - i) * city_x(from))
	y1 = .1 * (i * city_y(to2) + (10 - i) * city_y(from))
	GET (x1 - 10, y1 - 10)-(x1 + 9, y1 + 9), saved_under_marker
	PUT (x1 - 10, y1 - 10), saved_under_army, PSET
	IF opt_pause! > 1 THEN CALL wait_seconds(.1) ELSE CALL wait_seconds(.02)
	IF opt_sound >= SOUND_EFFECTS THEN SOUND 200, .1: SOUND 50, .1
	PUT (x1 - 10, y1 - 10), saved_under_marker, PSET
	NEXT i
	army_city(army) = from
END SUB

SUB animate_city (city)
DIM c AS INTEGER
FOR c = 1 TO 15 STEP 2
CALL draw_city_dot(city, c)
CALL wait_seconds(.1)
NEXT c
c = 9: IF city_owner(city) = SIDE_REBEL THEN c = 7
IF city_owner(city) = SIDE_NONE THEN c = 12
CALL draw_city_dot(city, c)
END SUB

SUB draw_army_flag (army)
DIM who AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER
who = army_side(army)
x = city_x(army_city(army)) - 12
y = city_y(army_city(army)) - 11
CALL draw_flag_icon(x, y, who)
IF army_supply(army) < 1 THEN
	x = x - 3: y = y + 4
	PSET (x, y), 13: DRAW "C11S8"
	DRAW map_font$(19)
	DRAW "S4"
END IF
END SUB

SUB draw_train (side, show)
DIM from AS INTEGER: DIM x AS INTEGER: DIM c AS INTEGER: DIM y AS INTEGER
	IF train_city(side) = 0 THEN EXIT SUB
	from = train_city(side)
	x = city_x(from) - 12: y = city_y(from) - 11
SELECT CASE show
	CASE IS > 0
	LINE (x - 8, y - 6)-(x + 10, y + 7), 10, BF
	PSET (x - 6, y - 2), 3: c = 9: IF side = SIDE_REBEL THEN c = 15
	DRAW "C0S2" + TRAIN_OUTLINE$ + "U8L2U5BF4S4"
	x = POINT(0): y = POINT(1): PAINT (x, y), c, 0
	CASE ELSE
	LINE (x - 9, y - 8)-(x + 10, y + 8), 2, BF
END SELECT
END SUB

SUB draw_flag_icon (x, y, side)
LINE (x - 5, y - 3)-(x + 10, y + 8), 0, BF
SELECT CASE side
	CASE 1
	LINE (x - 7, y - 5)-(x + 7, y + 5), 4, BF
	LINE (x - 7, y - 5)-(x - 1, y), 1, BF
	LINE (x, y - 2)-(x + 7, y - 1), 7, B
	LINE (x - 7, y + 2)-(x + 7, y + 3), 7, B
	LINE (x - 8, y - 6)-(x + 8, y + 6), 0, B
	CASE 2
	LINE (x - 7, y - 5)-(x + 7, y + 5), 4, BF
	LINE (x - 8, y - 6)-(x + 8, y + 6), 0, B
	LINE (x - 7, y - 4)-(x + 6, y + 5), 9
	LINE (x - 7, y + 4)-(x + 6, y - 5), 9
	LINE (x - 7, y - 5)-(x + 7, y + 5), 9
	LINE (x - 7, y + 5)-(x + 7, y - 5), 9
	CASE ELSE
END SELECT
END SUB

SUB draw_flag (side, w, a)
DIM x AS INTEGER: DIM y AS INTEGER: DIM i AS INTEGER: DIM j AS INTEGER
x = 585 + w: y = 200: IF w = 0 THEN y = 180
IF a <> 0 THEN y = a
SELECT CASE side
	CASE 1
	LINE (x - 17, y - 15)-(x + 17, y + 7), 4, BF
	FOR i = -13 TO 9 STEP 5
	LINE (x - 17, y + i)-(x + 17, y + i - 1), 7, B
	NEXT i
	LINE (x - 17, y - 15)-(x, y), 1, BF
	IF w = 0 THEN COLOR COLOR_LIGHT_BLUE: LOCATE 10, 70: PRINT "U N I O N"
	FOR i = -16 TO -1 STEP 3
		FOR j = -14 TO -1 STEP 4: PSET (x + i, y + j), 7: NEXT j
	NEXT i
	CASE 2
	LINE (x - 17, y - 15)-(x + 17, y + 7), 4, BF
	LINE (x - 17, y - 13)-(x + 15, y + 7), 7
	LINE (x - 15, y - 15)-(x + 17, y + 5), 7

	LINE (x - 17, y + 7)-(x + 17, y - 15), 1
	LINE (x - 17, y + 6)-(x + 16, y - 15), 1
	LINE (x - 16, y + 7)-(x + 17, y - 14), 1
	LINE (x - 17, y + 5)-(x + 15, y - 15), 7
	LINE (x - 15, y + 7)-(x + 17, y - 13), 7

	LINE (x - 17, y - 15)-(x + 17, y + 7), 1
	LINE (x - 17, y - 14)-(x + 16, y + 7), 1
	LINE (x - 16, y - 15)-(x + 17, y + 6), 1
	LINE (x - 17, y - 15)-(x + 17, y + 7), 4, B

	IF w = 0 THEN COLOR COLOR_RED: LOCATE 10, 70: PRINT "R E B E L"
	CASE ELSE
END SELECT
END SUB
