FOR i = 1 TO 6: LINE (x + 19 * i - 12, y + 7)-(x + 19 * i - 12 + 2, y + 40), 15, BF: NEXT i

IF opt_sound < 2 GOTO relee
PLAY "MBMS T120"
PLAY "O3 L16 g e L8 c c L16 c d e f L8 g g g e a a a. L16 g a8. g a b"
PLAY "O4 L16 c d e4. c O3 g O4 c4. O3 g e g4. d e c4 P8"
PLAY "L16 g e L8 c c L16 c d e f L8 g g g e a a a. L16 g a8. g a b"
PLAY "O4 L16 c d e4. c O3 g O4 c4. O3 g e g4. d e c4."
PLAY "L16 T150 g a b T120 O4 L8 c e d. c16 O3 a O4 c4 O3 a O4 d4."
PLAY "O3 a O4 d4. O3 T150 L16 g a b T120 L8 O4 c e d. c16"
PLAY "L8 O3 a b O4 c. O3 a16 g e O4 c. O3 e16 e d4 e c4. e d4. a"
PLAY "L8 g e O4 c. e16 d c4 O3 e c4. e d4. a g e O4 e4. c16 d c4"

GOTO relee

stars:
FOR i = 1 TO 8
x = flag_star_x(i): y = flag_star_y(i)
PSET (x, y), 0
LINE (x + 2, y - 1)-(x + 8, y + 16), 15
LINE -(x - 6, y + 2): LINE -(x - 20, y + 16)
LINE -(x - 14, y - 1): LINE -(x - 30, y - 9)
LINE -(x - 12, y - 9): LINE -(x - 6, y - 25)
LINE -(x, y - 9): LINE -(x + 16, y - 9)
LINE -(x + 2, y - 1): PAINT (x, y), 15
NEXT i
RETURN
relee:
END SUB

SUB scribe_message (a$, flag)
SELECT CASE flag
		CASE 1: CALL clear_bottom_line: PRINT a$;
		CASE 2: CALL show_message_box(a$, 4)
END SELECT
IF opt_history > 0 THEN
	OPEN "A", 2, "cws.his"
	a$ = LTRIM$(RTRIM$(a$))
	PRINT #2, a$
	CLOSE #2
END IF
END SUB

SUB play_shenandoah
'                       Shenandoah
IF opt_sound = 2 THEN
	IF INKEY$ <> "" THEN menu_choice = 1: EXIT SUB
	PLAY "T90MFMNo1c4f8f8f4."
	IF INKEY$ <> "" THEN menu_choice = 1: EXIT SUB
	PLAY "g8a8b-8o2d8c4."
	IF INKEY$ <> "" THEN menu_choice = 1: EXIT SUB
	PLAY "MLf8e8MNd4.c8d8c8o1a8o2c4.c4d8d8d4."
	IF INKEY$ <> "" THEN menu_choice = 1: EXIT SUB
	PLAY "o1a8o2c8o1a8g8f4.g4a4.f8"
	IF INKEY$ <> "" THEN menu_choice = 1: EXIT SUB
	PLAY "a8o2d8c4.o1f8g8a4.f8g4f2."
END IF
END SUB

SUB draw_ship_icon (who, flag)
	x = POINT(0) - 10: y = POINT(1) - 10
	CIRCLE (x, y), 18, 9, , , .4
	PAINT (x + 3, y + 4), 9, 9
	CIRCLE (x, y), 18, 10, , , .4
SELECT CASE flag
CASE 1                          'wooden ship
	DRAW "BF5R5D1C4L20C0H1R22E1L9": DRAW "BL6": DRAW "C0L10H1L1H2": DRAW "BR9D2"
	DRAW "C0U9": DRAW "BR13": DRAW "C0D9BU7R3"
	DRAW "C0L7BL5C0L7BD3BL2BD1BL1BD1C0R11BR3": DRAW "C0R10BL12"
	PSET (x + 8, y - 1)
	GOSUB jack

CASE 2                          'ironclad
	DRAW "BL15BD4E1"
	DRAW "C0R30H1L2C8L24E1R1"
	DRAW "C8E1R18F1L19BR4C6C5C4C3C2C1": DRAW "C0R2BR3C0R2BR3C0R2"
	DRAW "BU3BL10D1": DRAW "C0U4R1D4BR9"
	PSET (x + 8, y - 1)
	GOSUB jack
CASE ELSE
END SELECT
EXIT SUB
jack:
	SELECT CASE who
	CASE 1
	DRAW "C4R7BU1C7L6BU1C1R3C4R3BU1C7L2BL1C1L3"
	CASE 2
	DRAW "C4R4U1L4U1R4U1L4C3F4BU4C3G4BD2BR2BU1"
	END SELECT
	RETURN
END SUB

SUB draw_fleets
FOR s = 1 TO 2
IF fleet_size(s) = 0 OR fleet_city(s) = 0 THEN fleet_city(s) = 0: GOTO sink
IF fleet_city(s) = 30 THEN x = 515: y = 268: GOTO float
IF fleet_city(s) = 28 THEN x = 517: y = 172: GOTO float
IF fleet_city(s) = 17 THEN x = 380: y = 425: GOTO float
IF fleet_city(s) = 99 THEN x = 495: y = 310: GOTO float
x = city_x(fleet_city(s)) + 25: y = city_y(fleet_city(s)) + 25
IF fleet_city(s) = 24 THEN y = y + 5: x = x - 5
float:
	PSET (x, y), 1
	a = 1: IF LEFT$(fleet_ships$(s), 1) = "I" THEN a = 2
	CALL draw_ship_icon(s, a)
sink:
NEXT s
END SUB

SUB side_army_range (star, fin, who)
star = 1: fin = 20: IF who = 2 THEN star = 21: fin = 40
END SUB

SUB draw_stack_markers (who)
CALL side_army_range(star, fin, who)
FOR i = star TO fin
IF army_size(i) > 0 AND city_army(army_city(i)) <> i THEN
	target = army_city(i)
	x = city_x(target) - 12: y = city_y(target) - 12
	CIRCLE (x, y), 3, 14
END IF
NEXT i
END SUB

