SUB city_capture (active, c, s, flag)
	city_owner(c) = s: CALL clear_bottom_line
	a$ = army_name$(active) + " has captured " + city_name$(c)
	COLOR 11: PRINT army_name$(active) + " has captured " + city_name$(c);
	IF active < 21 AND opt_sound > 1 THEN PLAY "MNMFL16o2T120dd.dd.co1b.o2do3g.ab.bb.ag"
	IF active > 20 AND opt_sound > 1 THEN PLAY "MNMFT160o2L16geL8ccL16cdefL8ggge"
	IF c <> side_capital(3 - s) THEN CALL animate_city(c)
	side_victory_points(s) = side_victory_points(s) + city_value(c)
	IF c = side_capital(3 - s) THEN
		side_victory_points(s) = side_victory_points(s) + 100
		side_victory_points(3 - s) = side_victory_points(3 - s) - 100
		a$ = side_name$(3 - s) + " CAPITAL captured !"
		CALL scribe_message(a$, 1)
		CALL show_message_box(city_name$(side_capital(3 - s)) + " has fallen!", 4)
		side_capital(3 - s) = 0
		CALL animate_city(c)
	END IF
	IF city_fort(c) > 0 AND flag > 0 THEN city_fort(c) = city_fort(c) - 1: x = city_x(c): y = city_y(c): LINE (x - 5, y - 5)-(x + 5, y + 5), 2, BF: CALL draw_cities
END SUB

SUB print_centered (y, a$)
x = LEN(a$)
x = 26 - x \ 2
LOCATE y, 7 + x: PRINT a$
END SUB

