SUB railroad_capacity (who, limit)
IF opt_realism = 0 THEN limit = train_capacity(who): EXIT SUB
x = 11: IF side = 2 THEN x = 23
limit = train_capacity(who) + 5 * (side_city_count(who) - x)
x = 2 * train_capacity(who)
IF limit > x THEN limit = x
IF limit < x \ 4 THEN limit = x \ 4
END SUB

