LINE -(240, 170), 1

LINE (161, 400)-(155, 320), 1  'Tombigbee River
LINE -(145, 300), 1

LINE (161, 400)-(170, 370), 1  'Alabama River
LINE -(200, 350), 1

LINE (230, 425)-(231, 385), 1  'Chattahoochee River
LINE -(233, 350), 1
LINE -(240, 330), 1
LINE -(270, 290), 1

LINE (381, 81)-(431, 66), 1   'Potomac River
LINE -(456, 81), 1
LINE -(471, 111), 1

LINE (485, 150)-(455, 145), 1   'James River
LINE -(400, 150), 1

LINE (489, 200)-(415, 185), 1   'Roanoke River
LINE -(400, 160), 1

LINE (296, 241)-(291, 265), 1   'Savannah River
LINE -(350, 340), 1

LINE (438, 271)-(430, 235), 1  'Cape Fear River
LINE -(420, 205), 1

LINE (500, 80)-(498, 50), 1 'Susquehanna River
LINE -(470, 30), 1

LINE (405, 290)-(360, 240), 1 'Pee Dee River

LINE (400, 300)-(350, 280), 1 'Santee River

LINE (270, 423)-(280, 410), 1 'Suwanee River
LINE -(290, 390), 1

LINE (342, 370)-(300, 350), 1 'Altamaha River

LINE (50, 370)-(1, 330), 1 'Red River

LINE (65, 280)-(1, 240), 1 'Arkansas River

LINE (430, 66)-(400, 100), 1 ' Shenandoah River
LINE -(380, 120), 1

CALL draw_cities
PSET (493, 280), 1
IF fleet_city(1) = 30 OR fleet_city(2) = 30 THEN
	DRAW "C11U7R4D3L3BR6BU3D7BU4R3U3D7BR3U7BD4BR4BU4D7R4"
	LINE (485, 241)-(525, 270), 11, B
END IF

IF opt_graphics > 1 THEN CALL draw_city_names
IF raiding_side > 0 THEN
LINE (447, 291)-(525, 317), 4, BF: LINE (447, 291)-(525, 317), 10, B
y = 312
a$ = "COMMERCE"
FOR j = 1 TO LEN(a$): x = ASC(MID$(UCASE$(a$), j, 1)) - 64
PSET (440 + 10 * j, y), 0: DRAW map_font$(x)
NEXT j
ELSE
LINE (447, 291)-(525, 335), 1, BF
END IF

FOR i = 1 TO 40
IF army_city(i) > 0 THEN CALL draw_army_flag(i)
NEXT i

FOR k = 1 TO 2
CALL draw_stack_markers(k)
NEXT k

IF opt_players = 2 GOTO nosee
FOR i = 1 TO 40: IF army_city(i) > 0 AND army_order(i) > 0 THEN CALL draw_map_marker(army_city(i), army_order(i), 1)
NEXT i
nosee:
CALL draw_fleets
CALL draw_train_box
COLOR 13: LOCATE 24, 51: PRINT " "; UCASE$(LEFT$(month_name$(turn_month), 3)); ","; turn_year
END SUB

SUB check_victory_conditions
	x = 0: FOR j = 1 TO 20: IF army_city(j) > 0 THEN x = x + army_size(j)
	NEXT j
	y = 0: FOR j = 21 TO 40: IF army_city(j) > 0 THEN y = y + army_size(j)
	NEXT j

	CALL clear_bottom_line: COLOR 14
	IF victory_rule(2) > 0 AND turn_year >= victory_rule(2) AND turn_month < victory_rule(1) THEN
		a$ = "Time almost expired (" + month_name$(victory_rule(1)) + "," + STR$(victory_rule(2)) + ")"
		CALL show_message_box(a$, 4)
	END IF
    FOR i = 1 TO 2
	IF (i = 1 AND y = 0) OR (i = 2 AND x = 0) THEN j = 7: side_victory_points(i) = side_victory_points(i) + 300: GOTO finis

	IF turn_year >= victory_rule(2) AND turn_month >= victory_rule(1) AND victory_rule(2) > 0 THEN j = 2: GOTO finis
	IF side_city_count(i) >= victory_rule(3) AND victory_rule(3) > 0 THEN j = 3: GOTO finis
	IF side_income(i) / (side_income(1) + side_income(2)) >= .01 * victory_rule(4) AND victory_rule(4) > 0 THEN j = 4: GOTO finis
	IF victory_rule(5) > 0 AND side_capital(3 - i) = 0 AND side_capital(i) > 0 THEN j = 5: GOTO finis

	IF victory_rule(6) > 0 THEN
		IF i = 1 THEN
			IF y = 0 THEN j = 7: GOTO finis
			IF x / y > victory_rule(6) THEN j = 6: GOTO finis
		END IF
		IF i = 2 THEN
			IF x = 0 THEN j = 7: GOTO finis
			IF y / x > victory_rule(6) THEN j = 6: GOTO finis
		END IF
	END IF

	CALL clear_bottom_line: COLOR 14
	IF victory_rule(3) > 0 AND side_city_count(i) >= .9 * victory_rule(3) THEN
		a$ = side_name$(i) + " side almost controls" + STR$(victory_rule(3)) + " cities"
		CALL show_message_box(a$, 4)
	END IF

	IF victory_rule(4) > 0 AND side_income(i) / (side_income(1) + side_income(2)) >= .009 * victory_rule(4) THEN
		a$ = side_name$(i) + " side close to" + STR$(victory_rule(4)) + " % of total income"
		CALL show_message_box(a$, 4)
	END IF

	IF victory_rule(6) > 0 AND x > 0 AND y > 0 THEN
		IF (i = 1 AND x / y > .9 * victory_rule(6)) OR (i = 2 AND y / x > .9 * victory_rule(6)) THEN
		a$ = side_name$(i) + "side close to" + STR$(victory_rule(6)) + ":1 strength ratio"
		CALL show_message_box(a$, 4)
		END IF
	END IF
	GOTO stale

finis:
	SELECT CASE j
		CASE IS < 3
		a$ = "TIME EXPIRED"
		CASE 3
		a$ = STR$(2.5 * victory_rule(3)) + "% CITIES CONTROLLED"
		CASE 4
		a$ = STR$(victory_rule(4)) + " % OF TOTAL INCOME"
		CASE 5
		a$ = "CAPITAL CAPTURED"
		CASE 6
		a$ = STR$(victory_rule(6)) + ":1 ARMY STRENGTH RATIO"
		CASE 7
		a$ = "ENEMY ANNIHILATED"
END SELECT
	CLS
	c = 1: IF i = 2 THEN c = 7
	LINE (0, 0)-(639, 479), 4, BF
	LINE (0, 40)-(550, 460), 0, BF
	CALL draw_map
	LINE (70, 140)-(485, 265), 0, BF
	LINE (50, 120)-(465, 250), c, BF
	LINE (50, 120)-(465, 250), 4, B
	COLOR 14
	t$ = side_name$(i) + " SIDE IS WINNING"
	IF j = 2 THEN CALL print_centered(10, "Confederates will win a technical victory") ELSE CALL print_centered(10, t$)

	COLOR 15
	t$ = "END GAME VICTORY CONDITION" + STR$(j - 1) + " REACHED"
	CALL print_centered(12, t$)
	CALL print_centered(14, a$)

	menu_text$(0) = "End Game"
	menu_text$(1) = "Yes"
	menu_text$(2) = "No-Override"
	menu_item_count = 2: menu_color = 4
	menu_col = 27: menu_row = 18
	menu_highlight = 15
	IF j = 7 THEN menu_item_count = 1
	CALL menu_select(0)

	IF menu_choice <> 1 AND j < 7 THEN
play4ever:
			victory_rule(j) = victory_rule(j) + 1
			IF j = 5 THEN victory_rule(j) = 0
			CLS
			CALL draw_map
			EXIT SUB
	END IF
	menu_text$(0) = "Options"
	menu_text$(1) = "Quit this Game"
	menu_text$(2) = "Play More"
	IF opt_players = 1 THEN menu_text$(2) = "No - Press Onward to " + city_name$(side_capital(3 - side))
	menu_item_count = 2: menu_color = 8
	menu_col = 27: menu_row = 18
	IF j <> 7 THEN
		CALL menu_select(0)
		IF menu_choice <> 1 GOTO play4ever
	ELSE
		side_victory_points(i) = side_victory_points(i) + 100
	END IF

	victory_reason = i
	CALL draw_map: CALL menu_report(100 + side)
	IF j = 2 THEN FOR k = 1 TO 2: side_victory_points(k) = .7 * side_victory_points(k): NEXT k: CALL draw_rebel_victory: GOTO death

	IF i = 1 THEN CALL draw_union_victory: COLOR 15: LOCATE 2, 27: t$ = "UNION VICTORY  VP's=" + STR$(side_victory_points(1)): PRINT t$: GOTO death
	IF i = 2 THEN CALL draw_rebel_victory: COLOR 15: LOCATE 2, 27: t$ = "REBEL VICTORY  VP's=" + STR$(side_victory_points(2)): PRINT t$
death:
	COLOR 14: LOCATE 4, 40 - .5 * LEN(a$)
	IF opt_history > 0 THEN
		CALL scribe_message(t$, 0)
		CALL scribe_message(a$, 0)
	END IF
	PRINT a$: CALL hall_of_fame
	EXIT SUB
stale:
    NEXT i
END SUB

SUB city_nearby_enemy_strength (a, y)
  y = 0
FOR j = 1 TO 6
  x = matrix(a, j): IF x = 0 GOTO tally5
  IF city_owner(x) = side AND city_army(x) > 0 THEN y = y + army_size(city_army(x))
	FOR k = 1 TO 6: m = matrix(x, k): IF m = 0 OR m = a GOTO tally4
	IF city_owner(m) = side AND city_army(m) > 0 THEN y = y + .1 * army_size(city_army(m))
tally4:
	NEXT k
NEXT j
tally5:
END SUB

