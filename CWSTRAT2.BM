LINE (x + 100, y - 14)-(x + 102, y + 8), 7, BF
LINE (x, y)-(x + 100, y + 36), 7, BF
FOR i = 1 TO 6: LINE (x + 17 * i, y + 6)-(x + 17 * i + 4, y + 32), 0, BF: NEXT i
LINE (x + 12, y + 18)-(x + 98, y + 22), 7, BF
LINE (x + 50, y + 20)-(x + 57, y + 36), 8, BF
