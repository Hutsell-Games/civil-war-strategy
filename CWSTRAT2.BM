SUB draw_flag_icon (x, y, z)
LINE (x - 5, y - 3)-(x + 10, y + 8), 0, BF
SELECT CASE z
	CASE 1
	LINE (x - 7, y - 5)-(x + 7, y + 5), 4, BF
	LINE (x - 7, y - 5)-(x - 1, y), 1, BF
	LINE (x, y - 2)-(x + 7, y - 1), 7, B
	LINE (x - 7, y + 2)-(x + 7, y + 3), 7, B
	LINE (x - 8, y - 6)-(x + 8, y + 6), 0, B
	CASE 2
	LINE (x - 7, y - 5)-(x + 7, y + 5), 4, BF
	LINE (x - 8, y - 6)-(x + 8, y + 6), 0, B
	LINE (x - 7, y - 4)-(x + 6, y + 5), 9
	LINE (x - 7, y + 4)-(x + 6, y - 5), 9
	LINE (x - 7, y - 5)-(x + 7, y + 5), 9
	LINE (x - 7, y + 5)-(x + 7, y - 5), 9
	CASE ELSE
END SELECT
END SUB

SUB sort_move_order (limit)
DO
	swaps% = FALSE
	FOR i = 1 TO limit - 1
	IF move_order_key(i) > move_order_key(i + 1) THEN
		SWAP move_order_key(i), move_order_key(i + 1)
		swaps% = i
	END IF
	NEXT i
LOOP WHILE swaps%
END SUB

SUB menu_bubble_sort (limit)
DO
	swaps% = FALSE
	FOR i = 1 TO limit - 1
	IF menu_text$(i) > menu_text$(i + 1) THEN
		SWAP menu_text$(i), menu_text$(i + 1)
		SWAP menu_value(i), menu_value(i + 1)
		swaps% = i
	END IF
	NEXT i
LOOP WHILE swaps%
END SUB

SUB menu_army_cancel (side)
CALL side_army_range(star, fin, (side))
counter:
CALL clear_right_panel
	menu_item_count = 0
	FOR j = star TO fin
	a$ = army_name$(j): IF LEN(a$) > 10 THEN x = INSTR(a$, " "): a$ = RIGHT$(a$, LEN(a$) - x)
	IF army_city(j) > 0 AND army_order(j) > 0 THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = a$: menu_value(menu_item_count) = army_city(j)
	NEXT j
	CALL menu_bubble_sort(menu_item_count)
	menu_col = 67: menu_row = 2: menu_box_type = 2
	menu_text$(0) = "Cancel"
	IF menu_item_count < 1 THEN CALL clear_bottom_line: COLOR 11: PRINT "No units have orders to cancel"; : EXIT SUB
	CALL menu_select(1)
	SELECT CASE menu_choice
	 CASE 1 TO menu_item_count
		target = menu_value(menu_choice)
	       
		FOR i = star TO fin
		IF army_city(i) = target THEN x = INSTR(army_name$(i), menu_text$(menu_choice)): IF x > 0 AND army_order(i) > 0 THEN index = i
		NEXT i

		CALL clear_bottom_line: COLOR 11: PRINT army_name$(index); " has cancelled move to "; city_name$(army_order(index)); : CALL wait_seconds(turbo + 1)
		CALL draw_map_marker(army_city(index), army_order(index), 4)
		army_order(index) = 0: IF opt_sound > 0 THEN SOUND 2999, .5
		CALL draw_stack_markers(side)
	 CASE ELSE
		GOTO finix
	END SELECT
finix:
	CALL clear_right_panel
END SUB

