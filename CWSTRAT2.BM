SUB clear_bottom_line
LOCATE 29, 1: PRINT SPACE$(79);
LOCATE 29, 1
END SUB

SUB clear_right_panel
VIEW (528, 1)-(639, 450)
CLS 1
VIEW
END SUB

SUB army_get_commander (who, empty)
	empty = 0
	CALL side_army_range(star, fin, who)
	FOR i = star TO fin
	IF army_city(i) = 0 AND leader_name$(i) <> "" THEN empty = i: EXIT SUB
	NEXT i

'                 generic leaders if set list is exhausted
	FOR i = star TO fin
	IF army_city(i) = 0 THEN
		x = i
		CALL army_generate_name(x, a$)
		empty = i
		leader_name$(i) = a$
		leader_rating(i) = 1 + 8 * RND
		EXIT SUB
	END IF
	NEXT i
	CALL clear_bottom_line: PRINT "No more "; side_name$(who); " commanders available"; : CALL wait_seconds(opt_pause!)
END SUB

SUB menu_victory_conditions
	a$ = STR$(ABS(victory_rule(3)) * 2.5) + "% Cities"
	t$ = STR$(ABS(victory_rule(3)) * 2.5) + "% Total Income"
	menu_text$(8) = "Time: " + month_name$(victory_rule(1)) + STR$(ABS(victory_rule(2)))
	menu_text$(9) = RTRIM$(STR$(ABS(victory_rule(6)))) + ":1 Force Ratio"
	COLOR 15: LOCATE 1, 1: PRINT "Press ENTER to toggle ending conditions";
	COLOR 14: PRINT "				ESC when done"
what4:
	FOR i = 2 TO 6: IF victory_rule(i) > 0 THEN menu_text$(i - 1) = "û " ELSE menu_text$(i - 1) = "  "
	NEXT i
	menu_choice = chosit
	menu_text$(0) = "Victory Conditions"
	menu_text$(1) = menu_text$(1) + menu_text$(8)
	menu_text$(2) = menu_text$(2) + a$
	menu_text$(3) = menu_text$(3) + t$
	menu_text$(4) = menu_text$(4) + "Capital Captured"
	menu_text$(5) = menu_text$(5) + menu_text$(9)
	menu_text$(6) = "DONE"
	menu_box_type = 2: menu_color = 3: menu_item_count = 6: menu_highlight = 14
	CALL menu_select(0)
	chosit = 21 + menu_choice
SELECT CASE menu_choice
	CASE 1
	victory_rule(2) = -victory_rule(2)
	CASE 2 TO 5
	victory_rule(menu_choice + 1) = -victory_rule(menu_choice + 1)
	CASE ELSE
	GOTO cheer
END SELECT
	GOTO what4
cheer:
	CLS
	CALL draw_map
END SUB

SUB draw_train_box
IF train_army(1) + train_army(2) = 0 GOTO notrain
LINE (5, 17)-(100, 63), 3, BF
LINE (5, 17)-(100, 47), 0, B
LINE (5, 47)-(100, 63), 0, B

FOR i = 1 TO 2
IF train_army(i) = 0 GOTO notrane
PSET (15, 25), 3: c = 9: IF i = 2 THEN c = 15: PSET (60, 25), 3
DRAW "C0S4R9D4R6U3R3D3R7U5H3U2R9D3G2D6F1D3F5L10D1G1L4H2L7G2L3H2L3U8L2U5BF4"
x = POINT(0): y = POINT(1): PAINT (x, y), c, 0
LOCATE 4, 6 * (i - 1) + 2: PRINT LEFT$(city_name$(army_order(train_army(i))), 5)
notrane:
NEXT i

notrain:
END SUB

SUB ai_evaluate_move (index, x)
from = army_city(index)
x = 200: IF ai_strength_ratio! > 1.5 THEN x = 80: IF ai_strength_ratio! > 2 THEN x = 20: IF ai_strength_ratio! > 3 THEN x = 5
CALL city_nearby_enemy_strength(from, defend): IF defend = 0 THEN x = 0
IF opt_ai_aggression > 1 THEN x = .5 * x

best = army_size(index)

FOR j = 1 TO 6: menu_value(j) = -1
a = matrix(from, j): IF a > 0 THEN IF city_army(a) > 0 THEN best = best - army_size(city_army(a)): y = 1
NEXT j: best = .01 * best
IF opt_ai_aggression > 0 THEN best = best + 20 * opt_ai_aggression

CALL side_army_range(star, fin, 3 - side)

FOR j = 1 TO 6
	y = -1: a = matrix(from, j): IF a = 0 THEN max = j - 1: GOTO alleval
      
	c = city_army(a)
	FOR k = star TO fin: IF army_city(k) > 0 THEN IF army_order(k) = a AND c = 0 GOTO alle
	NEXT k
	
	y = best - x * city_fort(from) - city_value(from) + 30 * RND
	IF city_fort(from) > 0 THEN IF index = city_army(from) THEN y = y - 25: IF opt_realism > 0 THEN y = y - 50
	IF a = side_capital(side) THEN IF victory_rule(5) > 0 THEN y = y + 200
	IF city_owner(a) <> 3 - side THEN y = y + 5 * city_value(a) + 10 * city_fort(a)
	IF city_owner(a) <> side GOTO ourn
	   IF c = 0 THEN y = y + 10 * city_value(a): GOTO ourn
	   x1 = 1: IF city_fort(a) = 1 THEN x1 = 2: IF city_fort(a) = 3 THEN x1 = 3

	   IF army_size(c) > 0 THEN
		odds! = army_size(index) / (x1 * army_size(c))
		IF opt_realism > 1 THEN odds! = .8 * odds!
	   ELSE
		odds! = 5
	   END IF

	   IF army_size(index) < 15 THEN y = y - 300: odds! = .1
	   IF opt_ai_aggression < 3 AND army_size(index) < 40 AND odds! < .8 THEN y = 0
	   IF opt_realism > 0 THEN y = y - 15
	   IF odds! < .5 THEN y = y - 200
	   IF opt_ai_aggression = 0 AND RND > .9 THEN y = y + 10 * (army_leader_rating(index) - army_leader_rating(c) + army_experience(index) - army_leader_rating(index))
	   IF army_supply(index) < 1 THEN y = y - 100
	   SELECT CASE odds! + .5 * opt_ai_aggression
		CASE IS < .3
		y = -9999
		CASE IS < .5
		y = y - 300
		CASE IS <= .8
		y = y - 20
		CASE .8 TO 1.2
		y = y - 5
		CASE 1.2 TO 1.5
		y = y + 10
		CASE ELSE
		y = y + .5 * (army_size(index) - army_size(c)) + 50 * RND
	   END SELECT
ourn:
	IF city_owner(a) = 3 - side AND c > 0 AND army_order(c) = 0 THEN y = y - army_size(c)
	IF side = 1 AND city_y(a) < city_y(from) THEN y = y + 2
	IF side = 2 AND city_y(a) > city_y(from) THEN y = y + 2
'---------------------------------------------------------------------------
	FOR k = 1 TO 6: m = matrix(a, k): IF m = 0 GOTO tally3
	IF city_owner(m) = 0 THEN y = y + 3 * city_value(m) + 4 * city_fort(m)
	IF city_owner(m) = side THEN y = y + 3 * city_value(m) + 4 * city_fort(m)
	IF city_owner(m) = side AND c > 0 THEN
		odds! = 5 - 4 * RND
		IF army_size(c) > 0 THEN odds! = army_size(index) / army_size(c) ELSE odds! = 5
		IF odds! < 1 THEN y = y - 2
	END IF
	IF city_owner(m) = side_capital(side) THEN y = y + 50
tally3:
	NEXT k
'---------------------------------------------------------------------------
	menu_value(j) = y
alle:
NEXT j: max = 6
alleval:
x = 0: best = 0
FOR j = 1 TO max
IF menu_value(j) < 0 GOTO allof
	IF menu_value(j) > x THEN x = menu_value(j): best = j
allof:
NEXT j
	IF defend > army_size(index) AND menu_value(best) < 50 THEN best = 0
	x = best
END SUB

SUB special_events
'==========================================================================
'                              Special Events
'==========================================================================
IF opt_realism > 0 AND turn_year = 1862 AND turn_month < 3 THEN
	COLOR 14: CALL clear_bottom_line
	PRINT "SPECIAL DEVELOPMENT : IRONCLAD ships now available";
	IF opt_sound > 0 THEN FOR k = 1 TO 5: SOUND 140, 1: SOUND 37, 1: NEXT k
	CALL script_mark_key_wait(1, "I"): DO WHILE INKEY$ = "": LOOP
	EXIT SUB
END IF
IF opt_event_balance = 0 THEN EXIT SUB
plus = opt_difficulty: IF side = 1 THEN plus = 6 - opt_difficulty
pct! = .005 * (turn_year - 1860) * plus * plus: IF pct! > .9 THEN pct! = .9
IF RND > pct! THEN EXIT SUB

CALL clear_bottom_line: COLOR 14: PRINT "SPECIAL EVENT...";
who = 1: IF RND > .1 * opt_event_balance THEN who = 2

SELECT CASE who
'----------------------------------------------------------------------------
'                               good for South
'----------------------------------------------------------------------------
	CASE 1
	IF turn_year = 1864 AND turn_month = 1 THEN side_victory_points(2) = side_victory_points(2) + 50
	IF turn_year = 1865 AND turn_month = 1 THEN side_victory_points(2) = side_victory_points(2) + 100
	IF RND > .9 THEN GOSUB riot: EXIT SUB

	CALL clear_bottom_line
	IF RND > .2 OR fleet_size(2) > 9 GOTO mercen
	IF fleet_size(2) > 0 AND fleet_city(2) <> 99 THEN empty = fleet_city(2): GOTO float1
		empty = 0
		FOR i = 1 TO 40
		IF city_owner(i) = 2 AND matrix(i, 7) = 99 AND fleet_city(1) <> i THEN empty = i: EXIT FOR
		NEXT i
	IF empty = 0 GOTO mercen
float1:
	CALL scribe_message("England has given ships to the South", 2)
	fleet_size(2) = fleet_size(2) + 2 * plus
	IF fleet_size(2) > 10 THEN fleet_size(2) = 10
	x = fleet_size(2) - LEN(fleet_ships$(2))
	fleet_ships$(2) = fleet_ships$(2) + STRING$(x, "W")
	fleet_city(2) = empty: CALL draw_fleets
	GOTO dull1
mercen:
	IF RND > .1 OR side_city_count(2) < 30 GOTO money
	a$ = "French": IF RND > .5 THEN a$ = "British"
	CALL scribe_message(a$ + " mercenaries join " + army_name$(index) + "'s army", 2)
	army_size(index) = army_size(index) + 100 * plus
	army_experience(index) = 10: army_supply(index) = 10
	GOTO dull1
money:
	IF RND > .3 OR side_city_count(2) < 12 GOTO cotton
		CALL scribe_message("The South has obtained a loan from Europe", 2)
		GOTO purse
cotton:
	IF RND > .5 OR side_city_count(2) < 12 GOTO uprising
	CALL scribe_message("Cash from cotton sales fill the Rebel Treasury", 2)
purse:
	side_cash(2) = side_cash(2) + 100 * plus
	GOTO dull1
uprising:
	pct! = .9
	a$ = "Union troops diverted to fight Western Indian uprisings"
	IF RND > .5 THEN a$ = "Union 90-day enlistees return home"
	IF turn_year = 1864 AND turn_month > 5 THEN a$ = "20% of Union forces take furloughs to vote in 1864 elections": pct! = .8
	CALL scribe_message(a$, 2)
	FOR k = 1 TO 20
	army_size(k) = pct! * army_size(k)
	NEXT k
	GOTO dull1
'----------------------------------------------------------------------------
riot:
	IF opt_realism = 0 THEN RETURN
	IF side_city_count(who) = 1 THEN RETURN
	FOR k = 1 TO 99
	x = 1 + INT(40 * RND)
		IF city_first_owner(x) <> who AND city_owner(x) = who AND city_army(x) = 0 THEN
			CALL clear_bottom_line: COLOR 15
			PRINT " Riots have broken out in "; city_name$(x);
			city_owner(x) = 0
			CALL draw_cities
			wait_seconds opt_pause!
			CALL clear_bottom_line
			CALL show_message_box(city_name$(x) + " is now NEUTRAL !", 4)
			wait_seconds opt_pause!
			RETURN
		END IF
	NEXT k
	RETURN
'----------------------------------------------------------------------------
'                               good for Union
'----------------------------------------------------------------------------
	CASE 2
	IF RND > .1 OR fleet_city(1) = 0 OR fleet_size(1) > 9 GOTO event2
	IF RND > .95 THEN GOSUB riot: EXIT SUB
	CALL scribe_message("Union shipworks have produced extra ships", 2)
	fleet_size(1) = fleet_size(1) + plus
	IF fleet_size(1) > 10 THEN fleet_size(1) = 10
	x = fleet_size(1) - LEN(fleet_ships$(1))
	fleet_ships$(1) = fleet_ships$(1) + STRING$(x, "W")
	GOTO dull2
event2:
	IF RND < .7 GOTO abe
	CALL scribe_message("Volunteer troops swell the Union ranks", 2)
	x = 0: FOR i = 1 TO 20: x = x + 1: IF x > 5 GOTO dull2
	IF army_size(i) > 0 AND RND > .5 THEN army_size(i) = army_size(i) * 1.1 + plus
	NEXT i: GOTO dull2
abe:
	IF emancipation_done = 0 AND turn_year > 1862 THEN

		emancipation_done = 1
		CALL scribe_message("Abraham Lincoln announces the Emancipation Proclamation", 2)
		side_victory_points(1) = side_victory_points(1) + 100: side_victory_points(2) = side_victory_points(2) - 100
		' SHELL "abelinco.exe" (a DOS program with no source; cannot run on 64-bit Windows)
		CALL draw_map
		GOTO dull2
	END IF
	IF turn_year = 1864 AND turn_month = 11 THEN
		CALL scribe_message("Lincoln has been reelected", 2)
		side_victory_points(2) = .5 * side_victory_points(2)
		GOTO dull2
	END IF
	IF RND > .5 THEN
		CALL scribe_message("Wealthy Unionists give generously to the Federal Cause", 2)
		side_cash(1) = side_cash(1) + 100 * plus
		GOTO dull2
	END IF
	IF RND > .5 AND turn_year > 1861 THEN
		CALL scribe_message("Rebel deserters leave the battlefield to go home", 2)
		FOR i = 21 TO 40: army_size(i) = .92 * army_size(i): NEXT i: GOTO dull2
	END IF
	IF RND > .5 AND turn_year > 1861 THEN
		CALL scribe_message("Union soldiers now have repeating rifles", 2)
		FOR i = 1 TO 20
			IF army_experience(i) < 9 THEN army_experience(i) = army_experience(i) + 2
		NEXT i
	END IF
		CALL scribe_message("Secretary of War Stanton predicts the end of the Rebellion", 2)
		side_victory_points(1) = side_victory_points(1) + 10: GOTO dull2
	CASE ELSE
END SELECT

dull2:
	IF opt_sound = 2 THEN PLAY "MNMFL16o2T120dd.dd.co1b.o2do3g.ab.bb.ag"
	CALL script_mark_key_wait(1, "N"): DO WHILE INKEY$ = "": LOOP: EXIT SUB
dull1:
	IF opt_sound = 2 THEN PLAY "MNMFT160o2L16geL8ccL16cdefL8ggge"
	CALL script_mark_key_wait(1, "S"): DO WHILE INKEY$ = "": LOOP
END SUB

SUB draw_flag (who, w, a)
x = 585 + w: y = 200: IF w = 0 THEN y = 180
IF a <> 0 THEN y = a
SELECT CASE who
	CASE 1
	LINE (x - 17, y - 15)-(x + 17, y + 7), 4, BF
	FOR i = -13 TO 9 STEP 5
	LINE (x - 17, y + i)-(x + 17, y + i - 1), 7, B
	NEXT i
	LINE (x - 17, y - 15)-(x, y), 1, BF
	IF w = 0 THEN COLOR 9: LOCATE 10, 70: PRINT "U N I O N"
	FOR i = -16 TO -1 STEP 3
		FOR j = -14 TO -1 STEP 4: PSET (x + i, y + j), 7: NEXT j
	NEXT i
	CASE 2
	LINE (x - 17, y - 15)-(x + 17, y + 7), 4, BF
	LINE (x - 17, y - 13)-(x + 15, y + 7), 7
	LINE (x - 15, y - 15)-(x + 17, y + 5), 7

	LINE (x - 17, y + 7)-(x + 17, y - 15), 1
	LINE (x - 17, y + 6)-(x + 16, y - 15), 1
	LINE (x - 16, y + 7)-(x + 17, y - 14), 1
	LINE (x - 17, y + 5)-(x + 15, y - 15), 7
	LINE (x - 15, y + 7)-(x + 17, y - 13), 7

	LINE (x - 17, y - 15)-(x + 17, y + 7), 1
	LINE (x - 17, y - 14)-(x + 16, y + 7), 1
	LINE (x - 16, y - 15)-(x + 17, y + 6), 1
	LINE (x - 17, y - 15)-(x + 17, y + 7), 4, B

	IF w = 0 THEN COLOR 4: LOCATE 10, 70: PRINT "R E B E L"
	CASE ELSE
END SELECT
END SUB

SUB show_message_box (a$, s)
DIM g2(1 TO 8000)
menu_text$(1) = a$
menu_col = 32 - LEN(a$) \ 2
menu_row = 10: menu_item_count = 1
CALL menu_measure_width(wide)
IF wide > 59 THEN wide = 59: a$ = LEFT$(a$, 59)
x = 8 * (menu_col + wide)
y = 16 * (menu_row + 1)
	GET (8 * menu_col - 4, 16 * menu_row - 3)-(8 * (menu_col + wide + 1) + 15, 16 * (menu_row + 3) + 7), g2
	VIEW (8 * menu_col - 4, 16 * menu_row - 3)-(8 * (menu_col + wide + 1) + 7, 16 * (menu_row + 3) + 4)
	CLS 1
	VIEW
	LINE (8 * menu_col, 16 * menu_row - 1)-(8 * (menu_col + wide + 1) + 15, 16 * (menu_row + 3) + 7), 0, BF
	LINE (8 * menu_col - 4, 16 * menu_row - 3)-(8 * (menu_col + wide + 1) + 7, 16 * (menu_row + 3)), s, BF
	LINE (8 * menu_col - 4, 16 * menu_row - 3)-(8 * (menu_col + wide + 1) + 7, 16 * (menu_row + 3)), 15, B
	COLOR 14
	LOCATE menu_row + 2, menu_col + 2: PRINT a$
	CALL wait_seconds(9)
	PUT (8 * menu_col - 4, 16 * menu_row - 3), g2, PSET
END SUB

SUB check_map_links
CLS : COLOR 15
x = 0: y = 0
FOR i = 1 TO 40
FOR j = 1 TO 6: IF matrix(i, j) = 0 GOTO done
	index = matrix(i, j)
	FOR k = 1 TO 6
	IF matrix(index, k) = i GOTO ret
	IF matrix(index, k) = 0 THEN matrix(index, k) = i: PRINT "+ Adding return route from "; city_name$(index); " to "; city_name$(i): y = y + 1: GOTO ret
	NEXT k
	x = x + 1: PRINT "Error in CITIES.GRD entry for city #"; i; city_name$(index); ": no return route to "; city_name$(i): wait_seconds 1
ret:
NEXT j
done:
NEXT i
IF x + y = 0 THEN PRINT "ALL MAP LINKS ARE OK": EXIT SUB
IF y > 0 THEN PRINT "* "; y; " fixes made to provide RETURN ROUTES"
IF x > 0 THEN PRINT "** "; x; " UNRESOLVED RETURN ROUTES"
END SUB

SUB draw_city_names
FOR k = 1 TO 40
	FOR j = 1 TO LEN(city_name$(k))
	a = city_x(k) + 6 * (j - 4) - 3
	x = ASC(MID$(UCASE$(city_name$(k)), j, 1)) - 64
	IF a > 527 GOTO nextc
	PSET (a, city_y(k) + 12), 10
	
	IF matrix(k, 7) < 90 THEN
		IF opt_alt_colors = 0 THEN DRAW "S4C0" ELSE DRAW "S4C7"
	ELSE
		DRAW "C10"
	END IF
	IF x > 0 AND x < 27 THEN DRAW map_font$(x)
	NEXT j
nextc:
NEXT k
END SUB

SUB hall_of_fame
COLOR 14: LOCATE 28, 1: PRINT "press a key"; : CALL script_mark_key_wait(1, "H"): DO WHILE INKEY$ = "": LOOP
SCREEN 0: COLOR 14, 5: CLS : COLOR 11, 0

LOCATE 2, 7: PRINT STRING$(57, "²")
LOCATE 9, 7: PRINT STRING$(57, "²")
FOR i = 1 TO 6: LOCATE 2 + i, 7: PRINT "²"; SPACE$(55); "²": NEXT i

		OPEN "I", 1, "hiscore.cws"
		FOR s = 1 TO 2
		COLOR 14, 4: LOCATE 3, 30 * (s - 1) + 10: PRINT side_name$(s); " HALL of FAME"
		COLOR 15, 0: FOR i = 1 TO 5
		INPUT #1, city_name$(5 * (s - 1) + i), matrix(s, i)
		LOCATE 3 + i, 30 * (s - 1) + 8: PRINT i, city_name$(5 * (s - 1) + i), matrix(s, i)
		NEXT i: NEXT s: CLOSE #1
		      
			FOR s = 1 TO 2: FOR i = 1 TO 5
			IF side_victory_points(s) < matrix(s, i) GOTO oldskor
				FOR j = 5 TO i + 1 STEP -1
				matrix(s, j) = matrix(s, j - 1)
				city_name$(5 * (s - 1) + j) = city_name$(5 * (s - 1) + j - 1)
				NEXT j

			COLOR 15, 1: IF s = 2 THEN COLOR 4, 7
			FOR k = 12 TO 14: LOCATE k, 1: PRINT SPACE$(80); : NEXT k
			LOCATE 12, 1: PRINT "Congratulations ! Score of"; side_victory_points(s)
			PRINT "New Entry into "; side_name$(s); " HALL of FAME in place "; i
			IF opt_players = 1 AND s <> side THEN a$ = "COMPUTER": PRINT a$; " was "; side_name$(s); " commander": GOTO automate
who4:
			PRINT "What is name of "; side_name$(s); " commander"; : CALL script_mark_key_wait(4, ""): INPUT a$: IF a$ = "" GOTO who4
automate:
			city_name$(5 * (s - 1) + i) = a$
			matrix(s, i) = side_victory_points(s): GOTO foun
oldskor:
			NEXT i
foun:
			NEXT s
	       
		OPEN "O", 1, "hiscore.cws"
		FOR s = 1 TO 2
			FOR i = 1 TO 5
			WRITE #1, city_name$(5 * (s - 1) + i), matrix(s, i)
			NEXT i
		NEXT s: CLOSE #1: PRINT "Game Over": CALL script_mark_key_wait(1, "G"): DO WHILE INKEY$ = "": LOOP: game_over = 1
END SUB

SUB city_update_occupier (x)
city_army(x) = 0
FOR i = 1 TO 40
IF army_city(i) = x THEN city_army(x) = i: GOTO holdup
NEXT i
holdup:
END SUB

SUB menu_army_relieve (who)
menu_color = 3: target = 0: menu_highlight = 3
menu_col = 67: menu_row = 2
CALL side_army_range(star, fin, who)
menu_item_count = 0
FOR i = star TO fin
IF army_size(i) > 0 AND army_city(i) > 0 AND army_order(i) = 0 THEN
	menu_item_count = menu_item_count + 1
	menu_text$(menu_item_count) = army_name$(i)
	IF LEN(menu_text$(menu_item_count)) > 11 THEN menu_text$(menu_item_count) = LEFT$(menu_text$(menu_item_count), 11)
	menu_value(menu_item_count) = i
END IF
NEXT i

IF menu_item_count = 0 THEN EXIT SUB
CALL menu_bubble_sort(menu_item_count)
menu_text$(0) = "Relieve"
menu_choice = 31: menu_highlight = 11
CALL menu_select(6): CALL clear_right_panel

IF menu_choice < 1 THEN EXIT SUB
index = menu_value(menu_choice)
CALL draw_map_marker(army_city(index), 0, 9)

t$ = army_name$(index)
leader_name$(index) = t$

menu_item_count = 0
FOR i = star TO fin
IF leader_name$(i) <> "" THEN
	menu_item_count = menu_item_count + 1
	menu_text$(menu_item_count) = leader_name$(i)
	IF LEN(menu_text$(menu_item_count)) > 11 THEN menu_text$(menu_item_count) = LEFT$(menu_text$(menu_item_count), 11)
	menu_value(menu_item_count) = i
END IF
NEXT i
CALL menu_bubble_sort(menu_item_count)

have2:
menu_text$(0) = "New Leader"
menu_col = 67: menu_row = 2
CALL menu_select(0): CALL clear_right_panel
IF menu_choice < 1 GOTO have2
army_order(index) = -1
army_leader_rating(index) = leader_rating(menu_value(menu_choice))
IF army_leader_rating(index) > 0 THEN army_leader_rating(index) = army_leader_rating(index) - 1
IF army_experience(index) > 0 THEN army_experience(index) = army_experience(index) - 1
COLOR 15: CALL clear_bottom_line: PRINT leader_name$(menu_value(menu_choice)); " has replaced "; t$; " in "; city_name$(army_city(index)); : wait_seconds 9
army_name$(index) = leader_name$(menu_value(menu_choice))
leader_name$(menu_value(menu_choice)) = ""
CALL draw_map_marker(army_city(index), 0, 8)
CALL clear_bottom_line
END SUB

SUB menu_report (who)
DIM summ(40)
IF who = -1 GOTO frep
IF who > 100 GOTO batrep
menu_text$(0) = "Information"
menu_text$(1) = side_name$(side) + " Armies"
menu_text$(2) = side_name$(3 - side) + " Armies"
menu_text$(3) = "Cities"
menu_text$(4) = "Force Summary"
menu_text$(5) = "Intelligence"
menu_text$(6) = "Battles": menu_item_count = 6
IF LEN(DIR$("cws.his")) > 0 THEN menu_text$(7) = "Recap": menu_item_count = 7
CALL menu_select(0)
SELECT CASE menu_choice
CASE IS < 0
	CLS
	CALL draw_map
	EXIT SUB
CASE 2: who = 3 - side
CASE 3: GOTO cityrep
CASE 4: GOTO frep
CASE 5: GOTO srep
CASE 6: GOTO batrep
CASE 7: GOTO recap
CASE ELSE
END SELECT
'..........................................................................
'                               Army Report
'..........................................................................
IF menu_choice < 0 GOTO endrep
IF menu_choice = 4 GOTO frep
CALL side_army_range(star, fin, who)
CLS : LOCATE 1, 1: c = 9: IF who = 2 THEN c = 15
COLOR c
PRINT " Report for "; side_name$(who); " Forces"; TAB(30); month_name$(turn_month); ","; turn_year; TAB(49); : COLOR 14: PRINT " Victory Points "; side_victory_points(who);
IF c = 15 THEN c = 7
x = side_victory_points(who) + side_victory_points(3 - who)
IF x = 0 THEN
	PRINT
ELSE
	y = (side_victory_points(who) / x) * 100
	PRINT "("; y; " %)";
END IF
CALL draw_flag_icon(215, 8, who)
COLOR c: PRINT side_city_count(who); "/ 40"; TAB(15); "CITIES CONTROLLED"; TAB(40); : PRINT "("; : x = INT(side_city_count(who) * 2.5 + .5): PRINT x; "%)";
PRINT TAB(50); : COLOR 12: PRINT "Capital: "; city_name$(side_capital(who))
y = total_income: IF side_capital(1) > 0 THEN y = y + 100
IF side_capital(2) > 0 THEN y = y + 100
PRINT side_income(who); "/"; y; TAB(15); "INCOME"; TAB(40); "("; : x = (side_income(who) / total_income) * 100: PRINT x; "%)   "; : COLOR 14: PRINT "Cash:"; side_cash(who)
COLOR 11: PRINT " #      Name             Size  Location   Ldr Exp Suply Move To"
x = 0: FOR i = star TO fin
COLOR c
IF army_city(i) < 1 GOTO deadeye
x = x + army_size(i)
PRINT i; TAB(5); army_name$(i); TAB(25); : y = CSRLIN
CALL print_army_size(i): PRINT TAB(32); city_name$(army_city(i));
IF who <> side THEN PRINT : GOTO deadeye
PRINT TAB(43); army_leader_rating(i); TAB(47); army_experience(i); TAB(52); army_supply(i);
PRINT TAB(57); : IF army_order(i) > -1 THEN PRINT city_name$(army_order(i)) ELSE PRINT "Resting"
IF city_fort(army_city(i)) > 0 THEN LOCATE y, 68: PRINT "FORT +"; city_fort(army_city(i))
deadeye:
NEXT i
PRINT " "; STRING$(70, "Ä")
PRINT " Total Forces "; TAB(25); LTRIM$(STR$(x)); "00"; TAB(40); "[ Enemy Forces "; LTRIM$(STR$(INT(ai_strength_ratio! * x))); "00 ]"
PRINT " "; STRING$(70, "Ä")
PRINT " "; side_name$(who); " NAVY has "; fleet_size(who); " ship(s) ";
x = 0
FOR k = 1 TO fleet_size(who)
	IF MID$(fleet_ships$(who), k, 1) = "I" THEN x = x + 1
NEXT k
IF x > 0 THEN PRINT "("; x; "Ironclads) ";
IF fleet_city(who) > 0 AND fleet_city(who) < 99 THEN PRINT "in "; city_name$(fleet_city(who)) ELSE PRINT
IF train_army(who) > 0 THEN COLOR 14: PRINT " Army #"; train_army(who); army_name$(train_army(who)); " on train to "; city_name$(army_order(train_army(who)));
LINE (0, 0)-(639, 449), 15, B
LINE (0, 62)-(639, 62), 15
GOTO endrep
'..........................................................................
'                               City Report
'..........................................................................
cityrep:
CLS : LOCATE 1, 1: COLOR 14
PRINT "City Report"; TAB(20); month_name$(turn_month); ","; turn_year: COLOR 15
PRINT " #    City       Control   Value"; TAB(41); " #    City       Control   Value"
LINE (1, 30)-(630, 30), 15
FOR i = 1 TO 20: COLOR 4: a$ = "neutral": IF city_owner(i) = 1 THEN COLOR 9: a$ = "UNION"
IF city_owner(i) = 2 THEN COLOR 7: a$ = "REBEL"
LOCATE 2 + i, 1: PRINT i; TAB(6); city_name$(i); TAB(18); a$; TAB(29); city_value(i)
NEXT i

FOR i = 21 TO 40: COLOR 4: a$ = "neutral": IF city_owner(i) = 1 THEN COLOR 9: a$ = "UNION"
IF city_owner(i) = 2 THEN COLOR 7: a$ = "REBEL"
LOCATE i - 18, 41: PRINT i; TAB(46); city_name$(i); TAB(58); a$; TAB(69); city_value(i)
NEXT i
LINE (1, 360)-(630, 360), 15
COLOR 9: LOCATE 24, 1: PRINT "Side    No. Cities   Income    Cash"
COLOR 9: PRINT side_name$(1); TAB(12); side_city_count(1); TAB(23); side_income(1); TAB(32); side_cash(1)
COLOR 7: PRINT side_name$(2); TAB(12); side_city_count(2); TAB(23); side_income(2); TAB(32); side_cash(2)
COLOR 4: PRINT side_name$(0); TAB(12); 40 - side_city_count(1) - side_city_count(2)
LINE (1, 382)-(630, 382), 15
GOTO endrep
'..........................................................................
'                               Intelligence
'..........................................................................
srep:
c = 9: IF side = 2 THEN c = 7
CALL draw_map
CALL side_army_range(star, fin, side)
FOR k = star TO fin
	IF army_size(k) > 0 THEN
	COLOR c
	x = city_x(army_city(k))
	y = city_y(army_city(k))
	z = 10: IF army_size(k) < 1000 THEN z = 9
	x = x / 8 - 2: y = y / 16
	IF y > 26 THEN y = 26
	FOR j = 0 TO 3
	LOCATE y + j, x: PRINT SPACE$(z);
	NEXT j
	LOCATE y, x: PRINT "Siz:"; : CALL print_army_size(k)
	LOCATE y + 1, x: PRINT "Ldr:"; army_leader_rating(k)
	LOCATE y + 2, x: PRINT "Xpr:"; army_experience(k)
	LOCATE y + 3, x: PRINT "Sup:"; army_supply(k);
	LINE (8 * (x - 1) - 1, 16 * (y - 1) - 1)-(8 * (x + z - 1) + 1, 16 * (y + 3) + 1), 15, B
	wait_seconds 1
END IF
NEXT k
GOTO endrep
'..........................................................................
'                               Force Summary
'..........................................................................
frep:
FOR k = 1 TO 40
	IF city_army(k) > 0 THEN
		FOR j = 1 TO 40
		IF army_city(j) = k THEN summ(k) = summ(k) + army_size(j)
		NEXT j
	END IF
NEXT k

CLS : CALL draw_map
FOR k = 1 TO 40
IF summ(k) > 0 THEN
	c = 9: IF city_owner(k) = 2 THEN c = 7
	COLOR c
	LOCATE INT(city_y(k) / 16 + 1), city_x(k) / 8: PRINT summ(k)
END IF
NEXT k
COLOR 14: LOCATE 1, 20: PRINT "Total Forces in Cities (100's)"
GOTO endrep
'..........................................................................
'                               Battle Report
'..........................................................................
batrep:
VIEW (200, 123)-(400, 284)
CLS 1
VIEW
LINE (200, 123)-(400, 284), 15, B
COLOR 14
LOCATE 9, 32: PRINT "BATTLE SUMMARY"
CALL draw_flag_icon(320, 160, 1)
CALL draw_flag_icon(370, 160, 2)
LINE (200, 176)-(400, 230), 15, B
LINE (200, 230)-(400, 284), 15, B
LINE (290, 176)-(345, 284), 15, B
LOCATE 13, 27: PRINT "BATTLES"
LOCATE 14, 27: PRINT "WON"
LOCATE 16, 27: PRINT "MEN LOST"
LOCATE 17, 27: PRINT "(1000's)"
LOCATE 14, 38: PRINT side_battles_won(1)
LOCATE 14, 45: PRINT side_battles_won(2)
LOCATE 17, 38: PRINT INT(.1 * side_casualties&(1))
LOCATE 17, 45: PRINT INT(.1 * side_casualties&(2))
IF opt_history > 0 AND who > 2 THEN
	OPEN "O", #1, "battsumm"
	PRINT #1, " SIDE      BATTLES WON       LOSSES"
	FOR k = 1 TO 2
	a$ = " ": IF victory_reason = k THEN a$ = "*"
	PRINT #1, a$; side_name$(k), side_battles_won(k), 100 * side_casualties&(k)
	NEXT k
	CLOSE #1
END IF
GOTO endrep
'..........................................................................
'                               Recap (History)
'..........................................................................
recap:
CLS : x = 0
OPEN "I", 2, "cws.his"
DO WHILE NOT EOF(2)
INPUT #2, a$
COLOR 7: IF INSTR(a$, "[") THEN COLOR 15
IF INSTR(a$, ">") THEN COLOR 14
IF INSTR(a$, "..") THEN COLOR 11
IF INSTR(a$, "!") THEN COLOR 12
LOCATE 29, 1: PRINT a$
x = x + 1
IF x > 27 THEN wait_seconds .4
LOOP
CLOSE #2

endrep:
COLOR 14: LOCATE 29, 29: PRINT "press a key";
CALL script_mark_key_wait(1, "F"): DO WHILE INKEY$ = "": LOOP
IF who < 3 THEN
	CLS
	CALL draw_map
END IF
END SUB

SUB army_resupply (index)
		who = 1: IF index > 20 THEN who = 2
		IF opt_realism > 0 THEN
			CALL city_is_connected(who, army_city(index), a)
			IF a < 1 THEN EXIT SUB
		END IF
		IF army_size(index) > 0 THEN x = side_cash(who) / army_size(index) * 10
		y = x + army_supply(index): IF y > 5 THEN x = 5 - army_supply(index)
		IF x < 1 THEN CALL clear_bottom_line: PRINT "Not enough funds in the Treasury to supply "; army_name$(index); : GOTO nocash
		army_supply(index) = army_supply(index) + x: side_cash(who) = side_cash(who) - .1 * x * army_size(index)
		CALL clear_bottom_line: PRINT army_name$(index); " has received supplies "; : IF opt_sound > 0 THEN SOUND 4500, .5
nocash:
		CALL wait_seconds(opt_pause!): IF side_cash(who) < 0 THEN side_cash(who) = 0
END SUB

SUB menu_army_retreat (defend, x)
x = 0
IF opt_players = 1 THEN
	IF (side = 1 AND defend > 20) OR (side = 2 AND defend < 21) THEN EXIT SUB
END IF

menu_highlight = 13: menu_color = 3: menu_col = 67: menu_row = 5: menu_item_count = 0
y = army_city(defend)
who = 1: IF defend > 20 THEN who = 2
FOR k = 1 TO 6
	IF matrix(y, k) > 0 AND city_owner(matrix(y, k)) = who THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(matrix(y, k)): menu_value(menu_item_count) = matrix(y, k)
NEXT k
	IF menu_item_count = 0 THEN EXIT SUB
	IF menu_item_count = 1 THEN x = menu_value(1): EXIT SUB
	menu_text$(0) = "Retreat"
	CALL menu_bubble_sort(menu_item_count)
	CALL menu_select(9)
	CALL clear_right_panel
	IF menu_choice < 0 OR menu_choice > menu_item_count THEN x = 0: EXIT SUB
	x = menu_value(menu_choice)
END SUB

SUB army_generate_name (target, a$)
a$ = "Union ": IF target > 20 THEN a$ = "Rebel "
IF target > 20 THEN target = target - 20
IF target > 10 THEN a$ = a$ + "X": target = target - 10
SELECT CASE target
	CASE IS < 4
	x = target: GOSUB add1s
	CASE 4
	a$ = a$ + "IV"
	CASE 5 TO 8
	a$ = a$ + "V"
	x = target - 5
	GOSUB add1s
	CASE 9
	a$ = a$ + "IX"
	CASE 10
	a$ = a$ + "X"
END SELECT
EXIT SUB

add1s:
IF x > 0 THEN FOR k = 1 TO x: a$ = a$ + "I": NEXT k
RETURN

END SUB

SUB draw_rebel_victory
LINE (2, 2)-(637, 239), 4, BF
COLOR 15: LINE (2, 40)-(597, 239): LINE -(637, 239): LINE -(637, 199): LINE -(40, 2): LINE -(2, 2): LINE -(2, 40)
