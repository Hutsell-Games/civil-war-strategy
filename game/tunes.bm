' The war's tunes: Shenandoah, the title's tune, and each side's short tune.
'
' A tune is played one note at a time, and a key stops it before its next note. A PLAY in the
' foreground returns about a quarter of a second before its sound ends, in QB64pe, QB64Rust and
' QBJS, so the next note is queued in time and the notes join without a gap. PLAY "MB" would not
' do: QB64pe cannot take back notes already queued, and QBJS has no PLAY function to pace them.

SUB play_shenandoah
    '                       Shenandoah
    IF opt_sound = SOUND_MUSIC THEN
        IF play_until_key%("T90MFMNo1c4f8f8f4.g8a8b-8o2d8c4.MLf8e8MNd4.c8d8c8o1a8o2c4.c4d8d8d4.o1a8o2c8o1a8g8f4.g4a4.f8a8o2d8c4.o1f8g8a4.f8g4f2.") THEN
            menu_choice = 1
        END IF
    END IF
END SUB

' The title's tune: the Union's, or Shenandoah for the Rebels. A key stops either.
SUB play_title_music
    DIM stopped AS INTEGER
    IF current_side = SIDE_UNION THEN
        stopped = play_until_key%("MST170o1e8o0b8o1e8e8e4f#8g4f#8g4e8d2o0b8o1d2 o1e8o0b8o1e8e8e4f#8g4f#8g4a8b2g8b2MLg16a16MSb4b8b8a8g8a4a8a4f#8g4g8MLg8f#8MSe8f#4f#8f#8g8a8b4.a4.g4.f#4.o0b8o1e8e8e4d8e2.")
    ELSE
        CALL play_shenandoah
    END IF
END SUB

' The side's short tune, for a city taken or an event that is good for the side. The caller
' asks whether music is on.
SUB play_side_tune (side)
    IF side = SIDE_UNION THEN
        PLAY "MNMFL16o2T120dd.dd.co1b.o2do3g.ab.bb.ag"
    ELSE
        PLAY "MNMFT160o2L16geL8ccL16cdefL8ggge"
    END IF
END SUB

' Plays tune$ one note at a time. Gives -1, with the rest of the tune not played, when a key is
' pressed (the key is used up), and 0 when the tune played to its end.
FUNCTION play_until_key% (tune$)
    DIM start AS INTEGER
    DIM finish AS INTEGER
    play_until_key% = 0
    start = 1
    DO WHILE start <= LEN(tune$)
        IF INKEY$ <> "" THEN
            play_until_key% = -1
            EXIT FUNCTION
        END IF
        finish = tune_note_end%(tune$, start)
        PLAY MID$(tune$, start, finish - start + 1)
        start = finish + 1
    LOOP
END FUNCTION

' The position in tune$ of the last character of the piece that starts at start and holds one
' note (A to G, N or P) with its length and dots, and the commands before it. A command
' that starts with M (MF, MB, MN, ML, MS) is two letters, so the B, F or N in it is not a note.
' After the last note the piece runs to the end of tune$.
FUNCTION tune_note_end% (tune$, start)
    DIM i AS INTEGER
    DIM c$
    DIM noted AS INTEGER
    noted = 0
    i = start
    DO WHILE i <= LEN(tune$)
        c$ = UCASE$(MID$(tune$, i, 1))
        IF c$ = "M" THEN
            IF noted THEN
                EXIT DO
            END IF
            i = i + 1
        ELSEIF INSTR("ABCDEFGNP", c$) > 0 THEN
            IF noted THEN
                EXIT DO
            END IF
            noted = 1
        ELSEIF INSTR("OTLV<>", c$) > 0 THEN
            IF noted THEN
                EXIT DO
            END IF
        END IF
        i = i + 1
    LOOP
    IF i > LEN(tune$) THEN
        i = LEN(tune$) + 1
    END IF
    tune_note_end% = i - 1
END FUNCTION
