' The special events of the war: which one happens and what it does. They draw nothing; the
' messages are special_events and event_riot (ui/events.bm).

' Rolls the month's special event and carries out what it does. event is EVENT_NONE when
' nothing happens. variant picks the message of EVENT_MERCENARIES (0 French, 1 British) and
' of EVENT_UPRISING (0 the Indian uprisings, 1 the 90-day enlistees, 2 the 1864 furloughs).
' who is the side the event is rolled for: SIDE_UNION's events are good for the South.
' EVENT_RIOTS is rolled here and carried out by event_riot. EVENT_RIFLES is followed by
' Stanton's prediction, as EVENT_STANTON is.
SUB event_roll (event, variant, who)
DIM k AS INTEGER: DIM plus AS INTEGER: DIM pct!: DIM empty AS INTEGER: DIM i AS INTEGER: DIM x AS INTEGER: DIM index AS INTEGER
event = EVENT_NONE: variant = 0: who = 0
CALL script_dice_next
'==========================================================================
'                              Special Events
'==========================================================================
IF opt_realism >= REALISM_ON AND turn_year = IRONCLAD_YEAR AND turn_month < IRONCLAD_MONTH THEN
	event = EVENT_IRONCLADS
	EXIT SUB
END IF
IF opt_event_balance = 0 THEN EXIT SUB
plus = opt_difficulty: IF current_side = SIDE_UNION THEN plus = 6 - opt_difficulty
pct! = .005 * (turn_year - 1860) * plus * plus: IF pct! > .9 THEN pct! = .9
IF script_rnd! > pct! THEN EXIT SUB

who = SIDE_UNION: IF script_rnd! > .1 * opt_event_balance THEN who = SIDE_REBEL

SELECT CASE who
'----------------------------------------------------------------------------
'                               good for South
'----------------------------------------------------------------------------
	CASE 1
	IF turn_year = 1864 AND turn_month = 1 THEN sides(SIDE_REBEL).victory_points = sides(SIDE_REBEL).victory_points + 50
	IF turn_year = 1865 AND turn_month = 1 THEN sides(SIDE_REBEL).victory_points = sides(SIDE_REBEL).victory_points + 100
	IF script_rnd! > .9 THEN event = EVENT_RIOTS: EXIT SUB

	IF script_rnd! > .2 OR fleets(SIDE_REBEL).size >= MAX_FLEET_SHIPS GOTO mercen
	IF fleets(SIDE_REBEL).size > 0 AND fleets(SIDE_REBEL).city <> FLEET_AT_SEA THEN empty = fleets(SIDE_REBEL).city: GOTO float1
		empty = 0
		FOR i = 1 TO MAX_CITIES
		IF city_owner(i) = SIDE_REBEL AND city_port_type(i) = PORT_SEA AND fleets(SIDE_UNION).city <> i THEN empty = i: EXIT FOR
		NEXT i
	IF empty = 0 GOTO mercen
float1:
	event = EVENT_ENGLISH_SHIPS
	fleets(SIDE_REBEL).size = fleets(SIDE_REBEL).size + 2 * plus
	IF fleets(SIDE_REBEL).size > MAX_FLEET_SHIPS THEN fleets(SIDE_REBEL).size = MAX_FLEET_SHIPS
	x = fleets(SIDE_REBEL).size - LEN(fleets(SIDE_REBEL).ships)
	fleets(SIDE_REBEL).ships = fleets(SIDE_REBEL).ships + STRING$(x, "W")
	fleets(SIDE_REBEL).city = empty
	GOTO dull1
mercen:
	IF script_rnd! > .1 OR sides(SIDE_REBEL).city_count < 30 GOTO money
	variant = 0: IF script_rnd! > .5 THEN variant = 1
	event = EVENT_MERCENARIES
	army_size(index) = army_size(index) + 100 * plus
	army_experience(index) = MAX_EXPERIENCE: army_supply(index) = MAX_SUPPLY
	GOTO dull1
money:
	IF script_rnd! > .3 OR sides(SIDE_REBEL).city_count < 12 GOTO cotton
		event = EVENT_LOAN
		GOTO purse
cotton:
	IF script_rnd! > .5 OR sides(SIDE_REBEL).city_count < 12 GOTO uprising
	event = EVENT_COTTON
purse:
	sides(SIDE_REBEL).cash = sides(SIDE_REBEL).cash + 100 * plus
	GOTO dull1
uprising:
	pct! = .9
	variant = 0
	IF script_rnd! > .5 THEN variant = 1
	IF turn_year = 1864 AND turn_month > 5 THEN variant = 2: pct! = .8
	event = EVENT_UPRISING
	FOR k = 1 TO ARMIES_PER_SIDE
	army_size(k) = pct! * army_size(k)
	NEXT k
	GOTO dull1
'----------------------------------------------------------------------------
'                               good for Union
'----------------------------------------------------------------------------
	CASE 2
	IF script_rnd! > .1 OR fleets(SIDE_UNION).city = 0 OR fleets(SIDE_UNION).size >= MAX_FLEET_SHIPS GOTO event2
	IF script_rnd! > .95 THEN event = EVENT_RIOTS: EXIT SUB
	event = EVENT_SHIPWORKS
	fleets(SIDE_UNION).size = fleets(SIDE_UNION).size + plus
	IF fleets(SIDE_UNION).size > MAX_FLEET_SHIPS THEN fleets(SIDE_UNION).size = MAX_FLEET_SHIPS
	x = fleets(SIDE_UNION).size - LEN(fleets(SIDE_UNION).ships)
	fleets(SIDE_UNION).ships = fleets(SIDE_UNION).ships + STRING$(x, "W")
	GOTO dull2
event2:
	IF script_rnd! < .7 GOTO abe
	event = EVENT_VOLUNTEERS
	x = 0: FOR i = 1 TO ARMIES_PER_SIDE: x = x + 1: IF x > 5 GOTO dull2
	IF army_size(i) > 0 AND script_rnd! > .5 THEN army_size(i) = army_size(i) * 1.1 + plus
	NEXT i: GOTO dull2
abe:
	IF emancipation_done = 0 AND turn_year > 1862 THEN

		emancipation_done = 1
		event = EVENT_EMANCIPATION
		sides(SIDE_UNION).victory_points = sides(SIDE_UNION).victory_points + 100: sides(SIDE_REBEL).victory_points = sides(SIDE_REBEL).victory_points - 100
		' SHELL "abelinco.exe" (a DOS program with no source; cannot run on 64-bit Windows)
		GOTO dull2
	END IF
	IF turn_year = 1864 AND turn_month = 11 THEN
		event = EVENT_REELECTION
		sides(SIDE_REBEL).victory_points = .5 * sides(SIDE_REBEL).victory_points
		GOTO dull2
	END IF
	IF script_rnd! > .5 THEN
		event = EVENT_DONATIONS
		sides(SIDE_UNION).cash = sides(SIDE_UNION).cash + 100 * plus
		GOTO dull2
	END IF
	IF script_rnd! > .5 AND turn_year > FIRST_YEAR THEN
		event = EVENT_DESERTERS
		FOR i = ARMIES_PER_SIDE + 1 TO MAX_ARMIES: army_size(i) = .92 * army_size(i): NEXT i: GOTO dull2
	END IF
	IF script_rnd! > .5 AND turn_year > FIRST_YEAR THEN
		event = EVENT_RIFLES
		FOR i = 1 TO ARMIES_PER_SIDE
			IF army_experience(i) < 9 THEN army_experience(i) = army_experience(i) + 2
		NEXT i
	END IF
		IF event = EVENT_NONE THEN event = EVENT_STANTON
		sides(SIDE_UNION).victory_points = sides(SIDE_UNION).victory_points + 10: GOTO dull2
	CASE ELSE
END SELECT

dull2:
dull1:
END SUB

' A riot: a city that the side took from the other side, with no army in it, turns neutral.
' city is 0 when no such city is found.
SUB event_riot_city (who, city)
DIM k AS INTEGER: DIM x AS INTEGER
city = 0
	IF opt_realism = REALISM_OFF THEN EXIT SUB
	IF sides(who).city_count = 1 THEN EXIT SUB
	FOR k = 1 TO 99
	x = 1 + INT(MAX_CITIES * script_rnd!)
		IF city_first_owner(x) <> who AND city_owner(x) = who AND city_army(x) = 0 THEN
			city = x: city_owner(x) = SIDE_NONE: EXIT SUB
		END IF
	NEXT k
END SUB
