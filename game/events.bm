SUB special_events
DIM k AS INTEGER: DIM plus AS INTEGER: DIM pct!: DIM who AS INTEGER: DIM empty AS INTEGER: DIM i AS INTEGER: DIM x AS INTEGER: DIM a$: DIM index AS INTEGER
'==========================================================================
'                              Special Events
'==========================================================================
IF opt_realism > 0 AND turn_year = 1862 AND turn_month < 3 THEN
	COLOR 14: CALL clear_bottom_line
	PRINT "SPECIAL DEVELOPMENT : IRONCLAD ships now available";
	IF opt_sound > 0 THEN FOR k = 1 TO 5: SOUND 140, 1: SOUND 37, 1: NEXT k
	CALL script_mark_key_wait(1, "I"): DO WHILE INKEY$ = "": LOOP
	EXIT SUB
END IF
IF opt_event_balance = 0 THEN EXIT SUB
plus = opt_difficulty: IF current_side = SIDE_UNION THEN plus = 6 - opt_difficulty
pct! = .005 * (turn_year - 1860) * plus * plus: IF pct! > .9 THEN pct! = .9
IF RND > pct! THEN EXIT SUB

CALL clear_bottom_line: COLOR 14: PRINT "SPECIAL EVENT...";
who = SIDE_UNION: IF RND > .1 * opt_event_balance THEN who = SIDE_REBEL

SELECT CASE who
'----------------------------------------------------------------------------
'                               good for South
'----------------------------------------------------------------------------
	CASE 1
	IF turn_year = 1864 AND turn_month = 1 THEN side_victory_points(SIDE_REBEL) = side_victory_points(SIDE_REBEL) + 50
	IF turn_year = 1865 AND turn_month = 1 THEN side_victory_points(SIDE_REBEL) = side_victory_points(SIDE_REBEL) + 100
	IF RND > .9 THEN GOSUB riot: EXIT SUB

	CALL clear_bottom_line
	IF RND > .2 OR fleet_size(SIDE_REBEL) >= MAX_FLEET_SHIPS GOTO mercen
	IF fleet_size(SIDE_REBEL) > 0 AND fleet_city(SIDE_REBEL) <> FLEET_AT_SEA THEN empty = fleet_city(SIDE_REBEL): GOTO float1
		empty = 0
		FOR i = 1 TO MAX_CITIES
		IF city_owner(i) = SIDE_REBEL AND city_port_type(i) = PORT_SEA AND fleet_city(SIDE_UNION) <> i THEN empty = i: EXIT FOR
		NEXT i
	IF empty = 0 GOTO mercen
float1:
	CALL scribe_message("England has given ships to the South", SHOW_BOX)
	fleet_size(SIDE_REBEL) = fleet_size(SIDE_REBEL) + 2 * plus
	IF fleet_size(SIDE_REBEL) > MAX_FLEET_SHIPS THEN fleet_size(SIDE_REBEL) = MAX_FLEET_SHIPS
	x = fleet_size(SIDE_REBEL) - LEN(fleet_ships$(SIDE_REBEL))
	fleet_ships$(SIDE_REBEL) = fleet_ships$(SIDE_REBEL) + STRING$(x, "W")
	fleet_city(SIDE_REBEL) = empty: CALL draw_fleets
	GOTO dull1
mercen:
	IF RND > .1 OR side_city_count(SIDE_REBEL) < 30 GOTO money
	a$ = "French": IF RND > .5 THEN a$ = "British"
	CALL scribe_message(a$ + " mercenaries join " + army_name$(index) + "'s army", SHOW_BOX)
	army_size(index) = army_size(index) + 100 * plus
	army_experience(index) = MAX_EXPERIENCE: army_supply(index) = MAX_SUPPLY
	GOTO dull1
money:
	IF RND > .3 OR side_city_count(SIDE_REBEL) < 12 GOTO cotton
		CALL scribe_message("The South has obtained a loan from Europe", SHOW_BOX)
		GOTO purse
cotton:
	IF RND > .5 OR side_city_count(SIDE_REBEL) < 12 GOTO uprising
	CALL scribe_message("Cash from cotton sales fill the Rebel Treasury", SHOW_BOX)
purse:
	side_cash(SIDE_REBEL) = side_cash(SIDE_REBEL) + 100 * plus
	GOTO dull1
uprising:
	pct! = .9
	a$ = "Union troops diverted to fight Western Indian uprisings"
	IF RND > .5 THEN a$ = "Union 90-day enlistees return home"
	IF turn_year = 1864 AND turn_month > 5 THEN a$ = "20% of Union forces take furloughs to vote in 1864 elections": pct! = .8
	CALL scribe_message(a$, SHOW_BOX)
	FOR k = 1 TO ARMIES_PER_SIDE
	army_size(k) = pct! * army_size(k)
	NEXT k
	GOTO dull1
'----------------------------------------------------------------------------
riot:
	IF opt_realism = 0 THEN RETURN
	IF side_city_count(who) = 1 THEN RETURN
	FOR k = 1 TO 99
	x = 1 + INT(MAX_CITIES * RND)
		IF city_first_owner(x) <> who AND city_owner(x) = who AND city_army(x) = 0 THEN
			CALL clear_bottom_line: COLOR 15
			PRINT " Riots have broken out in "; city_name$(x);
			city_owner(x) = SIDE_NONE
			CALL draw_cities
			wait_seconds opt_pause!
			CALL clear_bottom_line
			CALL show_message_box(city_name$(x) + " is now NEUTRAL !", 4)
			wait_seconds opt_pause!
			RETURN
		END IF
	NEXT k
	RETURN
'----------------------------------------------------------------------------
'                               good for Union
'----------------------------------------------------------------------------
	CASE 2
	IF RND > .1 OR fleet_city(SIDE_UNION) = 0 OR fleet_size(SIDE_UNION) >= MAX_FLEET_SHIPS GOTO event2
	IF RND > .95 THEN GOSUB riot: EXIT SUB
	CALL scribe_message("Union shipworks have produced extra ships", SHOW_BOX)
	fleet_size(SIDE_UNION) = fleet_size(SIDE_UNION) + plus
	IF fleet_size(SIDE_UNION) > MAX_FLEET_SHIPS THEN fleet_size(SIDE_UNION) = MAX_FLEET_SHIPS
	x = fleet_size(SIDE_UNION) - LEN(fleet_ships$(SIDE_UNION))
	fleet_ships$(SIDE_UNION) = fleet_ships$(SIDE_UNION) + STRING$(x, "W")
	GOTO dull2
event2:
	IF RND < .7 GOTO abe
	CALL scribe_message("Volunteer troops swell the Union ranks", SHOW_BOX)
	x = 0: FOR i = 1 TO ARMIES_PER_SIDE: x = x + 1: IF x > 5 GOTO dull2
	IF army_size(i) > 0 AND RND > .5 THEN army_size(i) = army_size(i) * 1.1 + plus
	NEXT i: GOTO dull2
abe:
	IF emancipation_done = 0 AND turn_year > 1862 THEN

		emancipation_done = 1
		CALL scribe_message("Abraham Lincoln announces the Emancipation Proclamation", SHOW_BOX)
		side_victory_points(SIDE_UNION) = side_victory_points(SIDE_UNION) + 100: side_victory_points(SIDE_REBEL) = side_victory_points(SIDE_REBEL) - 100
		' SHELL "abelinco.exe" (a DOS program with no source; cannot run on 64-bit Windows)
		CALL draw_map
		GOTO dull2
	END IF
	IF turn_year = 1864 AND turn_month = 11 THEN
		CALL scribe_message("Lincoln has been reelected", SHOW_BOX)
		side_victory_points(SIDE_REBEL) = .5 * side_victory_points(SIDE_REBEL)
		GOTO dull2
	END IF
	IF RND > .5 THEN
		CALL scribe_message("Wealthy Unionists give generously to the Federal Cause", SHOW_BOX)
		side_cash(SIDE_UNION) = side_cash(SIDE_UNION) + 100 * plus
		GOTO dull2
	END IF
	IF RND > .5 AND turn_year > 1861 THEN
		CALL scribe_message("Rebel deserters leave the battlefield to go home", SHOW_BOX)
		FOR i = ARMIES_PER_SIDE + 1 TO MAX_ARMIES: army_size(i) = .92 * army_size(i): NEXT i: GOTO dull2
	END IF
	IF RND > .5 AND turn_year > 1861 THEN
		CALL scribe_message("Union soldiers now have repeating rifles", SHOW_BOX)
		FOR i = 1 TO ARMIES_PER_SIDE
			IF army_experience(i) < 9 THEN army_experience(i) = army_experience(i) + 2
		NEXT i
	END IF
		CALL scribe_message("Secretary of War Stanton predicts the end of the Rebellion", SHOW_BOX)
		side_victory_points(SIDE_UNION) = side_victory_points(SIDE_UNION) + 10: GOTO dull2
	CASE ELSE
END SELECT

dull2:
	IF opt_sound = 2 THEN PLAY "MNMFL16o2T120dd.dd.co1b.o2do3g.ab.bb.ag"
	CALL script_mark_key_wait(1, "N"): DO WHILE INKEY$ = "": LOOP: EXIT SUB
dull1:
	IF opt_sound = 2 THEN PLAY "MNMFT160o2L16geL8ccL16cdefL8ggge"
	CALL script_mark_key_wait(1, "S"): DO WHILE INKEY$ = "": LOOP
END SUB
