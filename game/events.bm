' The special events of the war: which one happens and what it does. They draw nothing; the
' messages are special_events and event_riot (ui/events.bm).

' Rolls the month's special event and carries out what it does. event is EVENT_NONE when
' nothing happens. variant picks the message of EVENT_MERCENARIES (0 French, 1 British) and
' of EVENT_UPRISING (0 the Indian uprisings, 1 the 90-day enlistees, 2 the 1864 furloughs).
' event_side is the side the event is rolled for: SIDE_UNION's events are good for the South.
' EVENT_RIOTS is rolled here and carried out by event_riot. EVENT_RIFLES is followed by
' Stanton's prediction, as EVENT_STANTON is.
SUB event_roll (event, variant, event_side)
DIM k AS INTEGER: DIM event_weight AS INTEGER: DIM chance!: DIM share_kept!: DIM port AS INTEGER: DIM i AS INTEGER: DIM new_ships AS INTEGER: DIM count AS INTEGER: DIM army AS INTEGER
event = EVENT_NONE: variant = 0: event_side = 0
CALL script_dice_next
'==========================================================================
'                              Special Events
'==========================================================================
IF opt_realism >= REALISM_ON AND turn_year = IRONCLAD_YEAR AND turn_month < IRONCLAD_MONTH THEN
	event = EVENT_IRONCLADS
	EXIT SUB
END IF
IF opt_event_balance = 0 THEN EXIT SUB
event_weight = opt_difficulty: IF current_side = SIDE_UNION THEN event_weight = 6 - opt_difficulty
chance! = .005 * (turn_year - 1860) * event_weight * event_weight: IF chance! > .9 THEN chance! = .9
IF script_rnd! > chance! THEN EXIT SUB

event_side = SIDE_UNION: IF script_rnd! > .1 * opt_event_balance THEN event_side = SIDE_REBEL

SELECT CASE event_side
'----------------------------------------------------------------------------
'                               good for South
'----------------------------------------------------------------------------
	CASE 1
	IF turn_year = 1864 AND turn_month = 1 THEN side_victory_points(SIDE_REBEL) = side_victory_points(SIDE_REBEL) + 50
	IF turn_year = 1865 AND turn_month = 1 THEN side_victory_points(SIDE_REBEL) = side_victory_points(SIDE_REBEL) + 100
	IF script_rnd! > .9 THEN event = EVENT_RIOTS: EXIT SUB

	IF script_rnd! <= .2 AND fleet_size(SIDE_REBEL) < MAX_FLEET_SHIPS THEN
		IF fleet_size(SIDE_REBEL) > 0 AND fleet_city(SIDE_REBEL) <> FLEET_AT_SEA THEN
			port = fleet_city(SIDE_REBEL)
			event = EVENT_ENGLISH_SHIPS
		ELSE
			port = 0
			FOR i = 1 TO MAX_CITIES
			IF city_owner(i) = SIDE_REBEL AND city_port_type(i) = PORT_SEA AND fleet_city(SIDE_UNION) <> i THEN port = i: EXIT FOR
			NEXT i
			IF port <> 0 THEN event = EVENT_ENGLISH_SHIPS
		END IF
		IF event = EVENT_ENGLISH_SHIPS THEN
			fleet_size(SIDE_REBEL) = fleet_size(SIDE_REBEL) + 2 * event_weight
			IF fleet_size(SIDE_REBEL) > MAX_FLEET_SHIPS THEN fleet_size(SIDE_REBEL) = MAX_FLEET_SHIPS
			new_ships = fleet_size(SIDE_REBEL) - LEN(fleet_ships$(SIDE_REBEL))
			fleet_ships$(SIDE_REBEL) = fleet_ships$(SIDE_REBEL) + STRING$(new_ships, "W")
			fleet_city(SIDE_REBEL) = port
			EXIT SUB
		END IF
	END IF
	IF script_rnd! <= .1 AND side_city_count(SIDE_REBEL) >= 30 THEN
		variant = 0: IF script_rnd! > .5 THEN variant = 1
		event = EVENT_MERCENARIES
		army_size(army) = army_size(army) + 100 * event_weight
		army_experience(army) = MAX_EXPERIENCE: army_supply(army) = MAX_SUPPLY
		EXIT SUB
	END IF
	IF script_rnd! <= .3 AND side_city_count(SIDE_REBEL) >= 12 THEN
		event = EVENT_LOAN
		side_cash(SIDE_REBEL) = side_cash(SIDE_REBEL) + 100 * event_weight
		EXIT SUB
	END IF
	IF script_rnd! <= .5 AND side_city_count(SIDE_REBEL) >= 12 THEN
		event = EVENT_COTTON
		side_cash(SIDE_REBEL) = side_cash(SIDE_REBEL) + 100 * event_weight
		EXIT SUB
	END IF
	share_kept! = .9
	variant = 0
	IF script_rnd! > .5 THEN variant = 1
	IF turn_year = 1864 AND turn_month > 5 THEN variant = 2: share_kept! = .8
	event = EVENT_UPRISING
	FOR k = 1 TO ARMIES_PER_SIDE
	army_size(k) = share_kept! * army_size(k)
	NEXT k
'----------------------------------------------------------------------------
'                               good for Union
'----------------------------------------------------------------------------
	CASE 2
	IF script_rnd! <= .1 AND fleet_city(SIDE_UNION) <> 0 AND fleet_size(SIDE_UNION) < MAX_FLEET_SHIPS THEN
		IF script_rnd! > .95 THEN event = EVENT_RIOTS: EXIT SUB
		event = EVENT_SHIPWORKS
		fleet_size(SIDE_UNION) = fleet_size(SIDE_UNION) + event_weight
		IF fleet_size(SIDE_UNION) > MAX_FLEET_SHIPS THEN fleet_size(SIDE_UNION) = MAX_FLEET_SHIPS
		new_ships = fleet_size(SIDE_UNION) - LEN(fleet_ships$(SIDE_UNION))
		fleet_ships$(SIDE_UNION) = fleet_ships$(SIDE_UNION) + STRING$(new_ships, "W")
		EXIT SUB
	END IF
	IF script_rnd! >= .7 THEN
		event = EVENT_VOLUNTEERS
		count = 0: FOR i = 1 TO ARMIES_PER_SIDE: count = count + 1: IF count > 5 THEN EXIT SUB
		IF army_size(i) > 0 AND script_rnd! > .5 THEN army_size(i) = army_size(i) * 1.1 + event_weight
		NEXT i: EXIT SUB
	END IF
	IF emancipation_done = 0 AND turn_year > 1862 THEN

		emancipation_done = 1
		event = EVENT_EMANCIPATION
		side_victory_points(SIDE_UNION) = side_victory_points(SIDE_UNION) + 100: side_victory_points(SIDE_REBEL) = side_victory_points(SIDE_REBEL) - 100
		' SHELL "abelinco.exe" (a DOS program with no source; cannot run on 64-bit Windows)
		EXIT SUB
	END IF
	IF turn_year = 1864 AND turn_month = 11 THEN
		event = EVENT_REELECTION
		side_victory_points(SIDE_REBEL) = .5 * side_victory_points(SIDE_REBEL)
		EXIT SUB
	END IF
	IF script_rnd! > .5 THEN
		event = EVENT_DONATIONS
		side_cash(SIDE_UNION) = side_cash(SIDE_UNION) + 100 * event_weight
		EXIT SUB
	END IF
	IF script_rnd! > .5 AND turn_year > FIRST_YEAR THEN
		event = EVENT_DESERTERS
		FOR i = ARMIES_PER_SIDE + 1 TO MAX_ARMIES: army_size(i) = .92 * army_size(i): NEXT i: EXIT SUB
	END IF
	IF script_rnd! > .5 AND turn_year > FIRST_YEAR THEN
		event = EVENT_RIFLES
		FOR i = 1 TO ARMIES_PER_SIDE
			IF army_experience(i) < 9 THEN army_experience(i) = army_experience(i) + 2
		NEXT i
	END IF
		IF event = EVENT_NONE THEN event = EVENT_STANTON
		side_victory_points(SIDE_UNION) = side_victory_points(SIDE_UNION) + 10
	CASE ELSE
END SELECT
END SUB

' A riot: a city that the side took from the other side, with no army in it, turns neutral.
' city is 0 when no such city is found.
SUB event_riot_city (side, city)
DIM k AS INTEGER: DIM candidate_city AS INTEGER
city = 0
	IF opt_realism = REALISM_OFF THEN EXIT SUB
	IF side_city_count(side) = 1 THEN EXIT SUB
	FOR k = 1 TO 99
	candidate_city = 1 + INT(MAX_CITIES * script_rnd!)
		IF city_first_owner(candidate_city) <> side AND city_owner(candidate_city) = side AND city_army(candidate_city) = 0 THEN
			city = candidate_city: city_owner(candidate_city) = SIDE_NONE: EXIT SUB
		END IF
	NEXT k
END SUB
