' Sorts a list of cities by name, as the menu's bubble sort sorts its rows (menu_bubble_sort).
SUB city_list_sort (cities(), count)
    DIM i AS INTEGER: DIM swaps%
    DO
        swaps% = FALSE
        FOR i = 1 TO count - 1
            IF city_name$(cities(i)) > city_name$(cities(i + 1)) THEN
                SWAP cities(i), cities(i + 1)
                swaps% = i
            END IF
        NEXT i
    LOOP WHILE swaps%
END SUB

' The number of cities next to city that side holds: 0 when the city is cut off.
FUNCTION city_is_connected (side, city)
    DIM j AS INTEGER: DIM neighbor AS INTEGER: DIM friendly_neighbors AS INTEGER
    friendly_neighbors = 0
    FOR j = 1 TO MAX_ROADS
        neighbor = city_road(city, j)
        IF neighbor > 0 AND city_owner(neighbor) = side THEN friendly_neighbors = friendly_neighbors + 1
    NEXT j
    city_is_connected = friendly_neighbors
END FUNCTION

' A side takes a city: the city's value in victory points, and 100 more taken from the other
' side when it is that side's capital, which the other side then no longer has. A fort loses a
' level when weaken_fort is above 0. city_capture (commands/city.bm) shows it.
SUB city_take (city, side, weaken_fort)
    city_owner(city) = side
    side_victory_points(side) = side_victory_points(side) + city_value(city)
    IF city = side_capital(other_side(side)) THEN
        side_victory_points(side) = side_victory_points(side) + 100
        side_victory_points(other_side(side)) = side_victory_points(other_side(side)) - 100
        side_capital(other_side(side)) = 0
    END IF
    IF city_fort(city) > 0 AND weaken_fort > 0 THEN city_fort(city) = city_fort(city) - 1
END SUB

' Fortify: the city's fort grows a level, and the side pays for it.
SUB city_build_fort (side, city)
    city_fort(city) = city_fort(city) + 1
    side_cash(side) = side_cash(side) - COST_FORT
END SUB

' Capital, first half: the side pays to move its capital, and the other side gets 50 victory
' points. This comes before the new capital is picked, so a player who then gives up has paid.
SUB capital_move_pay (side)
    side_cash(side) = side_cash(side) - COST_MOVE_CAPITAL
    side_victory_points(other_side(side)) = side_victory_points(other_side(side)) + 50
END SUB

' Capital, second half: the city is the side's capital.
SUB capital_move_to (side, city)
    side_capital(side) = city
END SUB

' Gives every road a way back: when city i has a road to a city that has no road to i, the
' road back is added in that city's first free slot. Each road without a way back is listed
' in from_city() and to_city(), with added() 1 when the road back was added and 0 when the
' city had no free slot. count is the length of the list. check_map_links (ui/reports.bm) shows it.
SUB city_fix_return_routes (count, added(), from_city(), to_city())
    DIM i AS INTEGER: DIM j AS INTEGER: DIM k AS INTEGER: DIM neighbor AS INTEGER: DIM linked AS INTEGER
    count = 0
    FOR i = 1 TO MAX_CITIES
        FOR j = 1 TO MAX_ROADS
            IF city_road(i, j) = 0 THEN EXIT FOR
            neighbor = city_road(i, j)
            linked = 0
            FOR k = 1 TO MAX_ROADS
                IF city_road(neighbor, k) = i THEN linked = 1: EXIT FOR
                IF city_road(neighbor, k) = 0 THEN city_road(neighbor, k) = i: count = count + 1: added(count) = 1: from_city(count) = neighbor: to_city(count) = i: linked = 1: EXIT FOR
            NEXT k
            IF linked = 0 THEN count = count + 1: added(count) = 0: from_city(count) = neighbor: to_city(count) = i
        NEXT j
    NEXT i
END SUB

SUB city_update_occupier (city)
    DIM i AS INTEGER
    city_army(city) = 0
    FOR i = 1 TO MAX_ARMIES
        IF army_city(i) = city THEN city_army(city) = i: EXIT SUB
    NEXT i
END SUB
