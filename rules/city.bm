' Sorts a list of cities by name, as the menu's bubble sort sorts its rows (menu_bubble_sort).
SUB city_list_sort (cities(), count)
    DIM i AS INTEGER
    DIM swaps%
    DO
        swaps% = FALSE
        FOR i = 1 TO count - 1
            IF city_name$(cities(i)) > city_name$(cities(i + 1)) THEN
                SWAP cities(i), cities(i + 1)
                swaps% = i
            END IF
        NEXT i
    LOOP WHILE swaps%
END SUB

' The number of cities next to city that side holds: 0 when the city is cut off.
FUNCTION city_is_connected (side, city)
    DIM j AS INTEGER
    DIM neighbor AS INTEGER
    DIM friendly_neighbors AS INTEGER
    friendly_neighbors = 0
    FOR j = 1 TO MAX_ROADS
        neighbor = city_road(city, j)
        IF neighbor > 0 AND city_owner(neighbor) = side THEN
            friendly_neighbors = friendly_neighbors + 1
        END IF
    NEXT j
    city_is_connected = friendly_neighbors
END FUNCTION

' A side takes a city: the city's value in victory points, and 100 more taken from the other
' side when it is that side's capital, which the other side then no longer has. A fort loses a
' level when weaken_fort is above 0. city_capture (commands/city.bm) shows it.
SUB city_take (city, side, weaken_fort)
    city_owner(city) = side
    side_victory_points(side) = side_victory_points(side) + city_value(city)
    IF city = side_capital(other_side(side)) THEN
        side_victory_points(side) = side_victory_points(side) + 100
        side_victory_points(other_side(side)) = side_victory_points(other_side(side)) - 100
        side_capital(other_side(side)) = 0
    END IF
    IF city_fort(city) > 0 AND weaken_fort > 0 THEN
        city_fort(city) = city_fort(city) - 1
    END IF
END SUB

' The side's next city from city, stepping by direction (1 or -1) and wrapping past either
' end: the first city the side holds within max_steps steps, or 0 when there is none. With
' max_steps MAX_CITIES a city the side holds is always found, if only city itself.
FUNCTION side_city_step (city, side, direction, max_steps)
    DIM steps AS INTEGER
    DIM next_city AS INTEGER
    side_city_step = 0
    next_city = city
    FOR steps = 1 TO max_steps
        next_city = next_city + direction
        IF next_city > MAX_CITIES THEN
            next_city = 1
        ELSEIF next_city < 1 THEN
            next_city = MAX_CITIES
        END IF
        IF city_owner(next_city) = side THEN
            side_city_step = next_city
            EXIT FUNCTION
        END IF
    NEXT steps
END FUNCTION

' The city a letter picks in the city picker (menu_city_select): the first city whose name
' starts with the letter, when the side holds it; otherwise the side's next city after that one.
' The search takes 38 steps, as the original's 39 tries did, so the city just before is never
' looked at. city when no name starts with the letter or the search finds nothing.
FUNCTION side_city_by_letter (letter$, side, city)
    DIM k AS INTEGER
    DIM found AS INTEGER
    side_city_by_letter = city
    FOR k = 1 TO MAX_CITIES
        IF LEFT$(city_name$(k), 1) = letter$ THEN
            IF city_owner(k) = side THEN
                side_city_by_letter = k
            ELSE
                found = side_city_step(k, side, 1, MAX_CITIES - 2)
                IF found > 0 THEN
                    side_city_by_letter = found
                END IF
            END IF
            EXIT FUNCTION
        END IF
    NEXT k
END FUNCTION

' Whether the side has the money for a fort.
FUNCTION fort_affordable (side)
    fort_affordable = side_cash(side) >= COST_FORT
END FUNCTION

' Whether the side can move its capital: it has one, and the money.
FUNCTION capital_can_move (side)
    capital_can_move = side_capital(side) <> 0 AND side_cash(side) >= COST_MOVE_CAPITAL
END FUNCTION

' Fortify: the city's fort grows a level, and the side pays for it.
SUB city_build_fort (side, city)
    city_fort(city) = city_fort(city) + 1
    side_cash(side) = side_cash(side) - COST_FORT
END SUB

' Capital, first half: the side pays to move its capital, and the other side gets 50 victory
' points. This comes before the new capital is picked, so a player who then gives up has paid.
SUB capital_move_pay (side)
    side_cash(side) = side_cash(side) - COST_MOVE_CAPITAL
    side_victory_points(other_side(side)) = side_victory_points(other_side(side)) + 50
END SUB

' Capital, second half: the city is the side's capital.
SUB capital_move_to (side, city)
    side_capital(side) = city
END SUB

' Gives every road a way back: when city i has a road to a city that has no road to i, the
' road back is added in that city's first free slot. Each road without a way back is listed
' in from_city() and to_city(), with added() 1 when the road back was added and 0 when the
' city had no free slot. count is the length of the list. check_map_links (ui/reports.bm) shows it.
SUB city_fix_return_routes (count, added(), from_city(), to_city())
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM k AS INTEGER
    DIM neighbor AS INTEGER
    DIM linked AS INTEGER
    count = 0
    FOR i = 1 TO MAX_CITIES
        FOR j = 1 TO MAX_ROADS
            IF city_road(i, j) = 0 THEN
                EXIT FOR
            END IF
            neighbor = city_road(i, j)
            linked = 0
            FOR k = 1 TO MAX_ROADS
                IF city_road(neighbor, k) = i THEN
                    linked = 1
                    EXIT FOR
                END IF
                IF city_road(neighbor, k) = 0 THEN
                    city_road(neighbor, k) = i
                    count = count + 1
                    added(count) = 1
                    from_city(count) = neighbor
                    to_city(count) = i
                    linked = 1
                    EXIT FOR
                END IF
            NEXT k
            IF linked = 0 THEN
                count = count + 1
                added(count) = 0
                from_city(count) = neighbor
                to_city(count) = i
            END IF
        NEXT j
    NEXT i
END SUB

SUB city_update_occupier (city)
    DIM i AS INTEGER
    city_army(city) = 0
    FOR i = 1 TO MAX_ARMIES
        IF army_city(i) = city THEN
            city_army(city) = i
            EXIT SUB
        END IF
    NEXT i
END SUB
