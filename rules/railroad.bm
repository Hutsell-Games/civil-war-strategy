' The rules of a side's train. They draw nothing. railroad_start and railroad_arrive
' (commands/railroad.bm) show the train and call them.

' Puts an army on the train for a city. The army leaves its city, which passes to the next army
' there, if any.
SUB railroad_board (side, army, city)
DIM from AS INTEGER
	from = army_city(army)
	trains(side).city = from
	trains(side).from_city = from
	trains(side).army = army: army_city(army) = 0: army_order(army) = city
	CALL city_update_occupier(from)
END SUB

' The train arrives: the city it left passes to the next army there, and its army gets off in
' the city it was sent to, where army_order becomes ORDER_BUSY.
SUB railroad_unload (side)
DIM index AS INTEGER
	CALL city_update_occupier(trains(side).from_city)
	index = trains(side).army
	trains(side).city = army_order(index)
	trains(side).army = 0: army_city(index) = army_order(index): army_order(index) = ORDER_BUSY
END SUB

' Counts the side's track out of a city: each road to a city of the side, and each road on
' from there to another city of the side.
FUNCTION railroad_route_count (side, city)
DIM x AS INTEGER: DIM j AS INTEGER: DIM y AS INTEGER: DIM m AS INTEGER: DIM z AS INTEGER
	x = 0: FOR j = 1 TO MAX_ROADS
	y = city_road(city, j)
	IF y > 0 AND city_owner(y) = side THEN
	x = x + 1
		FOR m = 1 TO MAX_ROADS
		z = city_road(y, m)
		IF z > 0 AND z <> city AND city_owner(z) = side THEN x = x + 1
		NEXT m
	END IF
NEXT j
railroad_route_count = x
END FUNCTION

' The largest army that side's railroad can carry.
FUNCTION railroad_capacity (side)
DIM x AS INTEGER: DIM limit AS INTEGER
IF opt_realism = REALISM_OFF THEN railroad_capacity = trains(side).capacity: EXIT FUNCTION
x = 11: IF current_side = SIDE_REBEL THEN x = 23
limit = trains(side).capacity + 5 * (sides(side).city_count - x)
x = 2 * trains(side).capacity
IF limit > x THEN limit = x
IF limit < x \ 4 THEN limit = x \ 4
railroad_capacity = limit
END FUNCTION
