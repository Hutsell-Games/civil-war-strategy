' The rules of a land battle. They draw nothing. calculate_battle (ui/battle.bm) shows the battle
' and calls them in this order: battle_strengths, battle_fight, battle_losses, battle_apply_losses.

' Both armies' strengths, step by step, as the right panel shows them. An army of fewer than 100
' men fights as one of 100.
' attack_steps(): 1 base, 2 leader and experience, 3 small army, 4 outmanned, 5 supply,
'   6 difficulty, 7 the attack.
' defend_steps(): 1 defense, 2 leader and experience, 3 small army, 4 outmanned, 5 supply,
'   6 difficulty, 7 fort, 8 the defense.
SUB battle_strengths (attacker, defender, attack_steps(), defend_steps())
DIM x AS INTEGER: DIM x1 AS INTEGER: DIM R!
IF army_size(defender) < 1 THEN army_size(defender) = 1
IF army_size(attacker) < 1 THEN army_size(attacker) = 1

x = .01 * army_size(attacker): IF x > rule_strength_cap THEN x = rule_strength_cap
attack_steps(1) = x
IF army_size(attacker) / army_size(defender) > .2 THEN x = x + .3 * army_leader_rating(attacker) + .3 * army_experience(attacker): IF x > rule_strength_cap THEN x = rule_strength_cap
IF army_experience(attacker) > 8 THEN x = x + 1: IF x > rule_strength_cap THEN x = rule_strength_cap
attack_steps(2) = x
IF army_size(attacker) < 15 THEN x = .5 * x: IF x > rule_strength_cap THEN x = rule_strength_cap
attack_steps(3) = x
IF army_size(attacker) / army_size(defender) <= .5 THEN x = x - 2: IF x < 1 THEN x = 1
IF army_size(attacker) / army_size(defender) > 3 THEN x = x + 2: IF x > rule_strength_cap THEN x = rule_strength_cap
IF army_size(attacker) / army_size(defender) > 10 THEN x = rule_strength_cap
IF army_size(attacker) / army_size(defender) <= .2 THEN x = 1
attack_steps(4) = x
IF army_supply(attacker) < 1 THEN x = .5 * x
attack_steps(5) = x
IF x < 1 THEN x = 1
'                       Adjust attack advantage
IF army_side(attacker) = SIDE_UNION AND current_side = SIDE_REBEL AND opt_difficulty > 3 THEN x = x + 2 * opt_difficulty - 6
IF army_side(attacker) = SIDE_REBEL AND current_side = SIDE_UNION AND opt_difficulty < 3 THEN x = x + 6 - 2 * opt_difficulty
attack_steps(6) = x
IF x > rule_strength_cap THEN x = rule_strength_cap
attack_steps(7) = x

x1 = .013 * army_size(defender) + 1: IF opt_realism = REALISM_ON THEN x1 = .02 * army_size(defender) + 2: IF x1 > 20 THEN x1 = 20
defend_steps(1) = x1
IF army_size(defender) / army_size(attacker) > .2 THEN x1 = x1 + .3 * army_leader_rating(defender) + .3 * army_experience(defender): IF x1 > rule_strength_cap THEN x1 = rule_strength_cap
IF army_experience(defender) > 8 THEN x1 = x1 + 1: IF x1 > rule_strength_cap THEN x1 = rule_strength_cap
defend_steps(2) = x1
IF army_size(defender) < 15 THEN x1 = .5 * x1
defend_steps(3) = x1

R! = army_size(defender) / army_size(attacker)
SELECT CASE R!
	CASE IS > 10
		x1 = rule_strength_cap
	CASE IS > 1.5
		x1 = x1 + 2
	CASE IS < .5
		x1 = .8 * x1
	CASE IS < .2
		x1 = .5 * x1
END SELECT
	IF x1 < 1 THEN x1 = 1
	IF x1 > rule_strength_cap THEN x1 = rule_strength_cap

defend_steps(4) = x1
IF army_supply(defender) < 1 THEN x1 = .5 * x1
defend_steps(5) = x1
IF x1 < 1 THEN x1 = 1
'                       Adjust defend advantage
IF army_side(defender) = SIDE_UNION AND current_side = SIDE_REBEL AND opt_difficulty > 3 THEN x1 = x1 + 2 * opt_difficulty - 6
IF army_side(defender) = SIDE_REBEL AND current_side = SIDE_UNION AND opt_difficulty < 3 THEN x1 = x1 + 6 - 2 * opt_difficulty
defend_steps(6) = x1

IF army_order(defender) = ORDER_NONE THEN x1 = x1 * (1 + city_fort(army_city(defender)))
IF x1 > rule_strength_cap THEN x1 = rule_strength_cap
defend_steps(7) = x1
IF x1 > rule_strength_cap THEN x1 = rule_strength_cap
defend_steps(8) = x1
END SUB

' The fight: each army rolls against its strength until one hits and the other does not. It also
' takes a day of supply from armies 1 and 2, whoever fights. rounds is how many rolls it took.
SUB battle_fight (attack, defend, attacker, defender, winner, loser, rounds)
DIM i AS INTEGER: DIM scale AS INTEGER: DIM hit AS INTEGER: DIM hit1 AS INTEGER: DIM star AS INTEGER: DIM fin AS INTEGER
scale = attack: IF defend > scale THEN scale = defend
scale = scale + 1
FOR i = 1 TO 2: IF army_supply(i) > 0 THEN army_supply(i) = army_supply(i) - 1
NEXT i
rounds = 0
DO
	hit = 0: hit1 = 0
	star = scale * RND: fin = scale * RND
	rounds = rounds + 1
	IF star <= attack THEN hit = 1
	IF fin <= defend THEN hit1 = 1
LOOP WHILE hit = hit1
winner = defender: loser = attacker: IF hit = 1 THEN winner = attacker: loser = defender
END SUB

' The losses of both armies, in hundreds of men. battle_apply_losses takes them later.
SUB battle_losses (attacker, defender, winner, attacker_losses, defender_losses)
DIM pct!: DIM xbar AS INTEGER: DIM vary AS INTEGER
pct! = .01 * rule_defend_loss - .03 * city_fort(army_city(defender)): IF winner = attacker THEN pct! = 1.3 * pct!
SELECT CASE army_size(defender)
	CASE IS > 300
		pct! = .9 * pct!
	CASE IS > 800
		pct! = .8 * pct!
END SELECT
xbar = army_size(attacker) * pct!
vary = xbar * (1 - pct!)
CALL normal_random_number(xbar, vary, defender_losses)
'...........................................................................
pct! = .01 * rule_attack_loss + .02 * city_fort(army_city(defender)): IF winner = defender THEN pct! = 1.5 * pct!
SELECT CASE army_size(attacker)
	CASE IS > 300
		pct! = .9 * pct!
	CASE IS > 800
		pct! = .8 * pct!
END SELECT
xbar = army_size(defender) * pct!
vary = xbar * (1 - pct!)
CALL normal_random_number(xbar, vary, attacker_losses)
'===========================================================================

attacker_losses = .8 * attacker_losses + .2 * defender_losses: IF attacker_losses < 1 THEN attacker_losses = 1
defender_losses = .8 * defender_losses + .2 * attacker_losses: IF defender_losses < 1 THEN defender_losses = 1
IF attacker_losses > 9 * defender_losses THEN attacker_losses = 9 * defender_losses
IF defender_losses > 5 * attacker_losses THEN defender_losses = 5 * attacker_losses

IF attacker_losses >= army_size(attacker) THEN attacker_losses = army_size(attacker) - 1
IF defender_losses >= army_size(defender) THEN defender_losses = army_size(defender) - 1
END SUB

' Takes the losses from both armies and records the battle: each side's casualties, and a battle won
' and a victory point for the winner's side.
SUB battle_apply_losses (attacker, defender, winner, attacker_losses, defender_losses)
DIM side AS INTEGER
army_size(attacker) = army_size(attacker) - attacker_losses
army_size(defender) = army_size(defender) - defender_losses
IF army_size(defender) < 1 THEN army_size(defender) = 1
'---------------------------------------------------------------------------
side = 1: IF attacker > 2 THEN side = 2
side_casualties&(side) = side_casualties&(side) + attacker_losses
side_casualties&(other_side(side)) = side_casualties&(other_side(side)) + defender_losses
'---------------------------------------------------------------------------
side = army_side(winner)
side_battles_won(side) = side_battles_won(side) + 1
side_victory_points(side) = side_victory_points(side) + 1
END SUB

SUB normal_random_number (xbar, vary, result)
DIM pct!: DIM k AS INTEGER
' NOTE : vary is VARIANCE
pct! = 0
FOR k = 1 TO 12: pct! = pct! + RND: NEXT k
pct! = pct! - 5.5
result = xbar + pct! * SQR(vary)
END SUB
