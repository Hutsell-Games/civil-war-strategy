' The rules of a land battle. They draw nothing. calculate_battle (ui/battle.bm) shows the battle
' and calls them in this order: battle_strengths, battle_fight, battle_losses, battle_apply_losses.

' Both armies' strengths, step by step, as the right panel shows them. An army of fewer than 100
' troops fights as one of 100.
' attack_steps(): 1 base, 2 leader and experience, 3 small army, 4 outmanned, 5 supply,
'   6 difficulty, 7 the attack.
' defend_steps(): 1 defense, 2 leader and experience, 3 small army, 4 outmanned, 5 supply,
'   6 difficulty, 7 fort, 8 the defense.
SUB battle_strengths (attacker, defender, attack_steps(), defend_steps())
    DIM attack_strength AS INTEGER
    DIM defend_strength AS INTEGER
    DIM size_ratio!
    IF army_size(defender) < 1 THEN
        army_size(defender) = 1
    END IF
    IF army_size(attacker) < 1 THEN
        army_size(attacker) = 1
    END IF

    attack_strength = attack_per_size# * army_size(attacker)
    attack_strength = strength_capped(attack_strength)
    attack_steps(1) = attack_strength
    IF army_size(attacker) / army_size(defender) > .2 THEN
        attack_strength = attack_strength + battle_leader_weight# * army_leader_rating(attacker) + battle_experience_weight# * army_experience(attacker)
        attack_strength = strength_capped(attack_strength)
    END IF
    IF army_experience(attacker) > veteran_experience THEN
        attack_strength = attack_strength + 1
        attack_strength = strength_capped(attack_strength)
    END IF
    attack_steps(2) = attack_strength
    IF army_size(attacker) < small_army_size THEN
        attack_strength = small_army_strength# * attack_strength
        attack_strength = strength_capped(attack_strength)
    END IF
    attack_steps(3) = attack_strength
    IF army_size(attacker) / army_size(defender) <= .5 THEN
        attack_strength = attack_strength - attack_outnumbered_penalty
        IF attack_strength < 1 THEN
            attack_strength = 1
        END IF
    END IF
    IF army_size(attacker) / army_size(defender) > 3 THEN
        attack_strength = attack_strength + attack_outnumbering_bonus
        attack_strength = strength_capped(attack_strength)
    END IF
    IF army_size(attacker) / army_size(defender) > 10 THEN
        attack_strength = rule_strength_cap
    END IF
    IF army_size(attacker) / army_size(defender) <= .2 THEN
        attack_strength = 1
    END IF
    attack_steps(4) = attack_strength
    IF army_supply(attacker) < 1 THEN
        attack_strength = no_supply_strength# * attack_strength
    END IF
    attack_steps(5) = attack_strength
    IF attack_strength < 1 THEN
        attack_strength = 1
    END IF
    '                       Adjust attack advantage
    attack_strength = attack_strength + balance_strength * balance_help(army_side(attacker))
    attack_steps(6) = attack_strength
    attack_strength = strength_capped(attack_strength)
    attack_steps(7) = attack_strength

    defend_strength = defense_per_size# * army_size(defender) + defense_base
    IF opt_realism = REALISM_ON THEN
        defend_strength = defense_per_size_realism# * army_size(defender) + defense_base_realism
        IF defend_strength > defense_most_realism THEN
            defend_strength = defense_most_realism
        END IF
    END IF
    defend_steps(1) = defend_strength
    IF army_size(defender) / army_size(attacker) > .2 THEN
        defend_strength = defend_strength + battle_leader_weight# * army_leader_rating(defender) + battle_experience_weight# * army_experience(defender)
        defend_strength = strength_capped(defend_strength)
    END IF
    IF army_experience(defender) > veteran_experience THEN
        defend_strength = defend_strength + 1
        defend_strength = strength_capped(defend_strength)
    END IF
    defend_steps(2) = defend_strength
    IF army_size(defender) < small_army_size THEN
        defend_strength = small_army_strength# * defend_strength
    END IF
    defend_steps(3) = defend_strength

    size_ratio! = army_size(defender) / army_size(attacker)
    SELECT CASE size_ratio!
        CASE IS > 10
            defend_strength = rule_strength_cap
        CASE IS > 1.5
            defend_strength = defend_strength + defend_outnumbering_bonus
        CASE IS < .2
            defend_strength = defend_badly_outnumbered# * defend_strength
        CASE IS < .5
            defend_strength = defend_outnumbered# * defend_strength
    END SELECT
    IF defend_strength < 1 THEN
        defend_strength = 1
    END IF
    defend_strength = strength_capped(defend_strength)

    defend_steps(4) = defend_strength
    IF army_supply(defender) < 1 THEN
        defend_strength = no_supply_strength# * defend_strength
    END IF
    defend_steps(5) = defend_strength
    IF defend_strength < 1 THEN
        defend_strength = 1
    END IF
    '                       Adjust defend advantage
    defend_strength = defend_strength + balance_strength * balance_help(army_side(defender))
    defend_steps(6) = defend_strength

    IF army_order(defender) = ORDER_NONE THEN
        defend_strength = defend_strength * (1 + city_fort(army_city(defender)))
    END IF
    defend_strength = strength_capped(defend_strength)
    defend_steps(7) = defend_strength
    defend_steps(8) = defend_strength
END SUB

' strength, or the scenario's cap on a battle strength when strength is above it.
FUNCTION strength_capped (strength)
    strength_capped = strength
    IF strength > rule_strength_cap THEN
        strength_capped = rule_strength_cap
    END IF
END FUNCTION

' The fight: each army rolls against its strength until one hits and the other does not. It also
' takes a day of supply from each of the two armies. rounds is how many rolls it took.
SUB battle_fight (attack_strength, defend_strength, attacker, defender, winner, loser, rounds)
    DIM scale AS INTEGER
    DIM attacker_hit AS INTEGER
    DIM defender_hit AS INTEGER
    DIM attack_roll AS INTEGER
    DIM defend_roll AS INTEGER
    scale = attack_strength
    IF defend_strength > scale THEN
        scale = defend_strength
    END IF
    scale = scale + 1
    IF army_supply(attacker) > 0 THEN
        army_supply(attacker) = army_supply(attacker) - 1
    END IF
    IF army_supply(defender) > 0 THEN
        army_supply(defender) = army_supply(defender) - 1
    END IF
    rounds = 0
    DO
        attacker_hit = FALSE
        defender_hit = FALSE
        attack_roll = scale * RND
        defend_roll = scale * RND
        rounds = rounds + 1
        IF attack_roll <= attack_strength THEN
            attacker_hit = TRUE
        END IF
        IF defend_roll <= defend_strength THEN
            defender_hit = TRUE
        END IF
    LOOP WHILE attacker_hit = defender_hit
    winner = defender
    loser = attacker
    IF attacker_hit THEN
        winner = attacker
        loser = defender
    END IF
END SUB

' A loss rate for army's side, made smaller when army is large: by a tenth over 300 (30,000
' troops), by a fifth over 800. The product is written as battle_losses wrote it, so it rounds
' the same.
FUNCTION battle_size_rate! (loss_rate!, army)
    battle_size_rate! = loss_rate!
    SELECT CASE army_size(army)
        CASE IS > huge_army_size
            battle_size_rate! = huge_army_loss# * loss_rate!
        CASE IS > large_army_size
            battle_size_rate! = large_army_loss# * loss_rate!
    END SELECT
END FUNCTION

' A loss rate kept between 0 and 1. At the shipped knobs it is always inside. The tuning knobs
' can push it out: below 0 behind a strong fort, above 1 for a side that loses with a large
' multiplier. normal_random_number would then take the square root of a negative variance,
' which stops the program.
FUNCTION battle_rate_bounded! (loss_rate!)
    battle_rate_bounded! = loss_rate!
    IF loss_rate! < 0 THEN
        battle_rate_bounded! = 0
    END IF
    IF loss_rate! > 1 THEN
        battle_rate_bounded! = 1
    END IF
END FUNCTION

' The losses army takes in a battle with enemy, before they are shared out: a normal draw around
' the share loss_rate! of the enemy's troops. The rate is made smaller when army is large and
' kept between 0 and 1. The rate is a SINGLE, as battle_losses kept it.
FUNCTION battle_draw_losses (loss_rate!, army, enemy)
    DIM rate!
    DIM mean AS INTEGER
    DIM variance AS INTEGER
    rate! = battle_rate_bounded!(battle_size_rate!(loss_rate!, army))
    mean = army_size(enemy) * rate!
    variance = mean * (1 - rate!)
    battle_draw_losses = normal_random_number(mean, variance)
END FUNCTION

' The losses of both armies, in hundreds of troops. battle_apply_losses takes them later.
' The defender's losses are drawn first.
SUB battle_losses (attacker, defender, winner, attacker_losses, defender_losses)
    DIM loss_rate!
    loss_rate! = .01 * rule_defend_loss - fort_defender_loss# * city_fort(army_city(defender))
    IF winner = attacker THEN
        loss_rate! = attacker_wins_loss# * loss_rate!
    END IF
    defender_losses = battle_draw_losses(loss_rate!, defender, attacker)

    loss_rate! = .01 * rule_attack_loss + fort_attacker_loss# * city_fort(army_city(defender))
    IF winner = defender THEN
        loss_rate! = defender_wins_loss# * loss_rate!
    END IF
    attacker_losses = battle_draw_losses(loss_rate!, attacker, defender)

    attacker_losses = loss_own_share# * attacker_losses + loss_other_share# * defender_losses
    IF attacker_losses < 1 THEN
        attacker_losses = 1
    END IF
    defender_losses = loss_own_share# * defender_losses + loss_other_share# * attacker_losses
    IF defender_losses < 1 THEN
        defender_losses = 1
    END IF
    IF attacker_losses > attacker_loss_most_times * defender_losses THEN
        attacker_losses = attacker_loss_most_times * defender_losses
    END IF
    IF defender_losses > defender_loss_most_times * attacker_losses THEN
        defender_losses = defender_loss_most_times * attacker_losses
    END IF

    IF attacker_losses >= army_size(attacker) THEN
        attacker_losses = army_size(attacker) - 1
    END IF
    IF defender_losses >= army_size(defender) THEN
        defender_losses = army_size(defender) - 1
    END IF
END SUB

' Takes the losses from both armies and records the battle: each side's casualties, and a battle won
' and a victory point for the winner's side. The casualties and the battle count in the game's
' totals and in those of all games.
SUB battle_apply_losses (attacker, defender, winner, attacker_losses, defender_losses)
    DIM side AS INTEGER
    army_size(attacker) = army_size(attacker) - attacker_losses
    army_size(defender) = army_size(defender) - defender_losses
    IF army_size(defender) < 1 THEN
        army_size(defender) = 1
    END IF

    side = army_side(attacker)
    side_casualties&(side) = side_casualties&(side) + attacker_losses
    side_casualties&(other_side(side)) = side_casualties&(other_side(side)) + defender_losses
    all_casualties&(side) = all_casualties&(side) + attacker_losses
    all_casualties&(other_side(side)) = all_casualties&(other_side(side)) + defender_losses

    side = army_side(winner)
    side_battles_won(side) = side_battles_won(side) + 1
    all_battles_won&(side) = all_battles_won&(side) + 1
    side_victory_points(side) = side_victory_points(side) + 1
END SUB

' Approximates a normal draw from twelve random values, centered half a standard deviation above mean.
FUNCTION normal_random_number (mean, variance)
    DIM sum!
    DIM k AS INTEGER
    sum! = 0
    FOR k = 1 TO 12
        sum! = sum! + RND
    NEXT k
    sum! = sum! - 5.5
    normal_random_number = mean + sum! * SQR(variance)
END FUNCTION
