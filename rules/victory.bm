' The rules of victory and of the Hall of Fame. They draw nothing; the screens are in
' ui/victory.bm.

' The troops in the field: union_troops the Union's and rebel_troops the Rebels', in hundreds.
' An army on a train counts (army_in_field).
SUB victory_forces (union_troops, rebel_troops)
    union_troops = side_field_troops(SIDE_UNION)
    rebel_troops = side_field_troops(SIDE_REBEL)
END SUB

' The side's share of both sides' income, from 0 to 1. A DOUBLE, so that a comparison with a
' rule's limit comes out as it did when the division was written in the comparison.
FUNCTION victory_income_share# (side)
    victory_income_share# = side_income(side) / (side_income(SIDE_UNION) + side_income(SIDE_REBEL))
END FUNCTION

' The side's troops divided by the other side's. union_troops and rebel_troops are the sides'
' troops (victory_forces); the other side's must not be 0. A DOUBLE, as victory_income_share#.
FUNCTION victory_troop_ratio# (side, union_troops, rebel_troops)
    IF side = SIDE_UNION THEN
        victory_troop_ratio# = union_troops / rebel_troops
    ELSE
        victory_troop_ratio# = rebel_troops / union_troops
    END IF
END FUNCTION

' Turns a victory rule on or off (the Utility menu's End Cond). A rule that is off keeps
' its number as a negative.
SUB victory_toggle_rule (rule)
    victory_rule(rule) = -victory_rule(rule)
END SUB

' 1 when the time limit's year has come and its month is still ahead.
FUNCTION victory_time_near
    victory_time_near = 0
    IF victory_rule(VICTORY_YEAR) > 0 AND turn_year >= victory_rule(VICTORY_YEAR) AND turn_month < victory_rule(VICTORY_MONTH) THEN
        victory_time_near = 1
    END IF
END FUNCTION

' The victory rule that the side has met, in rule: 2 time, 3 cities, 4 income, 5 the capital,
' 6 the strength ratio, 7 the enemy wiped out, which also gives 300 victory points. rule is 0
' when it has met none. union_troops and rebel_troops are the sides' troops (victory_forces).
SUB victory_rule_met (side, union_troops, rebel_troops, rule)
    rule = 0
    IF (side = SIDE_UNION AND rebel_troops = 0) OR (side = SIDE_REBEL AND union_troops = 0) THEN
        rule = VICTORY_WIPED_OUT
        side_victory_points(side) = side_victory_points(side) + wiped_out_points
        EXIT SUB
    END IF

    IF turn_year >= victory_rule(VICTORY_YEAR) AND turn_month >= victory_rule(VICTORY_MONTH) AND victory_rule(VICTORY_YEAR) > 0 THEN
        rule = VICTORY_YEAR
        EXIT SUB
    END IF
    IF side_city_count(side) >= victory_rule(VICTORY_CITIES) AND victory_rule(VICTORY_CITIES) > 0 THEN
        rule = VICTORY_CITIES
        EXIT SUB
    END IF
    IF victory_income_share#(side) >= .01 * victory_rule(VICTORY_INCOME) AND victory_rule(VICTORY_INCOME) > 0 THEN
        rule = VICTORY_INCOME
        EXIT SUB
    END IF
    IF victory_rule(VICTORY_CAPITAL) > 0 AND side_capital(other_side(side)) = 0 AND side_capital(side) > 0 THEN
        rule = VICTORY_CAPITAL
        EXIT SUB
    END IF

    ' The enemy's troops are not 0 here: the wiped-out rule above took that case.
    IF victory_rule(VICTORY_FORCE_RATIO) > 0 THEN
        IF victory_troop_ratio#(side, union_troops, rebel_troops) > victory_rule(VICTORY_FORCE_RATIO) THEN
            rule = VICTORY_FORCE_RATIO
        END IF
    END IF
END SUB

' 1 when the side holds nine tenths of the cities the cities rule asks for.
FUNCTION victory_near_cities (side)
    victory_near_cities = 0
    IF victory_rule(VICTORY_CITIES) > 0 AND side_city_count(side) >= .9 * victory_rule(VICTORY_CITIES) THEN
        victory_near_cities = 1
    END IF
END FUNCTION

' 1 when the side has nine tenths of the share of the income the income rule asks for.
FUNCTION victory_near_income (side)
    victory_near_income = 0
    IF victory_rule(VICTORY_INCOME) > 0 AND victory_income_share#(side) >= .009 * victory_rule(VICTORY_INCOME) THEN
        victory_near_income = 1
    END IF
END FUNCTION

' 1 when the side has nine tenths of the strength ratio the ratio rule asks for. union_troops and
' rebel_troops are the sides' troops.
FUNCTION victory_near_force (side, union_troops, rebel_troops)
    victory_near_force = 0
    IF victory_rule(VICTORY_FORCE_RATIO) > 0 AND union_troops > 0 AND rebel_troops > 0 THEN
        IF victory_troop_ratio#(side, union_troops, rebel_troops) > .9 * victory_rule(VICTORY_FORCE_RATIO) THEN
            victory_near_force = 1
        END IF
    END IF
END FUNCTION

' The player plays on after the victory rule in rule was met: the rule asks for one more, and
' the capital rule (5) is turned off.
SUB victory_play_on (rule)
    victory_rule(rule) = victory_rule(rule) + 1
    IF rule = VICTORY_CAPITAL THEN
        victory_rule(rule) = 0
    END IF
END SUB

' The side that wins when side has met rule (victory_rule_met): the Rebels when time ran out,
' a technical victory, whichever side met it first. The original ended the game with the
' Union, which check_victory_conditions tests first, and marked the Union as the winner (G39).
FUNCTION victory_winner (side, rule)
    victory_winner = side
    IF rule = VICTORY_YEAR THEN
        victory_winner = SIDE_REBEL
    END IF
END FUNCTION

' The game ends with the side's victory by the rule in rule: 100 more victory points when the enemy was
' wiped out (7), the side marked for the battle summary, and the game over.
SUB victory_won (side, rule)
    IF rule = VICTORY_WIPED_OUT THEN
        side_victory_points(side) = side_victory_points(side) + victory_points_bonus
    END IF
    victory_reason = side
    game_over = 1
END SUB

' A technical victory when the time ran out: both sides keep seven tenths of their points.
SUB victory_technical_points
    DIM k AS INTEGER
    FOR k = SIDE_UNION TO SIDE_REBEL
        side_victory_points(k) = time_limit_points_share# * side_victory_points(k)
    NEXT k
END SUB

' The place in the side's Hall of Fame that its score earns: the first whose score it reaches, or
' 0 when it reaches none.
FUNCTION hall_of_fame_place (side, hall_score())
    DIM i AS INTEGER
    hall_of_fame_place = 0
    FOR i = 1 TO 5
        IF side_victory_points(side) >= hall_score(side, i) THEN
            hall_of_fame_place = i
            EXIT FUNCTION
        END IF
    NEXT i
END FUNCTION

' Puts commander name$ in the side's Hall of Fame at place i, with the side's score. The entries
' below move down one, and the last drops out.
SUB hall_of_fame_insert (side, place, name$, hall_name$(), hall_score())
    DIM j AS INTEGER
    FOR j = 5 TO place + 1 STEP -1
        hall_score(side, j) = hall_score(side, j - 1)
        hall_name$(side, j) = hall_name$(side, j - 1)
    NEXT j
    hall_name$(side, place) = name$
    hall_score(side, place) = side_victory_points(side)
END SUB
