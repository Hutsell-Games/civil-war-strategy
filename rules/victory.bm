' The rules of victory and of the Hall of Fame. They draw nothing; the screens are in
' ui/victory.bm.

' The men in the field: x the Union's and y the Rebels', in hundreds.
SUB victory_forces (x, y)
DIM j AS INTEGER
	x = 0: FOR j = 1 TO ARMIES_PER_SIDE: IF army_city(j) > 0 THEN x = x + army_size(j)
	NEXT j
	y = 0: FOR j = ARMIES_PER_SIDE + 1 TO MAX_ARMIES: IF army_city(j) > 0 THEN y = y + army_size(j)
	NEXT j
END SUB

' 1 when the time limit's year has come and its month is still ahead.
FUNCTION victory_time_near
victory_time_near = 0
	IF victory_rule(VICTORY_YEAR) > 0 AND turn_year >= victory_rule(VICTORY_YEAR) AND turn_month < victory_rule(VICTORY_MONTH) THEN victory_time_near = 1
END FUNCTION

' The victory rule that side i has met, in j: 2 time, 3 cities, 4 income, 5 the capital,
' 6 the strength ratio, 7 the enemy wiped out, which also gives 300 victory points. j is 0
' when it has met none. x and y are the sides' men (victory_forces).
SUB victory_rule_met (i, x, y, j)
j = 0
	IF (i = 1 AND y = 0) OR (i = 2 AND x = 0) THEN j = 7: side_victory_points(i) = side_victory_points(i) + 300: GOTO finis

	IF turn_year >= victory_rule(VICTORY_YEAR) AND turn_month >= victory_rule(VICTORY_MONTH) AND victory_rule(VICTORY_YEAR) > 0 THEN j = 2: GOTO finis
	IF side_city_count(i) >= victory_rule(VICTORY_CITIES) AND victory_rule(VICTORY_CITIES) > 0 THEN j = 3: GOTO finis
	IF side_income(i) / (side_income(SIDE_UNION) + side_income(SIDE_REBEL)) >= .01 * victory_rule(VICTORY_INCOME) AND victory_rule(VICTORY_INCOME) > 0 THEN j = 4: GOTO finis
	IF victory_rule(VICTORY_CAPITAL) > 0 AND side_capital(other_side(i)) = 0 AND side_capital(i) > 0 THEN j = 5: GOTO finis

	IF victory_rule(VICTORY_FORCE_RATIO) > 0 THEN
		IF i = 1 THEN
			IF y = 0 THEN j = 7: GOTO finis
			IF x / y > victory_rule(VICTORY_FORCE_RATIO) THEN j = 6: GOTO finis
		END IF
		IF i = 2 THEN
			IF x = 0 THEN j = 7: GOTO finis
			IF y / x > victory_rule(VICTORY_FORCE_RATIO) THEN j = 6: GOTO finis
		END IF
	END IF
finis:
END SUB

' 1 when side i holds nine tenths of the cities the cities rule asks for.
FUNCTION victory_near_cities (i)
victory_near_cities = 0
IF victory_rule(VICTORY_CITIES) > 0 AND side_city_count(i) >= .9 * victory_rule(VICTORY_CITIES) THEN victory_near_cities = 1
END FUNCTION

' 1 when side i has nine tenths of the share of the income the income rule asks for.
FUNCTION victory_near_income (i)
victory_near_income = 0
IF victory_rule(VICTORY_INCOME) > 0 AND side_income(i) / (side_income(SIDE_UNION) + side_income(SIDE_REBEL)) >= .009 * victory_rule(VICTORY_INCOME) THEN victory_near_income = 1
END FUNCTION

' 1 when side i has nine tenths of the strength ratio the ratio rule asks for. x and y are the
' sides' men.
FUNCTION victory_near_force (i, x, y)
victory_near_force = 0
IF victory_rule(VICTORY_FORCE_RATIO) > 0 AND x > 0 AND y > 0 THEN
	IF (i = SIDE_UNION AND x / y > .9 * victory_rule(VICTORY_FORCE_RATIO)) OR (i = SIDE_REBEL AND y / x > .9 * victory_rule(VICTORY_FORCE_RATIO)) THEN victory_near_force = 1
END IF
END FUNCTION

' The player plays on after victory rule j was met: the rule asks for one more, and the capital
' rule (5) is turned off.
SUB victory_play_on (j)
	victory_rule(j) = victory_rule(j) + 1
	IF j = 5 THEN victory_rule(j) = 0
END SUB

' The game ends with side i's victory by rule j: 100 more victory points when the enemy was
' wiped out (7), the side marked for the battle summary, and the game over.
SUB victory_won (i, j)
IF j = 7 THEN side_victory_points(i) = side_victory_points(i) + 100
victory_reason = i
game_over = 1
END SUB

' A technical victory when the time ran out: both sides keep seven tenths of their points.
SUB victory_technical_points
DIM k AS INTEGER
FOR k = SIDE_UNION TO SIDE_REBEL: side_victory_points(k) = .7 * side_victory_points(k): NEXT k
END SUB

' The place in side s's Hall of Fame that its score earns: the first whose score it reaches, or
' 0 when it reaches none.
FUNCTION hall_of_fame_place (s, hall_score())
DIM i AS INTEGER
hall_of_fame_place = 0
FOR i = 1 TO 5
IF side_victory_points(s) >= hall_score(s, i) THEN hall_of_fame_place = i: EXIT FUNCTION
NEXT i
END FUNCTION

' Puts commander name$ in side s's Hall of Fame at place i, with the side's score. The entries
' below move down one, and the last drops out.
SUB hall_of_fame_insert (s, i, name$, hall_name$(), hall_score())
DIM j AS INTEGER
	FOR j = 5 TO i + 1 STEP -1
	hall_score(s, j) = hall_score(s, j - 1)
	hall_name$(s, j) = hall_name$(s, j - 1)
	NEXT j
	hall_name$(s, i) = name$
	hall_score(s, i) = side_victory_points(s)
END SUB
