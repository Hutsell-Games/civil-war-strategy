' The rules of the armies. They draw nothing. The screens of raising, supplying and combining
' armies are in commands/army.bm, and call these. In order: the slots and sides, the sides'
' strength, the leaders, raising and recruiting, supply, drill and detach, and combining.

' The first and last army slots of a side: 1 and 20 for the Union, 21 and 40 for the Rebels.
FUNCTION side_first_army (side)
    side_first_army = 1
    IF side = SIDE_REBEL THEN
        side_first_army = ARMIES_PER_SIDE + 1
    END IF
END FUNCTION

' Returns the last army slot reserved for the side, whether or not that slot holds an army.
FUNCTION side_last_army (side)
    side_last_army = ARMIES_PER_SIDE
    IF side = SIDE_REBEL THEN
        side_last_army = MAX_ARMIES
    END IF
END FUNCTION

' The side an army slot belongs to. Slot 0, no army, counts as the Union's, as the old tests army < 21 did.
FUNCTION army_side (army)
    army_side = SIDE_UNION
    IF army > ARMIES_PER_SIDE THEN
        army_side = SIDE_REBEL
    END IF
END FUNCTION

FUNCTION other_side (side)
    other_side = SIDE_UNION + SIDE_REBEL - side
END FUNCTION

' The computer plays the side: a one-player game, and not the side whose turn it is. Gives -1
' or 0, as a comparison does.
FUNCTION side_is_computers (side)
    side_is_computers = opt_players = PLAYERS_ONE AND side <> current_side
END FUNCTION

' The computer plays the army's side (side_is_computers).
FUNCTION army_is_computers (army)
    army_is_computers = side_is_computers(army_side(army))
END FUNCTION

' The state that army_city() and army_order() hold, by name. Each gives -1 or 0, as a comparison
' does. An army exists while it holds a city; army_city() is 0 for an empty slot.
FUNCTION army_exists (army)
    army_exists = army_city(army) > 0
END FUNCTION

' The army's order is a city to move to, not ORDER_NONE, ORDER_BUSY or ORDER_DONE.
FUNCTION army_has_move (army)
    army_has_move = army_order(army) > 0
END FUNCTION

' The army has acted this month: it is busy (ORDER_BUSY, after a fort, a drill, a combine, a
' train or being raised) or done (ORDER_DONE, after a move or a battle).
FUNCTION army_has_acted (army)
    army_has_acted = army_order(army) < 0
END FUNCTION

' Gives an army its order: a city to march to, or ORDER_NONE, ORDER_BUSY or ORDER_DONE.
SUB army_set_order (army, order)
    army_order(army) = order
END SUB

' Empties the army's slot: no city, no troops, no leader rating, experience, order or supplies.
' Its names are the caller's: each caller leaves or clears them in its own way.
SUB army_clear (army)
    army_city(army) = 0
    army_size(army) = 0
    army_leader_rating(army) = 0
    army_experience(army) = 0
    army_order(army) = ORDER_NONE
    army_supply(army) = 0
END SUB

' The army takes the supplies of army from, up to MAX_SUPPLY. from keeps its own.
SUB army_take_supplies (army, from)
    army_supply(army) = army_supply(army) + army_supply(from)
    IF army_supply(army) > MAX_SUPPLY THEN
        army_supply(army) = MAX_SUPPLY
    END IF
END SUB

' The army is gone: its slot is emptied (army_clear) and its name blanked.
SUB army_remove (army)
    CALL army_clear(army)
    army_name$(army) = ""
END SUB

' Whether an army counts in its side's strength: it holds a city, or rides its side's train.
FUNCTION army_in_field (army)
    army_in_field = army_exists(army) OR (army > 0 AND train_army(army_side(army)) = army)
END FUNCTION

' A side's troops in hundreds: the armies that hold a city, as the army report counts them. The
' report's "Enemy Forces" is this for the other side. The original printed the computer's
' strength ratio times the side's troops, which turn_update_victory_points raises by .7 when the
' computer holds few cities.
FUNCTION side_troops (side)
    DIM i AS INTEGER
    DIM troops AS INTEGER
    troops = 0
    FOR i = side_first_army(side) TO side_last_army(side)
        IF army_exists(i) THEN
            troops = troops + army_size(i)
        END IF
    NEXT i
    side_troops = troops
END FUNCTION

' A side's troops in hundreds in the field: the armies that hold a city or ride the side's train
' (army_in_field). The victory rules count these.
FUNCTION side_field_troops (side)
    DIM i AS INTEGER
    DIM troops AS INTEGER
    troops = 0
    FOR i = side_first_army(side) TO side_last_army(side)
        IF army_in_field(i) THEN
            troops = troops + army_size(i)
        END IF
    NEXT i
    side_field_troops = troops
END FUNCTION

' A side's strength in thousands of troops: a tenth of each army's size in hundreds, rounded at
' each step as the sum is an INTEGER. The computer plays by it.
FUNCTION side_strength (side)
    DIM i AS INTEGER
    DIM strength AS INTEGER
    strength = 0
    FOR i = side_first_army(side) TO side_last_army(side)
        IF army_in_field(i) THEN
            strength = strength + .1 * army_size(i)
        END IF
    NEXT i
    side_strength = strength
END FUNCTION

' The army takes the free leader of slot leader: his name and rating, and he leaves the free
' leaders. A new army takes the leader of its own slot.
SUB army_appoint (army, leader)
    army_leader_rating(army) = leader_rating(leader)
    army_name$(army) = leader_name$(leader)
    leader_name$(leader) = ""
END SUB

' The army's leader goes back among the free leaders (leader_return). Relieve calls it first;
' a combine calls it for each army that joins, except the one whose leader takes command.
SUB army_free_leader (army, slot)
    CALL leader_return(army_name$(army), army_leader_rating(army), army_side(army), army, slot)
END SUB

' A leader goes back among the side's free leaders with rating, at least 1, the lowest a leader
' has. He takes the slot preferred when it holds no free leader, or else the side's first slot
' that holds none. slot is the slot he took, or 0 when every slot of the side holds a free
' leader; he is then not kept. A leader who came to his army by Relieve keeps the point he
' lost then. The original put him in the army's slot with that slot's own rating, over any
' leader freed there before (G36).
SUB leader_return (name$, rating, side, preferred, slot)
    DIM i AS INTEGER
    slot = 0
    IF leader_name$(preferred) = "" THEN
        slot = preferred
    ELSE
        FOR i = side_first_army(side) TO side_last_army(side)
            IF leader_name$(i) = "" THEN
                slot = i
                EXIT FOR
            END IF
        NEXT i
    END IF
    IF slot = 0 THEN
        EXIT SUB
    END IF
    leader_name$(slot) = name$
    leader_rating(slot) = rating
    IF leader_rating(slot) < 1 THEN
        leader_rating(slot) = 1
    END IF
END SUB

' Relieve, second half: the army takes the free leader of a slot, with a point less than his
' rating. It loses a level of experience and is busy for the month.
SUB army_take_leader (army, leader)
    army_order(army) = ORDER_BUSY
    CALL army_appoint(army, leader)
    IF army_leader_rating(army) > 0 THEN
        army_leader_rating(army) = army_leader_rating(army) - 1
    END IF
    IF army_experience(army) > 0 THEN
        army_experience(army) = army_experience(army) - 1
    END IF
END SUB

' The next commander of a side, in army_slot: the first army without a city that has a name on the
' list, or a name made up for the first army without a city. army_slot is 0 when every army has a
' city. army_get_commander (commands/army.bm) says so. The army on the side's train has no city
' but is not free (army_in_field). The original could give its slot to a new army; the train
' then unloaded it in city -1, its order ORDER_BUSY (G48).
SUB army_pick_commander (side, army_slot)
    DIM last_army AS INTEGER
    DIM generated_name$
    DIM first_army AS INTEGER
    DIM i AS INTEGER
    army_slot = 0
    first_army = side_first_army(side)
    last_army = side_last_army(side)
    FOR i = first_army TO last_army
        IF NOT army_in_field(i) AND leader_name$(i) <> "" THEN
            army_slot = i
            EXIT SUB
        END IF
    NEXT i

    '                 generic leaders if set list is exhausted
    FOR i = first_army TO last_army
        IF NOT army_in_field(i) THEN
            ' (i): army_generate_name changes its first argument.
            CALL army_generate_name((i), generated_name$)
            army_slot = i
            leader_name$(i) = generated_name$
            leader_rating(i) = 1 + made_up_leader_spread * RND
            EXIT SUB
        END IF
    NEXT i
END SUB

' Builds a fallback name from the side and a Roman numeral, reducing the army argument as it goes.
SUB army_generate_name (army, name$)
    DIM ones AS INTEGER
    name$ = "Union "
    IF army_side(army) = SIDE_REBEL THEN
        name$ = "Rebel "
    END IF
    IF army_side(army) = SIDE_REBEL THEN
        army = army - ARMIES_PER_SIDE
    END IF
    IF army > 10 THEN
        name$ = name$ + "X"
        army = army - 10
    END IF
    SELECT CASE army
        CASE IS < 4
            ones = army
        CASE 4
            name$ = name$ + "IV"
        CASE 5 TO 8
            name$ = name$ + "V"
            ones = army - 5
        CASE 9
            name$ = name$ + "IX"
        CASE 10
            name$ = name$ + "X"
    END SELECT
    IF ones > 0 THEN
        name$ = name$ + STRING$(ones, "I")
    END IF
END SUB

' A new army in a city: its supplies, experience, leader and size with the Balance setting's
' extra troops, and the price (cost_recruit) taken from the side. army_new (commands/army.bm) shows it.
SUB army_raise (side, army_slot, city)
    DIM troops AS INTEGER
    army_supply(army_slot) = new_army_supply + new_army_supply_spread * RND
    IF side = SIDE_UNION THEN
        army_supply(army_slot) = army_supply(army_slot) + union_new_army_supply
    END IF
    army_experience(army_slot) = 1
    IF side = SIDE_REBEL THEN
        army_experience(army_slot) = rebel_new_army_experience
    END IF
    CALL army_appoint(army_slot, army_slot)

    troops = new_army_size
    IF opt_realism = REALISM_ON THEN
        troops = recruit_troops(side, city, FALSE)
    ELSE
        troops = recruits_cut_off(side, city, troops)
    END IF
    city_army(city) = army_slot
    army_size(army_slot) = troops
    CALL army_recruit_bonus(side, army_slot)
    side_cash(side) = side_cash(side) - cost_recruit
    army_city(army_slot) = city
    army_order(army_slot) = ORDER_BUSY
END SUB

' The cities where a side may recruit this month, sorted by name. They are drawn at random;
' the player's list is kept for the month. count is 0 when there is none, and Troops is then
' closed for the month. The original kept no empty list, so the player could open Troops again
' and again until the draw gave a city (G58).
SUB army_recruit_cities (side, cities(), count)
    ' A roll above this offers one city fewer.
    CONST FEWER_CITIES_ROLL = .8
    ' A city's chance to be offered: this times the cities to offer, over the side's cities.
    CONST CHANCE_SPREAD = .6
    ' The chance when the list is still short late in the loop, and for a side with no city.
    CONST CHANCE_CATCH_UP = .3
    ' The chance of a city where the side has an army.
    CONST CHANCE_WITH_ARMY = .4
    DIM i AS INTEGER
    DIM offer_count AS INTEGER
    DIM chance!
    count = 0
    IF side = current_side AND turn_recruit_count > 0 THEN
        FOR i = 1 TO turn_recruit_count
            cities(i) = turn_recruit_city(i)
        NEXT i
        count = turn_recruit_count
        CALL city_list_sort(cities(), count)
        EXIT SUB
    END IF
    offer_count = recruit_cities_offered
    IF RND > FEWER_CITIES_ROLL THEN
        offer_count = offer_count - 1
    END IF
    IF opt_difficulty < DIFFICULTY_EVEN THEN
        offer_count = offer_count + 1
    END IF

    FOR i = 1 TO MAX_CITIES
        IF side_city_count(side) > 0 THEN
            chance! = CHANCE_SPREAD * offer_count / side_city_count(side)
        ELSE
            chance! = CHANCE_CATCH_UP
        END IF
        IF count = 0 AND i > MAX_CITIES \ 2 THEN
            chance! = CHANCE_CATCH_UP
        END IF
        IF count < 2 AND i > 3 * MAX_CITIES \ 4 THEN
            chance! = CHANCE_CATCH_UP
        END IF
        IF city_army(i) > 0 AND city_owner(i) = side THEN
            chance! = CHANCE_WITH_ARMY
        END IF
        IF RND < chance! AND city_owner(i) = side THEN
            IF opt_realism = REALISM_ON AND city_first_owner(i) = other_side(side) THEN
                _CONTINUE
            END IF
            count = count + 1
            cities(count) = i
            IF count > offer_count - 1 THEN
                EXIT FOR
            END IF
        END IF
    NEXT i
    IF count = 0 THEN
        IF side = current_side AND turn_recruit_count = 0 THEN
            CALL turn_close_recruiting
        END IF
        EXIT SUB
    END IF
    IF side = current_side AND turn_recruit_count = 0 THEN
        FOR i = 1 TO count
            turn_recruit_city(i) = cities(i)
        NEXT i
        turn_recruit_count = count
    END IF
    CALL city_list_sort(cities(), count)
END SUB

' More troops for the army in a city: reinforce_size, or under the Realism setting a number from the
' city's value, less when the city is cut off (recruits_cut_off; isolated is then 1), and the Balance
' setting's extra troops. The side pays cost_recruit. The army has at most max_army_size, the
' limit of a Join; the original had none, and an army past 32,767 wrapped to a negative size
' (G46). army_recruit (commands/army.bm) recruits nothing for an army that is full.
SUB army_add_recruits (side, army, isolated)
    DIM troops AS INTEGER
    troops = reinforce_size
    isolated = FALSE
    IF opt_realism = REALISM_ON THEN
        troops = recruit_troops(side, army_city(army), TRUE)
        IF city_is_cut_off(side, army_city(army)) THEN
            isolated = TRUE
        END IF
    END IF
    army_size(army) = army_size(army) + troops
    CALL army_recruit_bonus(side, army)
    IF army_size(army) > max_army_size THEN
        army_size(army) = max_army_size
    END IF
    side_cash(side) = side_cash(side) - cost_recruit
END SUB

' Whether the army has as many troops as an army may have (army_add_recruits).
FUNCTION army_is_full (army)
    army_is_full = army_size(army) >= max_army_size
END FUNCTION

' The troops a city gives under the Realism setting, in hundreds: by the city's value, for a new
' army, or for the army already there when joins_army is TRUE. Less when the city is cut off
' (recruits_cut_off). army_raise, army_add_recruits and the computer's pick (ai_recruit_pick) use it.
FUNCTION recruit_troops (side, city, joins_army)
    DIM troops AS INTEGER
    troops = recruit_per_value * city_value(city) + recruit_base
    IF joins_army THEN
        troops = reinforce_per_value * city_value(city) + reinforce_base
    END IF
    recruit_troops = recruits_cut_off(side, city, troops)
END FUNCTION

' Gives troops divided by recruit_cut_off_divisor when the side's city is cut off: no city next to it
' is the side's.
FUNCTION recruits_cut_off (side, city, troops)
    recruits_cut_off = troops
    IF city_is_cut_off(side, city) THEN
        recruits_cut_off = troops \ recruit_cut_off_divisor
    END IF
END FUNCTION

' The Balance setting's extra troops for an army of side that recruits. As in battle_strengths,
' they go to the computer's side when the setting favors it. The original added them to army 0,
' or to a new army just before its size was set, so they were never seen.
SUB army_recruit_bonus (side, army_slot)
    army_size(army_slot) = army_size(army_slot) + balance_recruits * balance_help(side)
END SUB

' Buys supplies for an army, up to the resupply level, as far as the side's cash goes. result is
' SUPPLY_BOUGHT, SUPPLY_NO_CASH when the cash was not enough, or SUPPLY_CUT_OFF when the army is
' cut off under the Realism setting. army_resupply (commands/army.bm) shows it.
SUB army_buy_supply (army, result)
    DIM side AS INTEGER
    DIM supply_added AS INTEGER
    result = SUPPLY_CUT_OFF
    side = army_side(army)
    IF army_supply_cut_off(army) THEN
        EXIT SUB
    END IF
    result = SUPPLY_NO_CASH
    supply_added = army_supply_days(army)
    IF supply_added >= 1 THEN
        army_supply(army) = army_supply(army) + supply_added
        side_cash(side) = side_cash(side) - .1 * supply_added * army_size(army)
        result = SUPPLY_BOUGHT
    END IF
    IF side_cash(side) < 0 THEN
        side_cash(side) = 0
    END IF
END SUB

' How many days of supplies the side's cash buys for the army, up to the resupply level.
' army_buy_supply buys them when there is at least one. The days are capped before they are
' rounded, so a large treasury and a small army cannot overflow an INTEGER (rule-changes.md,
' G29). They are rounded down, so the cash pays for every day bought. The original rounded to
' the nearest, and 0.6 of a day bought a whole one (G56).
FUNCTION army_supply_days (army)
    DIM days AS SINGLE
    days = 0
    IF army_size(army) > 0 THEN
        days = side_cash(army_side(army)) * 10# / army_size(army)
    END IF
    IF days + army_supply(army) > resupply_level THEN
        days = resupply_level - army_supply(army)
    END IF
    army_supply_days = INT(days)
END FUNCTION

' Whether the Supply menu lists the army: it exists, it has a day of supplies or less, and
' under the Realism setting it is not cut off.
FUNCTION army_may_get_supply (army)
    army_may_get_supply = 0
    IF NOT army_exists(army) OR army_supply(army) > 1 THEN
        EXIT FUNCTION
    END IF
    IF army_supply_cut_off(army) THEN
        EXIT FUNCTION
    END IF
    army_may_get_supply = -1
END FUNCTION

' Whether the side has an army that the Supply menu lists.
FUNCTION side_needs_supply (side)
    DIM i AS INTEGER
    side_needs_supply = 0
    FOR i = side_first_army(side) TO side_last_army(side)
        IF army_may_get_supply(i) THEN
            side_needs_supply = -1
            EXIT FUNCTION
        END IF
    NEXT i
END FUNCTION

' Whether Supply would give supplies: the side has an army that the Supply menu lists and
' that its cash buys a day of supplies for. The Commands menu shows Supply as "-" otherwise.
FUNCTION side_can_supply (side)
    DIM i AS INTEGER
    side_can_supply = 0
    FOR i = side_first_army(side) TO side_last_army(side)
        IF army_may_get_supply(i) THEN
            IF army_supply_days(i) >= 1 THEN
                side_can_supply = -1
                EXIT FUNCTION
            END IF
        END IF
    NEXT i
END FUNCTION

' Whether drill can still improve the army: its experience is below drill_experience_below and
' below its leader's rating. -1 or 0, as a comparison gives.
FUNCTION army_can_drill (army)
    army_can_drill = army_experience(army) < drill_experience_below AND army_experience(army) < army_leader_rating(army)
END FUNCTION

' A month of drill: one more level of experience, and the army is busy for the month.
SUB army_drill (army)
    army_experience(army) = army_experience(army) + 1
    army_order(army) = ORDER_BUSY
END SUB

' Whether a side may detach part of an army: the Rebels only.
FUNCTION side_can_detach (side)
    side_can_detach = side = SIDE_REBEL
END FUNCTION

' Detaches a share (detach_share) of an army's troops and supplies into the free slot, in the city given.
' The new army takes the slot's leader and the old army's experience.
SUB army_detach (army, city, army_slot)
    army_supply(army_slot) = detach_share# * army_supply(army)
    army_supply(army) = army_supply(army) - army_supply(army_slot)
    IF army_supply(army) < 0 THEN
        army_supply(army) = 0
    END IF
    army_size(army_slot) = detach_share# * army_size(army)
    army_size(army) = army_size(army) - army_size(army_slot)
    army_city(army_slot) = city
    army_experience(army_slot) = army_experience(army)
    army_order(army_slot) = ORDER_NONE
    CALL army_appoint(army_slot, army_slot)
END SUB

' The side's cities where armies can combine, sorted by name: a city of the side with two armies
' or more that army_combine_add takes, with troops and no order. count is 0 when there is none.
' The original asked for one such army besides the army that holds the city, whatever that
' army's order. When the holder had acted, the one army joined alone and Join said "Only 1
' eligible army" (G57).
SUB army_list_combine_cities (side, cities(), count)
    DIM last_army AS INTEGER
    DIM first_army AS INTEGER
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM free_armies AS INTEGER
    first_army = side_first_army(side)
    last_army = side_last_army(side)
    count = 0
    FOR i = 1 TO MAX_CITIES
        IF city_owner(i) = side AND city_army(i) > 0 THEN
            free_armies = 0
            FOR j = first_army TO last_army
                IF army_city(j) = i AND army_order(j) = ORDER_NONE AND army_size(j) > 0 THEN
                    free_armies = free_armies + 1
                END IF
            NEXT j
            IF free_armies >= 2 THEN
                count = count + 1
                cities(count) = i
            END IF
        END IF
    NEXT i

    IF count = 0 THEN
        EXIT SUB
    END IF
    CALL city_list_sort(cities(), count)
END SUB

' Combining armies. Army 0 gathers the armies of a city, and the army of the best leader among
' them takes them over. army_combine_gather (commands/army.bm) calls army_combine_start, then
' army_combine_add for each army of the side, army_combine_absorb for each that joins, and
' army_combine_finish.
SUB army_combine_start (city)
    CALL army_clear(0)
    army_city(0) = city
    army_name$(0) = ""
END SUB

' army joins army 0 when it is in the city, has no order and has troops (COMBINE_JOINED). Army 0
' takes its leader when it is the first to join or he is better than any before (best is then
' army, and the leader of the best before goes back to the free leaders), its troops and their
' share of experience. status is COMBINE_TOO_LARGE when army 0 would have more than max_army_size,
' and COMBINE_SKIPPED when army does not join. The original took the first leader only when his
' rating was above 0, so armies whose leaders all had 0 joined army 0 and were lost (G35).
SUB army_combine_add (army, city, best, status)
    DIM share!
    DIM slot AS INTEGER
    status = COMBINE_SKIPPED
    IF army_order(army) <> ORDER_NONE OR army_city(army) <> city OR army_size(army) < 1 THEN
        EXIT SUB
    END IF
    IF army_size(0) + army_size(army) > max_army_size THEN
        status = COMBINE_TOO_LARGE
        EXIT SUB
    END IF

    IF best = 0 OR army_leader_rating(army) > army_leader_rating(0) THEN
        IF best > 0 THEN
            CALL leader_return(army_name$(0), army_leader_rating(0), army_side(army), best, slot)
        END IF
        army_name$(0) = army_name$(army)
        army_leader_rating(0) = army_leader_rating(army)
        best = army
    END IF

    army_size(0) = army_size(0) + army_size(army)
    share! = (army_size(army) / army_size(0))
    army_experience(0) = (1 - share!) * army_experience(0) + share! * army_experience(army)
    status = COMBINE_JOINED
END SUB

' The army's supplies go to army 0, and its slot is emptied. Its leader goes back to the list,
' unless it is best, the army whose leader takes command so far (army_combine_add).
SUB army_combine_absorb (army, best)
    DIM slot AS INTEGER
    CALL army_take_supplies(0, army)
    IF army <> best THEN
        CALL army_free_leader(army, slot)
    END IF
    CALL army_remove(army)
END SUB

' The combined army takes the slot of the best leader's army, in the city. When more than one
' army joined, it can take no order this turn. The best leader never went back to the free
' leaders; the original put him there and took him off again from the slot best, which could
' remove another leader freed there before.
SUB army_combine_finish (city, best, joined)
    army_size(best) = army_size(0)
    army_leader_rating(best) = army_leader_rating(0)
    army_experience(best) = army_experience(0)
    army_supply(best) = army_supply(0)
    army_city(best) = city
    army_name$(best) = army_name$(0)
    IF joined > 1 THEN
        army_order(best) = ORDER_BUSY
    END IF
    city_army(city) = best
END SUB
