' The rules of the armies. They draw nothing. The screens of raising, supplying and combining
' armies are in ui/army.bm, and call these.

' Combining armies. Army 0 gathers the armies of a city, and the army of the best leader among
' them takes them over. army_combine (ui/army.bm) calls army_combine_start, then
' army_combine_add for each army of the side, army_combine_absorb for each that joins, and
' army_combine_finish.
SUB army_combine_start (target)
		army_size(0) = 0: army_leader_rating(0) = 0: army_experience(0) = 0: army_city(0) = target
		army_name$(0) = "": army_supply(0) = 0: army_order(0) = ORDER_NONE
END SUB

' Army j joins army 0 when it is in the city, has no order and has men: status 2. Army 0 takes
' its leader when he is better than any before (best is then j), its men and their share of
' experience. status is 1 when army 0 would have more than 125,000 men, and 0 when j does not join.
SUB army_combine_add (j, target, best, status)
DIM pct!
	status = 0
		IF army_order(j) <> ORDER_NONE OR army_city(j) <> target OR army_size(j) = 0 THEN EXIT SUB
		IF army_size(0) + army_size(j) > 1250 THEN status = 1: EXIT SUB

		IF army_leader_rating(j) > army_leader_rating(0) THEN
			army_name$(0) = army_name$(j)
			army_leader_rating(0) = army_leader_rating(j)
			best = j
		END IF

		army_size(0) = army_size(0) + army_size(j)
		IF army_size(0) < 1 THEN EXIT SUB
		pct! = (army_size(j) / army_size(0))
		army_experience(0) = (1 - pct!) * army_experience(0) + pct! * army_experience(j)
		status = 2
END SUB

' Army j's supplies go to army 0, and its slot is emptied. Its leader goes back to the list.
SUB army_combine_absorb (j)
		army_supply(0) = army_supply(0) + army_supply(j)
		IF army_supply(0) > MAX_SUPPLY THEN army_supply(0) = MAX_SUPPLY
		army_size(j) = 0: army_city(j) = 0: army_experience(j) = 0: army_order(j) = ORDER_NONE
		leader_name$(j) = army_name$(j)
		army_leader_rating(j) = 0: army_supply(j) = 0: army_name$(j) = ""
END SUB

' The combined army takes the slot of the best leader's army, in the city. When more than one
' army joined, it can take no order this turn.
SUB army_combine_finish (target, best, joined)
		army_size(best) = army_size(0): army_leader_rating(best) = army_leader_rating(0)
		army_experience(best) = army_experience(0): army_supply(best) = army_supply(0)
		army_city(best) = target
		army_name$(best) = army_name$(0)
		leader_name$(best) = ""
		IF joined > 1 THEN army_order(best) = ORDER_BUSY
		city_army(target) = best
END SUB

' A new army in a city: its supplies, experience, leader and size, and the price of 100 taken
' from the side. army_new (ui/army.bm) shows it.
SUB army_raise (side, slot, city)
DIM x AS INTEGER: DIM a AS INTEGER
	army_supply(slot) = 3 + 5 * RND: IF side = SIDE_UNION THEN army_supply(slot) = army_supply(slot) + 2
	army_experience(slot) = 1: IF side = SIDE_REBEL THEN army_experience(slot) = 2
	army_leader_rating(slot) = leader_rating(slot)
	army_name$(slot) = leader_name$(slot): leader_name$(slot) = ""

	x = 70: IF opt_realism >= REALISM_ON THEN x = 3 * city_value(city) + 33
	a = city_is_connected(side, city): IF a < 1 THEN x = x \ 3
	city_army(city) = slot: army_size(slot) = x
	side_cash(side) = side_cash(side) - COST_RECRUIT
	army_city(slot) = city
	army_order(slot) = ORDER_BUSY
END SUB

SUB sort_move_order (limit)
DIM FALSE AS INTEGER: DIM i AS INTEGER: DIM swaps%
DO
	swaps% = FALSE
	FOR i = 1 TO limit - 1
	IF move_order_key(i) > move_order_key(i + 1) THEN
		SWAP move_order_key(i), move_order_key(i + 1)
		swaps% = i
	END IF
	NEXT i
LOOP WHILE swaps%
END SUB

' The next commander of a side, in slot: the first army without a city that has a name on the
' list, or a name made up for the first army without a city. slot is 0 when every army has a
' city. army_get_commander (ui/army.bm) says so.
SUB army_pick_commander (side, slot)
DIM fin AS INTEGER: DIM a$
DIM star AS INTEGER: DIM i AS INTEGER: DIM x AS INTEGER
	slot = 0
	star = side_first_army(side): fin = side_last_army(side)
	FOR i = star TO fin
	IF army_city(i) = 0 AND leader_name$(i) <> "" THEN slot = i: EXIT SUB
	NEXT i

'                 generic leaders if set list is exhausted
	FOR i = star TO fin
	IF army_city(i) = 0 THEN
		x = i
		CALL army_generate_name(x, a$)
		slot = i
		leader_name$(i) = a$
		leader_rating(i) = 1 + 8 * RND
		EXIT SUB
	END IF
	NEXT i
END SUB

' Buys supplies for an army, up to the resupply level, as far as the side's cash goes. result is
' 1 when it bought some, 0 when the cash was not enough, and -1 when the army is cut off under
' the Realism setting. army_resupply (ui/army.bm) shows it.
SUB army_buy_supply (army, result)
DIM who AS INTEGER: DIM a AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER
		result = -1
		who = army_side(army)
		IF opt_realism >= REALISM_ON THEN
			a = city_is_connected(who, army_city(army))
			IF a < 1 THEN EXIT SUB
		END IF
		result = 0
		IF army_size(army) > 0 THEN x = side_cash(who) / army_size(army) * 10
		y = x + army_supply(army): IF y > RESUPPLY_LEVEL THEN x = RESUPPLY_LEVEL - army_supply(army)
		IF x >= 1 THEN
			army_supply(army) = army_supply(army) + x: side_cash(who) = side_cash(who) - .1 * x * army_size(army)
			result = 1
		END IF
		IF side_cash(who) < 0 THEN side_cash(who) = 0
END SUB

SUB army_generate_name (army, name$)
DIM x AS INTEGER: DIM k AS INTEGER
name$ = "Union ": IF army_side(army) = SIDE_REBEL THEN name$ = "Rebel "
IF army_side(army) = SIDE_REBEL THEN army = army - ARMIES_PER_SIDE
IF army > 10 THEN name$ = name$ + "X": army = army - 10
SELECT CASE army
	CASE IS < 4
	x = army: GOSUB add1s
	CASE 4
	name$ = name$ + "IV"
	CASE 5 TO 8
	name$ = name$ + "V"
	x = army - 5
	GOSUB add1s
	CASE 9
	name$ = name$ + "IX"
	CASE 10
	name$ = name$ + "X"
END SELECT
EXIT SUB

add1s:
IF x > 0 THEN FOR k = 1 TO x: name$ = name$ + "I": NEXT k
RETURN

END SUB

' The first and last army slots of a side: 1 and 20 for the Union, 21 and 40 for the Rebels.
FUNCTION side_first_army (side)
side_first_army = 1: IF side = SIDE_REBEL THEN side_first_army = ARMIES_PER_SIDE + 1
END FUNCTION

FUNCTION side_last_army (side)
side_last_army = ARMIES_PER_SIDE: IF side = SIDE_REBEL THEN side_last_army = MAX_ARMIES
END FUNCTION

' The side an army slot belongs to. Slot 0, no army, counts as the Union's, as the old tests army < 21 did.
FUNCTION army_side (army)
army_side = SIDE_UNION: IF army > ARMIES_PER_SIDE THEN army_side = SIDE_REBEL
END FUNCTION

FUNCTION other_side (side)
other_side = SIDE_UNION + SIDE_REBEL - side
END FUNCTION

' Detaches three tenths of an army's men and supplies into the free slot, in the city given.
' The new army takes the slot's leader and the old army's experience.
SUB army_detach (army, city, slot)
	army_supply(slot) = .3 * army_supply(army): army_supply(army) = army_supply(army) - army_supply(slot): IF army_supply(army) < 0 THEN army_supply(army) = 0
	army_size(slot) = .3 * army_size(army): army_size(army) = army_size(army) - army_size(slot)
	army_city(slot) = city: army_experience(slot) = army_experience(army): army_order(slot) = ORDER_NONE
	army_leader_rating(slot) = leader_rating(slot)
	army_name$(slot) = leader_name$(slot): leader_name$(slot) = ""
	army_experience(slot) = army_experience(army)
END SUB

' A month of drill: one more level of experience, and the army is busy for the month.
SUB army_drill (army)
	army_experience(army) = army_experience(army) + 1
	army_order(army) = ORDER_BUSY
END SUB

' The first step of a new army raised by recruiting: it is placed in the city, with the Balance
' setting's extra men, which army_new then overwrites (TODO.md).
SUB army_place_new (slot, city)
	army_city(slot) = city
	CALL army_recruit_bonus(slot)
END SUB

' More men for the army in a city: 4,500, or under the Realism setting a number from the
' city's value, a third of it when the city is cut off (isolated is then 1). The side pays
' 100. The Balance setting's extra men go to army 0, as before (TODO.md).
SUB army_add_recruits (side, army, isolated)
DIM x AS INTEGER: DIM a AS INTEGER
	x = 45: isolated = 0
	IF opt_realism >= REALISM_ON THEN
		x = 2 * city_value(army_city(army)) + 20
		a = city_is_connected(side, army_city(army))
		IF a < 1 THEN x = x \ 3: isolated = 1
	END IF
	army_size(army) = army_size(army) + x
	CALL army_recruit_bonus(0)
	side_cash(side) = side_cash(side) - COST_RECRUIT
END SUB

' The Balance setting's extra men for a recruited army. The caller passes slot 0 when men
' join an army, and army_new sets a new army's size after it, as in the original.
SUB army_recruit_bonus (slot)
	IF current_side = SIDE_UNION AND opt_difficulty < 3 THEN army_size(slot) = army_size(slot) + 15 - 5 * opt_difficulty
	IF current_side = SIDE_REBEL AND opt_difficulty > 3 THEN army_size(slot) = army_size(slot) + 5 * opt_difficulty - 15
END SUB
