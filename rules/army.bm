SUB army_combine (side)
DIM fin AS INTEGER
DIM target AS INTEGER: DIM star AS INTEGER: DIM i AS INTEGER: DIM j AS INTEGER: DIM best AS INTEGER: DIM x AS INTEGER: DIM spin AS INTEGER: DIM pct!
	menu_color = COLOR_CYAN: target = 0: menu_highlight = COLOR_CYAN
	menu_col = 67: menu_row = 2
	CALL side_army_range(star, fin, side)
	menu_item_count = 0
	FOR i = 1 TO MAX_CITIES
		IF city_owner(i) = side AND city_army(i) > 0 THEN
			FOR j = star TO fin
			IF army_city(j) = i AND city_army(i) <> j AND army_order(j) = ORDER_NONE THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(i): menu_value(menu_item_count) = i: EXIT FOR
			NEXT j
		END IF
	NEXT i
	
	IF menu_item_count = 0 THEN side = -1: EXIT SUB
	CALL menu_bubble_sort(menu_item_count)

	IF side <> current_side THEN menu_choice = 1 + INT(menu_item_count * RND): GOTO join
	menu_text$(0) = "Join"
		menu_choice = MENU_START + 10: menu_highlight = COLOR_LIGHT_CYAN
		CALL menu_select(MENU_CITY_POINTER): CALL clear_right_panel
join:
		IF menu_choice < 1 GOTO nocity2
		target = menu_value(menu_choice)
		CALL clear_bottom_line: PRINT "Combining "; side_name$(side); " armies in "; city_name$(target); :  CALL wait_seconds(opt_pause!)

		army_size(0) = 0: army_leader_rating(0) = 0: army_experience(0) = 0: army_city(0) = target
		army_name$(0) = "": army_supply(0) = 0: army_order(0) = ORDER_NONE
'...........................................................................
		best = 0: x = 0: spin = 0
		FOR j = star TO fin
		IF army_order(j) <> ORDER_NONE OR army_city(j) <> target OR army_size(j) = 0 GOTO dork1
		IF army_size(0) + army_size(j) > 1250 THEN CALL clear_bottom_line: PRINT "Cannot combine "; army_name$(j); "... TOO LARGE"; : CALL wait_seconds(opt_pause!): GOTO dork1

		IF army_leader_rating(j) > x THEN
			x = army_leader_rating(j)
			army_name$(0) = army_name$(j)
			army_leader_rating(0) = army_leader_rating(j)
			best = j
		END IF

		army_size(0) = army_size(0) + army_size(j)
		IF army_size(0) < 1 GOTO dork1
		pct! = (army_size(j) / army_size(0))
		spin = spin + 1
		army_experience(0) = (1 - pct!) * army_experience(0) + pct! * army_experience(j)
		CALL clear_bottom_line: PRINT army_name$(j); " is combining his "; : CALL print_army_size(j): PRINT " forces"; : CALL wait_seconds(opt_pause!)
		army_supply(0) = army_supply(0) + army_supply(j)
		IF army_supply(0) > MAX_SUPPLY THEN army_supply(0) = MAX_SUPPLY
		army_size(j) = 0: army_city(j) = 0: army_experience(j) = 0: army_order(j) = ORDER_NONE
		leader_name$(j) = army_name$(j)
		army_leader_rating(j) = 0: army_supply(j) = 0: army_name$(j) = ""
dork1:
		NEXT j

		CALL clear_bottom_line
		IF side <> current_side AND spin = 0 THEN EXIT SUB
		IF spin = 0 THEN
				PRINT "No valid armies to combine at this time in "; city_name$(target);
				wait_seconds opt_pause!
				EXIT SUB
		END IF
		army_size(best) = army_size(0): army_leader_rating(best) = army_leader_rating(0)
		army_experience(best) = army_experience(0): army_supply(best) = army_supply(0)
		army_city(best) = target
		army_name$(best) = army_name$(0)
		leader_name$(best) = ""
		IF spin > 1 THEN
		PRINT "New army "; best; " of "; : CALL print_army_size(best): PRINT " is commanded by "; army_name$(best);
		army_order(best) = ORDER_BUSY
		ELSE
		PRINT "Only 1 eligible army -- cannot combine at this time";
		END IF
		IF side = current_side THEN CALL wait_seconds(opt_pause!)
		IF opt_sound >= SOUND_EFFECTS THEN SOUND 4000, .7
	       
		CALL draw_cities
		CALL draw_army_flag(best)
		CALL draw_map_marker(target, 0, MARK_FLASH_FRAME)
		city_army(target) = best
		CALL draw_stack_markers(side)
nocity2:
END SUB

SUB army_new (side, slot, city)
DIM x AS INTEGER: DIM a AS INTEGER
	army_supply(slot) = 3 + 5 * RND: IF side = SIDE_UNION THEN army_supply(slot) = army_supply(slot) + 2
	army_experience(slot) = 1: IF side = SIDE_REBEL THEN army_experience(slot) = 2
	army_leader_rating(slot) = leader_rating(slot)
	army_name$(slot) = leader_name$(slot): leader_name$(slot) = ""
	COLOR COLOR_LIGHT_RED: CALL clear_bottom_line: PRINT "Placing NEW army "; slot; army_name$(slot); " in "; city_name$(city);

	x = 70: IF opt_realism >= REALISM_ON THEN x = 3 * city_value(city) + 33
	CALL city_is_connected(side, city, a): IF a < 1 THEN x = x \ 3
	city_army(city) = slot: army_size(slot) = x
	PRINT " Size = "; : CALL print_army_size(slot)
	side_cash(side) = side_cash(side) - COST_RECRUIT: IF opt_sound >= SOUND_EFFECTS THEN SOUND 2222, .5
	army_city(slot) = city: CALL draw_army_flag(slot)
	CALL wait_seconds(opt_pause! - .5)
	army_order(slot) = ORDER_BUSY
END SUB

SUB sort_move_order (limit)
DIM FALSE AS INTEGER: DIM i AS INTEGER: DIM swaps%
DO
	swaps% = FALSE
	FOR i = 1 TO limit - 1
	IF move_order_key(i) > move_order_key(i + 1) THEN
		SWAP move_order_key(i), move_order_key(i + 1)
		swaps% = i
	END IF
	NEXT i
LOOP WHILE swaps%
END SUB

SUB army_get_commander (side, slot)
DIM fin AS INTEGER: DIM a$
DIM star AS INTEGER: DIM i AS INTEGER: DIM x AS INTEGER
	slot = 0
	CALL side_army_range(star, fin, side)
	FOR i = star TO fin
	IF army_city(i) = 0 AND leader_name$(i) <> "" THEN slot = i: EXIT SUB
	NEXT i

'                 generic leaders if set list is exhausted
	FOR i = star TO fin
	IF army_city(i) = 0 THEN
		x = i
		CALL army_generate_name(x, a$)
		slot = i
		leader_name$(i) = a$
		leader_rating(i) = 1 + 8 * RND
		EXIT SUB
	END IF
	NEXT i
	CALL clear_bottom_line: PRINT "No more "; side_name$(side); " commanders available"; : CALL wait_seconds(opt_pause!)
END SUB

SUB army_resupply (army)
DIM who AS INTEGER: DIM a AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER
		who = army_side(army)
		IF opt_realism >= REALISM_ON THEN
			CALL city_is_connected(who, army_city(army), a)
			IF a < 1 THEN EXIT SUB
		END IF
		IF army_size(army) > 0 THEN x = side_cash(who) / army_size(army) * 10
		y = x + army_supply(army): IF y > RESUPPLY_LEVEL THEN x = RESUPPLY_LEVEL - army_supply(army)
		IF x < 1 THEN CALL clear_bottom_line: PRINT "Not enough funds in the Treasury to supply "; army_name$(army); : GOTO nocash
		army_supply(army) = army_supply(army) + x: side_cash(who) = side_cash(who) - .1 * x * army_size(army)
		CALL clear_bottom_line: PRINT army_name$(army); " has received supplies "; : IF opt_sound >= SOUND_EFFECTS THEN SOUND 4500, .5
nocash:
		CALL wait_seconds(opt_pause!): IF side_cash(who) < 0 THEN side_cash(who) = 0
END SUB

SUB army_generate_name (army, name$)
DIM x AS INTEGER: DIM k AS INTEGER
name$ = "Union ": IF army_side(army) = SIDE_REBEL THEN name$ = "Rebel "
IF army_side(army) = SIDE_REBEL THEN army = army - ARMIES_PER_SIDE
IF army > 10 THEN name$ = name$ + "X": army = army - 10
SELECT CASE army
	CASE IS < 4
	x = army: GOSUB add1s
	CASE 4
	name$ = name$ + "IV"
	CASE 5 TO 8
	name$ = name$ + "V"
	x = army - 5
	GOSUB add1s
	CASE 9
	name$ = name$ + "IX"
	CASE 10
	name$ = name$ + "X"
END SELECT
EXIT SUB

add1s:
IF x > 0 THEN FOR k = 1 TO x: name$ = name$ + "I": NEXT k
RETURN

END SUB

SUB side_army_range (star, fin, side)
star = 1: fin = ARMIES_PER_SIDE: IF side = SIDE_REBEL THEN star = ARMIES_PER_SIDE + 1: fin = MAX_ARMIES
END SUB

' The side an army slot belongs to. Slot 0, no army, counts as the Union's, as the old tests army < 21 did.
FUNCTION army_side (army)
army_side = SIDE_UNION: IF army > ARMIES_PER_SIDE THEN army_side = SIDE_REBEL
END FUNCTION

FUNCTION other_side (side)
other_side = SIDE_UNION + SIDE_REBEL - side
END FUNCTION
