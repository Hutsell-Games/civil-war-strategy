' The settings and the start of a game. They draw nothing. The Utility menu that changes the
' settings is in ui/options.bm. game_new reads a new game's files (io/files.bm and
' io/events_file.bm).

' The Union's extra income each month, from the Balance setting.
SUB set_union_advantage
    union_income_bonus = union_bonus_per_balance * opt_difficulty
    IF opt_players = PLAYERS_TWO THEN
        union_income_bonus = union_bonus_two_players * opt_difficulty
    END IF
    IF opt_realism >= REALISM_ON THEN
        union_income_bonus = union_income_bonus * union_bonus_realism_share#
    END IF
END SUB

' How many steps the Balance setting helps side: opt_difficulty's distance from DIFFICULTY_EVEN
' when side is the computer's and the setting favors it, and 0 otherwise. Above DIFFICULTY_EVEN
' it favors the Union, below it the Rebels. The extra recruits, the battle strengths and the
' starting cash are multiples of it.
FUNCTION balance_help (side)
    balance_help = 0
    IF side = SIDE_UNION AND current_side = SIDE_REBEL AND opt_difficulty > DIFFICULTY_EVEN THEN
        balance_help = opt_difficulty - DIFFICULTY_EVEN
    END IF
    IF side = SIDE_REBEL AND current_side = SIDE_UNION AND opt_difficulty < DIFFICULTY_EVEN THEN
        balance_help = DIFFICULTY_EVEN - opt_difficulty
    END IF
END FUNCTION

' Vary Start: the game starts again from its scenario, with cash, armies, fleets, the Rebel
' capital and the leaders' ratings changed at random. Each side may lose some of its first six
' armies. The Utility menu offers it while vary_start_open is 1, until the first End Turn of a
' new game. The settings and the victory rules stay as the player set them; the Balance
' setting's cash and the Realism setting's wooden ships of 1861 are given as in a new game
' (game_apply_settings). The original was offered at any time and only read the scenario again:
' the date, the victory rules, the settings and every leader went back to the files', while
' the cities and the armies raised since stayed (G40, G43).
SUB vary_start_conditions
    DIM k AS INTEGER
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM ship$
    DIM rules(6) AS INTEGER
    DIM event_balance AS INTEGER
    FOR k = 1 TO 6
        rules(k) = victory_rule(k)
    NEXT k
    event_balance = opt_event_balance
    CALL game_reset
    CALL load_scenario
    side_cash(SIDE_UNION) = side_cash(SIDE_UNION) - vary_cash_shift + vary_cash_spread * RND
    side_cash(SIDE_REBEL) = side_cash(SIDE_REBEL) + vary_cash_shift + vary_cash_spread * RND
    opt_ai_aggression = 5 * RND
    FOR i = SIDE_UNION TO SIDE_REBEL
        FOR k = side_first_army(i) TO side_first_army(i) + 5
            IF RND > .6 THEN
                CALL army_clear(k)
            END IF
        NEXT k
    NEXT i
    ' A fleet of no ships is no fleet. The original left the Rebels' in its port (G41).
    fleet_size(SIDE_UNION) = 10 * RND
    IF fleet_size(SIDE_UNION) = 0 THEN
        fleet_city(SIDE_UNION) = 0
    END IF
    fleet_size(SIDE_REBEL) = 10 * RND
    IF fleet_size(SIDE_REBEL) > 0 THEN
        fleet_city(SIDE_REBEL) = VARY_REBEL_FLEET_CITY
    ELSE
        fleet_city(SIDE_REBEL) = 0
    END IF
    ' A ship is an ironclad with a chance of .55 for the Union and .1 for the Rebels. The
    ' original multiplied .45 by the player's side, so both fleets had the same chance (G42).
    FOR i = SIDE_UNION TO SIDE_REBEL
        fleet_ships$(i) = ""
        FOR j = 1 TO fleet_size(i)
            ship$ = SHIP_WOODEN$
            IF RND > .45 * i THEN
                ship$ = SHIP_IRONCLAD$
            END IF
            fleet_ships$(i) = fleet_ships$(i) + ship$
        NEXT j
    NEXT i
    IF RND > .7 THEN
        side_capital(SIDE_REBEL) = VARY_REBEL_CAPITAL
    END IF

    FOR k = 1 TO MAX_LEADERS
        IF RND > .8 THEN
            leader_rating(k) = leader_rating(k) - 3 + 6 * RND
            IF leader_rating(k) > MAX_LEADER_RATING THEN
                leader_rating(k) = MAX_LEADER_RATING
            END IF
        END IF
        IF leader_rating(k) < 1 THEN
            leader_rating(k) = 1
        END IF
    NEXT k
    CALL game_apply_settings
    opt_event_balance = event_balance
    CALL set_union_advantage
    ' The cities as at the start, and the army that holds each.
    CALL load_cities
    FOR k = 1 TO 6
        victory_rule(k) = rules(k)
    NEXT k
END SUB

' The settings of the Utility menu. Its menus are in ui/options.bm.

' Side: the player takes the other side, and the special events favor the side left to
' the computer.
SUB option_swap_side
    current_side = other_side(current_side)
    CALL option_events_favor_computer
END SUB

' The special events favor the side left to the computer: 7 for the Rebels, 3 for the Union.
SUB option_events_favor_computer
    SELECT CASE current_side
        CASE SIDE_UNION
            opt_event_balance = 7
        CASE SIDE_REBEL
            opt_event_balance = 3
    END SELECT
END SUB

' One player or two. The Union's extra income is worked out again, as it differs for two
' players. The original kept the old one until Balance or Realism changed (G54).
SUB option_toggle_players
    opt_players = PLAYERS_ONE + PLAYERS_TWO - opt_players
    CALL set_union_advantage
END SUB

' Graphics: the next level of the map's detail, and after the last the first again.
SUB option_next_graphics
    opt_graphics = opt_graphics + 1
    IF opt_graphics > GRAPHICS_FULL THEN
        opt_graphics = GRAPHICS_OFF
    END IF
END SUB

SUB option_set_sound (level)
    opt_sound = level
END SUB

' Display: choice is the menu's row, 1 (Fast) to 4 (Very Slow). Very Slow is 8 seconds.
SUB option_set_display_speed (choice)
    opt_pause! = choice
    IF opt_pause! = 4 THEN
        opt_pause! = 8
    END IF
END SUB

SUB option_toggle_alt_colors
    opt_alt_colors = 1 - opt_alt_colors
END SUB

' Balance: level is 1 (Rebel ++) to 5 (Union ++).
SUB option_set_balance (level)
    opt_difficulty = level
    CALL set_union_advantage
END SUB

' Rndom Evt: choice is the menu's row: off, favor the Union, neutral, favor the Rebels.
' Any other choice changes nothing.
SUB option_set_event_balance (choice)
    SELECT CASE choice
        CASE 1
            opt_event_balance = 0
        CASE 2
            opt_event_balance = 3
        CASE 3
            opt_event_balance = 5
        CASE 4
            opt_event_balance = 7
        CASE ELSE
    END SELECT
END SUB

SUB option_toggle_winter_campaigns
    opt_winter_campaigns = 1 - opt_winter_campaigns
END SUB

' Realism: off or on. Either way the Union's extra income is worked out again. The original
' worked it out only when Realism went on, so turning it off kept the 70% of Realism.
SUB option_toggle_realism
    opt_realism = 1 - opt_realism
    CALL set_union_advantage
END SUB

' The event balance that the month's roll uses. With Realism on, a Rebel player's balance of
' 1 counts as 3. The original added the 2 to the setting itself when Realism went on, and
' never took it off (G55). No menu sets 1; only a CWS.CFG written by hand does.
FUNCTION event_balance_in_play
    event_balance_in_play = opt_event_balance
    IF opt_realism <> REALISM_OFF AND current_side = SIDE_REBEL AND opt_event_balance = 1 THEN
        event_balance_in_play = 3
    END IF
END FUNCTION

SUB option_toggle_history
    opt_history = 1 - opt_history
END SUB

' Aggress: the next level of the computer's boldness, 0 to 5, and after 5 again 0.
SUB option_next_aggression
    opt_ai_aggression = opt_ai_aggression + 1
    IF opt_ai_aggression > 5 THEN
        opt_ai_aggression = 0
    END IF
END SUB

' A new game: the scenario, the settings of cws.cfg, the special events and the tuning knobs are
' read, and the map's cities. The first game reads the list of scenarios and starts on its first.
SUB game_new
    IF scenario_now = 0 THEN
        CALL load_scenario_list
        scenario_now = 1
    END IF
    CALL game_reset
    CALL load_scenario
    CALL config_read(current_side)
    CALL load_events(SCNDIR + "EVENTS.DAT")
    CALL load_tuning
    CALL game_apply_settings
    CALL set_union_advantage
    CALL load_cities
END SUB

' Clears the armies, the fleets, the trains, the city counts, the victory points and the game's
' battle totals for a new game. Also the month's command flags, the commerce raid and the
' computer's strength ratio, which the game before may have left set. Vary Start may be used again.
SUB game_reset
    DIM k AS INTEGER
    game_over = 0
    vary_start_open = 1
    CALL turn_reset_commands
    raiding_side = SIDE_NONE
    raid_loss = 0
    fleet_pursuit = 0
    ai_strength_ratio! = 0
    FOR k = 1 TO MAX_ARMIES
        army_size(k) = 0
        army_city(k) = 0
        army_order(k) = ORDER_NONE
        army_leader_rating(k) = 0
        army_name$(k) = ""
    NEXT k
    union_income_bonus = 0
    FOR k = 1 TO MAX_EVENTS
        event_done(k) = 0
    NEXT k
    FOR k = SIDE_UNION TO SIDE_REBEL
        fleet_size(k) = 0
        fleet_city(k) = 0
        train_army(k) = 0
        side_victory_points(k) = 0
        side_city_count(k) = 0
        train_city(k) = 0
        side_battles_won(k) = 0
        side_casualties&(k) = 0
    NEXT k
    saves_exist = 1
    victory_rule(VICTORY_MONTH) = 1
END SUB

' After the scenario and the settings are read. Under the Realism setting a game that starts
' before 1862 has no ironclads. The number of players and the display speed get a valid
' value, and the special events favor the side left to the computer. The Balance setting
' gives the computer's side cash. Each side's cash becomes its income, and it gets up to 50
' more.
SUB game_apply_settings
    DIM i AS INTEGER
    DIM ships$
    IF opt_realism >= REALISM_ON AND turn_year < IRONCLAD_YEAR THEN
        FOR i = SIDE_UNION TO SIDE_REBEL
            ships$ = STRING$(LEN(fleet_ships$(i)), SHIP_WOODEN$)
            fleet_ships$(i) = ships$
        NEXT i
    END IF
    IF opt_players < PLAYERS_ONE OR opt_players > PLAYERS_TWO THEN
        opt_players = PLAYERS_ONE
    END IF
    IF opt_players = PLAYERS_TWO OR current_side = SIDE_NONE THEN
        current_side = SIDE_UNION
    END IF
    CALL option_events_favor_computer
    IF opt_pause! < 1 THEN
        opt_pause! = 2
    END IF
    FOR i = SIDE_UNION TO SIDE_REBEL
        IF balance_help(i) > 0 THEN
            side_cash(i) = side_cash(i) + start_cash_per_balance * (DIFFICULTY_EVEN + balance_help(i))
        END IF
    NEXT i
    FOR i = SIDE_UNION TO SIDE_REBEL
        side_income(i) = side_cash(i)
        side_cash(i) = side_cash(i) + start_cash_spread * RND
    NEXT i
END SUB
