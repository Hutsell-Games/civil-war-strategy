SUB turn_date_and_supply
DIM i AS INTEGER: DIM s AS INTEGER: DIM a AS INTEGER: DIM k AS INTEGER: DIM y AS INTEGER: DIM x AS INTEGER
'---------------------------------------------------------------------------
FOR i = 1 TO MAX_ARMIES: IF army_city(i) > 0 THEN CALL draw_army_flag(i)
NEXT i
'---------------------------------------------------------------------------
turn_month = turn_month + 2
IF turn_month > 12 THEN turn_month = 1: turn_year = turn_year + 1
'---------------------------------------------------------------------------
s = SIDE_UNION
FOR i = 1 TO MAX_ARMIES: IF army_city(i) < 1 GOTO rip
IF army_side(i) = SIDE_REBEL THEN s = SIDE_REBEL
IF side_cash(s) >= .2 * army_size(i) THEN
	a = 1: IF opt_realism >= REALISM_ON THEN a = city_is_connected(s, army_city(i))
	IF a > 0 THEN
		army_supply(i) = army_supply(i) + 1
		side_cash(s) = side_cash(s) - .2 * army_size(i)
	END IF
END IF
IF (turn_month < 7 OR turn_month > 10) AND city_port_type(army_city(i)) < PORT_SEA THEN army_supply(i) = army_supply(i) - 1
IF city_port_type(army_city(i)) = PORT_SEA AND fleet_city(other_side(s)) = army_city(i) THEN army_supply(i) = army_supply(i) - 1: CALL clear_bottom_line: PRINT army_name$(i); " is blockaded"; : CALL wait_seconds(opt_pause!)
COLOR COLOR_LIGHT_MAGENTA
IF army_supply(i) < 1 THEN
	army_supply(i) = 0
	CALL clear_bottom_line
	PRINT army_name$(i); " is out of supplies";
	CALL draw_army_flag(i)
	CALL wait_seconds(opt_pause!)
	IF RND > .8 AND army_size(i) > 50 THEN army_size(i) = .9 * army_size(i)
END IF
rip:
NEXT i
FOR k = SIDE_UNION TO SIDE_REBEL: CALL draw_stack_markers(k): NEXT k
y = 0: FOR i = 1 TO ARMIES_PER_SIDE: y = y + .1 * army_size(i): NEXT i
x = 0: FOR i = ARMIES_PER_SIDE + 1 TO MAX_ARMIES: x = x + .1 * army_size(i): NEXT i
IF current_side = SIDE_REBEL AND x > 0 THEN ai_strength_ratio! = y / x ELSE ai_strength_ratio! = 1
IF current_side = SIDE_UNION AND y > 0 THEN ai_strength_ratio! = x / y ELSE IF current_side = SIDE_UNION THEN ai_strength_ratio! = 1
END SUB

SUB turn_resolve
DIM index AS INTEGER: DIM flee AS INTEGER: DIM best AS INTEGER: DIM move2 AS INTEGER: DIM c AS INTEGER: DIM y AS INTEGER
DIM flag AS INTEGER: DIM i AS INTEGER: DIM x AS INTEGER: DIM j AS INTEGER: DIM s AS INTEGER: DIM active AS INTEGER: DIM target AS INTEGER: DIM defend AS INTEGER: DIM win AS INTEGER: DIM lose AS INTEGER: DIM a$
flag = 0
IF opt_players = PLAYERS_ONE THEN
	CALL ai_turn
ELSE
	FOR i = 1 TO MAX_ARMIES
	IF army_city(i) > 0 AND army_order(i) > 0 THEN CALL draw_map_marker(army_city(i), army_order(i), MARK_MOVE_LINE)
	NEXT i
END IF
COLOR COLOR_YELLOW: LOCATE 1, 1: PRINT SPACE$(80);
LOCATE 1, 20: PRINT "Update for "; month_name$(turn_month); ","; turn_year
CALL clear_bottom_line: PRINT "press any key for "; month_name$(turn_month); ","; turn_year; " events";
CALL wait_key("U")
CALL draw_update_box
'==========================================================================
'                       Assign Time of Action
'==========================================================================
FOR i = SIDE_UNION TO SIDE_REBEL: IF train_army(i) > 0 THEN CALL railroad_move(i): LINE (5, 17)-(100, 63), 3, BF: LINE (5, 17)-(100, 63), 0, B: CALL draw_train_box
NEXT i

CALL turn_set_move_order
'==========================================================================
'                       Begin Main Loop
'==========================================================================
FOR j = 1 TO MAX_ARMIES
flag = 0
IF move_order_key(j) = MOVE_KEY_NONE GOTO allthru
active = INT(move_order_key(j) / 100): active = move_order_key(j) - 100 * active: s = army_side(active)
IF army_order(active) < 1 GOTO digin
COLOR COLOR_LIGHT_CYAN: CALL clear_bottom_line: PRINT army_name$(active); " is moving to "; city_name$(army_order(active));

army_supply(active) = army_supply(active) - 1: IF army_supply(active) < 0 THEN army_supply(active) = 0: CALL wait_seconds(opt_pause!): CALL clear_bottom_line: PRINT army_name$(active); " is out of supplies !";

CALL draw_army_flag(active)
CALL draw_map_marker(army_city(active), army_order(active), MARK_ERASE_LINE)

CALL animate_army(active, ANIMATE_TAKE_PICTURE)
'==========================================================================
target = army_order(active)
IF city_army(target) = 0 GOTO easy
IF army_side(city_army(target)) = s GOTO friend ELSE GOTO enemy
'==========================================================================
'                         Join Forces
'==========================================================================
friend:
COLOR COLOR_LIGHT_CYAN: CALL clear_bottom_line: PRINT army_name$(active); " and "; army_name$(city_army(target)); " meet in "; city_name$(target); : CALL wait_seconds(opt_pause!)
CALL draw_map_marker(army_order(active), 0, MARK_FLASH_FRAME)
CALL clear_bottom_line
GOTO easy
'==========================================================================
'                       Attack
'==========================================================================
enemy:
CALL draw_map_marker(target, 0, MARK_EXPLOSION)
defend = city_army(target)

COLOR COLOR_LIGHT_CYAN: CALL clear_bottom_line: PRINT army_name$(active); " attacks "; army_name$(defend); " in "; city_name$(army_city(defend)); : CALL wait_seconds(opt_pause! - 1)
IF army_size(defend) > 0 THEN CALL calculate_battle(active, defend, win, lose): flag = 1: IF opt_graphics >= GRAPHICS_BASIC THEN CALL draw_update_box
IF army_experience(win) < MAX_EXPERIENCE THEN army_experience(win) = army_experience(win) + 1

IF army_size(lose) < 2 THEN
	CALL clear_bottom_line
	a$ = army_name$(lose) + "'s army is crushed in " + city_name$(army_city(defend))
	CALL scribe_message(a$, SHOW_BOX)
	index = lose: GOTO crushed
END IF

CALL clear_right_panel
'==========================================================================
'                       Attacker Loses
'==========================================================================
IF win = active GOTO kickbutt
army_order(active) = army_city(active)
army_city(active) = target
COLOR COLOR_LIGHT_CYAN: CALL clear_bottom_line: PRINT army_name$(active); " withdrew to "; city_name$(army_order(active));

CALL draw_army_flag(army_city(active))
CALL animate_army(active, ANIMATE_PICTURE_TAKEN)

army_city(active) = army_order(active)
CALL draw_army_flag(army_city(active))
CALL draw_army_flag(active)
city_army(army_city(active)) = active
army_order(active) = ORDER_DONE
	      
IF 11 * RND > army_leader_rating(defend) THEN CALL draw_map_marker(army_city(defend), army_order(defend), MARK_ERASE_ARMY): IF army_order(defend) > 0 THEN army_order(defend) = ORDER_DONE

CALL wait_seconds(opt_pause!): GOTO digin
'==========================================================================
'                       Defender Retreats
'==========================================================================
kickbutt:
	CALL draw_map_marker(army_city(active), target, MARK_ERASE_ARMY)
	IF army_order(defend) > 0 THEN CALL draw_map_marker(target, army_order(defend), MARK_ERASE_ARMY)

	CALL menu_army_retreat(defend, flee): IF flee > 0 THEN move2 = flee: GOTO outta

	best = 0: flee = 0
	FOR i = 1 TO MAX_ROADS
	x = city_road(target, i)
	IF x > 0 AND (city_owner(x) = other_side(s)) AND city_value(x) > best THEN
		IF best = 0 THEN
			flee = i: best = city_value(x)
		ELSE
			IF city_army(x) = 0 THEN flee = i: best = city_value(x)
		END IF
	END IF
	NEXT i
	IF flee = 0 GOTO deadmeat
	move2 = city_road(target, flee)
outta:
	CALL draw_army_flag(defend)                  ' in old city

	army_order(defend) = move2
	CALL animate_army(defend, ANIMATE_TAKE_PICTURE)                 ' animate retreat
       
	army_city(defend) = move2
	city_army(move2) = defend
	CALL clear_bottom_line
	PRINT army_name$(defend) + " is withdrawing to " + city_name$(move2);

	CALL draw_army_flag(defend)                  ' in new city
       
	CALL draw_map_marker(target, 0, MARK_FLASH_FRAME)
	army_order(defend) = ORDER_DONE
	GOTO holdon

deadmeat:
	index = defend
	a$ = army_name$(index) + " surrenders to " + army_name$(active) + " in " + city_name$(army_city(index))
	CALL scribe_message(a$, SHOW_BOX)
crushed:
	IF opt_graphics >= GRAPHICS_FULL THEN CALL draw_surrender(index): COLOR COLOR_YELLOW: LOCATE 3, 68: PRINT army_name$(index): LOCATE 4, 68: PRINT "surrenders !"
	x = army_side(index)
	IF opt_sound >= SOUND_MUSIC AND x <> current_side THEN PLAY "MFMST220o3e4g8g2.g8g8g8o4c2"
	IF army_order(index) > 0 THEN CALL draw_map_marker(army_city(index), army_order(index), MARK_ERASE_ARMY)
	side_victory_points(other_side(s)) = side_victory_points(other_side(s)) + 25
	army_city(index) = 0: leader_name$(index) = "": army_name$(index) = ""
	army_size(index) = 0: army_leader_rating(index) = 0
	army_experience(index) = 0: army_order(index) = ORDER_NONE: army_supply(index) = 0
	army_supply(active) = army_supply(active) + army_supply(index): army_supply(index) = 0
	IF army_supply(active) > MAX_SUPPLY THEN army_supply(active) = MAX_SUPPLY
	CALL wait_seconds(PAUSE_LONG): CALL clear_right_panel
	IF army_city(active) = 0 GOTO digin
'---------------------------------------------------------------------------
'                       check for more defenders !
'---------------------------------------------------------------------------
holdon:
	CALL city_update_occupier(target): IF city_army(target) = 0 GOTO easy
	COLOR COLOR_LIGHT_CYAN: CALL clear_bottom_line: PRINT "There are still defenders in "; city_name$(target); : CALL wait_seconds(99)
	GOTO enemy
'==========================================================================
'                       Move Into New City
'==========================================================================
easy:
CALL draw_map_marker(army_city(active), target, MARK_ERASE_ARMY)
army_city(active) = target: army_order(active) = ORDER_DONE
CALL city_update_occupier(army_city(active))
CALL draw_army_flag(active)
'---------------------------------------------------------------------------
'                            City Capture
'---------------------------------------------------------------------------
	IF city_owner(army_city(active)) = s GOTO horde
	c = army_city(active)
	IF opt_players = PLAYERS_ONE AND s = current_side AND city_fort(c) > 0 AND flag = 0 THEN
		menu_col = PANEL_COL: menu_row = 15
		menu_highlight = COLOR_WHITE: menu_color = COLOR_CYAN
		menu_text$(0) = "Raze ?"
		menu_text$(1) = "No"
		menu_text$(2) = "Yes"
		menu_item_count = 2
		CALL menu_select(MENU_PLAIN)
		CALL clear_right_panel
		IF menu_choice = 2 GOTO smoke
	END IF
	IF opt_players = PLAYERS_ONE AND s <> current_side AND city_fort(c) > 0 AND flag = 0 THEN
		IF opt_realism >= REALISM_ON AND city_y(c) > 150 THEN
smoke:
			city_fort(c) = 0
			CALL city_redraw_fort(c)
			CALL clear_bottom_line
			PRINT army_name$(active); " has destroyed the forts at "; city_name$(c);
			wait_seconds 3
		END IF
	END IF
	CALL city_capture(active, c, s, flag)
horde:
IF army_supply(active) < MAX_SUPPLY THEN army_supply(active) = army_supply(active) + 1: IF RND > .8 GOTO horde
digin:
NEXT j

allthru:
CALL navy_commerce_raid

CALL draw_map_touchup: CALL draw_fleets: CALL turn_date_and_supply

CALL clear_bottom_line
LINE (390, 350)-(520, 400), 1, BF
COLOR COLOR_LIGHT_MAGENTA: LOCATE 24, 51: PRINT " "; UCASE$(LEFT$(month_name$(turn_month), 3)); ","; turn_year
CALL turn_update_victory_points
IF opt_players = PLAYERS_TWO THEN CALL clear_bottom_line: COLOR COLOR_YELLOW: PRINT "press a key"; : CALL wait_key("K")
END SUB

' The month's income: each side gets its cities' values and its capital's income, and loses
' what the other side's raiders took. Counts each side's cities and clears the orders.
SUB turn_collect_income
DIM i AS INTEGER: DIM x AS INTEGER
side_city_count(SIDE_UNION) = 0: side_city_count(SIDE_REBEL) = 0

FOR i = SIDE_UNION TO SIDE_REBEL
side_income(i) = 0
IF side_cash(i) > MAX_CASH THEN side_cash(i) = MAX_CASH
IF side_cash(i) < 0 THEN side_cash(i) = 0
NEXT i
IF opt_players = PLAYERS_ONE AND current_side = SIDE_REBEL THEN side_income(SIDE_UNION) = side_income(SIDE_UNION) + union_income_bonus

FOR i = 1 TO MAX_CITIES
IF city_owner(i) > 0 THEN x = city_owner(i): side_city_count(x) = side_city_count(x) + 1: side_income(x) = side_income(x) + city_value(i)
army_order(i) = ORDER_NONE
NEXT i

FOR i = SIDE_UNION TO SIDE_REBEL: IF side_capital(i) > 0 THEN side_income(i) = side_income(i) + CAPITAL_INCOME
side_cash(i) = side_cash(i) + side_income(i)
IF raiding_side > 0 AND i <> raiding_side THEN side_cash(i) = side_cash(i) - raid_loss
NEXT i
total_income = side_income(SIDE_UNION) + side_income(SIDE_REBEL)
END SUB

' Gives each army with an order its place in the month's moves and sorts them. An army
' out of supplies moves last; a large one moves later; a good leader may move sooner.
SUB turn_set_move_order
DIM i AS INTEGER: DIM x AS INTEGER
FOR i = 1 TO MAX_ARMIES
move_order_key(i) = MOVE_KEY_NONE
IF army_order(i) < 0 THEN army_order(i) = ORDER_NONE
IF army_city(i) > 0 AND army_order(i) > 0 THEN move_order_key(i) = INT(4 + 4 * RND) * 100 + i
IF army_supply(i) < 1 AND army_order(i) > 0 THEN move_order_key(i) = 900 + i
SELECT CASE army_size(i)         'bigger armies move slower
	CASE IS > 400
		IF move_order_key(i) < 900 THEN move_order_key(i) = move_order_key(i) + 100: x = 2
	CASE IS > 800
		IF move_order_key(i) < 800 THEN move_order_key(i) = move_order_key(i) + 200: x = 3
	CASE IS > 1000
		IF move_order_key(i) < 700 THEN move_order_key(i) = move_order_key(i) + 300: x = 4
	CASE ELSE
		x = 1
END SELECT
IF move_order_key(i) <> MOVE_KEY_NONE AND army_leader_rating(i) > 10 * RND THEN
		move_order_key(i) = move_order_key(i) - 100 * (army_leader_rating(i) \ 2)
		IF move_order_key(i) < 100 THEN move_order_key(i) = 100 + i
END IF
NEXT i

CALL sort_move_order(MAX_ARMIES)
END SUB

' The month's victory points: each side keeps eight tenths and gains by its income and
' cities. A computer that holds few cities gets a higher strength ratio.
SUB turn_update_victory_points
side_victory_points(SIDE_UNION) = .8 * side_victory_points(SIDE_UNION) + .3 * (side_income(SIDE_UNION) + side_city_count(SIDE_UNION))
IF side_city_count(SIDE_UNION) > 29 THEN side_victory_points(SIDE_UNION) = side_victory_points(SIDE_UNION) + 50: IF side_city_count(SIDE_UNION) > 34 THEN side_victory_points(SIDE_UNION) = side_victory_points(SIDE_UNION) + 100
IF current_side = SIDE_REBEL AND side_city_count(SIDE_UNION) < 11 THEN ai_strength_ratio! = ai_strength_ratio! + .7

IF side_victory_points(SIDE_UNION) < 1 THEN side_victory_points(SIDE_UNION) = 0
side_victory_points(SIDE_REBEL) = .8 * side_victory_points(SIDE_REBEL) + .3 * (side_income(SIDE_REBEL) + side_city_count(SIDE_REBEL))
IF side_city_count(SIDE_REBEL) > 29 THEN side_victory_points(SIDE_REBEL) = side_victory_points(SIDE_REBEL) + 50: IF side_city_count(SIDE_REBEL) > 34 THEN side_victory_points(SIDE_REBEL) = side_victory_points(SIDE_UNION) + 100
IF current_side = SIDE_UNION AND side_city_count(SIDE_REBEL) < 11 THEN ai_strength_ratio! = ai_strength_ratio! + .7
END SUB
