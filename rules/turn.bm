' The rules of the month's moves. They draw nothing. The moves as the player sees them are in
' ui/turn.bm, and call these.

' The main menu's Moves entry: done is 1 when no army is left to give an order to, and 0 when
' an order may have been cancelled.
SUB turn_set_moves_done (done)
    turn_moves_done = done
END SUB

' The main menu's Ships entry: done is 1 when the player's fleet has acted this month.
SUB turn_set_navy_done (done)
    turn_navy_done = done
END SUB

' Opens the main menu's Troops, Moves and Ships again for the month.
SUB turn_reset_commands
    turn_recruit_state = 0: turn_moves_done = 0: turn_navy_done = 0
END SUB

' Before each main menu. In a two-player game with no side set, the Union plays. Ships is
' closed for the month when the side has no fleet and not the price of a ship.
SUB turn_check_commands
    IF opt_players = PLAYERS_TWO AND current_side = SIDE_NONE THEN
        current_side = SIDE_UNION
    END IF
    IF side_cash(current_side) < COST_SHIP AND NOT fleet_exists(current_side) THEN
        turn_navy_done = 1
    END IF
END SUB

' Troops is closed for the month.
SUB turn_close_recruiting
    turn_recruit_state = -1
END SUB

' After a turn ends. In a two-player game the Rebels' turn follows the Union's, and
' month_over is 0. Otherwise the month is played, month_over is 1, and the Union is next.
SUB turn_next_player (month_over)
    month_over = 1
    IF opt_players = PLAYERS_TWO THEN
        current_side = current_side + 1: IF current_side = SIDE_REBEL THEN
            month_over = 0: EXIT SUB
        END IF
    END IF
    IF current_side > SIDE_REBEL THEN
        current_side = SIDE_UNION
    END IF
END SUB

' Two months pass.
SUB turn_advance_month
    turn_month = turn_month + MONTHS_PER_TURN
    IF turn_month > MONTHS_PER_YEAR THEN
        turn_month = 1: turn_year = turn_year + 1
    END IF
END SUB

' An army's supplies for the month. Its side pays for a day of supply if it can, and the army
' must be connected to it under the Realism setting. Outside the summer an army away from a sea
' port uses a day, and an army in a sea port blockaded by the other side's fleet uses one
' (blockaded is 1). An army left without supplies may lose a tenth of its men (starved is 1).
SUB turn_army_supply (army, blockaded, starved)
    DIM side AS INTEGER: DIM friendly_neighbors AS INTEGER
    side = army_side(army)
    IF side_cash(side) >= .2 * army_size(army) THEN
        friendly_neighbors = 1: IF opt_realism >= REALISM_ON THEN
            friendly_neighbors = city_is_connected(side, army_city(army))
        END IF
        IF friendly_neighbors > 0 THEN
            army_supply(army) = army_supply(army) + 1
            side_cash(side) = side_cash(side) - .2 * army_size(army)
        END IF
    END IF
    IF (turn_month < 7 OR turn_month > 10) AND city_port_type(army_city(army)) < PORT_SEA THEN
        army_supply(army) = army_supply(army) - 1
    END IF
    blockaded = 0: starved = 0
    IF city_port_type(army_city(army)) = PORT_SEA AND fleet_city(other_side(side)) = army_city(army) THEN
        army_supply(army) = army_supply(army) - 1: blockaded = 1
    END IF
    IF army_supply(army) < 1 THEN
        army_supply(army) = 0
        starved = 1
        IF RND > .8 AND army_size(army) > 50 THEN
            army_size(army) = .9 * army_size(army)
        END IF
    END IF
END SUB

' The strength ratio the computer plays by: the player's men against the computer's.
SUB turn_strength_ratio
    DIM i AS INTEGER: DIM union_strength AS INTEGER: DIM rebel_strength AS INTEGER
    union_strength = 0
    FOR i = 1 TO ARMIES_PER_SIDE
        union_strength = union_strength + .1 * army_size(i)
    NEXT i
    rebel_strength = 0
    FOR i = ARMIES_PER_SIDE + 1 TO MAX_ARMIES
        rebel_strength = rebel_strength + .1 * army_size(i)
    NEXT i
    IF current_side = SIDE_REBEL AND rebel_strength > 0 THEN
        ai_strength_ratio! = union_strength / rebel_strength
    ELSE
        ai_strength_ratio! = 1
    END IF
    IF current_side = SIDE_UNION AND union_strength > 0 THEN
        ai_strength_ratio! = rebel_strength / union_strength
    ELSE
        IF current_side = SIDE_UNION THEN
            ai_strength_ratio! = 1
        END IF
    END IF
END SUB

' An army sets out: it uses a day of supply. starved is 1 when it had none left.
SUB turn_army_marches (army, starved)
    starved = 0: army_supply(army) = army_supply(army) - 1: IF army_supply(army) < 0 THEN
        army_supply(army) = 0: starved = 1
    END IF
END SUB

' The winner of a battle gains a level of experience.
SUB turn_battle_experience (army)
    IF army_experience(army) < MAX_EXPERIENCE THEN
        army_experience(army) = army_experience(army) + 1
    END IF
END SUB

' The attacker withdrew to the city it came from (in its order) and is done for the month.
' (army_order(army)) is a copy: turn_retreat_to changes the order after it sets the city.
SUB turn_withdraw (army)
    CALL turn_retreat_to(army, (army_order(army)))
END SUB

' After the attacker withdrew, the defender loses its own order for the month (halted is 1)
' unless its leader's rating beats a draw from 0 to 11. old_order is its order before.
SUB turn_defender_halts (army, halted, old_order)
    halted = 0
    old_order = army_order(army)
    IF 11 * RND > army_leader_rating(army) THEN
        halted = 1: IF army_has_move(army) THEN
            army_order(army) = ORDER_DONE
        END IF
    END IF
END SUB

' The city the defender of city retreats to: the richest city of its side next to city, and
' after the first one found only an empty one. 0 when there is none.
FUNCTION turn_retreat_city (city, attacker_side)
    DIM best_road AS INTEGER: DIM best AS INTEGER: DIM i AS INTEGER: DIM neighbor AS INTEGER
    turn_retreat_city = 0
    best = 0: best_road = 0
    FOR i = 1 TO MAX_ROADS
        neighbor = city_road(city, i)
        IF neighbor > 0 AND (city_owner(neighbor) = other_side(attacker_side)) AND city_value(neighbor) > best THEN
            IF best = 0 THEN
                best_road = i
                best = city_value(neighbor)
            ELSE
                IF city_army(neighbor) = 0 THEN
                    best_road = i: best = city_value(neighbor)
                END IF
            END IF
        END IF
    NEXT i
    IF best_road = 0 THEN
        EXIT FUNCTION
    END IF
    turn_retreat_city = city_road(city, best_road)
END FUNCTION

' The defender is in the city it retreated to, and done for the month.
SUB turn_retreat_to (army, city)
    army_city(army) = city
    city_army(city) = army
    army_order(army) = ORDER_DONE
END SUB

' An army is crushed or surrenders to the army winner: winner's side gets 25 victory points,
' winner takes its supplies, and its slot is cleared. The original gave the points to the
' loser's side, and cleared the supplies before winner took them.
SUB turn_army_lost (army, winner)
    DIM side AS INTEGER
    side = army_side(winner)
    side_victory_points(side) = side_victory_points(side) + 25
    army_supply(winner) = army_supply(winner) + army_supply(army)
    IF army_supply(winner) > MAX_SUPPLY THEN
        army_supply(winner) = MAX_SUPPLY
    END IF
    army_city(army) = 0: leader_name$(army) = "": army_name$(army) = ""
    army_size(army) = 0: army_leader_rating(army) = 0
    army_experience(army) = 0: army_order(army) = ORDER_NONE: army_supply(army) = 0
END SUB

' An army enters the city and is done for the month.
SUB turn_occupy (army, city)
    army_city(army) = city: army_order(army) = ORDER_DONE
    CALL city_update_occupier(army_city(army))
END SUB

' A fort is razed.
SUB turn_raze_fort (city)
    city_fort(city) = 0
END SUB

' An army in a city of its side gathers supplies: a day, and more with a chance of 2 in 10 each.
SUB turn_army_forages (army)
    DO
        IF army_supply(army) >= MAX_SUPPLY THEN
            EXIT SUB
        END IF
        army_supply(army) = army_supply(army) + 1
    LOOP WHILE RND > .8
END SUB

' The month's income: each side gets its cities' values and its capital's income, and loses
' what the other side's raiders took. Counts each side's cities and clears the orders.
SUB turn_collect_income
    DIM i AS INTEGER: DIM owner AS INTEGER
    side_city_count(SIDE_UNION) = 0: side_city_count(SIDE_REBEL) = 0

    FOR i = SIDE_UNION TO SIDE_REBEL
        side_income(i) = 0
        IF side_cash(i) > MAX_CASH THEN
            side_cash(i) = MAX_CASH
        END IF
        IF side_cash(i) < 0 THEN
            side_cash(i) = 0
        END IF
    NEXT i
    IF opt_players = PLAYERS_ONE AND current_side = SIDE_REBEL THEN
        side_income(SIDE_UNION) = side_income(SIDE_UNION) + union_income_bonus
    END IF

    FOR i = 1 TO MAX_CITIES
        IF city_owner(i) > 0 THEN
            owner = city_owner(i): side_city_count(owner) = side_city_count(owner) + 1: side_income(owner) = side_income(owner) + city_value(i)
        END IF
        army_order(i) = ORDER_NONE
    NEXT i

    FOR i = SIDE_UNION TO SIDE_REBEL: IF side_capital(i) > 0 THEN
            side_income(i) = side_income(i) + CAPITAL_INCOME
        END IF
        side_cash(i) = side_cash(i) + side_income(i)
        IF raiding_side > 0 AND i <> raiding_side THEN
            side_cash(i) = side_cash(i) - raid_loss
        END IF
    NEXT i
    total_income = side_income(SIDE_UNION) + side_income(SIDE_REBEL)
END SUB

' Gives each army with an order its place in the month's moves and sorts them. An army
' out of supplies moves last; a large one moves later; a good leader may move sooner.
SUB turn_set_move_order
    DIM i AS INTEGER
    FOR i = 1 TO MAX_ARMIES
        move_order_key(i) = MOVE_KEY_NONE
        IF army_has_acted(i) THEN
            army_order(i) = ORDER_NONE
        END IF
        IF army_exists(i) AND army_has_move(i) THEN
            move_order_key(i) = INT(4 + 4 * RND) * 100 + i
        END IF
        IF army_supply(i) < 1 AND army_has_move(i) THEN
            move_order_key(i) = 900 + i
        END IF
        SELECT CASE army_size(i) 'bigger armies move slower
            CASE IS > 1000
                IF move_order_key(i) < 700 THEN
                    move_order_key(i) = move_order_key(i) + 300
                END IF
            CASE IS > 800
                IF move_order_key(i) < 800 THEN
                    move_order_key(i) = move_order_key(i) + 200
                END IF
            CASE IS > 400
                IF move_order_key(i) < 900 THEN
                    move_order_key(i) = move_order_key(i) + 100
                END IF
        END SELECT
        IF move_order_key(i) <> MOVE_KEY_NONE AND army_leader_rating(i) > 10 * RND THEN
            move_order_key(i) = move_order_key(i) - 100 * (army_leader_rating(i) \ 2)
            IF move_order_key(i) < 100 THEN
                move_order_key(i) = 100 + i
            END IF
        END IF
    NEXT i

    CALL sort_move_order(MAX_ARMIES)
END SUB

' The month's victory points of one side: it keeps eight tenths and gains by its income and
' cities. A computer whose enemy holds few cities gets a higher strength ratio. The points stop
' at 0; in the original only the Union's did.
SUB turn_update_victory_points (side)
    side_victory_points(side) = .8 * side_victory_points(side) + .3 * (side_income(side) + side_city_count(side))
    IF side_city_count(side) > 29 THEN
        side_victory_points(side) = side_victory_points(side) + 50: IF side_city_count(side) > 34 THEN
            side_victory_points(side) = side_victory_points(side) + 100
        END IF
    END IF
    IF current_side = other_side(side) AND side_city_count(side) < 11 THEN
        ai_strength_ratio! = ai_strength_ratio! + .7
    END IF
    IF side_victory_points(side) < 1 THEN
        side_victory_points(side) = 0
    END IF
END SUB
