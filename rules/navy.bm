' The rules of the fleets. They draw nothing. The navy's menus and screens are in ui/navy.bm,
' and call these.

' City 0 stands for "no port". Before a fleet's order it is given to the fleet's side, so that
' the owner of the port of a side without a fleet is that side. The computer's fleet orders
' (ai_fleet_orders) read it later, as the last order left it.
SUB navy_mark_side (side)
	city_owner(0) = side
END SUB

' Counts the fleet's ships again from its list of ships.
SUB navy_count_ships (side)
	fleets(side).size = LEN(fleets(side).ships)
END SUB

' 1 when ironclads can be built: always without the Realism setting, and with it from March
' 1862.
FUNCTION navy_has_ironclads
	navy_has_ironclads = 1
	IF opt_realism >= REALISM_ON AND ((turn_year < IRONCLAD_YEAR) OR (turn_year = IRONCLAD_YEAR AND turn_month < IRONCLAD_MONTH)) THEN navy_has_ironclads = 0
END FUNCTION

' Fills the menu with the sea ports where the side can start a fleet: its own, without the
' port the other side's fleet lies off.
SUB navy_list_shipyards (side)
DIM i AS INTEGER
	menu_text$(0) = "Port": menu_item_count = 0: menu_col = PANEL_COL: menu_row = 12
	FOR i = 1 TO MAX_CITIES: IF city_port_type(i) = PORT_SEA AND city_owner(i) = side AND fleets(other_side(side)).city <> i THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(i): menu_value(menu_item_count) = i
	NEXT i
END SUB

' Fills the menu with the sea ports the side's fleet can sail to: all but the one it lies off.
SUB navy_list_ports (side)
DIM i AS INTEGER
	menu_item_count = 0
	FOR i = 1 TO MAX_CITIES: IF city_port_type(i) > PORT_RIVER AND fleets(side).city <> i THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(i): menu_value(menu_item_count) = i
	NEXT i
END SUB

' Draws a random number and drops it. The player's Build and Attack call it where the
' original drew a number for a test that only the computer's fleet uses, so that the random
' numbers of a game stay in their order (TODO.md).
SUB random_discard
DIM unused!
	unused! = RND
END SUB

SUB navy_remove_ship (side)
fleets(side).size = fleets(side).size - 1
IF fleets(side).size > 0 THEN
	fleets(side).ships = LEFT$(fleets(side).ships, fleets(side).size)
ELSE
	fleets(side).ships = "": fleets(side).city = 0: fleets(side).size = 0
END IF
END SUB

' Build: a ship of kind ship$ ("W" wooden, "I" ironclad) joins the side's fleet. Ironclads go
' first in fleet_ships$. A fleet that had ships pays cost now; a new one pays in
' navy_found_fleet, when its port is known.
SUB navy_add_ship (side, ship$, cost)
	fleets(side).size = fleets(side).size + 1
	IF ship$ = "W" THEN
		fleets(side).ships = fleets(side).ships + ship$
	ELSE
		fleets(side).ships = ship$ + fleets(side).ships
	END IF
	IF fleets(side).size > 1 THEN sides(side).cash = sides(side).cash - cost
END SUB

' A new fleet of one ship in port city, for cost.
SUB navy_found_fleet (side, city, cost)
	fleets(side).city = city
	sides(side).cash = sides(side).cash - cost: fleets(side).size = 1
END SUB

' A new fleet has no port to start in: the ship is not built.
SUB navy_cancel_new_fleet (side)
	fleets(side).size = 0: fleets(side).ships = ""
END SUB

' Attack on the army in the city the fleet lies off: losses of its men, in hundreds, and some
' of its supplies. The army keeps at least 100 men.
SUB navy_bombard_army (side, army, losses)
DIM pct!: DIM x AS INTEGER
	pct! = .005 * fleets(side).size + .02 * RND: losses = army_size(army) * pct!: IF losses < 1 THEN losses = 1
	x = .5 * fleets(side).size + 1: IF x > army_supply(army) THEN x = army_supply(army)
	army_supply(army) = army_supply(army) - x
	army_size(army) = army_size(army) - losses: IF army_size(army) < 1 THEN army_size(army) = 1
END SUB

' Attack on a city with a fort and no army: the fleet damages the fort (damaged is 1), or the
' shore battery sinks one of its ships.
SUB navy_shore_battery (side, city, damaged)
	damaged = 0
	IF RND < .7 + .03 * (fleets(side).size - city_fort(city)) THEN damaged = 1: city_fort(city) = city_fort(city) - 1: EXIT SUB
	CALL navy_remove_ship(side)
END SUB

' The shore battery sank the fleet's last ship. The other side gets 5 victory points.
SUB navy_fleet_lost (side)
	fleets(side).city = 0: fleets(side).ships = ""
	sides(other_side(side)).victory_points = sides(other_side(side)).victory_points + 5
	IF side = current_side THEN fleet_pursuit = 0
END SUB

' Attack on a city with neither army nor fort. result is BLAST_FIRM when the citizens stand firm,
' BLAST_LOYAL when the city is the other side's capital, which stays loyal, and BLAST_NEUTRAL when
' the city turns neutral; the side then gets the city's value in victory points.
SUB navy_blast (side, city, result)
	result = BLAST_FIRM
	IF RND > .25 + .07 * fleets(side).size THEN EXIT SUB
	result = BLAST_LOYAL
	IF fleets(side).city = sides(other_side(side)).capital THEN EXIT SUB
	result = BLAST_NEUTRAL
	city_owner(fleets(side).city) = SIDE_NONE
	sides(side).victory_points = sides(side).victory_points + city_value(fleets(side).city)
END SUB

' Sail: the fleet is now off city.
SUB navy_move_fleet (side, city)
	fleets(side).city = city
END SUB

' Raid: the fleet is at sea, raiding the other side's commerce.
SUB navy_go_raiding (side)
	fleets(side).city = FLEET_AT_SEA: raiding_side = side
END SUB

' Invasion: the new army that the ship landed is 3,500 men, and its side gets back the 100
' that army_new took for it.
SUB navy_landed (side, army)
	sides(side).cash = sides(side).cash + COST_RECRUIT     'compensate for cost of recruiting new army
	army_size(army) = 35
END SUB

' After a fleet has moved or fought: which side's fleet is at sea, raiding commerce.
SUB navy_note_raiding_side
DIM k AS INTEGER
	raiding_side = SIDE_NONE
	FOR k = SIDE_UNION TO SIDE_REBEL
	IF fleets(k).city = FLEET_AT_SEA THEN raiding_side = k
	NEXT k
END SUB

' One round of the raid on commerce. raider is the side that raids, or 0 when none does. When
' sank is 1 its raiders sank raid_loss of the other side's income; when 0 it lost a ship, and
' raiding_side becomes 0 when that was its last.
SUB navy_raid_round (raider, sank)
IF fleets(raiding_side).size < 1 THEN raiding_side = SIDE_NONE
raider = raiding_side: sank = 0
IF raider <= 0 THEN EXIT SUB
	IF RND < .8 + .02 * fleets(raider).size THEN
		sank = 1
		raid_loss = .05 * fleets(raider).size * (1 + RND) * (sides(other_side(raider)).income)
		IF raid_loss < 1 THEN raid_loss = 1
		IF raid_loss / sides(other_side(raider)).income > .3 THEN raid_loss = .3 * sides(other_side(raider)).income
		IF raider = current_side THEN fleet_pursuit = 1
	ELSE
		raid_loss = 0
		CALL navy_remove_ship(raider)
		IF fleets(raider).city <= 0 THEN raiding_side = SIDE_NONE
	END IF
END SUB

' Naval combat: the hits the side's last ship can take, 20 for an ironclad and 10 for a wooden ship.
FUNCTION navy_ship_hits (side)
	navy_ship_hits = 10
	IF RIGHT$(fleets(side).ships, 1) = "I" THEN navy_ship_hits = 20
END FUNCTION

' Naval combat: 1 when the side's shot hits. An ironclad against a wooden ship has a better
' chance, and a wooden ship against an ironclad a worse one.
FUNCTION navy_shot_hits (side)
DIM pct!: DIM a$
	pct! = 0: a$ = RIGHT$(fleets(side).ships, 1)
	IF a$ <> RIGHT$(fleets(other_side(side)).ships, 1) THEN
		IF a$ = "I" THEN pct! = .1 ELSE pct! = -.1
	END IF
	navy_shot_hits = 0: IF RND <= .5 + pct! THEN navy_shot_hits = 1
END FUNCTION

' Naval combat: the loser's fleet is sunk. The loser's side gets 10 victory points (TODO.md).
' The winner pursues when it is the side whose turn it is.
SUB navy_fleet_defeated (loser)
	fleets(loser).city = 0: fleets(loser).ships = ""
	sides(loser).victory_points = sides(loser).victory_points + 10
	IF other_side(loser) = current_side THEN fleet_pursuit = 1 ELSE fleet_pursuit = 0
END SUB

' Naval combat: the side's fleet retreats to one of its other sea ports. Each in turn becomes
' the target, and the search stops there with a chance of 7 in 10. port is 0 when there is none.
SUB navy_retreat_port (side, port)
DIM i AS INTEGER
	 port = 0
	 FOR i = 1 TO MAX_CITIES
	 IF city_owner(i) = side THEN IF i <> fleets(side).city AND city_port_type(i) = PORT_SEA THEN port = i: IF RND > .3 GOTO found1
	 NEXT i
found1:
	 fleets(side).city = port
END SUB
