SUB navy_remove_ship (side)
fleet_size(side) = fleet_size(side) - 1
IF fleet_size(side) > 0 THEN
	fleet_ships$(side) = LEFT$(fleet_ships$(side), fleet_size(side))
ELSE
	fleet_ships$(side) = "": fleet_city(side) = 0: fleet_size(side) = 0
END IF
END SUB

SUB navy_commands (side, action)
DIM empty AS INTEGER: DIM c AS INTEGER: DIM k AS INTEGER: DIM best AS INTEGER
DIM cost AS INTEGER: DIM defend AS INTEGER: DIM a$: DIM a AS INTEGER: DIM i AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER: DIM target AS INTEGER: DIM index AS INTEGER: DIM pct!: DIM killd AS INTEGER
DIM hit(SIDE_REBEL)
IF action > 0 THEN
	IF fleet_city(side) < 1 THEN
		action = NAVY_BUILD
	ELSE
		IF raiding_side = other_side(side) AND raid_loss > 0 THEN action = NAVY_RAID
		IF fleet_pursuit > 0 THEN action = NAVY_SAIL
	END IF
END IF
COLOR COLOR_LIGHT_CYAN
ahoy:
cost = COST_SHIP: city_owner(0) = side
IF action = NAVY_ASK THEN CALL clear_bottom_line: PRINT "Funds available "; side_cash(side);
IF action = NAVY_BUILD THEN
	IF side_cash(side) < cost THEN EXIT SUB
	IF fleet_size(side) >= MAX_FLEET_SHIPS THEN EXIT SUB
END IF
menu_text$(0) = "Ships"
menu_text$(1) = "Build"
IF fleet_city(side) <> FLEET_AT_SEA THEN
IF side_cash(side) < cost OR fleet_size(side) >= MAX_FLEET_SHIPS OR city_owner(fleet_city(side)) <> side THEN menu_text$(1) = "-": menu_choice = MENU_START + 2
END IF
menu_text$(2) = "Attack"
IF fleet_city(side) <> FLEET_AT_SEA THEN
IF city_owner(fleet_city(side)) <> other_side(side) THEN menu_text$(2) = "-": menu_choice = MENU_START + 1
ELSE
menu_text$(1) = "-": menu_text$(2) = "-": menu_choice = MENU_START + 3
END IF
menu_text$(3) = "Sail": IF fleet_city(side) < 1 THEN menu_text$(3) = "-": IF action = NAVY_SAIL THEN action = NAVY_BUILD
menu_text$(4) = "Raid": IF fleet_size(side) < 1 OR raiding_side = side THEN menu_text$(4) = "-"
menu_col = PANEL_COL: menu_row = 12: menu_item_count = 4
IF fleet_city(side) <> FLEET_AT_SEA THEN
IF side = SIDE_UNION AND fleet_size(side) > 1 AND city_owner(fleet_city(side)) = SIDE_NONE THEN menu_item_count = 5: menu_text$(5) = "Invasion": CALL city_nearby_enemy_strength(fleet_city(SIDE_UNION), defend): IF action > 0 AND defend < 100 THEN action = NAVY_INVADE
IF opt_realism = REALISM_OFF AND side = SIDE_REBEL AND fleet_size(side) > 1 AND city_owner(fleet_city(side)) = SIDE_NONE THEN menu_item_count = 5: menu_text$(5) = "Invasion": CALL city_nearby_enemy_strength(fleet_city(SIDE_UNION), defend): IF action > 0 AND defend < 100 THEN action = NAVY_INVADE
END IF

IF action > 0 THEN menu_choice = action: GOTO anchor
IF turn_navy_done > 0 AND menu_choice <> 1 THEN EXIT SUB
CALL menu_select(MENU_PLAIN): CALL clear_right_panel
anchor:
'---------------------------------------------------------------------------
SELECT CASE menu_choice
'---------------------------------------------------------------------------
'                               Build Ship
'---------------------------------------------------------------------------
	CASE 1
	IF side_cash(side) < cost OR fleet_city(side) = FLEET_AT_SEA GOTO ahoy
	IF action = NAVY_BUILD AND fleet_size(side) >= MAX_FLEET_SHIPS THEN EXIT SUB
	IF action = NAVY_ASK AND fleet_size(side) >= MAX_FLEET_SHIPS THEN GOTO ahoy

	IF action = NAVY_ASK AND fleet_city(side) > 0 THEN
		IF city_owner(fleet_city(side)) <> side GOTO ahoy
		IF city_port_type(fleet_city(side)) < PORT_SEA GOTO ahoy
	END IF
	IF action = NAVY_BUILD AND RND < .07 * fleet_size(side) THEN EXIT SUB
	a$ = "W"

	IF opt_realism >= REALISM_ON AND ((turn_year < IRONCLAD_YEAR) OR (turn_year = IRONCLAD_YEAR AND turn_month < IRONCLAD_MONTH)) GOTO noiron
	IF side_cash(side) >= 2 * cost THEN
		menu_col = PANEL_COL: menu_row = 12: menu_color = COLOR_LIGHT_BLUE
		IF side = current_side THEN
			menu_text$(0) = "Type"
			menu_text$(1) = "Wooden"
			menu_text$(2) = "Ironclad"
			menu_item_count = 2
			CALL menu_select(MENU_PLAIN)
			CALL clear_right_panel
			IF menu_choice < 1 GOTO ahoy
			IF menu_choice = 2 THEN a$ = "I": cost = 2 * cost
		ELSE
			a$ = "I"
		END IF
	END IF

noiron:
	fleet_size(side) = fleet_size(side) + 1
	IF a$ = "W" THEN
		fleet_ships$(side) = fleet_ships$(side) + a$: a = 1
	ELSE
		fleet_ships$(side) = a$ + fleet_ships$(side): a = 2
	END IF
	IF fleet_size(side) > 1 GOTO add2ship
ships:
	menu_text$(0) = "Port": menu_item_count = 0: menu_col = PANEL_COL: menu_row = 12
	FOR i = 1 TO MAX_CITIES: IF city_port_type(i) = PORT_SEA AND city_owner(i) = side AND fleet_city(other_side(side)) <> i THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(i): menu_value(menu_item_count) = i
	NEXT i
	IF action = NAVY_BUILD THEN menu_choice = 1 + INT(menu_item_count * RND)
	IF menu_item_count < 1 THEN
		fleet_size(side) = 0: fleet_ships$(side) = ""
		IF action = NAVY_ASK THEN CALL clear_bottom_line: PRINT "NO SHIPYARDS AVAILABLE !"; : EXIT SUB
		IF action = NAVY_BUILD THEN EXIT SUB
	END IF
	IF action = NAVY_ASK THEN CALL menu_select(MENU_CITY_POINTER): CALL clear_right_panel

	IF menu_choice < 1 GOTO ships
	fleet_city(side) = menu_value(menu_choice)
	side_cash(side) = side_cash(side) - cost: fleet_size(side) = 1
	x = city_x(menu_value(menu_choice)) + 25: y = city_y(menu_value(menu_choice)) + 25: CALL draw_fleets
	CALL clear_bottom_line: COLOR COLOR_LIGHT_CYAN: PRINT side_name$(side); " is building NEW fleet in "; city_name$(menu_value(menu_choice));
	PSET (400, 465), 0: CALL draw_ship_icon(side, a)
	IF opt_sound >= SOUND_EFFECTS THEN SOUND 3000, 1
	CALL wait_seconds(opt_pause!)
	GOTO ahoy
add2ship:
	side_cash(side) = side_cash(side) - cost
	CALL clear_bottom_line: PRINT side_name$(side); " navy increased to "; fleet_size(side);
	PSET (400, 465), 0: CALL draw_ship_icon(side, a)
	CALL draw_fleets
	IF opt_sound >= SOUND_EFFECTS THEN SOUND 3000, 1
	CALL wait_seconds(opt_pause!)
'---------------------------------------------------------------------------
'                               Attack City
'---------------------------------------------------------------------------
	CASE 2
	IF fleet_city(side) = FLEET_AT_SEA GOTO ahoy
	IF action = NAVY_ATTACK AND city_owner(fleet_city(side)) = side THEN EXIT SUB
	IF action = NAVY_ATTACK AND city_army(fleet_city(side)) > 0 AND RND > .5 THEN action = NAVY_SAIL: GOTO anchor
	IF action = NAVY_ATTACK AND city_owner(fleet_city(side)) = SIDE_NONE THEN action = NAVY_SAIL: GOTO ahoy
	IF fleet_city(side) < 1 THEN EXIT SUB
	IF side = current_side THEN turn_navy_done = 1
	IF city_owner(fleet_city(side)) <> other_side(side) GOTO ahoy
	CALL clear_bottom_line: COLOR COLOR_LIGHT_RED: PRINT side_name$(side); " fleet bombards "; city_name$(fleet_city(side));
	CALL draw_map_marker(fleet_city(side), 0, MARK_EXPLOSION)
	      
	target = fleet_city(side): index = city_army(target): IF index = 0 GOTO deserted
	pct! = .005 * fleet_size(side) + .02 * RND: killd = army_size(index) * pct!: IF killd < 1 THEN killd = 1
	CALL clear_bottom_line: PRINT army_name$(index); " suffered "; 100 * killd; " casualties";
	x = .5 * fleet_size(side) + 1: IF x > army_supply(index) THEN x = army_supply(index)
	army_supply(index) = army_supply(index) - x
	CALL wait_seconds(opt_pause!)
	army_size(index) = army_size(index) - killd: IF army_size(index) < 1 THEN army_size(index) = 1
	EXIT SUB
deserted:
	IF city_fort(target) = 0 GOTO blast
	IF RND < .7 + .03 * (fleet_size(side) - city_fort(target)) GOTO hurt1
	CALL navy_remove_ship(side)
	CALL clear_bottom_line
	PRINT side_name$(city_owner(target)); " shore battery sunk an attacking ship!"; fleet_size(side); "ship(s) left! ";
	IF opt_sound >= SOUND_EFFECTS THEN SOUND 77, .5: SOUND 59, .5
	CALL wait_seconds(opt_pause!)
	IF fleet_size(side) < 1 THEN
		fleet_city(side) = 0: fleet_ships$(side) = "": GOSUB box2
		LOCATE 12, 27: PRINT side_name$(side); " fleet eliminated"
		CALL wait_seconds(PAUSE_LONG)
		side_victory_points(other_side(side)) = side_victory_points(other_side(side)) + 5
		IF side = current_side THEN fleet_pursuit = 0
		GOTO sail3
	END IF
	GOTO deserted
hurt1:
	CALL clear_bottom_line: PRINT city_name$(target); " fortifications damaged";
	city_fort(target) = city_fort(target) - 1: x = city_x(target): y = city_y(target): LINE (x - 5, y - 5)-(x + 5, y + 5), 2, BF
	CALL draw_cities
	CALL wait_seconds(opt_pause!)
	EXIT SUB
blast:
	IF RND > .25 + .07 * fleet_size(side) THEN CALL clear_bottom_line: PRINT "Citizens of "; city_name$(target); " stand firm against the attack"; : CALL wait_seconds(opt_pause!): EXIT SUB
	IF fleet_city(side) = side_capital(other_side(side)) THEN CALL clear_bottom_line: PRINT "The CAPITAL steadfastly stands loyal"; : CALL wait_seconds(opt_pause!): EXIT SUB
	city_owner(fleet_city(side)) = SIDE_NONE
	CALL clear_bottom_line: PRINT city_name$(fleet_city(side)); " is now  NEUTRAL";
	CALL draw_cities
	side_victory_points(side) = side_victory_points(side) + city_value(fleet_city(side))
	EXIT SUB
'---------------------------------------------------------------------------
'                               Sail
'---------------------------------------------------------------------------
	CASE 3
	fleet_size(side) = LEN(fleet_ships$(side))
	IF fleet_size(side) < 1 AND action > 0 THEN EXIT SUB
	IF fleet_city(side) < 1 OR fleet_size(side) < 1 THEN CALL clear_bottom_line: PRINT "No ships remain"; : wait_seconds 1: GOTO ahoy

	menu_item_count = 0
	FOR i = 1 TO MAX_CITIES: IF city_port_type(i) > PORT_RIVER AND fleet_city(side) <> i THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(i): menu_value(menu_item_count) = i
	NEXT i
	IF action = NAVY_SAIL THEN
		IF menu_item_count = 0 THEN EXIT SUB
		IF fleet_pursuit > 0 THEN menu_choice = 1: menu_value(1) = fleet_city(other_side(side)): GOTO admiral
		GOSUB nest: IF menu_choice > 0 GOTO admiral ELSE EXIT SUB
	END IF
	COLOR COLOR_LIGHT_CYAN: LOCATE 11, 68
	IF fleet_city(side) < 41 THEN
		PRINT city_name$(fleet_city(side))
	ELSE
		PRINT "Raiding"
	END IF
	menu_text$(0) = "To"
	menu_color = COLOR_CYAN: menu_col = PANEL_COL: menu_row = 12
      
	CALL menu_select(MENU_CITY_POINTER): CALL clear_right_panel: IF menu_choice < 1 THEN EXIT SUB
admiral:
	IF menu_value(menu_choice) = fleet_city(side) THEN EXIT SUB
	IF menu_value(menu_choice) < 1 THEN EXIT SUB
	IF fleet_size(side) < 1 GOTO ships
	IF side = current_side THEN turn_navy_done = 1
	GOSUB box2
	LOCATE 10, 25: PRINT side_name$(side); " fleet of"; fleet_size(side); "ship(s) is sailing"
	LOCATE 11, 25: PRINT "From ";
	IF fleet_city(side) < 41 THEN
		PRINT city_name$(fleet_city(side));
	ELSE
		PRINT "Raiding";
	END IF
	PRINT " to ";
	IF menu_value(menu_choice) <> 99 THEN
		PRINT city_name$(menu_value(menu_choice));
	ELSE
		PRINT "Raid Commerce";
	END IF

	FOR i = 1 TO fleet_size(side)
		PSET (120 + 41 * i, 210), 0
		CALL draw_fleet_ship(side, i)
	NEXT i
	IF opt_graphics >= GRAPHICS_FULL THEN
		a = ASC(LEFT$(fleet_ships$(side), 1))
		SELECT CASE a
			CASE 73
				CALL draw_ironclad
			CASE 87
				CALL draw_schooner
		END SELECT
		wait_seconds 2 * opt_pause!
	ELSE
		wait_seconds opt_pause!
	END IF
	fleet_city(side) = menu_value(menu_choice)
	IF fleet_city(SIDE_UNION) = fleet_city(SIDE_REBEL) GOTO pirate
	GOTO sail3
'---------------------------------------------------------------------------
'                               Raid Commerce
'---------------------------------------------------------------------------
	CASE 4
	fleet_size(side) = LEN(fleet_ships$(side))
	IF fleet_size(side) < 1 AND action > 0 THEN EXIT SUB
	IF fleet_size(side) < 1 OR raiding_side = side GOTO ahoy

	IF side = current_side THEN turn_navy_done = 1
	GOSUB box2
	LOCATE 10, 25: PRINT side_name$(side); " fleet of"; fleet_size(side); "ship(s) is sailing"
	LOCATE 11, 25: PRINT "to RAID "; side_name$(other_side(side)); " COMMERCE !"

	FOR i = 1 TO fleet_size(side)
		PSET (120 + 41 * i, 210), 0
		CALL draw_fleet_ship(side, i)
	NEXT i
	IF opt_graphics >= GRAPHICS_FULL THEN
		a = ASC(LEFT$(fleet_ships$(side), 1))
		SELECT CASE a
			CASE 73
				CALL draw_ironclad
			CASE 87
				CALL draw_schooner
		END SELECT
		wait_seconds 2 * opt_pause!
	ELSE
		wait_seconds opt_pause!
	END IF
	fleet_city(side) = FLEET_AT_SEA: raiding_side = side
	IF fleet_city(SIDE_UNION) = fleet_city(SIDE_REBEL) GOTO pirate
	CLS : CALL draw_map
	EXIT SUB
'---------------------------------------------------------------------------
'                               Invasion
'---------------------------------------------------------------------------
	CASE 5
	CALL army_get_commander((side), empty)
	IF action > 0 AND empty = 0 THEN action = NAVY_SAIL: GOTO anchor
	x = 35
	CALL navy_remove_ship(side)
	c = fleet_city(side): CALL army_new((side), empty, c)
	side_cash(side) = side_cash(side) + COST_RECRUIT     'compensate for cost of recruiting new army
	CALL city_capture(empty, c, side, 0)
	army_size(empty) = x
	IF side = current_side THEN turn_navy_done = 1
	EXIT SUB
'---------------------------------------------------------------------------
'                               Exit
'---------------------------------------------------------------------------
	CASE ELSE
	EXIT SUB
END SELECT
GOTO ahoy
'---------------------------------------------------------------------------
'                               Ship vs. Ship
'---------------------------------------------------------------------------
pirate:
	CLS : LOCATE 1, 30: COLOR COLOR_LIGHT_CYAN: PRINT "NAVAL COMBAT"
	FOR k = SIDE_UNION TO SIDE_REBEL
	hit(k) = 10
	IF RIGHT$(fleet_ships$(k), 1) = "I" THEN hit(k) = 20
	NEXT k
cannon:
	LOCATE 9, 1: PRINT SPACE$(79)
	LOCATE 15, 1: PRINT SPACE$(79)
	x = 10: y = 100
	COLOR COLOR_LIGHT_BLUE: LOCATE 5, 25: PRINT "UNION"; fleet_size(SIDE_UNION); "ship(s)"
	GOSUB boxes
	COLOR COLOR_BLUE
	FOR i = 1 TO fleet_size(SIDE_UNION)
	x = x + 50: PSET (x, y)
	CALL draw_fleet_ship(SIDE_UNION, i)
	NEXT i
	COLOR COLOR_LIGHT_CYAN: LOCATE 11, 22: PRINT "CONFEDERATES "; fleet_size(SIDE_REBEL); "ship(s)"
	LINE (10, 180)-(530, 210), 1, BF
	LINE (10, 180)-(530, 210), 11, B
	x = 10: y = 200
	COLOR COLOR_BLUE
	FOR i = 1 TO fleet_size(SIDE_REBEL)
	x = x + 50: PSET (x, y)
	CALL draw_fleet_ship(SIDE_REBEL, i)
	NEXT i
	COLOR COLOR_LIGHT_CYAN
wave:
	menu_text$(0) = "Options"
	menu_text$(1) = "Attack"
	menu_text$(2) = "Retreat"
	IF action > 0 THEN menu_choice = 1: GOTO powder
      
	menu_item_count = 2: menu_color = COLOR_CYAN: menu_highlight = COLOR_YELLOW: menu_col = 50: menu_row = 18: CALL menu_select(MENU_PLAIN)
powder:
	SELECT CASE menu_choice
	 CASE 1
firemore:
	 IF opt_sound >= SOUND_EFFECTS THEN SOUND 77, .5: SOUND 59, .5: CALL wait_seconds(.1)
	 pct! = 0: a$ = RIGHT$(fleet_ships$(side), 1)
	 IF a$ <> RIGHT$(fleet_ships$(other_side(side)), 1) THEN
		IF a$ = "I" THEN pct! = .1 ELSE pct! = -.1
	 END IF
	 IF RND <= .5 + pct! GOTO hitem ELSE GOTO hitme1
	 GOTO firemore
hitem:
	 hit(other_side(side)) = hit(other_side(side)) - 1: GOSUB showhit: IF hit(other_side(side)) > 0 GOTO firemore
	 x = 10 + 50 * fleet_size(other_side(side))
	 y = 90: IF side = SIDE_UNION THEN y = 190
	 GOSUB xout
	 LOCATE 17, 5: PRINT side_name$(other_side(side)); " ship SUNK!": CALL wait_seconds(opt_pause! + 1): GOSUB clr1
	 CALL navy_remove_ship(other_side(side))
	 IF fleet_size(other_side(side)) < 1 THEN
		LOCATE 19, 5: COLOR COLOR_LIGHT_RED
		PRINT side_name$(other_side(side)); " fleet DEFEATED"
		CALL wait_seconds(opt_pause!)
		fleet_city(other_side(side)) = 0: fleet_ships$(other_side(side)) = ""
		side_victory_points(other_side(side)) = side_victory_points(other_side(side)) + 10
		IF side = current_side THEN fleet_pursuit = 1 ELSE fleet_pursuit = 0
		GOTO sail3
	 END IF
	 hit(other_side(side)) = 10
	 IF RIGHT$(fleet_ships$(other_side(side)), 1) = "I" THEN hit(other_side(side)) = 20
	 GOTO cannon
hitme1:
	 hit(side) = hit(side) - 1: GOSUB showhit: IF hit(side) > 0 GOTO firemore
	 x = 10 + 50 * fleet_size(side)
	 y = 190: IF side = SIDE_UNION THEN y = 90
	 GOSUB xout
	 LOCATE 17, 5: PRINT "One of the "; side_name$(side); " ships was SUNK!": CALL wait_seconds(opt_pause!): GOSUB clr1
	 CALL navy_remove_ship(side)
	 IF fleet_size(side) < 1 THEN
		LOCATE 19, 5: COLOR COLOR_LIGHT_RED
		PRINT "Attacking "; side_name$(side); " fleet has been ELIMINATED !"
		CALL wait_seconds(opt_pause!)
		fleet_city(side) = 0: fleet_ships$(side) = ""
		side_victory_points(side) = side_victory_points(side) + 10
		IF side <> current_side THEN fleet_pursuit = 1 ELSE fleet_pursuit = 0
		GOTO sail3
	 END IF
	 hit(side) = 10
	 IF RIGHT$(fleet_ships$(side), 1) = "I" THEN hit(side) = 20
	 GOTO cannon

	 CASE 2
	 target = 0
	 FOR i = 1 TO MAX_CITIES
	 IF city_owner(i) = side THEN IF i <> fleet_city(side) AND city_port_type(i) = PORT_SEA THEN target = i: IF RND > .3 GOTO found1
	 NEXT i
found1:
	 CALL clear_bottom_line: COLOR COLOR_LIGHT_CYAN: PRINT side_name$(side); " is retreating to "; city_name$(target); : CALL wait_seconds(opt_pause!)
	 fleet_city(side) = target
	 GOTO sail3
	 CASE ELSE
	 GOTO wave
	 END SELECT
	 GOTO pirate
'---------------------------------------------------------------------------
'                               Subs
'---------------------------------------------------------------------------
showhit:
	 LOCATE 9, 6 * fleet_size(SIDE_UNION): PRINT hit(SIDE_UNION); " ";
	 LOCATE 15, 6 * fleet_size(SIDE_REBEL): PRINT hit(SIDE_REBEL); " ";
	 IF opt_sound = SOUND_OFF THEN wait_seconds .1 * opt_pause!
	 RETURN
clr1:
	LOCATE 17, 1: PRINT SPACE$(60): RETURN
nest:
	best = 0: x = 0
	FOR i = 1 TO menu_item_count
	target = menu_value(i)
	IF city_owner(target) = SIDE_NONE GOTO neutral

	IF target = fleet_city(other_side(side)) THEN IF fleet_size(side) >= fleet_size(other_side(side)) AND RND > .1 THEN menu_choice = i: RETURN
	IF city_owner(target) <> side THEN
		best = i: x = x + 1
		IF RND > .8 THEN menu_choice = best: RETURN
	END IF
neutral:
	NEXT i
	IF best = 0 THEN
		menu_choice = 1 + INT(RND * menu_item_count)
	ELSE
		menu_choice = best
	END IF

	IF side = SIDE_REBEL AND fleet_city(SIDE_REBEL) = 30 THEN IF RND > .5 THEN menu_choice = 30: RETURN
	RETURN
boxes:
	LINE (10, 80)-(530, 110), 1, BF
	LINE (10, 80)-(530, 110), 11, B
	RETURN
box2:
	CLS
	LINE (100, 110)-(550, 240), 1, B
	LINE (95, 115)-(555, 235), 7, B
	RETURN
xout:
		PSET (x, y)
		DRAW "S5C15G5F5G3H5G5H3E5H5E3F5E5F3"
		PAINT (x - 3, y + 1), 12, 15
	RETURN
sail3:
	raiding_side = SIDE_NONE
	FOR k = SIDE_UNION TO SIDE_REBEL
	IF fleet_city(k) = FLEET_AT_SEA THEN raiding_side = k
	NEXT k
	CLS : CALL draw_map
END SUB
