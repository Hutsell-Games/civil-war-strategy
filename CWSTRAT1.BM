SUB animate_army (army, background_saved)
from = army_city(army): to2 = army_order(army): army_city(army) = 0
x = city_x(from) - 12
y = city_y(from) - 11
x1 = .5 * (city_x(to2) + city_x(from))
y1 = .5 * (city_y(to2) + city_y(from))

CALL city_update_occupier(from): IF city_army(from) > 0 THEN CALL draw_army_flag(city_army(from))
       
IF background_saved > 0 GOTO already
	GET (x - 9, y - 7)-(x + 9, y + 6), saved_under_army
	IF city_army(from) = 0 THEN LINE (x - 9, y - 8)-(x + 10, y + 8), 2, BF
already:

	FOR i = 2 TO 8
	x1 = .1 * (i * city_x(to2) + (10 - i) * city_x(from))
	y1 = .1 * (i * city_y(to2) + (10 - i) * city_y(from))
	GET (x1 - 10, y1 - 10)-(x1 + 9, y1 + 9), saved_under_marker
	PUT (x1 - 10, y1 - 10), saved_under_army, PSET
	IF opt_pause! > 1 THEN CALL wait_seconds(.1) ELSE CALL wait_seconds(.02)
	IF opt_sound > 0 THEN SOUND 200, .1: SOUND 50, .1
	PUT (x1 - 10, y1 - 10), saved_under_marker, PSET
	NEXT i
	army_city(army) = from
END SUB

SUB menu_army_move
CALL menu_army_select(index, target): IF target > 0 AND index > 0 GOTO tent
	IF index = -1 THEN turn_moves_done = 1
	GOTO dudd
tent:
menu_col = 67: menu_row = 12

CALL draw_army_stats(index)
COLOR 11: LOCATE 11, 68: PRINT city_name$(target)
menu_item_count = 0
menu_text$(0) = "To"
FOR i = 1 TO 6: IF matrix(target, i) > 0 THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(matrix(target, i)): menu_value(menu_item_count) = matrix(target, i)
NEXT i
CALL menu_bubble_sort(menu_item_count)

menu_highlight = 10: menu_color = 3: CALL menu_select(2): CALL clear_right_panel
IF menu_choice < 0 GOTO dudd
IF turn_month < 3 AND opt_winter_campaigns = 0 AND city_owner(menu_value(menu_choice)) <> current_side THEN COLOR 11: CALL clear_bottom_line: PRINT "No campaigns in January"; : CALL wait_seconds(9): CALL clear_bottom_line: GOTO dudd

CALL clear_bottom_line: PRINT "Army "; index; " "; army_name$(index); " is moving from "; city_name$(target); " to "; city_name$(menu_value(menu_choice));
IF opt_sound > 0 THEN SOUND 2200, .5: SOUND 2900, .7
CALL draw_map_marker(target, menu_value(menu_choice), 1)
army_order(index) = menu_value(menu_choice): CALL wait_seconds(opt_pause!): CALL clear_bottom_line
CALL clear_right_panel
dudd:
END SUB

SUB draw_army_stats (army)
LINE (530, 60)-(639, 150), 0, BF
COLOR 15
LOCATE 5, 68: PRINT army_name$(army)
COLOR 9: IF army > 20 THEN COLOR 7
LOCATE 6, 68: PRINT "Size:"; : CALL print_army_size(army)
LOCATE 7, 68: PRINT "Leader:"; TAB(75); army_leader_rating(army)
LOCATE 8, 68: PRINT "Exper:"; TAB(75); army_experience(army)
IF army_supply(army) < 2 THEN COLOR 12
LOCATE 9, 68: PRINT "Supply:"; TAB(75); army_supply(army)
END SUB

SUB navy_remove_ship (side)
fleet_size(side) = fleet_size(side) - 1
IF fleet_size(side) > 0 THEN
	fleet_ships$(side) = LEFT$(fleet_ships$(side), fleet_size(side))
ELSE
	fleet_ships$(side) = "": fleet_city(side) = 0: fleet_size(side) = 0
END IF
END SUB

SUB calculate_battle (attacker, defender, winner, loser)
IF army_size(defender) < 1 THEN army_size(defender) = 1
IF army_size(attacker) < 1 THEN army_size(attacker) = 1

CALL draw_map_marker(army_city(defender), 0, 9)
LOCATE 1, 1: PRINT SPACE$(80)
CALL clear_right_panel: y = 68: COLOR 11: LOCATE 1, y: PRINT "Attacker"
c = 9: IF attacker > 20 THEN c = 7
COLOR c: LOCATE 2, y: PRINT army_name$(attacker)
LOCATE 3, y: CALL print_army_size(attacker)
x = .01 * army_size(attacker): IF x > rule_strength_cap THEN x = rule_strength_cap
LOCATE 4, y: PRINT "Base    "; x
IF army_size(attacker) / army_size(defender) > .2 THEN x = x + .3 * army_leader_rating(attacker) + .3 * army_experience(attacker): IF x > rule_strength_cap THEN x = rule_strength_cap
IF army_experience(attacker) > 8 THEN x = x + 1: IF x > rule_strength_cap THEN x = rule_strength_cap
LOCATE 5, y: PRINT "Ldr/Exp "; x
IF army_size(attacker) < 15 THEN x = .5 * x: IF x > rule_strength_cap THEN x = rule_strength_cap
LOCATE 6, y: PRINT "Small   "; x
IF army_size(attacker) / army_size(defender) <= .5 THEN x = x - 2: IF x < 1 THEN x = 1
IF army_size(attacker) / army_size(defender) > 3 THEN x = x + 2: IF x > rule_strength_cap THEN x = rule_strength_cap
IF army_size(attacker) / army_size(defender) > 10 THEN x = rule_strength_cap
IF army_size(attacker) / army_size(defender) <= .2 THEN x = 1
LOCATE 7, y: PRINT "Outman  "; x
IF army_supply(attacker) < 1 THEN x = .5 * x: COLOR 13
LOCATE 8, y: PRINT "Supply  "; x: COLOR c
IF x < 1 THEN x = 1
'                       Adjust attack advantage
IF attacker < 21 AND current_side = 2 AND opt_difficulty > 3 THEN x = x + 2 * opt_difficulty - 6
IF attacker > 20 AND current_side = 1 AND opt_difficulty < 3 THEN x = x + 6 - 2 * opt_difficulty
LOCATE 9, y: PRINT "Difclt  "; x
IF x > rule_strength_cap THEN x = rule_strength_cap
COLOR 11: LOCATE 11, y: PRINT "Attack  "; x
LINE (530, 155)-(635, 175), 11, B

x1 = .013 * army_size(defender) + 1: IF opt_realism = 1 THEN x1 = .02 * army_size(defender) + 2: IF x1 > 20 THEN x1 = 20
LOCATE 13, y: PRINT "Defender"
COLOR 16 - c: LOCATE 14, y: PRINT army_name$(defender)
LOCATE 15, y: CALL print_army_size(defender)
LOCATE 16, y: PRINT "Base    "; INT(.01 * army_size(defender))
LOCATE 17, y: PRINT "Defense "; x1
IF army_size(defender) / army_size(attacker) > .2 THEN x1 = x1 + .3 * army_leader_rating(defender) + .3 * army_experience(defender): IF x1 > rule_strength_cap THEN x1 = rule_strength_cap
IF army_experience(defender) > 8 THEN x1 = x1 + 1: IF x1 > rule_strength_cap THEN x1 = rule_strength_cap
LOCATE 18, y: PRINT "Ldr/Exp "; x1
IF army_size(defender) < 15 THEN x1 = .5 * x1
LOCATE 19, y: PRINT "Small   "; x1

R! = army_size(defender) / army_size(attacker)
SELECT CASE R!
	CASE IS > 10
		x1 = rule_strength_cap
	CASE IS > 1.5
		x1 = x1 + 2
	CASE IS < .5
		x1 = .8 * x1
	CASE IS < .2
		x1 = .5 * x1
END SELECT
	IF x1 < 1 THEN x1 = 1
	IF x1 > rule_strength_cap THEN x1 = rule_strength_cap

LOCATE 20, y: PRINT "Outman  "; x1
IF army_supply(defender) < 1 THEN x1 = .5 * x1: COLOR 13
LOCATE 21, y: PRINT "Supply  "; x1: COLOR 16 - c
IF x1 < 1 THEN x1 = 1
'                       Adjust defend advantage
IF defender < 21 AND current_side = 2 AND opt_difficulty > 3 THEN x1 = x1 + 2 * opt_difficulty - 6
IF defender > 20 AND current_side = 1 AND opt_difficulty < 3 THEN x1 = x1 + 6 - 2 * opt_difficulty
LOCATE 22, y: PRINT "Difclt  "; x1

a$ = "Fort": IF army_order(defender) = 0 THEN x1 = x1 * (1 + city_fort(army_city(defender)))
IF x1 > rule_strength_cap THEN x1 = rule_strength_cap
IF city_fort(army_city(defender)) > 0 AND army_order(defender) = 0 THEN
	COLOR 13: a$ = "Fort+"
	IF city_fort(army_city(defender)) = 2 THEN a$ = "Fort++"
END IF
LOCATE 23, y: PRINT a$; TAB(76); x1
IF x1 > rule_strength_cap THEN x1 = rule_strength_cap
COLOR 11: LOCATE 25, y: PRINT "Defend  "; x1
LINE (530, 380)-(635, 400), 11, B

spin = 0
scale = x: IF x1 > scale THEN scale = x1
scale = scale + 1

odds! = x / (x + x1): a = INT(100 * odds!): IF a < 1 THEN a = 1
a$ = LTRIM$(RTRIM$(STR$(a))) + "%"
COLOR 14: LOCATE 27, y: PRINT "Odds:  "; a$;
LINE (530, 412)-(635, 435), 14, B
LINE (528, 410)-(637, 437), 14, B
CALL script_mark_key_wait(1, "P"): DO WHILE INKEY$ = "": LOOP
IF opt_graphics > 2 THEN
	CALL draw_cannon
	k = city_fort(army_city(defender))
	t$ = GFXDIR + "fort" + LTRIM$(STR$(k)) + ".vga"
	IF LEN(DIR$(t$)) > 0 THEN
		DEF SEG = VARSEG(pic_loaded(1))
		BLOAD t$, VARPTR(pic_loaded(1))
		DEF SEG
		PUT (550, 270), pic_loaded, PSET
	END IF
ELSE
	CALL clear_right_panel
END IF
FOR i = 1 TO 2: IF army_supply(i) > 0 THEN army_supply(i) = army_supply(i) - 1
NEXT i
'---------------------------------------------------------------------------
grapple:
hit = 0: hit1 = 0
star = scale * RND: fin = scale * RND
IF opt_sound > 0 THEN SOUND 77, .5: SOUND 59, .5: CALL wait_seconds(.1)
IF star <= x THEN hit = 1
IF fin <= x1 THEN hit1 = 1

IF hit = 0 AND hit1 = 0 GOTO grapple
IF hit = 1 AND hit1 = 1 GOTO grapple
winner = defender: loser = attacker: IF hit = 1 THEN winner = attacker: loser = defender
'---------------------------------------------------------------------------
a$ = "UNION": IF winner > 20 THEN a$ = "REBEL"
COLOR 14: LOCATE 3, 68: PRINT a$; " VICTORY"
LOCATE 4, 71: PRINT "in"
LOCATE 5, 69: PRINT city_name$(army_city(defender))
a = 1: IF winner > 20 THEN a = 2
CALL draw_flag(a, 0, 0)
CALL clear_bottom_line: COLOR 11: PRINT army_name$(winner); " defeats "; army_name$(loser); " in "; city_name$(army_city(defender)); : CALL wait_seconds(9)
'===========================================================================
pct! = .01 * rule_defend_loss - .03 * city_fort(army_city(defender)): IF winner = attacker THEN pct! = 1.3 * pct!
SELECT CASE army_size(defender)
	CASE IS > 300
		pct! = .9 * pct!
	CASE IS > 800
		pct! = .8 * pct!
END SELECT
xbar = army_size(attacker) * pct!
vary = xbar * (1 - pct!)
CALL normal_random_number(xbar, vary, killd)
'...........................................................................
pct! = .01 * rule_attack_loss + .02 * city_fort(army_city(defender)): IF winner = defender THEN pct! = 1.5 * pct!
SELECT CASE army_size(attacker)
	CASE IS > 300
		pct! = .9 * pct!
	CASE IS > 800
		pct! = .8 * pct!
END SELECT
xbar = army_size(defender) * pct!
vary = xbar * (1 - pct!)
CALL normal_random_number(xbar, vary, killa)
'===========================================================================

killa = .8 * killa + .2 * killd: IF killa < 1 THEN killa = 1
killd = .8 * killd + .2 * killa: IF killd < 1 THEN killd = 1
IF killa > 9 * killd THEN killa = 9 * killd
IF killd > 5 * killa THEN killd = 5 * killa

IF killa >= army_size(attacker) THEN killa = army_size(attacker) - 1
IF killd >= army_size(defender) THEN killd = army_size(defender) - 1
'---------------------------------------------------------------------------
x = INT(100 * odds!): IF x < 1 THEN x = 1
a$ = LTRIM$(RTRIM$(STR$(x))) + "%"

COLOR c
LOCATE 1, 1: PRINT "Attack Loss: ";
PRINT LTRIM$(RTRIM$(STR$(killa)) + "00"); "/";
CALL print_army_size(attacker)
PRINT " ("; LTRIM$(RTRIM$(STR$(INT(100 * (killa / army_size(attacker)))))); "%) ฒ";
COLOR 16 - c: PRINT "ฒ Defend Loss: "; : PRINT LTRIM$(RTRIM$(STR$(killd)) + "00"); "/";
CALL print_army_size(defender)
PRINT " ("; LTRIM$(RTRIM$(STR$(INT(100 * (killd / army_size(defender)))))); "%)"
'---------------------------------------------------------------------------
menu_text$(1) = " (" + LTRIM$(RTRIM$(STR$(killa) + "00")) + "/" + LTRIM$(STR$(army_size(attacker)) + "00") + ") "
t$ = " (" + LTRIM$(RTRIM$(STR$(killd) + "00")) + "/" + LTRIM$(STR$(army_size(defender)) + "00") + ")"
menu_text$(2) = t$
IF winner = defender THEN menu_text$(2) = menu_text$(1): menu_text$(1) = t$
menu_text$(3) = "*" + army_name$(winner): menu_text$(4) = army_name$(loser)
IF winner = defender THEN menu_text$(3) = army_name$(winner): menu_text$(4) = "*" + army_name$(loser)
a$ = city_name$(army_city(defender)) + ": " + menu_text$(3) + menu_text$(1) + " defeats " + menu_text$(4) + menu_text$(2)
CALL scribe_message(a$, 0)

IF opt_players = 1 AND (current_side = 1 AND attacker > 20) OR (current_side = 2 AND attacker < 21) THEN
COLOR 14: CALL clear_bottom_line: PRINT "hit any key to continue"; : CALL script_mark_key_wait(1, "B"): DO WHILE INKEY$ = "": LOOP
END IF

army_size(attacker) = army_size(attacker) - killa
army_size(defender) = army_size(defender) - killd
IF army_size(defender) < 1 THEN army_size(defender) = 1
'---------------------------------------------------------------------------
s = 1: IF attacker > 2 THEN s = 2
side_casualties&(s) = side_casualties&(s) + killa
side_casualties&(3 - s) = side_casualties&(3 - s) + killd
'---------------------------------------------------------------------------
s = 1: IF winner > 20 THEN s = 2
side_battles_won(s) = side_battles_won(s) + 1
side_victory_points(s) = side_victory_points(s) + 1
CALL draw_map_marker(army_city(defender), 0, 8)
END SUB

SUB army_combine (side)
	menu_color = 3: target = 0: menu_highlight = 3
	menu_col = 67: menu_row = 2
	CALL side_army_range(star, fin, side)
	menu_item_count = 0
	FOR i = 1 TO 40
		IF city_owner(i) = side AND city_army(i) > 0 THEN
			FOR j = star TO fin
			IF army_city(j) = i AND city_army(i) <> j AND army_order(j) = 0 THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(i): menu_value(menu_item_count) = i: EXIT FOR
			NEXT j
		END IF
	NEXT i
	
	IF menu_item_count = 0 THEN side = -1: EXIT SUB
	CALL menu_bubble_sort(menu_item_count)

	IF side <> current_side THEN menu_choice = 1 + INT(menu_item_count * RND): GOTO join
	menu_text$(0) = "Join"
		menu_choice = 31: menu_highlight = 11
		CALL menu_select(9): CALL clear_right_panel
join:
		IF menu_choice < 1 GOTO nocity2
		target = menu_value(menu_choice)
		CALL clear_bottom_line: PRINT "Combining "; side_name$(side); " armies in "; city_name$(target); :  CALL wait_seconds(opt_pause!)

		army_size(0) = 0: army_leader_rating(0) = 0: army_experience(0) = 0: army_city(0) = target
		army_name$(0) = "": army_supply(0) = 0: army_order(0) = 0
'...........................................................................
		best = 0: x = 0: spin = 0
		FOR j = star TO fin
		IF army_order(j) <> 0 OR army_city(j) <> target OR army_size(j) = 0 GOTO dork1
		IF army_size(0) + army_size(j) > 1250 THEN CALL clear_bottom_line: PRINT "Cannot combine "; army_name$(j); "... TOO LARGE"; : CALL wait_seconds(opt_pause!): GOTO dork1

		IF army_leader_rating(j) > x THEN
			x = army_leader_rating(j)
			army_name$(0) = army_name$(j)
			army_leader_rating(0) = army_leader_rating(j)
			best = j
		END IF

		army_size(0) = army_size(0) + army_size(j)
		IF army_size(0) < 1 GOTO dork1
		pct! = (army_size(j) / army_size(0))
		spin = spin + 1
		army_experience(0) = (1 - pct!) * army_experience(0) + pct! * army_experience(j)
		CALL clear_bottom_line: PRINT army_name$(j); " is combining his "; : CALL print_army_size(j): PRINT " forces"; : CALL wait_seconds(opt_pause!)
		army_supply(0) = army_supply(0) + army_supply(j)
		IF army_supply(0) > 10 THEN army_supply(0) = 10
		army_size(j) = 0: army_city(j) = 0: army_experience(j) = 0: army_order(j) = 0
		leader_name$(j) = army_name$(j)
		army_leader_rating(j) = 0: army_supply(j) = 0: army_name$(j) = ""
dork1:
		NEXT j

		CALL clear_bottom_line
		IF side <> current_side AND spin = 0 THEN EXIT SUB
		IF spin = 0 THEN
				PRINT "No valid armies to combine at this time in "; city_name$(target);
				wait_seconds opt_pause!
				EXIT SUB
		END IF
		army_size(best) = army_size(0): army_leader_rating(best) = army_leader_rating(0)
		army_experience(best) = army_experience(0): army_supply(best) = army_supply(0)
		army_city(best) = target
		army_name$(best) = army_name$(0)
		leader_name$(best) = ""
		IF spin > 1 THEN
		PRINT "New army "; best; " of "; : CALL print_army_size(best): PRINT " is commanded by "; army_name$(best);
		army_order(best) = -1
		ELSE
		PRINT "Only 1 eligible army -- cannot combine at this time";
		END IF
		IF side = current_side THEN CALL wait_seconds(opt_pause!)
		IF opt_sound > 0 THEN SOUND 4000, .7
	       
		CALL draw_cities
		CALL draw_army_flag(best)
		CALL draw_map_marker(target, 0, 6)
		city_army(target) = best
		CALL draw_stack_markers(side)
nocity2:
END SUB

SUB city_is_connected (side, city, a)
a = 0
FOR j = 1 TO 6
y = matrix(city, j)
IF y > 0 AND city_owner(y) = side THEN a = a + 1
NEXT j
END SUB

SUB file_management (job)
SELECT CASE job
	CASE 1
	OPEN "I", 1, SCNDIR + "cwslead.dat"
	FOR i = 1 TO 40: INPUT #1, leader_name$(i), leader_rating(i): NEXT i
	CLOSE #1
	OPEN "I", 1, SCNDIR + "cws.ini"
	FOR i = 0 TO 2: INPUT #1, side_name$(i): NEXT i
	FOR i = 1 TO 12: INPUT #1, month_name$(i): NEXT i
	INPUT #1, turn_month, turn_year
'               set end game conditions
	FOR i = 1 TO 6: INPUT #1, victory_rule(i): NEXT i
	victory_rule(3) = .4 * victory_rule(3)
	INPUT #1, a             ' number of Yankee armies
FOR i = 1 TO a
	INPUT #1, army_city(i), army_size(i), army_experience(i), army_supply(i): city_army(army_city(i)) = i: army_name$(i) = leader_name$(i): army_leader_rating(i) = leader_rating(i): leader_name$(i) = ""
NEXT i
	INPUT #1, a             ' number of Rebel armies
FOR i = 21 TO 20 + a
	INPUT #1, army_city(i), army_size(i), army_experience(i), army_supply(i)
	city_army(army_city(i)) = i: army_name$(i) = leader_name$(i): army_leader_rating(i) = leader_rating(i): leader_name$(i) = ""
NEXT i
FOR i = 1 TO 2: INPUT #1, side_cash(i): NEXT i
	INPUT #1, rule_attack_loss, rule_defend_loss, rule_strength_cap
	INPUT #1, fleet_ships$(1), fleet_city(1), fleet_ships$(2), fleet_city(2)
	FOR k = 1 TO 2: fleet_size(k) = LEN(fleet_ships$(k)): NEXT k
	INPUT #1, side_capital(1), side_capital(2)

FOR i = 1 TO 8: INPUT #1, flag_star_x(i), flag_star_y(i): NEXT i  ' star locations on flag
	CLOSE #1
	OPEN "I", 1, "cws.cfg"
	INPUT #1, current_side, opt_graphics, opt_sound, opt_difficulty, opt_players, opt_pause!, opt_event_balance, train_capacity(1), train_capacity(2), opt_winter_campaigns, opt_realism, side_battles_won(1), side_battles_won(2), side_casualties&(1), side_casualties&(2), opt_history, opt_ai_aggression
	CLOSE #1

	CASE 2
	IF LEN(DIR$("*.sav")) = 0 THEN menu_choice = -1: EXIT SUB
	menu_text$(0) = "Load"
	menu_item_count = 0
	FOR k = 1 TO 9
		t$ = "cws" + LTRIM$(STR$(k)) + ".sav"
		IF LEN(DIR$(t$)) > 0 THEN
			menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = t$: menu_value(menu_item_count) = k
		END IF
	NEXT k
	CALL menu_bubble_sort((menu_item_count))
	menu_col = 67: menu_row = 14 - .5 * menu_item_count
	CALL menu_select(0)
	CALL clear_right_panel
	IF menu_choice < 1 THEN EXIT SUB
	OPEN "I", 1, "cws" + LTRIM$(STR$(menu_value(menu_choice))) + ".sav"
	COLOR 11: CALL clear_bottom_line: PRINT "Loading";
	INPUT #1, turn_month, turn_year, union_income_bonus, a
	FOR i = 1 TO 40: INPUT #1, army_name$(i), army_size(i), army_leader_rating(i), army_city(i), army_experience(i), army_supply(i), army_order(i)
	IF army_city(i) > 0 THEN
		IF army_name$(i) = leader_name$(i) THEN
			leader_name$(i) = ""
		ELSE
			who = 1: IF i > 20 THEN who = 2
			CALL side_army_range(star, fin, who)
			FOR k = star TO fin
			IF army_name$(i) = leader_name$(k) THEN leader_name$(k) = "": EXIT FOR
			NEXT k
		END IF
	END IF
	NEXT i
	FOR i = 1 TO 40: INPUT #1, city_army(i), city_owner(i), city_fort(i): PRINT "."; : NEXT i
	FOR i = 1 TO 2: INPUT #1, side_cash(i), side_city_count(i), side_income(i), side_victory_points(i), side_capital(i)
	INPUT #1, fleet_ships$(i), fleet_city(i), navymove(i), train_army(i), train_city(i)
	fleet_size(i) = LEN(fleet_ships$(i))
	NEXT i
       
	CLOSE #1
	OPEN "I", 1, "cws.cfg"
	INPUT #1, myside, opt_graphics, opt_sound, opt_difficulty, opt_players, opt_pause!, opt_event_balance, train_capacity(1), train_capacity(2), opt_winter_campaigns, opt_realism, side_battles_won(1), side_battles_won(2), side_casualties&(1), side_casualties&(2), opt_history, opt_ai_aggression
	CLOSE #1
	SCREEN 12: CLS
	CLOSE #1: CALL draw_map: CALL clear_bottom_line
	FOR k = 1 TO 2
	IF train_army(k) > 0 THEN CALL draw_train(k, 1)
	NEXT k
	current_side = a

	CASE 3
	menu_text$(0) = "Save Game"
	FOR k = 1 TO 9
	menu_text$(k) = "cws" + LTRIM$(STR$(k)) + ".sav"
	IF LEN(DIR$(menu_text$(k))) > 0 THEN menu_text$(k) = menu_text$(k) + " ๛"
	NEXT k
	menu_col = 67: menu_item_count = 9
	CALL menu_select(0)
	IF menu_choice < 1 THEN clear_right_panel: EXIT SUB
	COLOR 11: CALL clear_bottom_line: PRINT "Saving";

	OPEN "O", 1, "cws" + LTRIM$(STR$(menu_choice)) + ".sav"
	WRITE #1, turn_month, turn_year, union_income_bonus, current_side
	FOR i = 1 TO 40: WRITE #1, army_name$(i), army_size(i), army_leader_rating(i), army_city(i), army_experience(i), army_supply(i), army_order(i)
	NEXT i
	FOR i = 1 TO 40: WRITE #1, city_army(i), city_owner(i), city_fort(i): PRINT "."; : NEXT i
	FOR i = 1 TO 2: WRITE #1, side_cash(i), side_city_count(i), side_income(i), side_victory_points(i), side_capital(i)
	WRITE #1, fleet_ships$(i), fleet_city(i), navymove(i), train_army(i), train_city(i)
	NEXT i
	CLOSE #1
       
	myside = current_side
	IF myside < 1 OR myside > 2 THEN myside = 1
	OPEN "O", 1, "cws.cfg"
	WRITE #1, myside, opt_graphics, opt_sound, opt_difficulty, opt_players, opt_pause!, opt_event_balance, train_capacity(1), train_capacity(2), opt_winter_campaigns, opt_realism, side_battles_won(1), side_battles_won(2), side_casualties&(1), side_casualties&(2), opt_history, opt_ai_aggression
	CLOSE #1
	CLS : CALL draw_map
END SELECT
END SUB

SUB animate_city (city)
FOR c = 1 TO 15 STEP 2
CIRCLE (city_x(city), city_y(city)), 4, 0
CIRCLE (city_x(city), city_y(city)), 3, c
PAINT (city_x(city), city_y(city)), c, c
CALL wait_seconds(.1)
NEXT c
c = 9: IF city_owner(city) = 2 THEN c = 7
IF city_owner(city) = 0 THEN c = 12
CIRCLE (city_x(city), city_y(city)), 4, 0
CIRCLE (city_x(city), city_y(city)), 3, c
PAINT (city_x(city), city_y(city)), c, c
END SUB

SUB menu_city_fortify (city)
	city = 0: menu_highlight = 11
	menu_col = 67: menu_row = 2
	who = current_side
	CALL side_army_range(star, fin, who)
	menu_item_count = 0
	FOR i = star TO fin
	IF army_city(i) > 0 AND city_fort(army_city(i)) < 2 THEN
		menu_item_count = menu_item_count + 1
		menu_text$(menu_item_count) = city_name$(army_city(i))
		menu_value(menu_item_count) = army_city(i)
	END IF
	NEXT i
	IF menu_item_count = 0 THEN CALL clear_bottom_line: COLOR 11: PRINT "No cities eligible to fortify"; : EXIT SUB
	CALL menu_bubble_sort(menu_item_count)
	menu_text$(0) = "Fortify"
		menu_choice = 31
		CALL menu_select(9): CALL clear_right_panel
		IF menu_choice < 0 GOTO nocity
		city = menu_value(menu_choice): CALL city_update_occupier(city): x = city_army(city): IF x < 0 GOTO nocity
		IF city_fort(city) > 1 THEN CALL clear_bottom_line: PRINT city_name$(city); " at MAXIMUM fortification level of 2"; : CALL wait_seconds(4): GOTO nocity
		cost = 200
		IF side_cash(current_side) < cost THEN CALL clear_bottom_line: PRINT "Fortifications for "; city_name$(city); " cost "; cost; " and you only have "; side_cash(current_side); : CALL wait_seconds(4): GOTO nocity
		COLOR 3
		city_fort(city) = city_fort(city) + 1
		side_cash(current_side) = side_cash(current_side) - cost
		CALL clear_bottom_line: PRINT city_name$(city); " fortifications increased to "; city_fort(city);
		CALL draw_map_marker(city, 0, 6)
		CALL draw_cities
		IF army_order(x) > 0 THEN CALL draw_map_marker(army_city(x), army_order(x), 5)
		army_order(x) = -1
		CALL draw_army_flag(x)
		CALL draw_stack_markers(who)
nocity:
END SUB

SUB draw_map_marker (from_city, to_city, mark)
IF from_city < 1 OR from_city > 40 GOTO noshow
IF to_city < 0 GOTO noshow
IF from_city = 999 GOTO noshow
x = city_x(from_city) - 12: y = city_y(from_city) - 11
x1 = city_x(to_city): y1 = city_y(to_city)
SELECT CASE mark
	CASE 1
	LINE (x, y)-(x1, y1), 15, , &HF0F0
       
	CASE 2
	FOR i = 6 TO 8
	LINE (x - i, y - i + 3)-(x + i, y + i - 3), 14, B
	NEXT i
	CALL wait_seconds(.1)
       
	CASE 3
	x = city_x(from_city): y = city_y(from_city)
	CALL screen_snapshot(x, y, 0)
	FOR j = 1 TO 3
	FOR i = 4 TO 10 STEP 1
	CIRCLE (x, y), i, 4
	PAINT (x, y), 14, 4
	IF opt_sound > 0 THEN SOUND 37 + 50 * RND, .03
	NEXT i
	CALL wait_seconds(.1)
	CALL screen_snapshot(x, y, 1)
	NEXT j
       
	CASE 4
	IF city_army(from_city) = 0 THEN LINE (x - 8, y - 6)-(x + 10, y + 8), 2, BF
	IF x1 + y1 > 0 THEN LINE (x, y)-(x1, y1), 2, , &HF0F0
	IF from_city = 27 OR from_city = 28 THEN CALL draw_map_touchup

	CASE 5
	IF x1 + y1 > 0 THEN LINE (x, y)-(x1, y1), 2, , &HF0F0

	CASE 6
	x = city_x(from_city): y = city_y(from_city)
	CALL screen_snapshot(x, y, 0)
	LINE (x - 9, y - 9)-(x + 9, y + 9), 15, B
	LINE (x - 10, y - 10)-(x + 10, y + 10), 15, B
	IF opt_sound > 0 THEN SOUND 3999, .3
	CALL wait_seconds(opt_pause! - .5)
	CALL screen_snapshot(x, y, 1)
	CASE 7          ' draw white box
	x = city_x(from_city) - 12: y = city_y(from_city) - 11
	GET (x - 8, y - 8)-(x + 8, y + 8), saved_under_marker
	LINE (x - 7, y - 7)-(x + 7, y + 7), 15, B
	LINE (x - 8, y - 6)-(x + 8, y + 6), 15, B
	     CASE 8     ' replace old image
	x = city_x(from_city) - 12: y = city_y(from_city) - 11
	IF x > 0 THEN PUT (x - 8, y - 8), saved_under_marker, PSET
       
	CASE 9          ' draw arrow pointer
	x = city_x(from_city) - 12: y = city_y(from_city) - 11
	GET (x - 8, y - 8)-(x + 10, y + 7), saved_under_marker
	x = x + 7: y = y + 5
	LINE (x + 2, y)-(x + 2, y - 8), 12
	LINE -(x, y - 6), 12
	LINE -(x - 5, y - 11), 12
	LINE -(x - 10, y - 6), 12
	LINE -(x - 6, y - 2), 12
	LINE -(x - 10, y), 12
	LINE -(x + 1, y), 12
	PAINT (x - 2, y - 1), 15, 12

	CASE 11
	LINE (x + 12, y + 11)-(x1, y1), 0, , &H1111

	CASE ELSE
END SELECT
noshow:
END SUB

SUB turn_date_and_supply
'---------------------------------------------------------------------------
FOR i = 1 TO 40: IF army_city(i) > 0 THEN CALL draw_army_flag(i)
NEXT i
'---------------------------------------------------------------------------
turn_month = turn_month + 2
IF turn_month > 12 THEN turn_month = 1: turn_year = turn_year + 1
'---------------------------------------------------------------------------
s = 1
FOR i = 1 TO 40: IF army_city(i) < 1 GOTO rip
IF i > 20 THEN s = 2
IF side_cash(s) >= .2 * army_size(i) THEN
	a = 1: IF opt_realism > 0 THEN CALL city_is_connected(s, army_city(i), a)
	IF a > 0 THEN
		army_supply(i) = army_supply(i) + 1
		side_cash(s) = side_cash(s) - .2 * army_size(i)
	END IF
END IF
IF (turn_month < 7 OR turn_month > 10) AND matrix(army_city(i), 7) < 99 THEN army_supply(i) = army_supply(i) - 1
IF matrix(army_city(i), 7) = 99 AND fleet_city(3 - s) = army_city(i) THEN army_supply(i) = army_supply(i) - 1: CALL clear_bottom_line: PRINT army_name$(i); " is blockaded"; : CALL wait_seconds(opt_pause!)
COLOR 13
IF army_supply(i) < 1 THEN
	army_supply(i) = 0
	CALL clear_bottom_line
	PRINT army_name$(i); " is out of supplies";
	CALL draw_army_flag(i)
	CALL wait_seconds(opt_pause!)
	IF RND > .8 AND army_size(i) > 50 THEN army_size(i) = .9 * army_size(i)
END IF
rip:
NEXT i
FOR k = 1 TO 2: CALL draw_stack_markers(k): NEXT k
y = 0: FOR i = 1 TO 20: y = y + .1 * army_size(i): NEXT i
x = 0: FOR i = 21 TO 40: x = x + .1 * army_size(i): NEXT i
IF current_side = 2 AND x > 0 THEN ai_strength_ratio! = y / x ELSE ai_strength_ratio! = 1
IF current_side = 1 AND y > 0 THEN ai_strength_ratio! = x / y ELSE IF current_side = 1 THEN ai_strength_ratio! = 1
END SUB

SUB menu_army_select (army, city)
	menu_color = 3: menu_col = 67: menu_row = 5: army = 0: menu_item_count = 0: city = 0
	who = current_side: CALL side_army_range(star, fin, who)
	FOR i = star TO fin
	IF army_city(i) > 0 AND army_order(i) = 0 THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(army_city(i)): menu_value(menu_item_count) = army_city(i)
	NEXT i
	IF menu_item_count = 0 THEN army = -1: GOTO notarg
	menu_text$(0) = "From"
	CALL menu_bubble_sort(menu_item_count)
movopt:
	menu_col = 67: menu_row = 5
		menu_highlight = 15: CALL menu_select(1): CALL clear_right_panel
		IF menu_choice < 0 THEN city = 0: GOTO notarg
		city = menu_value(menu_choice)

		menu_item_count = 0
		FOR i = star TO fin
		IF army_city(i) = city AND army_order(i) = 0 THEN army = i: menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = "Army" + STR$(i): menu_value(menu_item_count) = i
		NEXT i
		IF menu_item_count = 1 GOTO notarg
		menu_text$(0) = "Which"
		CALL menu_bubble_sort(menu_item_count)
		menu_col = 67: menu_row = 15: CALL menu_select(4): CALL clear_right_panel
		IF menu_choice < 0 THEN army = 0: GOTO notarg
		army = menu_value(menu_choice)
notarg:
END SUB

SUB navy_commands (side, action)
DIM hit(2)
IF action > 0 THEN
	IF fleet_city(side) < 1 THEN
		action = 1
	ELSE
		IF raiding_side = 3 - side AND raid_loss > 0 THEN action = 4
		IF fleet_pursuit > 0 THEN action = 3
	END IF
END IF
COLOR 11
ahoy:
cost = 100: city_owner(0) = side
IF action = 0 THEN CALL clear_bottom_line: PRINT "Funds available "; side_cash(side);
IF action = 1 THEN
	IF side_cash(side) < cost THEN EXIT SUB
	IF fleet_size(side) > 9 THEN EXIT SUB
END IF
menu_text$(0) = "Ships"
menu_text$(1) = "Build"
IF fleet_city(side) <> 99 THEN
IF side_cash(side) < cost OR fleet_size(side) > 9 OR city_owner(fleet_city(side)) <> side THEN menu_text$(1) = "-": menu_choice = 23
END IF
menu_text$(2) = "Attack"
IF fleet_city(side) <> 99 THEN
IF city_owner(fleet_city(side)) <> 3 - side THEN menu_text$(2) = "-": menu_choice = 22
ELSE
menu_text$(1) = "-": menu_text$(2) = "-": menu_choice = 24
END IF
menu_text$(3) = "Sail": IF fleet_city(side) < 1 THEN menu_text$(3) = "-": IF action = 3 THEN action = 1
menu_text$(4) = "Raid": IF fleet_size(side) < 1 OR raiding_side = side THEN menu_text$(4) = "-"
menu_col = 67: menu_row = 12: menu_item_count = 4
IF fleet_city(side) <> 99 THEN
IF side = 1 AND fleet_size(side) > 1 AND city_owner(fleet_city(side)) = 0 THEN menu_item_count = 5: menu_text$(5) = "Invasion": CALL city_nearby_enemy_strength(fleet_city(1), defend): IF action > 0 AND defend < 100 THEN action = 5
IF opt_realism = 0 AND side = 2 AND fleet_size(side) > 1 AND city_owner(fleet_city(side)) = 0 THEN menu_item_count = 5: menu_text$(5) = "Invasion": CALL city_nearby_enemy_strength(fleet_city(1), defend): IF action > 0 AND defend < 100 THEN action = 5
END IF

IF action > 0 THEN menu_choice = action: GOTO anchor
IF turn_navy_done > 0 AND menu_choice <> 1 THEN EXIT SUB
CALL menu_select(0): CALL clear_right_panel
anchor:
'---------------------------------------------------------------------------
SELECT CASE menu_choice
'---------------------------------------------------------------------------
'                               Build Ship
'---------------------------------------------------------------------------
	CASE 1
	IF side_cash(side) < cost OR fleet_city(side) = 99 GOTO ahoy
	IF action = 1 AND fleet_size(side) > 9 THEN EXIT SUB
	IF action = 0 AND fleet_size(side) > 9 THEN GOTO ahoy

	IF action = 0 AND fleet_city(side) > 0 THEN
		IF city_owner(fleet_city(side)) <> side GOTO ahoy
		IF matrix(fleet_city(side), 7) < 99 GOTO ahoy
	END IF
	IF action = 1 AND RND < .07 * fleet_size(side) THEN EXIT SUB
	a$ = "W"

	IF opt_realism > 0 AND ((turn_year < 1862) OR (turn_year = 1862 AND turn_month < 3)) GOTO noiron
	IF side_cash(side) >= 2 * cost THEN
		menu_col = 67: menu_row = 12: menu_color = 9
		IF side = current_side THEN
			menu_text$(0) = "Type"
			menu_text$(1) = "Wooden"
			menu_text$(2) = "Ironclad"
			menu_item_count = 2
			CALL menu_select(0)
			CALL clear_right_panel
			IF menu_choice < 1 GOTO ahoy
			IF menu_choice = 2 THEN a$ = "I": cost = 2 * cost
		ELSE
			a$ = "I"
		END IF
	END IF

noiron:
	fleet_size(side) = fleet_size(side) + 1
	IF a$ = "W" THEN
		fleet_ships$(side) = fleet_ships$(side) + a$: a = 1
	ELSE
		fleet_ships$(side) = a$ + fleet_ships$(side): a = 2
	END IF
	IF fleet_size(side) > 1 GOTO add2ship
ships:
	menu_text$(0) = "Port": menu_item_count = 0: menu_col = 67: menu_row = 12
	FOR i = 1 TO 40: IF matrix(i, 7) = 99 AND city_owner(i) = side AND fleet_city(3 - side) <> i THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(i): menu_value(menu_item_count) = i
	NEXT i
	IF action = 1 THEN menu_choice = 1 + INT(menu_item_count * RND)
	IF menu_item_count < 1 THEN
		fleet_size(side) = 0: fleet_ships$(side) = ""
		IF action = 0 THEN CALL clear_bottom_line: PRINT "NO SHIPYARDS AVAILABLE !"; : EXIT SUB
		IF action = 1 THEN EXIT SUB
	END IF
	IF action = 0 THEN CALL menu_select(9): CALL clear_right_panel

	IF menu_choice < 1 GOTO ships
	fleet_city(side) = menu_value(menu_choice)
	side_cash(side) = side_cash(side) - cost: fleet_size(side) = 1
	x = city_x(menu_value(menu_choice)) + 25: y = city_y(menu_value(menu_choice)) + 25: CALL draw_fleets
	CALL clear_bottom_line: COLOR 11: PRINT side_name$(side); " is building NEW fleet in "; city_name$(menu_value(menu_choice));
	PSET (400, 465), 0: CALL draw_ship_icon(side, a)
	IF opt_sound > 0 THEN SOUND 3000, 1
	CALL wait_seconds(opt_pause!)
	GOTO ahoy
add2ship:
	side_cash(side) = side_cash(side) - cost
	CALL clear_bottom_line: PRINT side_name$(side); " navy increased to "; fleet_size(side);
	PSET (400, 465), 0: CALL draw_ship_icon(side, a)
	CALL draw_fleets
	IF opt_sound > 0 THEN SOUND 3000, 1
	CALL wait_seconds(opt_pause!)
'---------------------------------------------------------------------------
'                               Attack City
'---------------------------------------------------------------------------
	CASE 2
	IF fleet_city(side) = 99 GOTO ahoy
	IF action = 2 AND city_owner(fleet_city(side)) = side THEN EXIT SUB
	IF action = 2 AND city_army(fleet_city(side)) > 0 AND RND > .5 THEN action = 3: GOTO anchor
	IF action = 2 AND city_owner(fleet_city(side)) = 0 THEN action = 3: GOTO ahoy
	IF fleet_city(side) < 1 THEN EXIT SUB
	IF side = current_side THEN turn_navy_done = 1
	IF city_owner(fleet_city(side)) <> 3 - side GOTO ahoy
	CALL clear_bottom_line: COLOR 12: PRINT side_name$(side); " fleet bombards "; city_name$(fleet_city(side));
	CALL draw_map_marker(fleet_city(side), 0, 3)
	      
	target = fleet_city(side): index = city_army(target): IF index = 0 GOTO deserted
	pct! = .005 * fleet_size(side) + .02 * RND: killd = army_size(index) * pct!: IF killd < 1 THEN killd = 1
	CALL clear_bottom_line: PRINT army_name$(index); " suffered "; 100 * killd; " casualties";
	x = .5 * fleet_size(side) + 1: IF x > army_supply(index) THEN x = army_supply(index)
	army_supply(index) = army_supply(index) - x
	CALL wait_seconds(opt_pause!)
	army_size(index) = army_size(index) - killd: IF army_size(index) < 1 THEN army_size(index) = 1
	EXIT SUB
deserted:
	IF city_fort(target) = 0 GOTO blast
	IF RND < .7 + .03 * (fleet_size(side) - city_fort(target)) GOTO hurt1
	CALL navy_remove_ship(side)
	CALL clear_bottom_line
	PRINT side_name$(city_owner(target)); " shore battery sunk an attacking ship!"; fleet_size(side); "ship(s) left! ";
	IF opt_sound > 0 THEN SOUND 77, .5: SOUND 59, .5
	CALL wait_seconds(opt_pause!)
	IF fleet_size(side) < 1 THEN
		fleet_city(side) = 0: fleet_ships$(side) = "": GOSUB box2
		LOCATE 12, 27: PRINT side_name$(side); " fleet eliminated"
		CALL wait_seconds(9)
		side_victory_points(3 - side) = side_victory_points(3 - side) + 5
		IF side = current_side THEN fleet_pursuit = 0
		GOTO sail3
	END IF
	GOTO deserted
hurt1:
	CALL clear_bottom_line: PRINT city_name$(target); " fortifications damaged";
	city_fort(target) = city_fort(target) - 1: x = city_x(target): y = city_y(target): LINE (x - 5, y - 5)-(x + 5, y + 5), 2, BF
	CALL draw_cities
	CALL wait_seconds(opt_pause!)
	EXIT SUB
blast:
	IF RND > .25 + .07 * fleet_size(side) THEN CALL clear_bottom_line: PRINT "Citizens of "; city_name$(target); " stand firm against the attack"; : CALL wait_seconds(opt_pause!): EXIT SUB
	IF fleet_city(side) = side_capital(3 - side) THEN CALL clear_bottom_line: PRINT "The CAPITAL steadfastly stands loyal"; : CALL wait_seconds(opt_pause!): EXIT SUB
	city_owner(fleet_city(side)) = 0
	CALL clear_bottom_line: PRINT city_name$(fleet_city(side)); " is now  NEUTRAL";
	CALL draw_cities
	side_victory_points(side) = side_victory_points(side) + city_value(fleet_city(side))
	EXIT SUB
'---------------------------------------------------------------------------
'                               Sail
'---------------------------------------------------------------------------
	CASE 3
	fleet_size(side) = LEN(fleet_ships$(side))
	IF fleet_size(side) < 1 AND action > 0 THEN EXIT SUB
	IF fleet_city(side) < 1 OR fleet_size(side) < 1 THEN CALL clear_bottom_line: PRINT "No ships remain"; : wait_seconds 1: GOTO ahoy

	menu_item_count = 0
	FOR i = 1 TO 40: IF matrix(i, 7) > 90 AND fleet_city(side) <> i THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(i): menu_value(menu_item_count) = i
	NEXT i
	IF action = 3 THEN
		IF menu_item_count = 0 THEN EXIT SUB
		IF fleet_pursuit > 0 THEN menu_choice = 1: menu_value(1) = fleet_city(3 - side): GOTO admiral
		GOSUB nest: IF menu_choice > 0 GOTO admiral ELSE EXIT SUB
	END IF
	COLOR 11: LOCATE 11, 68
	IF fleet_city(side) < 41 THEN
		PRINT city_name$(fleet_city(side))
	ELSE
		PRINT "Raiding"
	END IF
	menu_text$(0) = "To"
	menu_color = 3: menu_col = 67: menu_row = 12
      
	CALL menu_select(9): CALL clear_right_panel: IF menu_choice < 1 THEN EXIT SUB
admiral:
	IF menu_value(menu_choice) = fleet_city(side) THEN EXIT SUB
	IF menu_value(menu_choice) < 1 THEN EXIT SUB
	IF fleet_size(side) < 1 GOTO ships
	IF side = current_side THEN turn_navy_done = 1
	GOSUB box2
	LOCATE 10, 25: PRINT side_name$(side); " fleet of"; fleet_size(side); "ship(s) is sailing"
	LOCATE 11, 25: PRINT "From ";
	IF fleet_city(side) < 41 THEN
		PRINT city_name$(fleet_city(side));
	ELSE
		PRINT "Raiding";
	END IF
	PRINT " to ";
	IF menu_value(menu_choice) <> 99 THEN
		PRINT city_name$(menu_value(menu_choice));
	ELSE
		PRINT "Raid Commerce";
	END IF

	FOR i = 1 TO fleet_size(side)
		PSET (120 + 41 * i, 210), 0
		CALL draw_fleet_ship(side, i)
	NEXT i
	IF opt_graphics > 2 THEN
		a = ASC(LEFT$(fleet_ships$(side), 1))
		SELECT CASE a
			CASE 73
				CALL draw_ironclad
			CASE 87
				CALL draw_schooner
		END SELECT
		wait_seconds 2 * opt_pause!
	ELSE
		wait_seconds opt_pause!
	END IF
	fleet_city(side) = menu_value(menu_choice)
	IF fleet_city(1) = fleet_city(2) GOTO pirate
	GOTO sail3
'---------------------------------------------------------------------------
'                               Raid Commerce
'---------------------------------------------------------------------------
	CASE 4
	fleet_size(side) = LEN(fleet_ships$(side))
	IF fleet_size(side) < 1 AND action > 0 THEN EXIT SUB
	IF fleet_size(side) < 1 OR raiding_side = side GOTO ahoy

	IF side = current_side THEN turn_navy_done = 1
	GOSUB box2
	LOCATE 10, 25: PRINT side_name$(side); " fleet of"; fleet_size(side); "ship(s) is sailing"
	LOCATE 11, 25: PRINT "to RAID "; side_name$(3 - side); " COMMERCE !"

	FOR i = 1 TO fleet_size(side)
		PSET (120 + 41 * i, 210), 0
		CALL draw_fleet_ship(side, i)
	NEXT i
	IF opt_graphics > 2 THEN
		a = ASC(LEFT$(fleet_ships$(side), 1))
		SELECT CASE a
			CASE 73
				CALL draw_ironclad
			CASE 87
				CALL draw_schooner
		END SELECT
		wait_seconds 2 * opt_pause!
	ELSE
		wait_seconds opt_pause!
	END IF
	fleet_city(side) = 99: raiding_side = side
	IF fleet_city(1) = fleet_city(2) GOTO pirate
	CLS : CALL draw_map
	EXIT SUB
'---------------------------------------------------------------------------
'                               Invasion
'---------------------------------------------------------------------------
	CASE 5
	CALL army_get_commander((side), empty)
	IF action > 0 AND empty = 0 THEN action = 3: GOTO anchor
	x = 35
	CALL navy_remove_ship(side)
	c = fleet_city(side): CALL army_new((side), empty, c)
	side_cash(side) = side_cash(side) + 100     'compensate for cost of recruiting new army
	CALL city_capture(empty, c, side, 0)
	army_size(empty) = x
	IF side = current_side THEN turn_navy_done = 1
	EXIT SUB
'---------------------------------------------------------------------------
'                               Exit
'---------------------------------------------------------------------------
	CASE ELSE
	EXIT SUB
END SELECT
GOTO ahoy
'---------------------------------------------------------------------------
'                               Ship vs. Ship
'---------------------------------------------------------------------------
pirate:
	CLS : LOCATE 1, 30: COLOR 11: PRINT "NAVAL COMBAT"
	FOR k = 1 TO 2
	hit(k) = 10
	IF RIGHT$(fleet_ships$(k), 1) = "I" THEN hit(k) = 20
	NEXT k
cannon:
	LOCATE 9, 1: PRINT SPACE$(79)
	LOCATE 15, 1: PRINT SPACE$(79)
	x = 10: y = 100
	COLOR 9: LOCATE 5, 25: PRINT "UNION"; fleet_size(1); "ship(s)"
	GOSUB boxes
	COLOR 1
	FOR i = 1 TO fleet_size(1)
	x = x + 50: PSET (x, y)
	CALL draw_fleet_ship(1, i)
	NEXT i
	COLOR 11: LOCATE 11, 22: PRINT "CONFEDERATES "; fleet_size(2); "ship(s)"
	LINE (10, 180)-(530, 210), 1, BF
	LINE (10, 180)-(530, 210), 11, B
	x = 10: y = 200
	COLOR 1
	FOR i = 1 TO fleet_size(2)
	x = x + 50: PSET (x, y)
	CALL draw_fleet_ship(2, i)
	NEXT i
	COLOR 11
wave:
	menu_text$(0) = "Options"
	menu_text$(1) = "Attack"
	menu_text$(2) = "Retreat"
	IF action > 0 THEN menu_choice = 1: GOTO powder
      
	menu_item_count = 2: menu_color = 3: menu_highlight = 14: menu_col = 50: menu_row = 18: CALL menu_select(0)
powder:
	SELECT CASE menu_choice
	 CASE 1
firemore:
	 IF opt_sound > 0 THEN SOUND 77, .5: SOUND 59, .5: CALL wait_seconds(.1)
	 pct! = 0: a$ = RIGHT$(fleet_ships$(side), 1)
	 IF a$ <> RIGHT$(fleet_ships$(3 - side), 1) THEN
		IF a$ = "I" THEN pct! = .1 ELSE pct! = -.1
	 END IF
	 IF RND <= .5 + pct! GOTO hitem ELSE GOTO hitme1
	 GOTO firemore
hitem:
	 hit(3 - side) = hit(3 - side) - 1: GOSUB showhit: IF hit(3 - side) > 0 GOTO firemore
	 x = 10 + 50 * fleet_size(3 - side)
	 y = 90: IF side = 1 THEN y = 190
	 GOSUB xout
	 LOCATE 17, 5: PRINT side_name$(3 - side); " ship SUNK!": CALL wait_seconds(opt_pause! + 1): GOSUB clr1
	 CALL navy_remove_ship(3 - side)
	 IF fleet_size(3 - side) < 1 THEN
		LOCATE 19, 5: COLOR 12
		PRINT side_name$(3 - side); " fleet DEFEATED"
		CALL wait_seconds(opt_pause!)
		fleet_city(3 - side) = 0: fleet_ships$(3 - side) = ""
		side_victory_points(3 - side) = side_victory_points(3 - side) + 10
		IF side = current_side THEN fleet_pursuit = 1 ELSE fleet_pursuit = 0
		GOTO sail3
	 END IF
	 hit(3 - side) = 10
	 IF RIGHT$(fleet_ships$(3 - side), 1) = "I" THEN hit(3 - side) = 20
	 GOTO cannon
hitme1:
	 hit(side) = hit(side) - 1: GOSUB showhit: IF hit(side) > 0 GOTO firemore
	 x = 10 + 50 * fleet_size(side)
	 y = 190: IF side = 1 THEN y = 90
	 GOSUB xout
	 LOCATE 17, 5: PRINT "One of the "; side_name$(side); " ships was SUNK!": CALL wait_seconds(opt_pause!): GOSUB clr1
	 CALL navy_remove_ship(side)
	 IF fleet_size(side) < 1 THEN
		LOCATE 19, 5: COLOR 12
		PRINT "Attacking "; side_name$(side); " fleet has been ELIMINATED !"
		CALL wait_seconds(opt_pause!)
		fleet_city(side) = 0: fleet_ships$(side) = ""
		side_victory_points(side) = side_victory_points(side) + 10
		IF side <> current_side THEN fleet_pursuit = 1 ELSE fleet_pursuit = 0
		GOTO sail3
	 END IF
	 hit(side) = 10
	 IF RIGHT$(fleet_ships$(side), 1) = "I" THEN hit(side) = 20
	 GOTO cannon

	 CASE 2
	 target = 0
	 FOR i = 1 TO 40
	 IF city_owner(i) = side THEN IF i <> fleet_city(side) AND matrix(i, 7) = 99 THEN target = i: IF RND > .3 GOTO found1
	 NEXT i
found1:
	 CALL clear_bottom_line: COLOR 11: PRINT side_name$(side); " is retreating to "; city_name$(target); : CALL wait_seconds(opt_pause!)
	 fleet_city(side) = target
	 GOTO sail3
	 CASE ELSE
	 GOTO wave
	 END SELECT
	 GOTO pirate
'---------------------------------------------------------------------------
'                               Subs
'---------------------------------------------------------------------------
showhit:
	 LOCATE 9, 6 * fleet_size(1): PRINT hit(1); " ";
	 LOCATE 15, 6 * fleet_size(2): PRINT hit(2); " ";
	 IF opt_sound = 0 THEN wait_seconds .1 * opt_pause!
	 RETURN
clr1:
	LOCATE 17, 1: PRINT SPACE$(60): RETURN
nest:
	best = 0: x = 0
	FOR i = 1 TO menu_item_count
	target = menu_value(i)
	IF city_owner(target) = 0 GOTO neutral

	IF target = fleet_city(3 - side) THEN IF fleet_size(side) >= fleet_size(3 - side) AND RND > .1 THEN menu_choice = i: RETURN
	IF city_owner(target) <> side THEN
		best = i: x = x + 1
		IF RND > .8 THEN menu_choice = best: RETURN
	END IF
neutral:
	NEXT i
	IF best = 0 THEN
		menu_choice = 1 + INT(RND * menu_item_count)
	ELSE
		menu_choice = best
	END IF

	IF side = 2 AND fleet_city(2) = 30 THEN IF RND > .5 THEN menu_choice = 30: RETURN
	RETURN
boxes:
	LINE (10, 80)-(530, 110), 1, BF
	LINE (10, 80)-(530, 110), 11, B
	RETURN
box2:
	CLS
	LINE (100, 110)-(550, 240), 1, B
	LINE (95, 115)-(555, 235), 7, B
	RETURN
xout:
		PSET (x, y)
		DRAW "S5C15G5F5G3H5G5H3E5H5E3F5E5F3"
		PAINT (x - 3, y + 1), 12, 15
	RETURN
sail3:
	raiding_side = 0
	FOR k = 1 TO 2
	IF fleet_city(k) = 99 THEN raiding_side = k
	NEXT k
	CLS : CALL draw_map
END SUB

SUB army_new (side, slot, city)
	army_supply(slot) = 3 + 5 * RND: IF side = 1 THEN army_supply(slot) = army_supply(slot) + 2
	army_experience(slot) = 1: IF side = 2 THEN army_experience(slot) = 2
	army_leader_rating(slot) = leader_rating(slot)
	army_name$(slot) = leader_name$(slot): leader_name$(slot) = ""
	COLOR 12: CALL clear_bottom_line: PRINT "Placing NEW army "; slot; army_name$(slot); " in "; city_name$(city);

	x = 70: IF opt_realism > 0 THEN x = 3 * city_value(city) + 33
	CALL city_is_connected(side, city, a): IF a < 1 THEN x = x \ 3
	city_army(city) = slot: army_size(slot) = x
	PRINT " Size = "; : CALL print_army_size(slot)
	side_cash(side) = side_cash(side) - 100: IF opt_sound > 0 THEN SOUND 2222, .5
	army_city(slot) = city: CALL draw_army_flag(slot)
	CALL wait_seconds(opt_pause! - .5)
	army_order(slot) = -1
END SUB

SUB menu_city_select (city)
		menu_text$(1) = "  "
		menu_text$(3) = "  "
		menu_item_count = 3: a$ = city_name$(city)
morecap:
		menu_col = 68: menu_row = 15: menu_color = 3: menu_choice = 23
		menu_text$(2) = city_name$(city)
		CALL menu_select(3): CALL clear_right_panel
	       SELECT CASE menu_choice
		CASE IS = -27
		city = 0: EXIT SUB
		CASE IS < 1
		a$ = CHR$(ABS(menu_choice))
		x = 0
		FOR k = 1 TO 40
		IF LEFT$(city_name$(k), 1) = a$ THEN
			y = city: city = k
spin2:
			IF city_owner(city) = current_side GOTO morecap
				city = city + 1
				IF city > 40 THEN city = 1
				x = x + 1: IF x < 39 GOTO spin2
				city = y: GOTO morecap
		END IF
		NEXT k
		GOTO morecap
		CASE 1
minus1:
		city = city - 1: IF city < 1 THEN city = 40
		IF city_owner(city) <> current_side GOTO minus1 ELSE GOTO morecap
		CASE 2
		GOTO fnew
		CASE 3
plus1:
		city = city + 1: IF city > 40 THEN city = 1
		IF city_owner(city) <> current_side GOTO plus1 ELSE GOTO morecap
		CASE ELSE
		city = 0
		END SELECT
fnew:
END SUB

SUB normal_random_number (xbar, vary, result)
' NOTE : vary is VARIANCE
pct! = 0
FOR k = 1 TO 12: pct! = pct! + RND: NEXT k
pct! = pct! - 5.5
result = xbar + pct! * SQR(vary)
END SUB

SUB draw_army_flag (army)
who = 1: IF army > 20 THEN who = 2
x = city_x(army_city(army)) - 12
y = city_y(army_city(army)) - 11
CALL draw_flag_icon(x, y, who)
IF army_supply(army) < 1 THEN
	x = x - 3: y = y + 4
	PSET (x, y), 13: DRAW "C11S8"
	DRAW map_font$(19)
	DRAW "S4"
END IF
END SUB

SUB railroad_move (side)
SELECT CASE train_army(side)
	CASE 0
	IF side = current_side GOTO human
	CALL side_army_range(star, fin, side): max = 32767
	index = 0
	FOR i = star TO fin: IF army_city(i) = 0 OR army_order(i) <> 0 GOTO puter
	x = 0: FOR j = 1 TO 6: from = matrix(army_city(i), j): IF from > 0 AND city_owner(from) <> side THEN x = x + 1
	NEXT j
	IF city_army(side_capital(side)) > 0 AND x > 1 GOTO puter
	CALL city_nearby_enemy_strength(army_city(i), defend)
	IF victory_rule(5) > 0 AND city_army(side_capital(side)) = 0 THEN IF defend > max THEN defend = max - 1
	IF defend < max THEN target = army_city(i): GOSUB route: IF x > 1 THEN max = defend: index = i
puter:  NEXT i
	IF index = 0 OR max > .3 * army_size(index) GOTO toot
	CALL railroad_capacity(side, limit)
	IF army_size(index) > limit THEN GOTO toot
	from = army_city(index)
	x1 = 0: FOR i = 1 TO 40: IF city_owner(i) <> side GOTO puted
	CALL city_nearby_enemy_strength(i, defend): IF defend = 0 OR defend > 3 * army_size(index) GOTO puted
	IF city_army(i) > 0 GOTO puted
	target = i
	GOSUB route: IF x = 0 GOTO puted
	IF current_side = 1 AND city_y(i) < city_y(from) THEN x1 = i
	IF current_side = 2 AND city_y(i) > city_y(from) THEN x1 = i
	IF city_fort(i) > 0 AND city_army(i) = 0 THEN x1 = i: EXIT FOR
puted:  NEXT i
	IF victory_rule(5) > 0 AND city_army(side_capital(side)) = 0 THEN
		GOSUB route
		IF x > 0 THEN
			CALL city_nearby_enemy_strength(side_capital(side), defend)
			IF defend > 0 THEN x1 = side_capital(side)
		END IF
	END IF
	IF x1 > 0 GOTO haul ELSE GOTO toot
human:
	CALL menu_army_select(index, a): IF a < 1 OR index < 1 THEN COLOR 11: CALL clear_bottom_line: PRINT "Railroad move not allowed"; : GOTO toot
	x = 1: IF index > 20 THEN x = 2
	CALL railroad_capacity(side, limit)
	IF army_size(index) > limit THEN CALL clear_bottom_line: PRINT "Too many troops for railroad capacity"; : GOTO toot
	
	target = army_city(index): GOSUB route: IF x > 1 GOTO aboard
	CALL clear_bottom_line: PRINT "Track from "; city_name$(target); " is blocked"; : GOTO toot
aboard:
	CALL clear_bottom_line: PRINT "Select destination for "; army_name$(index); " from "; city_name$(target);
	menu_text$(0) = "To": from = target: x1 = from: IF from = 0 GOTO toot
	CALL menu_city_select(x1): IF x1 = from OR x1 = 0 GOTO toot

	target = x1: GOSUB route: IF x > 1 GOTO haul
	CALL clear_bottom_line: PRINT army_name$(index); "'s train cannot go to "; city_name$(x1); " - select another city"; : CALL wait_seconds(9)
	GOTO aboard
haul:
	COLOR 11: CALL clear_bottom_line: PRINT army_name$(index); " is taking the train from "; city_name$(from); " to "; city_name$(x1);
	train_city(side) = army_city(index)
	from = army_city(index)
	train_from_city(side) = from
	train_army(side) = index: army_city(index) = 0: army_order(index) = x1
	CALL draw_train(side, 1)
	IF opt_sound > 0 THEN SOUND 2222, 1
	CALL draw_train_box

	CALL city_update_occupier(from)
       IF city_army(from) > 0 THEN CALL draw_army_flag(city_army(from))
	GOTO toot

	CASE IS > 0
	CALL draw_train(side, 0)
	CALL city_update_occupier(train_from_city(side))
	IF city_army(train_from_city(side)) > 0 THEN CALL draw_army_flag(city_army(train_from_city(side)))

	index = train_army(side)
	train_city(side) = army_order(index)
	CALL draw_train(side, 1)

	train_army(side) = 0: army_city(index) = army_order(index): army_order(index) = -1
	COLOR 11: CALL clear_bottom_line: PRINT "Train with "; army_name$(index); " has arrived in "; city_name$(army_city(index)); : IF opt_sound > 0 THEN SOUND 1200, 2
	CALL wait_seconds(opt_pause!)
	x = city_x(army_city(index)) - 12: y = city_y(army_city(index)) - 11
	LINE (x - 9, y - 8)-(x + 10, y + 8), 2, BF
	IF city_owner(army_city(index)) <> side THEN CALL city_capture(index, army_city(index), side, 0)
	CALL draw_army_flag(index)
	IF city_army(army_city(index)) > 0 THEN CALL draw_stack_markers(side): GOTO toot
	CALL city_update_occupier(army_city(index)): CALL draw_army_flag(index)
	GOTO toot
END SELECT

route:
	x = 0: FOR j = 1 TO 6
	y = matrix(target, j)
	IF y > 0 AND city_owner(y) = side THEN
	x = x + 1
		FOR m = 1 TO 6
		z = matrix(y, m)
		IF z > 0 AND z <> target AND city_owner(z) = side THEN x = x + 1
		NEXT m
	END IF
NEXT j
RETURN

toot:
	IF side = current_side THEN CALL wait_seconds(9)
	CALL clear_right_panel
	clear_bottom_line
END SUB

SUB menu_army_recruit (side)
	IF side_cash(side) < 100 GOTO menu1
	menu_item_count = 0: COLOR 12
	menu_text$(0) = "Recruit"
	IF side = current_side AND turn_recruit_state > 0 THEN FOR i = 1 TO turn_recruit_state: x = turn_recruit_city(i): menu_text$(i) = city_name$(x): menu_value(i) = x: NEXT i: menu_item_count = turn_recruit_state: GOTO alldone
	max = 4: IF RND > .8 THEN max = max - 1
	IF opt_difficulty < 3 THEN max = max + 1

	FOR i = 1 TO 40
	IF side_city_count(side) > 0 THEN pct! = .6 * max / side_city_count(side) ELSE pct! = .3
	IF menu_item_count = 0 AND i > 20 THEN pct! = .3
	IF menu_item_count < 2 AND i > 30 THEN pct! = .3
	menu_value(i) = 0
	IF city_army(i) > 0 AND city_owner(i) = side THEN pct! = .4
	IF RND < pct! AND city_owner(i) = side THEN
		IF opt_realism > 0 AND city_first_owner(i) = 3 - side GOTO foe
		menu_item_count = menu_item_count + 1
		menu_text$(menu_item_count) = city_name$(i)
		menu_value(menu_item_count) = i
		IF menu_item_count > max - 1 GOTO alldone
	END IF
foe:
	NEXT i
alldone:
	IF menu_item_count = 0 GOTO menu1
	IF side = current_side AND turn_recruit_state = 0 THEN FOR i = 1 TO menu_item_count: turn_recruit_city(i) = menu_value(i): NEXT i: turn_recruit_state = menu_item_count
	CALL menu_bubble_sort(menu_item_count)
'............................................................................
levy:
	IF side_cash(side) < 100 GOTO menu1
	IF (side = current_side) OR (opt_players = 2) THEN CALL clear_bottom_line: PRINT side_name$(side); " funds available "; side_cash(side);
	menu_col = 67: menu_row = 12: menu_color = 3
	IF side <> current_side THEN GOSUB randsel: GOTO auto1
      
	IF menu_choice > 0 THEN menu_choice = 21 + menu_choice
	CALL menu_select(2): CALL clear_right_panel
	IF menu_choice < 1 GOTO menu1
auto1:
	empty = 0
	index = menu_value(menu_choice)
	CALL city_update_occupier(index)
	IF city_army(index) > 0 THEN i = city_army(index): GOTO add2
	CALL army_get_commander((side), empty)
       
	IF side <> current_side AND empty = 0 GOTO menu1
	IF empty = 0 GOTO levy
	army_city(empty) = index
	GOSUB playb
	CALL army_new(side, empty, index)
	GOTO levy
'............................................................................
add2:
	target = menu_value(menu_choice)
	x = 45: a$ = ""
	IF opt_realism > 0 THEN
		x = 2 * city_value(army_city(i)) + 20
		CALL city_is_connected(side, target, a)
		IF a < 1 THEN x = x \ 3: a$ = " ISOLATED !"
	END IF
	army_size(i) = army_size(i) + x

	GOSUB playb
	side_cash(side) = side_cash(side) - 100
	from = army_city(i): x = city_x(from) - 12: y = city_y(from) - 11
	GET (x - 9, y - 7)-(x + 9, y + 6), saved_under_army
	CALL draw_map_marker(army_city(i), 0, 2)
	IF opt_sound > 0 THEN SOUND 2222, 1
	COLOR 11: CALL clear_bottom_line: PRINT "Army "; i; army_name$(i); " in "; city_name$(army_city(i)); " strength increased to "; : CALL print_army_size(i)
	IF a$ <> "" THEN PRINT a$;
	PUT (x - 9, y - 7), saved_under_army, PSET
	CALL wait_seconds(opt_pause! - .5)
	GOTO levy
randsel:
		menu_choice = 0: x = 0
		FOR i = 1 TO menu_item_count
		target = menu_value(i)
		LOCATE 14 + i, 69
		x = city_army(target)
		IF x = 0 XOR army_size(x) < 155 THEN menu_choice = i
		NEXT i

	IF menu_choice = 0 THEN menu_choice = 1 + INT(RND * menu_item_count)
	IF opt_realism > 0 THEN
		x = 0
		FOR i = 1 TO menu_item_count
		target = menu_value(i)
		IF city_army(target) = 0 THEN
			y = 3 * city_value(target) + 33
			CALL city_is_connected(side, target, a)
			IF a < 1 THEN y = y \ 3
		ELSE
			y = 2 * city_value(target) + 20
			CALL city_is_connected(side, target, a)
			IF a < 1 THEN y = y \ 3
		END IF
		IF y > x AND RND > .5 THEN x = y: menu_choice = i
		NEXT i
	END IF
	IF side_cash(side) < 100 THEN menu_choice = menu_item_count
	RETURN
playb:
	IF current_side = 1 AND opt_difficulty < 3 THEN army_size(empty) = army_size(empty) + 15 - 5 * opt_difficulty
	IF current_side = 2 AND opt_difficulty > 3 THEN army_size(empty) = army_size(empty) + 5 * opt_difficulty - 15
	RETURN
menu1:
END SUB

SUB draw_fleet_ship (side, i)
a = 1: IF MID$(fleet_ships$(side), i, 1) = "I" THEN a = 2
CALL draw_ship_icon(side, a)
END SUB

SUB draw_cities
FOR i = 1 TO 40
c = 9: IF city_owner(i) = 2 THEN c = 7
IF city_owner(i) = 0 THEN c = 12
x = city_x(i): y = city_y(i)
IF i = side_capital(1) OR i = side_capital(2) THEN
	PUT (x - 6, y - 6), pic_capital, PSET
	LINE (x + 9, y - 4)-(x + 15, y + 4), 0, BF
	LINE (x + 8, y - 5)-(x + 13, y + 2), 3, BF
	PSET (x + 8, y - 4)
	IF city_fort(i) = 1 THEN DRAW "BR2C0e1D6BL1R2"
	IF city_fort(i) = 2 THEN DRAW "C0e1R1F1D1G3R3"
ELSE
	IF city_fort(i) = 1 THEN LINE (x - 5, y - 5)-(x + 5, y + 5), 0, B
	IF city_fort(i) > 1 THEN LINE (x - 5, y - 5)-(x + 5, y + 5), 0, BF
	CIRCLE (city_x(i), city_y(i)), 4, 0
	CIRCLE (city_x(i), city_y(i)), 3, c
	PAINT (city_x(i), city_y(i)), c, c
END IF
IF opt_graphics = 0 GOTO nocon
	FOR j = 1 TO 6: IF matrix(i, j) > 0 THEN CALL draw_map_marker(i, matrix(i, j), 11)
	NEXT j
nocon:
NEXT i
END SUB

SUB ai_turn
CALL special_events
slush = 0: who = 3 - current_side
c = 9: IF current_side = 1 THEN c = 15
LOCATE 1, 1: PRINT SPACE$(80);
COLOR c: LOCATE 1, 10: PRINT side_name$(who); " Side is making decisions";
CALL side_army_range(star, fin, who)
'==========================================================================
'                       Check Supply
'==========================================================================
FOR i = star TO fin: IF army_city(i) > 0 AND army_supply(i) < 1 THEN CALL army_resupply(i)
NEXT i
'==========================================================================
'                       Fortify Capital or Other City
'==========================================================================
cost = 200
IF cost > side_cash(who) GOTO signup

target = 0: IF city_army(side_capital(who)) = 0 OR city_fort(side_capital(who)) > 1 GOTO city2
target = side_capital(who)
IF city_owner(target) = who GOTO capital ELSE GOTO city2
IF target > 0 GOTO capital

city2:
IF 1 + RND < opt_ai_aggression + ai_strength_ratio! GOTO signup
target = 0: FOR i = star TO fin
x = army_city(i): IF x = 0 OR army_order(city_army(x)) < 0 OR army_order(i) < 0 GOTO endlook
IF city_fort(x) > 1 GOTO endlook
	CALL city_nearby_enemy_strength(x, defend): IF defend > army_size(i) THEN target = army_city(i): GOTO capital
endlook:
NEXT i

capital:
	IF target = 0 GOTO signup
	IF city_fort(target) > 1 GOTO signup
	city_fort(target) = city_fort(target) + 1
	x = city_army(target): army_order(x) = -1
	side_cash(who) = side_cash(who) - cost
	CALL clear_bottom_line: PRINT city_name$(target); " fortifications increased to "; city_fort(target);
	CALL draw_map_marker(target, 0, 6)
	CALL draw_cities
	IF who = 1 AND fleet_size(1) < 1 AND RND > .5 AND side_cash < 222 GOTO signup
	IF 3 * RND > 1 + ai_strength_ratio! AND side_cash(who) >= cost GOTO city2
'==========================================================================
'                       Recruit New Armies
'==========================================================================
signup:
IF who = 1 AND fleet_size(1) < 1 AND side_cash(1) > 100 THEN CALL navy_commands(1, 1): IF side_cash(who) < 100 GOTO isok
GOSUB enufarmies
IF x > 2 + 3 * current_side + 3 * RND GOTO isok
IF fleet_size(who) < 5 AND side_cash(who) > 100 AND fleet_city(who) <> 99 THEN IF city_owner(fleet_city(who)) = who THEN slush = slush + 100: side_cash(who) = side_cash(who) - 100: IF side_cash(who) < 100 GOTO isok
CALL menu_army_recruit(who)
'==========================================================================
'                         Naval Commands
'==========================================================================
isok:
	side_cash(who) = side_cash(who) + slush
dock:
	IF current_side = 2 AND fleet_city(1) = 0 AND fleet_size(1) < 1 AND city_owner(30) = 1 AND side_cash(1) > 100 THEN fleet_city(1) = 30: CALL navy_commands(1, 1): GOTO movenavy
	IF fleet_city(who) = 99 THEN
		IF RND < .9 THEN CALL navy_commands(who, 3)
		GOTO movearmy
	END IF
	IF side_cash(who) < 100 OR fleet_size(who) > 9 OR city_owner(fleet_city(who)) <> who GOTO movenavy
	CALL navy_commands(who, 1)
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
movenavy:
	IF fleet_size(who) = 0 THEN fleet_city(who) = 0
	IF fleet_city(who) = 0 GOTO movearmy
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
'                     move ships & prohibit further action this turn
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	IF fleet_city(who) <> 99 THEN
		IF city_owner(fleet_city(who)) = who THEN CALL navy_commands(who, 3): GOTO movearmy   'move ships & prohibit further action this turn
		IF city_owner(fleet_city(who)) = 0 THEN CALL navy_commands(who, 3): GOTO movearmy
	ELSE
		IF RND < .5 THEN CALL navy_commands(who, 3)
		GOTO movearmy
	END IF

	IF city_owner(fleet_city(who)) <> who THEN
		IF city_army(fleet_city(who)) = 0 OR RND > .3 THEN
			CALL navy_commands(who, 2) 'attack
		ELSE
			CALL navy_commands(who, 3) 'move
		END IF
	END IF
'==========================================================================
'                       Give Move Orders to Each Army
'==========================================================================
movearmy:
	CALL draw_fleets
'---------------------------------------------------------------------------
'                               Check to Combine
'---------------------------------------------------------------------------
a = who: CALL army_combine(a)
CALL railroad_move(who)
'---------------------------------------------------------------------------
'                               Top Priority
'---------------------------------------------------------------------------
FOR i = star TO fin
target = army_city(i)
IF army_city(i) < 1 OR army_order(i) < 0 GOTO deadman
x = army_size(i): IF army_supply(i) < 1 AND RND > .1 GOTO deadman

menu_choice = 0

CALL city_nearby_enemy_strength(target, defend)

IF defend > 0 AND target = side_capital(who) AND city_army(target) = i GOTO deadman   'hold capital
IF target <> side_capital(who) GOTO nocap
IF victory_rule(5) = 0 GOTO nocap
	FOR j = 1 TO 6
	k = matrix(target, j): IF j = 0 GOTO nocap
	CALL city_nearby_enemy_strength(k, flag): IF flag > 0 GOTO deadman
	NEXT j
nocap:
CALL ai_evaluate_move(i, best): IF best = 0 GOTO deadman
move9:
	IF best = 0 THEN menu_choice = 1 + INT((j - 1) * RND)
	IF menu_choice = 0 THEN menu_choice = best
	army_order(i) = matrix(target, menu_choice)

	IF city_owner(army_order(i)) = who THEN y = city_army(army_order(i)): IF y > 0 THEN IF army_order(y) = x THEN army_order(i) = 0: GOTO deadman  ' eliminate crossing moves
	IF turn_month = 1 AND opt_winter_campaigns = 0 AND city_owner(army_order(i)) <> who THEN army_order(i) = 0: GOTO deadman

	IF opt_pause! > 1 THEN
		COLOR c: CALL clear_bottom_line
		PRINT army_name$(i); " plans to move from "; city_name$(army_city(i)); " to "; city_name$(army_order(i));
	END IF
		CALL draw_map_marker(army_city(i), army_order(i), 1)
		CALL draw_map_marker(army_city(i), army_order(i), 9)
	CALL wait_seconds(opt_pause! - 1)
	PUT (city_x(army_city(i)) - 20, city_y(army_city(i)) - 19), saved_under_marker, PSET
deadman:
NEXT i
	FOR i = star TO fin
	IF army_order(i) = 0 AND army_experience(i) < 6 AND army_experience(i) < army_leader_rating(i) THEN
		army_experience(i) = army_experience(i) + 1

		IF opt_pause! > 1 THEN
		CALL clear_bottom_line
			PRINT army_name$(i); " has drilled to reach experience level "; army_experience(i);
		END IF
		army_order(i) = -1
		CALL wait_seconds(opt_pause! - 1)
	END IF
	NEXT i
EXIT SUB
'---------------------------------------------------------------------------
enufarmies:
CALL side_army_range(star, fin, 3 - who)
FOR i = star TO fin
	IF army_city(i) > 0 THEN y = y + .1 * army_size(i)
NEXT i
CALL side_army_range(star, fin, who)
x = 0: z = 0: FOR i = star TO fin: IF army_city(i) > 0 THEN x = x + 1: z = z + .1 * army_size(i)
NEXT i
IF y > z THEN x = x - 2
IF y > 2 * z THEN x = 0
RETURN
'---------------------------------------------------------------------------
END SUB

SUB screen_snapshot (x, y, put_back)
IF put_back = 0 THEN GET (x - 10, y - 10)-(x + 10, y + 10), saved_under_marker
IF put_back = 1 THEN PUT (x - 10, y - 10), saved_under_marker, PSET
END SUB

SUB print_army_size (army)
a$ = LTRIM$(RTRIM$(STR$(army_size(army)))) + "00"
PRINT a$;
END SUB

SUB draw_train (side, show)
	IF train_city(side) = 0 THEN EXIT SUB
	from = train_city(side)
	x = city_x(from) - 12: y = city_y(from) - 11
SELECT CASE show
	CASE IS > 0
	LINE (x - 8, y - 6)-(x + 10, y + 7), 10, BF
	PSET (x - 6, y - 2), 3: c = 9: IF side = 2 THEN c = 15
	DRAW "C0S2R9D4R6U3R3D3R7U5H3U2R9D3G2D6F1D3F5L10D1G1L4H2L7G2L3H2L3U8L2U5BF4S4"
	x = POINT(0): y = POINT(1): PAINT (x, y), c, 0
	CASE ELSE
	LINE (x - 9, y - 8)-(x + 10, y + 8), 2, BF
END SELECT
END SUB

SUB turn_resolve
flag = 0
IF opt_players = 1 THEN
	CALL ai_turn
ELSE
	FOR i = 1 TO 40
	IF army_city(i) > 0 AND army_order(i) > 0 THEN CALL draw_map_marker(army_city(i), army_order(i), 1)
	NEXT i
END IF
COLOR 14: LOCATE 1, 1: PRINT SPACE$(80);
LOCATE 1, 20: PRINT "Update for "; month_name$(turn_month); ","; turn_year
CALL clear_bottom_line: PRINT "press any key for "; month_name$(turn_month); ","; turn_year; " events";
CALL script_mark_key_wait(1, "U"): DO WHILE INKEY$ = "": LOOP
GOSUB upbox
'==========================================================================
'                       Assign Time of Action
'==========================================================================
FOR i = 1 TO 2: IF train_army(i) > 0 THEN CALL railroad_move(i): LINE (5, 17)-(100, 63), 3, BF: LINE (5, 17)-(100, 63), 0, B: CALL draw_train_box
NEXT i

FOR i = 1 TO 40
move_order_key(i) = 999
IF army_order(i) < 0 THEN army_order(i) = 0
IF army_city(i) > 0 AND army_order(i) > 0 THEN move_order_key(i) = INT(4 + 4 * RND) * 100 + i
IF army_supply(i) < 1 AND army_order(i) > 0 THEN move_order_key(i) = 900 + i
SELECT CASE army_size(i)         'bigger armies move slower
	CASE IS > 400
		IF move_order_key(i) < 900 THEN move_order_key(i) = move_order_key(i) + 100: x = 2
	CASE IS > 800
		IF move_order_key(i) < 800 THEN move_order_key(i) = move_order_key(i) + 200: x = 3
	CASE IS > 1000
		IF move_order_key(i) < 700 THEN move_order_key(i) = move_order_key(i) + 300: x = 4
	CASE ELSE
		x = 1
END SELECT
IF move_order_key(i) <> 999 AND army_leader_rating(i) > 10 * RND THEN
		move_order_key(i) = move_order_key(i) - 100 * (army_leader_rating(i) \ 2)
		IF move_order_key(i) < 100 THEN move_order_key(i) = 100 + i
END IF
NEXT i

CALL sort_move_order(40)
'==========================================================================
'                       Begin Main Loop
'==========================================================================
FOR j = 1 TO 40
flag = 0
IF move_order_key(j) = 999 GOTO allthru
active = INT(move_order_key(j) / 100): active = move_order_key(j) - 100 * active: s = 1: IF active > 20 THEN s = 2
IF army_order(active) < 1 GOTO digin
COLOR 11: CALL clear_bottom_line: PRINT army_name$(active); " is moving to "; city_name$(army_order(active));

army_supply(active) = army_supply(active) - 1: IF army_supply(active) < 0 THEN army_supply(active) = 0: CALL wait_seconds(opt_pause!): CALL clear_bottom_line: PRINT army_name$(active); " is out of supplies !";

CALL draw_army_flag(active)
CALL draw_map_marker(army_city(active), army_order(active), 5)

CALL animate_army(active, 0)
'==========================================================================
target = army_order(active)
IF city_army(target) = 0 GOTO easy
IF (s = 1 AND city_army(target) < 21) OR (s = 2 AND city_army(target) > 20) GOTO friend ELSE GOTO enemy
'==========================================================================
'                         Join Forces
'==========================================================================
friend:
COLOR 11: CALL clear_bottom_line: PRINT army_name$(active); " and "; army_name$(city_army(target)); " meet in "; city_name$(target); : CALL wait_seconds(opt_pause!)
CALL draw_map_marker(army_order(active), 0, 6)
CALL clear_bottom_line
GOTO easy
'==========================================================================
'                       Attack
'==========================================================================
enemy:
CALL draw_map_marker(target, 0, 3)
defend = city_army(target)

COLOR 11: CALL clear_bottom_line: PRINT army_name$(active); " attacks "; army_name$(defend); " in "; city_name$(army_city(defend)); : CALL wait_seconds(opt_pause! - 1)
IF army_size(defend) > 0 THEN CALL calculate_battle(active, defend, win, lose): flag = 1: IF opt_graphics > 0 THEN GOSUB upbox
IF army_experience(win) < 10 THEN army_experience(win) = army_experience(win) + 1

IF army_size(lose) < 2 THEN
	CALL clear_bottom_line
	a$ = army_name$(lose) + "'s army is crushed in " + city_name$(army_city(defend))
	CALL scribe_message(a$, 2)
	index = lose: GOTO crushed
END IF

CALL clear_right_panel
'==========================================================================
'                       Attacker Loses
'==========================================================================
IF win = active GOTO kickbutt
army_order(active) = army_city(active)
army_city(active) = target
COLOR 11: CALL clear_bottom_line: PRINT army_name$(active); " withdrew to "; city_name$(army_order(active));

CALL draw_army_flag(army_city(active))
CALL animate_army(active, 1)

army_city(active) = army_order(active)
CALL draw_army_flag(army_city(active))
CALL draw_army_flag(active)
city_army(army_city(active)) = active
army_order(active) = -2
	      
IF 11 * RND > army_leader_rating(defend) THEN CALL draw_map_marker(army_city(defend), army_order(defend), 4): IF army_order(defend) > 0 THEN army_order(defend) = -2

CALL wait_seconds(opt_pause!): GOTO digin
'==========================================================================
'                       Defender Retreats
'==========================================================================
kickbutt:
	CALL draw_map_marker(army_city(active), target, 4)
	IF army_order(defend) > 0 THEN CALL draw_map_marker(target, army_order(defend), 4)

	CALL menu_army_retreat(defend, flee): IF flee > 0 THEN move2 = flee: GOTO outta

	best = 0: flee = 0
	FOR i = 1 TO 6
	x = matrix(target, i)
	IF x > 0 AND (city_owner(x) = 3 - s) AND city_value(x) > best THEN
		IF best = 0 THEN
			flee = i: best = city_value(x)
		ELSE
			IF city_army(x) = 0 THEN flee = i: best = city_value(x)
		END IF
	END IF
	NEXT i
	IF flee = 0 GOTO deadmeat
	move2 = matrix(target, flee)
outta:
	CALL draw_army_flag(defend)                  ' in old city

	army_order(defend) = move2
	CALL animate_army(defend, 0)                 ' animate retreat
       
	army_city(defend) = move2
	city_army(move2) = defend
	CALL clear_bottom_line
	PRINT army_name$(defend) + " is withdrawing to " + city_name$(move2);

	CALL draw_army_flag(defend)                  ' in new city
       
	CALL draw_map_marker(target, 0, 6)
	army_order(defend) = -2
	GOTO holdon

deadmeat:
	index = defend
	a$ = army_name$(index) + " surrenders to " + army_name$(active) + " in " + city_name$(army_city(index))
	CALL scribe_message(a$, 2)
crushed:
	IF opt_graphics > 2 THEN CALL draw_surrender(index): COLOR 14: LOCATE 3, 68: PRINT army_name$(index): LOCATE 4, 68: PRINT "surrenders !"
	x = 1: IF index > 20 THEN x = 2
	IF opt_sound > 1 AND x <> current_side THEN PLAY "MFMST220o3e4g8g2.g8g8g8o4c2"
	IF army_order(index) > 0 THEN CALL draw_map_marker(army_city(index), army_order(index), 4)
	side_victory_points(3 - s) = side_victory_points(3 - s) + 25
	army_city(index) = 0: leader_name$(index) = "": army_name$(index) = ""
	army_size(index) = 0: army_leader_rating(index) = 0
	army_experience(index) = 0: army_order(index) = 0: army_supply(index) = 0
	army_supply(active) = army_supply(active) + army_supply(index): army_supply(index) = 0
	IF army_supply(active) > 10 THEN army_supply(active) = 10
	CALL wait_seconds(9): CALL clear_right_panel
	IF army_city(active) = 0 GOTO digin
'---------------------------------------------------------------------------
'                       check for more defenders !
'---------------------------------------------------------------------------
holdon:
	CALL city_update_occupier(target): IF city_army(target) = 0 GOTO easy
	COLOR 11: CALL clear_bottom_line: PRINT "There are still defenders in "; city_name$(target); : CALL wait_seconds(99)
	GOTO enemy
'==========================================================================
'                       Move Into New City
'==========================================================================
easy:
CALL draw_map_marker(army_city(active), target, 4)
army_city(active) = target: army_order(active) = -2
CALL city_update_occupier(army_city(active))
CALL draw_army_flag(active)
'---------------------------------------------------------------------------
'                            City Capture
'---------------------------------------------------------------------------
	IF city_owner(army_city(active)) = s GOTO horde
	c = army_city(active)
	IF opt_players = 1 AND s = current_side AND city_fort(c) > 0 AND flag = 0 THEN
		menu_col = 67: menu_row = 15
		menu_highlight = 15: menu_color = 3
		menu_text$(0) = "Raze ?"
		menu_text$(1) = "No"
		menu_text$(2) = "Yes"
		menu_item_count = 2
		CALL menu_select(0)
		CALL clear_right_panel
		IF menu_choice = 2 GOTO smoke
	END IF
	IF opt_players = 1 AND s <> current_side AND city_fort(c) > 0 AND flag = 0 THEN
		IF opt_realism > 0 AND city_y(c) > 150 THEN
smoke:
			city_fort(c) = 0
			x = city_x(c)
			y = city_y(c)
			LINE (x - 5, y - 5)-(x + 5, y + 5), 2, BF
			CALL draw_cities
			CALL clear_bottom_line
			PRINT army_name$(active); " has destroyed the forts at "; city_name$(c);
			wait_seconds 3
		END IF
	END IF
	CALL city_capture(active, c, s, flag)
horde:
IF army_supply(active) < 10 THEN army_supply(active) = army_supply(active) + 1: IF RND > .8 GOTO horde
digin:
NEXT j
GOTO allthru

upbox:
LINE (450, 318)-(526, 420), 1, BF
LINE (527, 315)-(527, 439), 10
COLOR 14: LOCATE 23, 50: PRINT "ษอออออออออออออป"
LOCATE 24, 50: PRINT "บ U P D A T E บ"
LOCATE 25, 50: PRINT "ศอออออออออออออผ"
RETURN

allthru:
IF fleet_size(raiding_side) < 1 THEN raiding_side = 0
IF raiding_side > 0 THEN
	CALL clear_bottom_line
	IF RND < .8 + .02 * fleet_size(raiding_side) THEN
		raid_loss = .05 * fleet_size(raiding_side) * (1 + RND) * (side_income(3 - raiding_side))
		IF raid_loss < 1 THEN raid_loss = 1
		IF raid_loss / side_income(3 - raiding_side) > .3 THEN raid_loss = .3 * side_income(3 - raiding_side)
		COLOR 15: PRINT side_name$(raiding_side); " raiders have sunk $"; raid_loss; " of "; side_name$(3 - raiding_side); " commerce";
		a = 1: IF LEFT$(fleet_ships$(raiding_side), 1) = "I" THEN a = 2
		PSET (500, 465), 0: CALL draw_ship_icon(raiding_side, a)
		IF opt_sound > 0 THEN PLAY "t210l8o4co3bo4l4co3ccL8gfego4co3bo4c"
		IF raiding_side = current_side THEN fleet_pursuit = 1
		wait_seconds 9
	ELSE
		raid_loss = 0
		CALL navy_remove_ship(raiding_side)
		COLOR 15: PRINT side_name$(raiding_side); " raiders have lost a ship ("; fleet_size(raiding_side); " remain)";
		IF opt_sound > 0 THEN SOUND 590, .5: SOUND 999, .5: SOUND 1999, .5
		IF fleet_city(raiding_side) > 0 THEN
			wait_seconds 9
			GOTO allthru
		ELSE
			raiding_side = 0
			LINE (447, 291)-(525, 335), 1, BF
			FOR k = 1 TO 5: CIRCLE (480, 315), 4 * k, 11: NEXT k
			wait_seconds 9
			LINE (447, 291)-(525, 335), 1, BF
		END IF
	END IF
END IF

CALL draw_map_touchup: CALL draw_fleets: CALL turn_date_and_supply

CALL clear_bottom_line
LINE (390, 350)-(520, 400), 1, BF
COLOR 13: LOCATE 24, 51: PRINT " "; UCASE$(LEFT$(month_name$(turn_month), 3)); ","; turn_year
side_victory_points(1) = .8 * side_victory_points(1) + .3 * (side_income(1) + side_city_count(1))
IF side_city_count(1) > 29 THEN side_victory_points(1) = side_victory_points(1) + 50: IF side_city_count(1) > 34 THEN side_victory_points(1) = side_victory_points(1) + 100
IF current_side = 2 AND side_city_count(1) < 11 THEN ai_strength_ratio! = ai_strength_ratio! + .7

IF side_victory_points(1) < 1 THEN side_victory_points(1) = 0
side_victory_points(2) = .8 * side_victory_points(2) + .3 * (side_income(2) + side_city_count(2))
IF side_city_count(2) > 29 THEN side_victory_points(2) = side_victory_points(2) + 50: IF side_city_count(2) > 34 THEN side_victory_points(2) = side_victory_points(1) + 100
IF current_side = 1 AND side_city_count(2) < 11 THEN ai_strength_ratio! = ai_strength_ratio! + .7
IF opt_players = 2 THEN CALL clear_bottom_line: COLOR 14: PRINT "press a key"; : CALL script_mark_key_wait(1, "K"): DO WHILE INKEY$ = "": LOOP
END SUB

