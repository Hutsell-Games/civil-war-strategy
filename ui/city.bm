' What a captured city and the map check show. The rules are in rules/city.bm.

SUB city_capture (active, c, side, weaken_fort)
DIM a$: DIM capital AS INTEGER: DIM razed AS INTEGER
	capital = 0: IF c = side_capital(other_side(side)) THEN capital = 1
	razed = 0: IF city_fort(c) > 0 AND weaken_fort > 0 THEN razed = 1
	CALL city_take(c, side, weaken_fort)
	CALL clear_bottom_line
	a$ = army_name$(active) + " has captured " + city_name$(c)
	COLOR COLOR_LIGHT_CYAN: PRINT army_name$(active) + " has captured " + city_name$(c);
	IF army_side(active) = SIDE_UNION AND opt_sound >= SOUND_MUSIC THEN PLAY "MNMFL16o2T120dd.dd.co1b.o2do3g.ab.bb.ag"
	IF army_side(active) = SIDE_REBEL AND opt_sound >= SOUND_MUSIC THEN PLAY "MNMFT160o2L16geL8ccL16cdefL8ggge"
	IF capital = 0 THEN CALL animate_city(c)
	IF capital = 1 THEN
		a$ = side_name$(other_side(side)) + " CAPITAL captured !"
		CALL scribe_message(a$, SHOW_LINE)
		CALL show_message_box(city_name$(c) + " has fallen!", 4)
		CALL animate_city(c)
	END IF
	IF razed = 1 THEN CALL city_redraw_fort(c)
END SUB

SUB check_map_links
DIM x AS INTEGER: DIM y AS INTEGER: DIM n AS INTEGER: DIM count AS INTEGER
DIM added(MAX_CITIES * MAX_ROADS) AS INTEGER: DIM from_city(MAX_CITIES * MAX_ROADS) AS INTEGER: DIM to_city(MAX_CITIES * MAX_ROADS) AS INTEGER
CLS : COLOR COLOR_WHITE
CALL city_fix_return_routes(count, added(), from_city(), to_city())
x = 0: y = 0
FOR n = 1 TO count
	IF added(n) = 1 THEN PRINT "+ Adding return route from "; city_name$(from_city(n)); " to "; city_name$(to_city(n)): y = y + 1
	IF added(n) = 0 THEN x = x + 1: PRINT "Error in CITIES.GRD entry for city #"; to_city(n); city_name$(from_city(n)); ": no return route to "; city_name$(to_city(n)): wait_seconds 1
NEXT n
IF x + y = 0 THEN PRINT "ALL MAP LINKS ARE OK": EXIT SUB
IF y > 0 THEN PRINT "* "; y; " fixes made to provide RETURN ROUTES"
IF x > 0 THEN PRINT "** "; x; " UNRESOLVED RETURN ROUTES"
END SUB
