' A land battle as the player sees it: both armies' strengths step by step and the odds, the
' picture of the fort, the winner and the losses. The rules are in rules/battle.bm.
SUB calculate_battle (attacker, defender, winner, loser)
    DIM attack_steps(7) AS INTEGER
    DIM defend_steps(8) AS INTEGER
    DIM attack_strength AS INTEGER
    DIM defend_strength AS INTEGER
    DIM rounds AS INTEGER
    DIM attacker_losses AS INTEGER
    DIM defender_losses AS INTEGER
    CALL battle_strengths(attacker, defender, attack_steps(), defend_steps())
    attack_strength = attack_steps(7)
    defend_strength = defend_steps(8)

    CALL draw_map_marker(army_city(defender), 0, MARK_POINTER)
    LOCATE 1, 1
    PRINT SPACE$(80)
    CALL clear_right_panel
    CALL draw_battle_attacker(attacker, attack_steps())
    CALL draw_battle_defender(attacker, defender, defend_steps())
    CALL draw_battle_odds(attack_strength, defend_strength)
    CALL wait_key("P")
    CALL draw_battle_fort(defender)
    CALL battle_fight(attack_strength, defend_strength, attacker, defender, winner, loser, rounds)
    CALL battle_cannon_sound(rounds)
    CALL draw_battle_winner(defender, winner, loser)
    CALL battle_losses(attacker, defender, winner, attacker_losses, defender_losses)
    CALL draw_battle_losses(attacker, defender, attacker_losses, defender_losses)
    CALL scribe_message(battle_history_line$(attacker, defender, winner, loser, attacker_losses, defender_losses), SHOW_HISTORY_ONLY)

    IF opt_players = PLAYERS_ONE AND (current_side = SIDE_UNION AND army_side(attacker) = SIDE_REBEL) OR (current_side = SIDE_REBEL AND army_side(attacker) = SIDE_UNION) THEN
        COLOR COLOR_YELLOW
        CALL clear_bottom_line
        PRINT "hit any key to continue";
        CALL wait_key("B")
    END IF

    CALL battle_apply_losses(attacker, defender, winner, attacker_losses, defender_losses)
    CALL draw_map_marker(army_city(defender), 0, MARK_RESTORE)
END SUB

' The attacker's half of the right panel: its name, its size and each step of its strength.
SUB draw_battle_attacker (attacker, attack_steps())
    DIM col AS INTEGER
    DIM side_color AS INTEGER
    col = 68
    COLOR COLOR_LIGHT_CYAN
    LOCATE 1, col
    PRINT "Attacker"
    side_color = side_color_of(army_side(attacker))
    COLOR side_color
    LOCATE 2, col
    PRINT army_name$(attacker)
    LOCATE 3, col
    CALL print_army_size(attacker)
    LOCATE 4, col
    PRINT "Base    "; attack_steps(1)
    LOCATE 5, col
    PRINT "Ldr/Exp "; attack_steps(2)
    LOCATE 6, col
    PRINT "Small   "; attack_steps(3)
    LOCATE 7, col
    PRINT "Outman  "; attack_steps(4)
    IF army_supply(attacker) < 1 THEN
        COLOR COLOR_LIGHT_MAGENTA
    END IF
    LOCATE 8, col
    PRINT "Supply  "; attack_steps(5)
    COLOR side_color
    LOCATE 9, col
    PRINT "Difclt  "; attack_steps(6)
    COLOR COLOR_LIGHT_CYAN
    LOCATE 11, col
    PRINT "Attack  "; attack_steps(7)
    LINE (530, 155)-(635, 175), 11, B
END SUB

' The defender's half of the right panel, below the attacker's, in the other side's color.
SUB draw_battle_defender (attacker, defender, defend_steps())
    DIM col AS INTEGER
    DIM side_color AS INTEGER
    DIM fort_label$
    col = 68
    side_color = side_color_of(army_side(attacker))
    COLOR COLOR_LIGHT_CYAN
    LOCATE 13, col
    PRINT "Defender"
    COLOR 16 - side_color
    LOCATE 14, col
    PRINT army_name$(defender)
    LOCATE 15, col
    CALL print_army_size(defender)
    LOCATE 16, col
    PRINT "Base    "; INT(.01 * army_size(defender))
    LOCATE 17, col
    PRINT "Defense "; defend_steps(1)
    LOCATE 18, col
    PRINT "Ldr/Exp "; defend_steps(2)
    LOCATE 19, col
    PRINT "Small   "; defend_steps(3)
    LOCATE 20, col
    PRINT "Outman  "; defend_steps(4)
    IF army_supply(defender) < 1 THEN
        COLOR COLOR_LIGHT_MAGENTA
    END IF
    LOCATE 21, col
    PRINT "Supply  "; defend_steps(5)
    COLOR 16 - side_color
    LOCATE 22, col
    PRINT "Difclt  "; defend_steps(6)
    fort_label$ = "Fort"
    IF city_fort(army_city(defender)) > 0 AND army_order(defender) = ORDER_NONE THEN
        COLOR COLOR_LIGHT_MAGENTA
        fort_label$ = "Fort+"
        IF city_fort(army_city(defender)) = MAX_FORT THEN
            fort_label$ = "Fort++"
        END IF
    END IF
    LOCATE 23, col
    PRINT fort_label$; TAB(76); defend_steps(7)
    COLOR COLOR_LIGHT_CYAN
    LOCATE 25, col
    PRINT "Defend  "; defend_steps(8)
    LINE (530, 380)-(635, 400), 11, B
END SUB

' The attacker's chance of winning, in whole percent and at least 1, such as "62%".
FUNCTION battle_odds_text$ (attack_strength, defend_strength)
    DIM odds!
    DIM odds_pct AS INTEGER
    odds! = attack_strength / (attack_strength + defend_strength)
    odds_pct = INT(100 * odds!)
    IF odds_pct < 1 THEN
        odds_pct = 1
    END IF
    battle_odds_text$ = LTRIM$(RTRIM$(STR$(odds_pct))) + "%"
END FUNCTION

' The odds, boxed at the foot of the right panel.
SUB draw_battle_odds (attack_strength, defend_strength)
    DIM col AS INTEGER
    col = 68
    COLOR COLOR_YELLOW
    LOCATE 27, col
    PRINT "Odds:  "; battle_odds_text$(attack_strength, defend_strength);
    LINE (530, 412)-(635, 435), 14, B
    LINE (528, 410)-(637, 437), 14, B
END SUB

' The cannon and the defender's fort with full graphics; otherwise an empty right panel.
SUB draw_battle_fort (defender)
    DIM fort_level AS INTEGER
    DIM file$
    IF opt_graphics >= GRAPHICS_FULL THEN
        CALL draw_cannon
        fort_level = city_fort(army_city(defender))
        file$ = GFXDIR + "fort" + LTRIM$(STR$(fort_level)) + ".vga"
        IF _FILEEXISTS(file$) THEN
            CALL load_picture(file$, pic_loaded())
            PUT (550, 270), pic_loaded(), PSET
        END IF
    ELSE
        CALL clear_right_panel
    END IF
END SUB

' Two notes of cannon fire for each round of the battle, when sound effects are on.
SUB battle_cannon_sound (rounds)
    DIM k AS INTEGER
    FOR k = 1 TO rounds
        IF opt_sound >= SOUND_EFFECTS THEN
            SOUND 77, .5
            SOUND 59, .5
            CALL wait_seconds(.1)
        END IF
    NEXT k
END SUB

' The winner's flag and name in the right panel, and who defeats whom on the bottom line.
SUB draw_battle_winner (defender, winner, loser)
    DIM winner_label$
    DIM winner_side AS INTEGER
    winner_label$ = "UNION"
    IF army_side(winner) = SIDE_REBEL THEN
        winner_label$ = "REBEL"
    END IF
    COLOR COLOR_YELLOW
    LOCATE 3, 68
    PRINT winner_label$; " VICTORY"
    LOCATE 4, 71
    PRINT "in"
    LOCATE 5, 69
    PRINT city_name$(army_city(defender))
    winner_side = army_side(winner)
    CALL draw_large_flag(winner_side, 0, 0)
    CALL clear_bottom_line
    COLOR COLOR_LIGHT_CYAN
    PRINT army_name$(winner); " defeats "; army_name$(loser); " in "; city_name$(army_city(defender));
    CALL wait_seconds(PAUSE_LONG)
END SUB

' Both sides' losses on the top line, in hundreds and as a percentage of each army.
SUB draw_battle_losses (attacker, defender, attacker_losses, defender_losses)
    DIM side_color AS INTEGER
    side_color = side_color_of(army_side(attacker))
    COLOR side_color
    LOCATE 1, 1
    PRINT "Attack Loss: ";
    PRINT LTRIM$(RTRIM$(STR$(attacker_losses)) + "00"); "/";
    CALL print_army_size(attacker)
    PRINT " ("; LTRIM$(RTRIM$(STR$(INT(100 * (attacker_losses / army_size(attacker)))))); "%) ²";
    COLOR 16 - side_color
    PRINT "² Defend Loss: ";
    PRINT LTRIM$(RTRIM$(STR$(defender_losses)) + "00"); "/";
    CALL print_army_size(defender)
    PRINT " ("; LTRIM$(RTRIM$(STR$(INT(100 * (defender_losses / army_size(defender)))))); "%)"
END SUB

' The battle's line in the history, such as "Memphis: *Grant (1200/15000)  defeats Polk (3000/9000)".
' The star marks the attacker. Each army shows its losses and its size before them, in men. The
' attacker's text ends in a space, so a winning attacker's is followed by two.
FUNCTION battle_history_line$ (attacker, defender, winner, loser, attacker_losses, defender_losses)
    DIM attacker_text$
    DIM defender_text$
    attacker_text$ = " (" + LTRIM$(RTRIM$(STR$(attacker_losses) + "00")) + "/" + LTRIM$(STR$(army_size(attacker)) + "00") + ") "
    defender_text$ = " (" + LTRIM$(RTRIM$(STR$(defender_losses) + "00")) + "/" + LTRIM$(STR$(army_size(defender)) + "00") + ")"
    IF winner = defender THEN
        battle_history_line$ = city_name$(army_city(defender)) + ": " + army_name$(winner) + defender_text$ + " defeats *" + army_name$(loser) + attacker_text$
    ELSE
        battle_history_line$ = city_name$(army_city(defender)) + ": *" + army_name$(winner) + attacker_text$ + " defeats " + army_name$(loser) + defender_text$
    END IF
END FUNCTION
