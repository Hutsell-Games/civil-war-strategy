SUB screen_snapshot (x, y, put_back)
IF put_back = 0 THEN GET (x - 10, y - 10)-(x + 10, y + 10), saved_under_marker
IF put_back = 1 THEN PUT (x - 10, y - 10), saved_under_marker, PSET
END SUB

SUB print_centered (y, text$)
DIM x AS INTEGER
x = LEN(text$)
x = 26 - x \ 2
LOCATE y, 7 + x: PRINT text$
END SUB

SUB clear_bottom_line
LOCATE 29, 1: PRINT SPACE$(79);
LOCATE 29, 1
END SUB

SUB clear_right_panel
VIEW (528, 1)-(639, 450)
CLS 1
VIEW
END SUB

SUB draw_train_box
DIM i AS INTEGER: DIM c AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER
IF train_army(1) + train_army(2) = 0 GOTO notrain
LINE (5, 17)-(100, 63), 3, BF
LINE (5, 17)-(100, 47), 0, B
LINE (5, 47)-(100, 63), 0, B

FOR i = 1 TO 2
IF train_army(i) = 0 GOTO notrane
PSET (15, 25), 3: c = 9: IF i = 2 THEN c = 15: PSET (60, 25), 3
DRAW "C0S4R9D4R6U3R3D3R7U5H3U2R9D3G2D6F1D3F5L10D1G1L4H2L7G2L3H2L3U8L2U5BF4"
x = POINT(0): y = POINT(1): PAINT (x, y), c, 0
LOCATE 4, 6 * (i - 1) + 2: PRINT LEFT$(city_name$(army_order(train_army(i))), 5)
notrane:
NEXT i

notrain:
END SUB

SUB wait_seconds (seconds!)
DIM start!
IF script_tick(seconds!) THEN EXIT SUB
start! = TIMER
DO WHILE TIMER - start! < seconds! AND INKEY$ = "": LOOP
END SUB

SUB draw_top_bar
DIM i AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER: DIM c AS INTEGER: DIM a$
	LOCATE 1, 1: PRINT SPACE$(80);
	COLOR 11
	LOCATE 1, 10: PRINT "Input your decisions now for "; side_name$(current_side); " side "; : COLOR 14: PRINT month_name$(turn_month); ","; turn_year; "  "

	CALL draw_flag((current_side), 0, 0)
	COLOR 4: IF opt_alt_colors > 0 THEN COLOR 7
	LOCATE 6, 68: PRINT "Difficulty "; LTRIM$(RTRIM$(STR$(opt_difficulty)))
	LOCATE 7, 68: PRINT "Funds:"; side_cash(current_side);

	FOR i = 1 TO 2: IF side_victory_points(i) < 0 THEN side_victory_points(i) = 0
	NEXT i
	x = side_victory_points(1) + side_victory_points(2): y = 0
	c = 9: IF current_side = 2 THEN c = 7
	LINE (580, 15)-(580, 35), 15
	LINE (530, 20)-(630, 30), 8 - c, BF
	IF x > 0 THEN y = 100 * (side_victory_points(current_side) / x)

	LINE (530, 20)-(530 + y, 30), c, BF
	COLOR c: LOCATE 4, 68: PRINT "VP :"; side_victory_points(current_side)

	LOCATE 5, 68: PRINT "("; y; "%)"

a$ = "  Snd": IF opt_sound < 2 THEN a$ = "   Snd": IF opt_sound = 0 THEN a$ = "      "
IF opt_graphics > 0 THEN a$ = a$ + " G" + LTRIM$(STR$(opt_graphics))
a$ = a$ + STR$(opt_players)
COLOR c
LOCATE 26, 68: PRINT "F3 Redrw Scrn"
LOCATE 27, 68: PRINT "F7 End Turn"
LOCATE 28, 68: PRINT a$
END SUB
