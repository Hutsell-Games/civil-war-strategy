' Parts of the screen that many SUBs share: the bottom line, the right panel and an army's
' numbers there, the top bar, the train's box, the screen between two players' turns, and
' the waits for a time or a key.

' Saves or restores the 21-by-21 pixel area centered on x and y using saved_under_marker().
SUB screen_snapshot (x, y, put_back)
    SELECT CASE put_back
        CASE SNAP_SAVE
            GET (x - 10, y - 10)-(x + 10, y + 10), saved_under_marker()
        CASE SNAP_RESTORE
            PUT (x - 10, y - 10), saved_under_marker(), PSET
    END SELECT
END SUB

' Prints text centered across the map area at the given text row.
SUB print_centered (row, text$)
    DIM col AS INTEGER
    col = LEN(text$)
    col = 26 - col \ 2
    LOCATE row, 7 + col
    PRINT text$
END SUB

SUB clear_bottom_line
    LOCATE 29, 1
    PRINT SPACE$(79);
    LOCATE 29, 1
END SUB

SUB clear_right_panel
    VIEW (528, 1)-(639, 450)
    CLS 1
    VIEW
END SUB

' Shows the trains carrying armies and their destination names in a box at the map's upper left.
SUB draw_train_box
    DIM i AS INTEGER
    DIM side_color AS INTEGER
    DIM x AS INTEGER
    DIM y AS INTEGER
    IF train_army(SIDE_UNION) + train_army(SIDE_REBEL) = 0 THEN
        EXIT SUB
    END IF
    LINE (5, 17)-(100, 63), 3, BF
    LINE (5, 17)-(100, 47), 0, B
    LINE (5, 47)-(100, 63), 0, B

    FOR i = SIDE_UNION TO SIDE_REBEL
        IF train_army(i) = 0 THEN
            _CONTINUE
        END IF
        PSET (15, 25), 3
        side_color = side_bright_color(i)
        IF i = SIDE_REBEL THEN
            PSET (60, 25), 3
        END IF
        DRAW "C0S4" + TRAIN_OUTLINE$ + "U8L2U5BF4"
        x = POINT(0)
        y = POINT(1)
        PAINT (x, y), side_color, 0
        LOCATE 4, 6 * (i - 1) + 2
        PRINT LEFT$(city_name$(army_order(train_army(i))), 5)
    NEXT i
END SUB

' Pauses for the requested time or until a key is pressed, using the script wait hook during scripted play.
SUB wait_seconds (seconds!)
    DIM start!
    IF script_tick(seconds!) THEN
        EXIT SUB
    END IF
    start! = TIMER
    DO WHILE TIMER - start! < seconds! AND INKEY$ = ""
        ' rest between checks, so that the wait does not use a whole processor core (and so that
        ' QBJS lets the browser deliver the key)
        _LIMIT 60
    LOOP
END SUB

' Waits until a key is pressed. The letter tells a script which wait this is (io/script.bm).
SUB wait_key (letter$)
    CALL script_mark_key_wait(1, letter$)
    DO WHILE INKEY$ = ""
        _LIMIT 60
    LOOP
END SUB

' Shows the current side and date above the map, with its flag, funds, victory points and settings in the right panel.
SUB draw_top_bar
    DIM i AS INTEGER
    DIM total_points AS INTEGER
    DIM percent AS INTEGER
    DIM side_color AS INTEGER
    DIM settings$
    LOCATE 1, 1
    PRINT SPACE$(80);
    COLOR COLOR_LIGHT_CYAN
    LOCATE 1, 10
    PRINT "Input your decisions now for "; side_name$(current_side); " side ";
    COLOR COLOR_YELLOW
    PRINT month_name$(turn_month); ","; turn_year; "  "

    CALL draw_large_flag((current_side), 0, 0)
    COLOR COLOR_RED
    IF opt_alt_colors > 0 THEN
        COLOR COLOR_GRAY
    END IF
    LOCATE 6, 68
    PRINT "Difficulty "; _TRIM$(STR$(opt_difficulty))
    LOCATE 7, 68
    PRINT "Funds:"; side_cash(current_side);

    FOR i = SIDE_UNION TO SIDE_REBEL
        IF side_victory_points(i) < 0 THEN
            side_victory_points(i) = 0
        END IF
    NEXT i
    total_points = side_victory_points(SIDE_UNION) + side_victory_points(SIDE_REBEL)
    percent = 0
    side_color = side_color_of(current_side)
    LINE (580, 15)-(580, 35), 15
    LINE (530, 20)-(630, 30), 8 - side_color, BF
    IF total_points > 0 THEN
        percent = 100 * (side_victory_points(current_side) / total_points)
    END IF

    LINE (530, 20)-(530 + percent, 30), side_color, BF
    COLOR side_color
    LOCATE 4, 68
    PRINT "VP :"; side_victory_points(current_side)

    LOCATE 5, 68
    PRINT "("; percent; "%)"

    settings$ = "  Snd"
    IF opt_sound < SOUND_MUSIC THEN
        settings$ = "   Snd"
        IF opt_sound = SOUND_OFF THEN
            settings$ = "      "
        END IF
    END IF
    IF opt_graphics >= GRAPHICS_BASIC THEN
        settings$ = settings$ + " G" + LTRIM$(STR$(opt_graphics))
    END IF
    settings$ = settings$ + STR$(opt_players)
    COLOR side_color
    LOCATE 26, 68
    PRINT "F3 Redrw Scrn"
    LOCATE 27, 68
    PRINT "F7 End Turn"
    LOCATE 28, 68
    PRINT settings$
END SUB

' The screen between two players' turns: whose turn it is. Waits for a key.
SUB draw_player_turn
    DIM side_color AS INTEGER
    side_color = side_panel_color(current_side)
    CLS
    LINE (100, 200)-(500, 300), side_color, BF
    LINE (100, 200)-(500, 300), 8 - side_color, B
    COLOR COLOR_GRAY
    LOCATE 14, 31
    PRINT " "; month_name$(turn_month); turn_year
    COLOR COLOR_LIGHT_CYAN
    LOCATE 17, 30
    PRINT side_name$(current_side); " PLAYER TURN"
    CALL wait_key("T")
END SUB

' The UPDATE box beside the map, shown while the month's moves are played.
SUB draw_update_box
    LINE (450, 318)-(526, 420), 1, BF
    LINE (527, 315)-(527, 439), 10
    COLOR COLOR_YELLOW
    LOCATE 23, 50
    PRINT "ษอออออออออออออป"
    LOCATE 24, 50
    PRINT "บ U P D A T E บ"
    LOCATE 25, 50
    PRINT "ศอออออออออออออผ"
END SUB

SUB draw_army_stats (army)
    LINE (530, 60)-(639, 150), 0, BF
    COLOR COLOR_WHITE
    LOCATE 5, 68
    PRINT army_name$(army)
    COLOR side_color_of(army_side(army))
    LOCATE 6, 68
    PRINT "Size:";
    CALL print_army_size(army)
    LOCATE 7, 68
    PRINT "Leader:"; TAB(75); army_leader_rating(army)
    LOCATE 8, 68
    PRINT "Exper:"; TAB(75); army_experience(army)
    IF army_supply(army) < 2 THEN
        COLOR COLOR_LIGHT_RED
    END IF
    LOCATE 9, 68
    PRINT "Supply:"; TAB(75); army_supply(army)
END SUB

' Prints the army's size in individual troops, converting the stored hundreds without starting a new line.
SUB print_army_size (army)
    PRINT troops_text$(army_size(army));
END SUB

' A number of troops, given in hundreds as the game keeps them: 35 is "3500".
FUNCTION troops_text$ (hundreds)
    troops_text$ = LTRIM$(STR$(hundreds)) + "00"
END FUNCTION
