' The player's Ships command: the Ships menu and a menu SUB for each of its actions. Each
' asks the player what the action needs, then gives the order (commands/navy.bm). The
' computer's fleet is ai_navy_carry_out (ai/navy.bm). The Ships menu itself is menu_navy, at
' the end of this file.

' The Ships command. The menu shows again while an action asks for it, for example after a
' ship is built.
SUB menu_navy_commands (side)
    DIM again AS INTEGER
    DIM quit AS INTEGER
    COLOR COLOR_LIGHT_CYAN
    DO
        CALL navy_mark_side(side)
        quit = FALSE
        CALL menu_navy(side, quit)
        IF quit THEN
            EXIT SUB
        END IF
        again = FALSE
        SELECT CASE menu_choice
            CASE 1
                CALL menu_navy_build(side, again)
            CASE 2
                CALL menu_navy_attack(side, again)
            CASE 3
                CALL menu_navy_sail(side, again)
            CASE 4
                CALL menu_navy_raid(side, again)
            CASE 5
                CALL menu_navy_invade(side)
        END SELECT
    LOOP WHILE again
END SUB

' Build: a ship is added to the fleet, or a new fleet is started in a sea port that the
' player picks. With the money for it, the player chooses wood or iron. Esc at either menu
' builds nothing. again is FALSE only when there is no port for a new fleet.
SUB menu_navy_build (side, again)
    DIM cost AS INTEGER
    DIM ship$
    DIM cities(MAX_CITIES) AS INTEGER
    DIM count AS INTEGER
    again = TRUE
    cost = ship_cost(SHIP_WOODEN$)
    IF NOT navy_can_build(side) THEN
        EXIT SUB
    END IF
    ship$ = SHIP_WOODEN$

    IF navy_has_ironclads AND side_cash(side) >= ship_cost(SHIP_IRONCLAD$) THEN
        menu_col = PANEL_COL
        menu_row = 12
        menu_color = COLOR_LIGHT_BLUE
        CALL menu_set_two("Type", "Wooden", "Ironclad")
        CALL menu_select(MENU_PLAIN, 1)
        CALL clear_right_panel
        IF menu_choice < 1 THEN
            EXIT SUB
        END IF
        IF menu_choice = 2 THEN
            ship$ = SHIP_IRONCLAD$
            cost = ship_cost(ship$)
        END IF
    END IF

    CALL navy_add_ship(side, ship$, cost)
    IF fleet_size(side) > 1 THEN
        CALL navy_ship_joins(side, ship$)
        EXIT SUB
    END IF
    CALL navy_list_shipyards(side, cities(), count)
    menu_text$(0) = "Port"
    CALL menu_set_cities(cities(), count)
    menu_col = PANEL_COL
    menu_row = 12
    IF menu_item_count < 1 THEN
        CALL navy_cancel_new_fleet(side)
        CALL clear_bottom_line
        PRINT "NO SHIPYARDS AVAILABLE !";
        again = FALSE
        EXIT SUB
    END IF
    CALL menu_select(MENU_CITY_POINTER, 1)
    CALL clear_right_panel
    ' Esc at the Port menu: the ship is not built. The original showed the menu again.
    IF menu_choice < 1 THEN
        CALL navy_cancel_new_fleet(side)
        EXIT SUB
    END IF
    CALL navy_fleet_founded(side, menu_value(menu_choice), ship$, cost)
END SUB

' Attack: the fleet bombards the city it lies off, if that is the enemy's. Only then has the
' fleet acted this month.
SUB menu_navy_attack (side, again)
    again = FALSE
    IF NOT navy_can_attack(side) THEN
        IF fleet_exists(side) THEN
            again = TRUE
        END IF
        EXIT SUB
    END IF
    CALL turn_set_navy_done(TRUE)
    CALL navy_bombard(side)
END SUB

' Sail: the player picks a port, and the fleet goes there. It fights the enemy's fleet if
' that is there.
SUB menu_navy_sail (side, again)
    DIM sailed AS INTEGER
    DIM cities(MAX_CITIES) AS INTEGER
    DIM count AS INTEGER
    again = FALSE
    CALL navy_count_ships(side)
    IF NOT fleet_exists(side) OR fleet_size(side) < 1 THEN
        CALL navy_say_no_ships
        again = TRUE
        EXIT SUB
    END IF

    CALL navy_list_ports(side, cities(), count)
    CALL menu_set_cities(cities(), count)
    COLOR COLOR_LIGHT_CYAN
    LOCATE 11, 68
    IF NOT fleet_is_at_sea(side) THEN
        PRINT city_name$(fleet_city(side))
    ELSE
        PRINT "Raiding"
    END IF
    menu_text$(0) = "To"
    menu_color = COLOR_CYAN
    menu_col = PANEL_COL
    menu_row = 12

    CALL menu_select(MENU_CITY_POINTER, 1)
    CALL clear_right_panel
    IF menu_choice < 1 THEN
        EXIT SUB
    END IF
    CALL navy_sail_to(side, menu_value(menu_choice), sailed)
    IF NOT sailed THEN
        EXIT SUB
    END IF
    CALL turn_set_navy_done(TRUE)
    IF fleet_city(SIDE_UNION) = fleet_city(SIDE_REBEL) THEN
        CALL menu_navy_combat(side)
    END IF
    CALL navy_finish_move
END SUB

' Raid: the fleet goes to sea to raid the other side's commerce. It fights the enemy's fleet
' if that is at sea too.
SUB menu_navy_raid (side, again)
    again = FALSE
    CALL navy_count_ships(side)
    IF NOT navy_can_raid(side) THEN
        again = TRUE
        EXIT SUB
    END IF

    CALL turn_set_navy_done(TRUE)
    CALL navy_start_raid(side)
    IF fleet_city(SIDE_UNION) = fleet_city(SIDE_REBEL) THEN
        CALL menu_navy_combat(side)
        CALL navy_finish_move
        EXIT SUB
    END IF
    CALL navy_redraw_map
END SUB

' Invasion: a ship lands a new army in the neutral city the fleet lies off. With no commander
' left it lands none.
SUB menu_navy_invade (side)
    DIM army_slot AS INTEGER
    CALL army_get_commander((side), army_slot)
    IF army_slot = 0 THEN
        EXIT SUB
    END IF
    CALL navy_land_army(side, army_slot)
    CALL turn_set_navy_done(TRUE)
END SUB

' Ship against ship, for the player's fleet: before each volley the player chooses to attack
' or to retreat to a port. With no other sea port the fleet cannot retreat, and the player
' chooses again.
SUB menu_navy_combat (side)
    DIM combat_over AS INTEGER
    DIM hits(SIDE_REBEL)
    CALL navy_combat_begin(hits())
    DO
        CALL navy_combat_draw
        DO
            CALL menu_set_two("Options", "Attack", "Retreat")
            menu_color = COLOR_CYAN
            menu_highlight = COLOR_YELLOW
            menu_col = 50
            menu_row = 18
            CALL menu_select(MENU_NO_KEYS, 1)
        LOOP UNTIL menu_choice = 1 OR menu_choice = 2
        IF menu_choice = 2 THEN
            IF navy_has_retreat_port(side) THEN
                CALL navy_combat_retreat(side)
                EXIT SUB
            END IF
            CALL clear_bottom_line
            COLOR COLOR_LIGHT_CYAN
            PRINT side_name$(side); " has no port to retreat to";
            CALL wait_seconds(opt_pause!)
        ELSE
            CALL navy_combat_volley(side, hits(), combat_over)
        END IF
    LOOP UNTIL combat_over
END SUB

' The Ships menu for the player. quit is TRUE when the fleet has acted this month. The main menu
' opens Ships only before that, and each action that acts also ends the Ships menu, so quit
' stays 0 (in the original, an Attack on no enemy city set it).
SUB menu_navy (side, quit)
    DIM start_row AS INTEGER
    CALL clear_bottom_line
    PRINT "Funds available "; side_cash(side);
    CALL menu_navy_items(side, start_row)
    IF turn_navy_done AND menu_choice <> 1 THEN
        quit = TRUE
        EXIT SUB
    END IF
    CALL menu_select(MENU_PLAIN, start_row)
    CALL clear_right_panel
END SUB

' Fills the Ships menu: Build, Attack, Sail and Raid, each "-" when the fleet cannot do it,
' and Invasion when the fleet lies off a neutral city. start_row is the row the menu starts on.
SUB menu_navy_items (side, start_row)
    start_row = 1
    menu_text$(0) = "Ships"
    menu_text$(1) = "Build"
    IF NOT fleet_is_at_sea(side) THEN
        IF NOT navy_can_build(side) THEN
            menu_text$(1) = "-"
            start_row = 2
        END IF
    END IF
    menu_text$(2) = "Attack"
    IF NOT fleet_is_at_sea(side) THEN
        IF NOT navy_can_attack(side) THEN
            menu_text$(2) = "-"
            start_row = 1
            ' With Build "-" too, Sail. The original started on the "-" of Build.
            IF menu_text$(1) = "-" THEN
                start_row = 3
            END IF
        END IF
    ELSE
        menu_text$(1) = "-"
        menu_text$(2) = "-"
        start_row = 3
    END IF
    menu_text$(3) = "Sail"
    IF NOT fleet_exists(side) THEN
        menu_text$(3) = "-"
    END IF
    menu_text$(4) = "Raid"
    IF NOT navy_can_raid(side) THEN
        menu_text$(4) = "-"
    END IF
    menu_col = PANEL_COL
    menu_row = 12
    menu_item_count = 4
    IF navy_can_invade(side) THEN
        menu_item_count = 5
        menu_text$(5) = "Invasion"
    END IF
END SUB
