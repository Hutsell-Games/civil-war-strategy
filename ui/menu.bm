SUB menu_bubble_sort (limit)
DIM FALSE AS INTEGER: DIM i AS INTEGER: DIM swaps%
DO
	swaps% = FALSE
	FOR i = 1 TO limit - 1
	IF menu_text$(i) > menu_text$(i + 1) THEN
		SWAP menu_text$(i), menu_text$(i + 1)
		SWAP menu_value(i), menu_value(i + 1)
		swaps% = i
	END IF
	NEXT i
LOOP WHILE swaps%
END SUB

'============================================================================
'                GENmenu 3.05 : Generic Menu Main Module Level  12/91
'                Updated to Use Graphic Screens 8, 9, 12
'============================================================================
'       tlx  = top left x  (if zero, automatically centered)
'       tly = top left y   (if zero, automatically centered)
'       size = # rows (current maximum=20)
'       mtx$() = text for menu
'                mtx$(0) = heading (blank defaults to M E N U)
'                mtx$(1-size) are options
'       choose = option selected (row #)
'            -1 indicates ESC key pressed
'            entering with choose+21 causes choose to be default entry
'       wtype = window type (0 = no line; 1=single line;
'                            2=double line
'               if >10 then 10's digit=box color  1's digit= window type

SUB draw_menu (b1, wide)
DIM boxc AS INTEGER: DIM i AS INTEGER
boxc = menu_color: IF menu_box_type > 10 THEN boxc = INT(menu_box_type / 10): menu_box_type = menu_box_type - 10 * boxc
COLOR boxc
VIEW (8 * menu_col - 6, 16 * menu_row - 11)-(8 * (menu_col + wide + 1) + 7, 16 * (menu_row + menu_item_count + 2) + 8)
CLS 1
VIEW
LINE (8 * menu_col - 6, 16 * menu_row - 11)-(8 * (menu_col + wide + 1) + 7, 16 * (menu_row + menu_item_count + 2) + 8), menu_color, B
LINE (8 * menu_col - 2, 16 * (menu_row + 1) + 3)-(8 * (menu_col + wide + 1) + 3, 16 * (menu_row + 1) + 6), menu_color, B
IF ABS(menu_box_type) = BOX_DOUBLE THEN
LINE (8 * menu_col - 2, 16 * menu_row - 8)-(8 * (menu_col + wide + 1) + 3, 16 * (menu_row + menu_item_count + 2) + 4), menu_color, B
END IF
COLOR menu_color

LOCATE menu_row + 1, menu_col + b1: PRINT menu_text$(0)
FOR i = 1 TO menu_item_count
LOCATE menu_row + 2 + i, menu_col + 2: PRINT menu_text$(i);
NEXT i
END SUB

SUB menu_select (menu_item_show_beside%)
DIM row1 AS INTEGER: DIM brx AS INTEGER: DIM a AS INTEGER: DIM leave AS INTEGER: DIM a$: DIM k AS INTEGER: DIM c1$
DIM wide AS INTEGER: DIM row AS INTEGER: DIM bry AS INTEGER: DIM boxc AS INTEGER: DIM b1 AS INTEGER: DIM target AS INTEGER: DIM flag AS INTEGER: DIM t$: DIM x AS INTEGER: DIM y AS INTEGER
remenu:
	IF menu_color = 0 THEN menu_color = COLOR_GRAY
	LOCATE 1, 1, 0
	IF menu_text$(0) = "" THEN menu_text$(0) = "M E N U"

	IF wide = 0 THEN wide = menu_measure_width
	IF menu_col = 0 THEN GOSUB noadjust
	IF menu_choice < MENU_START THEN menu_choice = 1
	IF menu_choice > MENU_START THEN menu_choice = menu_choice - MENU_START
	IF menu_choice > 21 THEN menu_choice = 1
	row = menu_choice: IF row < 1 THEN row = 1
	IF row > menu_item_count THEN row = 1
	menu_choice = row
	row1 = row
       
	IF menu_row = 0 THEN menu_row = INT(11.5 - .5 * menu_item_count)
	IF menu_row + menu_item_count > 26 THEN menu_row = 26 - menu_item_count
       
	brx = menu_col + wide + 1
	bry = menu_row + menu_item_count + 3
       
	boxc = menu_color: IF menu_box_type > 10 THEN boxc = INT(menu_box_type / 10): menu_box_type = menu_box_type - 10 * boxc

	COLOR boxc

	VIEW (8 * menu_col - 6, 16 * menu_row - 11)-(8 * (menu_col + wide + 1) + 7, 16 * (menu_row + menu_item_count + 2) + 8)
	CLS 1
	VIEW
	LINE (8 * menu_col - 6, 16 * menu_row - 11)-(8 * (menu_col + wide + 1) + 7, 16 * (menu_row + menu_item_count + 2) + 8), menu_color, B
	LINE (8 * menu_col - 2, 16 * (menu_row + 1) + 3)-(8 * (menu_col + wide + 1) + 3, 16 * (menu_row + 1) + 6), menu_color, B
	IF ABS(menu_box_type) = BOX_DOUBLE THEN
		LINE (8 * menu_col - 2, 16 * menu_row - 8)-(8 * (menu_col + wide + 1) + 3, 16 * (menu_row + menu_item_count + 2) + 4), menu_color, B
	END IF

	COLOR menu_color
	b1 = INT(.5 * (wide - LEN(menu_text$(0))) + .5) + 1

	CALL draw_menu(b1, wide)
sel1:
	SELECT CASE menu_item_show_beside
		CASE MENU_CITY_BOX: CALL draw_map_marker(menu_value(row), 0, MARK_BOX)
		CASE MENU_CITY_ARMY: CALL draw_map_marker(menu_value(row), 0, MARK_POINTER)
			target = city_army(menu_value(row))
			IF target > 0 THEN
			flag = 1
			t$ = army_name$(target)
			IF LEN(t$) > wide THEN t$ = LEFT$(t$, wide)
			COLOR COLOR_LIGHT_RED
			LOCATE menu_row + 2 + row, menu_col + 2: PRINT SPACE$(wide);
			LOCATE menu_row + 2 + row, menu_col + 2: PRINT t$;
			LOCATE menu_row + 4 + menu_item_count, menu_col + 1: PRINT SPACE$(12);
			LOCATE menu_row + 4 + menu_item_count, menu_col + 1: PRINT "Size"; army_size(target);
			x = POS(0): y = CSRLIN: LOCATE y, x - 1: PRINT "00";
			ELSE
			flag = 0
			LOCATE menu_row + 4 + menu_item_count, menu_col + 1: PRINT SPACE$(12);
			END IF
		CASE MENU_ARMY_STATS: CALL draw_army_stats(menu_value(row))
		CASE MENU_ARMY_POINTER: CALL draw_map_marker(army_city(menu_value(row)), 0, MARK_POINTER)
		CASE MENU_FACES
			IF opt_graphics >= GRAPHICS_FULL AND row > 0 THEN
				LINE (548, 148)-(592, 216), 15, B
				a = row: IF current_side = SIDE_UNION THEN a = 6 - row
				t$ = GFXDIR + "face" + LTRIM$(STR$(a)) + ".vga"
				IF LEN(DIR$(t$)) > 0 THEN
					DEF SEG = VARSEG(pic_face(1))
					BLOAD t$, VARPTR(pic_face(1))
					DEF SEG
					PUT (550, 150), pic_face, PSET
					IF current_side = SIDE_REBEL THEN
						PAINT (560, 160), 8, 0
						PAINT (570, 155), 7, 0
					END IF
				END IF
			END IF
		CASE MENU_CITY_POINTER: CALL draw_map_marker(menu_value(row), 0, MARK_POINTER)
	END SELECT
	IF flag = 0 THEN
		COLOR menu_highlight
		LOCATE menu_row + 2 + row, menu_col + 2
		PRINT menu_text$(row)
		IF opt_alt_colors > 0 THEN LINE (8 * (menu_col + 1), 16 * (menu_row + row + 1))-(8 * (menu_col + LEN(menu_text$(row)) + 1) - 1, 16 * (menu_row + row + 2) - 1), menu_highlight, B
	END IF
	leave = 0: GOSUB crsr
	IF leave = 1 GOTO called
	IF menu_item_show_beside <> MENU_RAW_KEYS GOTO reglr
	IF a$ = KEY_UP$ THEN menu_choice = 1: GOTO called
	IF ASC(a$) = KEY_ENTER THEN menu_choice = 2: GOTO called
	IF a$ = KEY_DOWN$ THEN menu_choice = 3: GOTO called
reglr:
	IF ASC(a$) = KEY_ENTER GOTO called
	IF menu_item_show_beside = MENU_CITY_ARMY THEN LOCATE menu_row + 2 + row1, menu_col + 2: PRINT SPACE$(wide);
	COLOR menu_color
	LOCATE menu_row + 2 + row1, menu_col + 2: PRINT menu_text$(row1)

	SELECT CASE menu_item_show_beside
		CASE MENU_CITY_BOX, MENU_CITY_ARMY, MENU_CITY_POINTER
			IF menu_text$(row1) <> "EXIT" THEN CALL draw_map_marker(menu_value(row1), 0, MARK_RESTORE)
		CASE MENU_ARMY_POINTER
			IF menu_text$(row1) <> "EXIT" THEN CALL draw_map_marker(army_city(menu_value(row1)), 0, MARK_RESTORE)
	END SELECT

	menu_choice = row
	GOTO sel1
crsr:   CALL script_mark_key_wait(2, menu_text$(0)): DO: a$ = INKEY$: LOOP WHILE a$ = ""
	IF ASC(a$) = KEY_ENTER THEN RETURN
	IF LEN(a$) = 2 GOTO arrows
	IF menu_item_show_beside = MENU_RAW_KEYS THEN menu_choice = -ASC(UCASE$(a$)): leave = 1: RETURN
	IF ASC(a$) = KEY_ESC THEN menu_choice = MENU_ESCAPED: leave = 1: RETURN
		row1 = row
		FOR k = 1 TO menu_item_count
		c1$ = UCASE$(LEFT$(LTRIM$(menu_text$(k)), 1))
		IF c1$ = UCASE$(a$) THEN menu_choice = k: GOSUB limits: leave = 1: RETURN
		NEXT k
	GOTO crsr
arrows:
	a$ = RIGHT$(a$, 1)
	row1 = row
	 IF a$ = KEY_UP$ THEN row = row - 1: GOSUB limits: RETURN
	 IF a$ = KEY_PAGE_UP$ THEN row = 1: GOSUB limits: RETURN
	 IF a$ = KEY_DOWN$ THEN row = row + 1: GOSUB limits: RETURN
	 IF a$ = KEY_PAGE_DOWN$ THEN row = menu_item_count: GOSUB limits: RETURN
	 IF a$ = KEY_F3$ AND menu_item_show_beside = MENU_PLAIN THEN
		CLS
		CALL draw_map
		CALL draw_menu(b1, wide)
		CALL draw_top_bar
		RETURN
	 END IF
	 IF a$ = KEY_F7$ AND menu_item_show_beside = MENU_PLAIN THEN
		menu_choice = MENU_END_TURN_KEY
		leave = 1
		RETURN
	 END IF
	 IF a$ = KEY_F4$ AND menu_item_show_beside = MENU_PLAIN THEN
		CALL menu_report(-1)
		CALL draw_menu(b1, wide)
		CALL draw_top_bar
		RETURN
	 END IF
	 RETURN

limits:
	IF row > menu_item_count THEN row = 1
	IF row < 1 THEN row = menu_item_count
	RETURN
noadjust:
	IF menu_col = 0 THEN menu_col = INT(40.5 - .5 * wide)
	RETURN
called:
	IF opt_sound >= SOUND_EFFECTS THEN SOUND 700, .5
	COLOR menu_color
	menu_col = 0: menu_row = 0
	SELECT CASE menu_item_show_beside
	CASE MENU_CITY_BOX, MENU_CITY_ARMY, MENU_CITY_POINTER
		CALL draw_map_marker(menu_value(row), 0, MARK_RESTORE)
	CASE MENU_ARMY_POINTER
		CALL draw_map_marker(army_city(menu_value(row)), 0, MARK_RESTORE)
	END SELECT
	VIEW
END SUB

' The width a menu needs: its longest option, or its title and a space.
FUNCTION menu_measure_width
DIM i AS INTEGER: DIM x AS INTEGER: DIM wide AS INTEGER
	wide = LEN(menu_text$(0)) + 1
	FOR i = 1 TO menu_item_count
	x = LEN(menu_text$(i))
	IF x > wide THEN wide = x
	NEXT i
	menu_measure_width = wide
END FUNCTION
