SUB draw_army_stats (army)
LINE (530, 60)-(639, 150), 0, BF
COLOR COLOR_WHITE
LOCATE 5, 68: PRINT army_name$(army)
COLOR COLOR_LIGHT_BLUE: IF army_side(army) = SIDE_REBEL THEN COLOR COLOR_GRAY
LOCATE 6, 68: PRINT "Size:"; : CALL print_army_size(army)
LOCATE 7, 68: PRINT "Leader:"; TAB(75); army_leader_rating(army)
LOCATE 8, 68: PRINT "Exper:"; TAB(75); army_experience(army)
IF army_supply(army) < 2 THEN COLOR COLOR_LIGHT_RED
LOCATE 9, 68: PRINT "Supply:"; TAB(75); army_supply(army)
END SUB

SUB print_army_size (army)
DIM a$
a$ = LTRIM$(RTRIM$(STR$(army_size(army)))) + "00"
PRINT a$;
END SUB

SUB menu_victory_conditions
DIM a$: DIM t$: DIM i AS INTEGER: DIM chosit AS INTEGER
	a$ = STR$(ABS(victory_rule(VICTORY_CITIES)) * 2.5) + "% Cities"
	t$ = STR$(ABS(victory_rule(VICTORY_CITIES)) * 2.5) + "% Total Income"
	menu_text$(8) = "Time: " + month_name$(victory_rule(VICTORY_MONTH)) + STR$(ABS(victory_rule(VICTORY_YEAR)))
	menu_text$(9) = RTRIM$(STR$(ABS(victory_rule(VICTORY_FORCE_RATIO)))) + ":1 Force Ratio"
	COLOR COLOR_WHITE: LOCATE 1, 1: PRINT "Press ENTER to toggle ending conditions";
	COLOR COLOR_YELLOW: PRINT "				ESC when done"
what4:
	FOR i = 2 TO 6: IF victory_rule(i) > 0 THEN menu_text$(i - 1) = "û " ELSE menu_text$(i - 1) = "  "
	NEXT i
	menu_choice = chosit
	menu_text$(0) = "Victory Conditions"
	menu_text$(1) = menu_text$(1) + menu_text$(8)
	menu_text$(2) = menu_text$(2) + a$
	menu_text$(3) = menu_text$(3) + t$
	menu_text$(4) = menu_text$(4) + "Capital Captured"
	menu_text$(5) = menu_text$(5) + menu_text$(9)
	menu_text$(6) = "DONE"
	menu_box_type = BOX_DOUBLE: menu_color = COLOR_CYAN: menu_item_count = 6: menu_highlight = COLOR_YELLOW
	CALL menu_select(MENU_PLAIN)
	chosit = 21 + menu_choice
SELECT CASE menu_choice
	CASE 1
	CALL victory_toggle_rule(VICTORY_YEAR)
	CASE 2 TO 5
	CALL victory_toggle_rule(menu_choice + 1)
	CASE ELSE
	GOTO cheer
END SELECT
	GOTO what4
cheer:
	CLS
	CALL draw_map
END SUB

SUB menu_report (side)
menu_text$(0) = "Information"
menu_text$(1) = sides(current_side).name + " Armies"
menu_text$(2) = sides(other_side(current_side)).name + " Armies"
menu_text$(3) = "Cities"
menu_text$(4) = "Force Summary"
menu_text$(5) = "Intelligence"
menu_text$(6) = "Battles": menu_item_count = 6
IF LEN(DIR$("cws.his")) > 0 THEN menu_text$(7) = "Recap": menu_item_count = 7
CALL menu_select(MENU_PLAIN)
SELECT CASE menu_choice
CASE IS < 0
	CLS
	CALL draw_map
	EXIT SUB
CASE 2: CALL report_armies(other_side(current_side))
CASE 3: CALL report_cities
CASE 4: CALL report_force_summary
CASE 5: CALL report_intelligence
CASE 6: CALL report_battle_summary
CASE 7: CALL report_recap
CASE ELSE: CALL report_armies(side)
END SELECT
CLS
CALL draw_map
END SUB

'..........................................................................
'                               Army Report
'..........................................................................
SUB report_armies (side)
DIM fin AS INTEGER: DIM i AS INTEGER: DIM k AS INTEGER: DIM star AS INTEGER
DIM c AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER
star = side_first_army(side): fin = side_last_army(side)
CLS : LOCATE 1, 1: c = 9: IF side = SIDE_REBEL THEN c = 15
COLOR c
PRINT " Report for "; sides(side).name; " Forces"; TAB(30); month_name$(turn_month); ","; turn_year; TAB(49); : COLOR COLOR_YELLOW: PRINT " Victory Points "; sides(side).victory_points;
IF c = 15 THEN c = 7
x = sides(side).victory_points + sides(other_side(side)).victory_points
IF x = 0 THEN
	PRINT
ELSE
	y = (sides(side).victory_points / x) * 100
	PRINT "("; y; " %)";
END IF
CALL draw_flag_icon(215, 8, side)
COLOR c: PRINT sides(side).city_count; "/ 40"; TAB(15); "CITIES CONTROLLED"; TAB(40); : PRINT "("; : x = INT(sides(side).city_count * 2.5 + .5): PRINT x; "%)";
PRINT TAB(50); : COLOR COLOR_LIGHT_RED: PRINT "Capital: "; city_name$(sides(side).capital)
y = total_income: IF sides(SIDE_UNION).capital > 0 THEN y = y + CAPITAL_INCOME
IF sides(SIDE_REBEL).capital > 0 THEN y = y + CAPITAL_INCOME
PRINT sides(side).income; "/"; y; TAB(15); "INCOME"; TAB(40); "("; : x = (sides(side).income / total_income) * 100: PRINT x; "%)   "; : COLOR COLOR_YELLOW: PRINT "Cash:"; sides(side).cash
COLOR COLOR_LIGHT_CYAN: PRINT " #      Name             Size  Location   Ldr Exp Suply Move To"
x = 0: FOR i = star TO fin
COLOR c
IF army_city(i) < 1 GOTO deadeye
x = x + army_size(i)
PRINT i; TAB(5); army_name$(i); TAB(25); : y = CSRLIN
CALL print_army_size(i): PRINT TAB(32); city_name$(army_city(i));
IF side <> current_side THEN PRINT : GOTO deadeye
PRINT TAB(43); army_leader_rating(i); TAB(47); army_experience(i); TAB(52); army_supply(i);
PRINT TAB(57); : IF army_order(i) > -1 THEN PRINT city_name$(army_order(i)) ELSE PRINT "Resting"
IF city_fort(army_city(i)) > 0 THEN LOCATE y, 68: PRINT "FORT +"; city_fort(army_city(i))
deadeye:
NEXT i
PRINT " "; STRING$(70, "Ä")
PRINT " Total Forces "; TAB(25); LTRIM$(STR$(x)); "00"; TAB(40); "[ Enemy Forces "; LTRIM$(STR$(INT(ai_strength_ratio! * x))); "00 ]"
PRINT " "; STRING$(70, "Ä")
PRINT " "; sides(side).name; " NAVY has "; fleet_size(side); " ship(s) ";
x = 0
FOR k = 1 TO fleet_size(side)
	IF MID$(fleet_ships$(side), k, 1) = "I" THEN x = x + 1
NEXT k
IF x > 0 THEN PRINT "("; x; "Ironclads) ";
IF fleet_city(side) > 0 AND fleet_city(side) < FLEET_AT_SEA THEN PRINT "in "; city_name$(fleet_city(side)) ELSE PRINT
IF train_army(side) > 0 THEN COLOR COLOR_YELLOW: PRINT " Army #"; train_army(side); army_name$(train_army(side)); " on train to "; city_name$(army_order(train_army(side)));
LINE (0, 0)-(639, 449), 15, B
LINE (0, 62)-(639, 62), 15
CALL report_wait_key
END SUB

'..........................................................................
'                               City Report
'..........................................................................
SUB report_cities
DIM i AS INTEGER: DIM a$
CLS : LOCATE 1, 1: COLOR COLOR_YELLOW
PRINT "City Report"; TAB(20); month_name$(turn_month); ","; turn_year: COLOR COLOR_WHITE
PRINT " #    City       Control   Value"; TAB(41); " #    City       Control   Value"
LINE (1, 30)-(630, 30), 15
FOR i = 1 TO 20: COLOR COLOR_RED: a$ = "neutral": IF city_owner(i) = SIDE_UNION THEN COLOR COLOR_LIGHT_BLUE: a$ = "UNION"
IF city_owner(i) = SIDE_REBEL THEN COLOR COLOR_GRAY: a$ = "REBEL"
LOCATE 2 + i, 1: PRINT i; TAB(6); city_name$(i); TAB(18); a$; TAB(29); city_value(i)
NEXT i

FOR i = 21 TO 40: COLOR COLOR_RED: a$ = "neutral": IF city_owner(i) = SIDE_UNION THEN COLOR COLOR_LIGHT_BLUE: a$ = "UNION"
IF city_owner(i) = SIDE_REBEL THEN COLOR COLOR_GRAY: a$ = "REBEL"
LOCATE i - 18, 41: PRINT i; TAB(46); city_name$(i); TAB(58); a$; TAB(69); city_value(i)
NEXT i
LINE (1, 360)-(630, 360), 15
COLOR COLOR_LIGHT_BLUE: LOCATE 24, 1: PRINT "Side    No. Cities   Income    Cash"
COLOR COLOR_LIGHT_BLUE: PRINT sides(SIDE_UNION).name; TAB(12); sides(SIDE_UNION).city_count; TAB(23); sides(SIDE_UNION).income; TAB(32); sides(SIDE_UNION).cash
COLOR COLOR_GRAY: PRINT sides(SIDE_REBEL).name; TAB(12); sides(SIDE_REBEL).city_count; TAB(23); sides(SIDE_REBEL).income; TAB(32); sides(SIDE_REBEL).cash
COLOR COLOR_RED: PRINT sides(SIDE_NONE).name; TAB(12); MAX_CITIES - sides(SIDE_UNION).city_count - sides(SIDE_REBEL).city_count
LINE (1, 382)-(630, 382), 15
CALL report_wait_key
END SUB

'..........................................................................
'                               Intelligence
'..........................................................................
SUB report_intelligence
DIM fin AS INTEGER: DIM k AS INTEGER: DIM z AS INTEGER: DIM j AS INTEGER
DIM star AS INTEGER: DIM c AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER
c = 9: IF current_side = SIDE_REBEL THEN c = 7
CALL draw_map
star = side_first_army(current_side): fin = side_last_army(current_side)
FOR k = star TO fin
	IF army_size(k) > 0 THEN
	COLOR c
	x = city_x(army_city(k))
	y = city_y(army_city(k))
	z = 10: IF army_size(k) < 1000 THEN z = 9
	x = x / 8 - 2: y = y / 16
	IF y > 26 THEN y = 26
	FOR j = 0 TO 3
	LOCATE y + j, x: PRINT SPACE$(z);
	NEXT j
	LOCATE y, x: PRINT "Siz:"; : CALL print_army_size(k)
	LOCATE y + 1, x: PRINT "Ldr:"; army_leader_rating(k)
	LOCATE y + 2, x: PRINT "Xpr:"; army_experience(k)
	LOCATE y + 3, x: PRINT "Sup:"; army_supply(k);
	LINE (8 * (x - 1) - 1, 16 * (y - 1) - 1)-(8 * (x + z - 1) + 1, 16 * (y + 3) + 1), 15, B
	wait_seconds 1
END IF
NEXT k
CALL report_wait_key
END SUB

'..........................................................................
'                               Force Summary
'..........................................................................
SUB report_force_summary
DIM k AS INTEGER: DIM j AS INTEGER: DIM c AS INTEGER
DIM summ(MAX_CITIES)
FOR k = 1 TO MAX_CITIES
	IF city_army(k) > 0 THEN
		FOR j = 1 TO MAX_ARMIES
		IF army_city(j) = k THEN summ(k) = summ(k) + army_size(j)
		NEXT j
	END IF
NEXT k

CLS : CALL draw_map
FOR k = 1 TO MAX_CITIES
IF summ(k) > 0 THEN
	c = 9: IF city_owner(k) = SIDE_REBEL THEN c = 7
	COLOR c
	LOCATE INT(city_y(k) / 16 + 1), city_x(k) / 8: PRINT summ(k)
END IF
NEXT k
COLOR COLOR_YELLOW: LOCATE 1, 20: PRINT "Total Forces in Cities (100's)"
CALL report_wait_key
END SUB

'..........................................................................
'                               Battle Report
'..........................................................................
SUB report_battle_summary
VIEW (200, 123)-(400, 284)
CLS 1
VIEW
LINE (200, 123)-(400, 284), 15, B
COLOR COLOR_YELLOW
LOCATE 9, 32: PRINT "BATTLE SUMMARY"
CALL draw_flag_icon(320, 160, 1)
CALL draw_flag_icon(370, 160, 2)
LINE (200, 176)-(400, 230), 15, B
LINE (200, 230)-(400, 284), 15, B
LINE (290, 176)-(345, 284), 15, B
LOCATE 13, 27: PRINT "BATTLES"
LOCATE 14, 27: PRINT "WON"
LOCATE 16, 27: PRINT "MEN LOST"
LOCATE 17, 27: PRINT "(1000's)"
LOCATE 14, 38: PRINT sides(SIDE_UNION).battles_won
LOCATE 14, 45: PRINT sides(SIDE_REBEL).battles_won
LOCATE 17, 38: PRINT INT(.1 * sides(SIDE_UNION).casualties)
LOCATE 17, 45: PRINT INT(.1 * sides(SIDE_REBEL).casualties)
CALL report_wait_key
END SUB

'..........................................................................
'                               Recap (History)
'..........................................................................
SUB report_recap
DIM x AS INTEGER: DIM a$
CLS : x = 0
OPEN "I", 2, "cws.his"
DO WHILE NOT EOF(2)
INPUT #2, a$
COLOR COLOR_GRAY: IF INSTR(a$, "[") THEN COLOR COLOR_WHITE
IF INSTR(a$, ">") THEN COLOR COLOR_YELLOW
IF INSTR(a$, "..") THEN COLOR COLOR_LIGHT_CYAN
IF INSTR(a$, "!") THEN COLOR COLOR_LIGHT_RED
LOCATE 29, 1: PRINT a$
x = x + 1
IF x > 27 THEN wait_seconds .4
LOOP
CLOSE #2
CALL report_wait_key
END SUB

SUB report_wait_key
COLOR COLOR_YELLOW: LOCATE 29, 29: PRINT "press a key";
CALL wait_key("F")
END SUB

' Utility, Chk Links: gives every road of the map a way back and lists what it found.
SUB check_map_links
DIM x AS INTEGER: DIM y AS INTEGER: DIM n AS INTEGER: DIM count AS INTEGER
DIM added(MAX_CITIES * MAX_ROADS) AS INTEGER: DIM from_city(MAX_CITIES * MAX_ROADS) AS INTEGER: DIM to_city(MAX_CITIES * MAX_ROADS) AS INTEGER
CLS : COLOR COLOR_WHITE
CALL city_fix_return_routes(count, added(), from_city(), to_city())
x = 0: y = 0
FOR n = 1 TO count
	IF added(n) = 1 THEN PRINT "+ Adding return route from "; city_name$(from_city(n)); " to "; city_name$(to_city(n)): y = y + 1
	IF added(n) = 0 THEN x = x + 1: PRINT "Error in CITIES.GRD entry for city #"; to_city(n); city_name$(from_city(n)); ": no return route to "; city_name$(to_city(n)): wait_seconds 1
NEXT n
IF x + y = 0 THEN PRINT "ALL MAP LINKS ARE OK": EXIT SUB
IF y > 0 THEN PRINT "* "; y; " fixes made to provide RETURN ROUTES"
IF x > 0 THEN PRINT "** "; x; " UNRESOLVED RETURN ROUTES"
END SUB
