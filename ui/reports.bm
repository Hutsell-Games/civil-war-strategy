SUB draw_army_stats (army)
    LINE (530, 60)-(639, 150), 0, BF
    COLOR COLOR_WHITE
    LOCATE 5, 68: PRINT army_name$(army)
    COLOR COLOR_LIGHT_BLUE: IF army_side(army) = SIDE_REBEL THEN COLOR COLOR_GRAY
    LOCATE 6, 68: PRINT "Size:"; : CALL print_army_size(army)
    LOCATE 7, 68: PRINT "Leader:"; TAB(75); army_leader_rating(army)
    LOCATE 8, 68: PRINT "Exper:"; TAB(75); army_experience(army)
    IF army_supply(army) < 2 THEN COLOR COLOR_LIGHT_RED
    LOCATE 9, 68: PRINT "Supply:"; TAB(75); army_supply(army)
END SUB

SUB print_army_size (army)
    DIM size$
    size$ = LTRIM$(RTRIM$(STR$(army_size(army)))) + "00"
    PRINT size$;
END SUB

SUB menu_victory_conditions
    DIM cities_text$: DIM income_text$: DIM i AS INTEGER: DIM start_option AS INTEGER
    cities_text$ = STR$(ABS(victory_rule(VICTORY_CITIES)) * 2.5) + "% Cities"
    income_text$ = STR$(ABS(victory_rule(VICTORY_CITIES)) * 2.5) + "% Total Income"
    menu_text$(8) = "Time: " + month_name$(victory_rule(VICTORY_MONTH)) + STR$(ABS(victory_rule(VICTORY_YEAR)))
    menu_text$(9) = RTRIM$(STR$(ABS(victory_rule(VICTORY_FORCE_RATIO)))) + ":1 Force Ratio"
    COLOR COLOR_WHITE: LOCATE 1, 1: PRINT "Press ENTER to toggle ending conditions";
    COLOR COLOR_YELLOW: PRINT "				ESC when done"
    DO
        FOR i = 2 TO 6: IF victory_rule(i) > 0 THEN menu_text$(i - 1) = "û " ELSE menu_text$(i - 1) = "  "
        NEXT i
        menu_choice = start_option
        menu_text$(0) = "Victory Conditions"
        menu_text$(1) = menu_text$(1) + menu_text$(8)
        menu_text$(2) = menu_text$(2) + cities_text$
        menu_text$(3) = menu_text$(3) + income_text$
        menu_text$(4) = menu_text$(4) + "Capital Captured"
        menu_text$(5) = menu_text$(5) + menu_text$(9)
        menu_text$(6) = "DONE"
        menu_box_type = BOX_DOUBLE: menu_color = COLOR_CYAN: menu_item_count = 6: menu_highlight = COLOR_YELLOW
        CALL menu_select(MENU_PLAIN)
        start_option = 21 + menu_choice
        SELECT CASE menu_choice
            CASE 1
                CALL victory_toggle_rule(VICTORY_YEAR)
            CASE 2 TO 5
                CALL victory_toggle_rule(menu_choice + 1)
            CASE ELSE
                EXIT DO
        END SELECT
    LOOP
    CLS
    CALL draw_map
END SUB

SUB menu_report (side)
    menu_text$(0) = "Information"
    menu_text$(1) = side_name$(current_side) + " Armies"
    menu_text$(2) = side_name$(other_side(current_side)) + " Armies"
    menu_text$(3) = "Cities"
    menu_text$(4) = "Force Summary"
    menu_text$(5) = "Intelligence"
    menu_text$(6) = "Battles": menu_item_count = 6
    IF _FILEEXISTS("cws.his") THEN menu_text$(7) = "Recap": menu_item_count = 7
    CALL menu_select(MENU_PLAIN)
    SELECT CASE menu_choice
        CASE IS < 0
            CLS
            CALL draw_map
            EXIT SUB
        CASE 2: CALL report_armies(other_side(current_side))
        CASE 3: CALL report_cities
        CASE 4: CALL report_force_summary
        CASE 5: CALL report_intelligence
        CASE 6: CALL report_battle_summary
        CASE 7: CALL report_recap
        CASE ELSE: CALL report_armies(side)
    END SELECT
    CLS
    CALL draw_map
END SUB

'                               Army Report
SUB report_armies (side)
    DIM last_army AS INTEGER: DIM i AS INTEGER: DIM k AS INTEGER: DIM first_army AS INTEGER
    DIM side_color AS INTEGER: DIM total_points AS INTEGER: DIM percent AS INTEGER: DIM total_troops AS INTEGER: DIM ironclads AS INTEGER: DIM all_income AS INTEGER: DIM row AS INTEGER
    first_army = side_first_army(side): last_army = side_last_army(side)
    CLS : LOCATE 1, 1: side_color = 9: IF side = SIDE_REBEL THEN side_color = 15
    COLOR side_color
    PRINT " Report for "; side_name$(side); " Forces"; TAB(30); month_name$(turn_month); ","; turn_year; TAB(49); : COLOR COLOR_YELLOW: PRINT " Victory Points "; side_victory_points(side);
    IF side_color = 15 THEN side_color = 7
    total_points = side_victory_points(side) + side_victory_points(other_side(side))
    IF total_points = 0 THEN
        PRINT
    ELSE
        percent = (side_victory_points(side) / total_points) * 100
        PRINT "("; percent; " %)";
    END IF
    CALL draw_flag_icon(215, 8, side)
    COLOR side_color
    PRINT side_city_count(side); "/ 40"; TAB(15); "CITIES CONTROLLED"; TAB(40); : PRINT "("; : percent = INT(side_city_count(side) * 2.5 + .5): PRINT percent; "%)";
    PRINT TAB(50); : COLOR COLOR_LIGHT_RED: PRINT "Capital: "; city_name$(side_capital(side))
    all_income = total_income: IF side_capital(SIDE_UNION) > 0 THEN all_income = all_income + CAPITAL_INCOME
    IF side_capital(SIDE_REBEL) > 0 THEN all_income = all_income + CAPITAL_INCOME
    PRINT side_income(side); "/"; all_income; TAB(15); "INCOME"; TAB(40); "("; : percent = (side_income(side) / total_income) * 100: PRINT percent; "%)   "; : COLOR COLOR_YELLOW: PRINT "Cash:"; side_cash(side)
    COLOR COLOR_LIGHT_CYAN: PRINT " #      Name             Size  Location   Ldr Exp Suply Move To"
    total_troops = 0: FOR i = first_army TO last_army
        COLOR side_color
        IF army_city(i) < 1 THEN _CONTINUE
        total_troops = total_troops + army_size(i)
        PRINT i; TAB(5); army_name$(i); TAB(25); : row = CSRLIN
        CALL print_army_size(i): PRINT TAB(32); city_name$(army_city(i));
        IF side <> current_side THEN PRINT : _CONTINUE
        PRINT TAB(43); army_leader_rating(i); TAB(47); army_experience(i); TAB(52); army_supply(i);
        PRINT TAB(57); : IF army_order(i) > -1 THEN PRINT city_name$(army_order(i)) ELSE PRINT "Resting"
        IF city_fort(army_city(i)) > 0 THEN LOCATE row, 68: PRINT "FORT +"; city_fort(army_city(i))
    NEXT i
    PRINT " "; STRING$(70, "Ä")
    PRINT " Total Forces "; TAB(25); LTRIM$(STR$(total_troops)); "00"; TAB(40); "[ Enemy Forces "; LTRIM$(STR$(INT(ai_strength_ratio! * total_troops))); "00 ]"
    PRINT " "; STRING$(70, "Ä")
    PRINT " "; side_name$(side); " NAVY has "; fleet_size(side); " ship(s) ";
    ironclads = 0
    FOR k = 1 TO fleet_size(side)
        IF MID$(fleet_ships$(side), k, 1) = "I" THEN ironclads = ironclads + 1
    NEXT k
    IF ironclads > 0 THEN PRINT "("; ironclads; "Ironclads) ";
    IF fleet_city(side) > 0 AND fleet_city(side) < FLEET_AT_SEA THEN PRINT "in "; city_name$(fleet_city(side)) ELSE PRINT
    IF train_army(side) > 0 THEN COLOR COLOR_YELLOW: PRINT " Army #"; train_army(side); army_name$(train_army(side)); " on train to "; city_name$(army_order(train_army(side)));
    LINE (0, 0)-(639, 449), 15, B
    LINE (0, 62)-(639, 62), 15
    CALL report_wait_key
END SUB

'                               City Report
SUB report_cities
    DIM i AS INTEGER: DIM owner$
    CLS : LOCATE 1, 1: COLOR COLOR_YELLOW
    PRINT "City Report"; TAB(20); month_name$(turn_month); ","; turn_year: COLOR COLOR_WHITE
    PRINT " #    City       Control   Value"; TAB(41); " #    City       Control   Value"
    LINE (1, 30)-(630, 30), 15
    FOR i = 1 TO 20: COLOR COLOR_RED: owner$ = "neutral": IF city_owner(i) = SIDE_UNION THEN COLOR COLOR_LIGHT_BLUE: owner$ = "UNION"
        IF city_owner(i) = SIDE_REBEL THEN COLOR COLOR_GRAY: owner$ = "REBEL"
        LOCATE 2 + i, 1: PRINT i; TAB(6); city_name$(i); TAB(18); owner$; TAB(29); city_value(i)
    NEXT i

    FOR i = 21 TO 40: COLOR COLOR_RED: owner$ = "neutral": IF city_owner(i) = SIDE_UNION THEN COLOR COLOR_LIGHT_BLUE: owner$ = "UNION"
        IF city_owner(i) = SIDE_REBEL THEN COLOR COLOR_GRAY: owner$ = "REBEL"
        LOCATE i - 18, 41: PRINT i; TAB(46); city_name$(i); TAB(58); owner$; TAB(69); city_value(i)
    NEXT i
    LINE (1, 360)-(630, 360), 15
    COLOR COLOR_LIGHT_BLUE: LOCATE 24, 1: PRINT "Side    No. Cities   Income    Cash"
    COLOR COLOR_LIGHT_BLUE: PRINT side_name$(SIDE_UNION); TAB(12); side_city_count(SIDE_UNION); TAB(23); side_income(SIDE_UNION); TAB(32); side_cash(SIDE_UNION)
    COLOR COLOR_GRAY: PRINT side_name$(SIDE_REBEL); TAB(12); side_city_count(SIDE_REBEL); TAB(23); side_income(SIDE_REBEL); TAB(32); side_cash(SIDE_REBEL)
    COLOR COLOR_RED: PRINT side_name$(SIDE_NONE); TAB(12); MAX_CITIES - side_city_count(SIDE_UNION) - side_city_count(SIDE_REBEL)
    LINE (1, 382)-(630, 382), 15
    CALL report_wait_key
END SUB

'                               Intelligence
SUB report_intelligence
    DIM last_army AS INTEGER: DIM k AS INTEGER: DIM box_width AS INTEGER: DIM j AS INTEGER
    DIM first_army AS INTEGER: DIM side_color AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER
    side_color = 9: IF current_side = SIDE_REBEL THEN side_color = 7
    CALL draw_map
    first_army = side_first_army(current_side): last_army = side_last_army(current_side)
    FOR k = first_army TO last_army
        IF army_size(k) > 0 THEN
            COLOR side_color
            x = city_x(army_city(k))
            y = city_y(army_city(k))
            box_width = 10: IF army_size(k) < 1000 THEN box_width = 9
            x = x / 8 - 2: y = y / 16
            IF y > 26 THEN y = 26
            FOR j = 0 TO 3
                LOCATE y + j, x: PRINT SPACE$(box_width);
            NEXT j
            LOCATE y, x: PRINT "Siz:"; : CALL print_army_size(k)
            LOCATE y + 1, x: PRINT "Ldr:"; army_leader_rating(k)
            LOCATE y + 2, x: PRINT "Xpr:"; army_experience(k)
            LOCATE y + 3, x: PRINT "Sup:"; army_supply(k);
            LINE (8 * (x - 1) - 1, 16 * (y - 1) - 1)-(8 * (x + box_width - 1) + 1, 16 * (y + 3) + 1), 15, B
            wait_seconds 1
        END IF
    NEXT k
    CALL report_wait_key
END SUB

'                               Force Summary
SUB report_force_summary
    DIM k AS INTEGER: DIM j AS INTEGER: DIM side_color AS INTEGER
    DIM city_troops(MAX_CITIES)
    FOR k = 1 TO MAX_CITIES
        IF city_army(k) > 0 THEN
            FOR j = 1 TO MAX_ARMIES
                IF army_city(j) = k THEN city_troops(k) = city_troops(k) + army_size(j)
            NEXT j
        END IF
    NEXT k

    CLS : CALL draw_map
    FOR k = 1 TO MAX_CITIES
        IF city_troops(k) > 0 THEN
            side_color = 9: IF city_owner(k) = SIDE_REBEL THEN side_color = 7
            COLOR side_color
            LOCATE INT(city_y(k) / 16 + 1), city_x(k) / 8: PRINT city_troops(k)
        END IF
    NEXT k
    COLOR COLOR_YELLOW: LOCATE 1, 20: PRINT "Total Forces in Cities (100's)"
    CALL report_wait_key
END SUB

'                               Battle Report
SUB report_battle_summary
    VIEW (200, 123)-(400, 284)
    CLS 1
    VIEW
    LINE (200, 123)-(400, 284), 15, B
    COLOR COLOR_YELLOW
    LOCATE 9, 32: PRINT "BATTLE SUMMARY"
    CALL draw_flag_icon(320, 160, 1)
    CALL draw_flag_icon(370, 160, 2)
    LINE (200, 176)-(400, 230), 15, B
    LINE (200, 230)-(400, 284), 15, B
    LINE (290, 176)-(345, 284), 15, B
    LOCATE 13, 27: PRINT "BATTLES"
    LOCATE 14, 27: PRINT "WON"
    LOCATE 16, 27: PRINT "MEN LOST"
    LOCATE 17, 27: PRINT "(1000's)"
    LOCATE 14, 38: PRINT side_battles_won(SIDE_UNION)
    LOCATE 14, 45: PRINT side_battles_won(SIDE_REBEL)
    LOCATE 17, 38: PRINT INT(.1 * side_casualties&(SIDE_UNION))
    LOCATE 17, 45: PRINT INT(.1 * side_casualties&(SIDE_REBEL))
    CALL report_wait_key
END SUB

'                               Recap (History)
SUB report_recap
    DIM line_count AS INTEGER: DIM history_line$
    CLS : line_count = 0
    OPEN "I", 2, "cws.his"
    DO WHILE NOT EOF(2)
        INPUT #2, history_line$
        COLOR COLOR_GRAY: IF INSTR(history_line$, "[") THEN COLOR COLOR_WHITE
        IF INSTR(history_line$, ">") THEN COLOR COLOR_YELLOW
        IF INSTR(history_line$, "..") THEN COLOR COLOR_LIGHT_CYAN
        IF INSTR(history_line$, "!") THEN COLOR COLOR_LIGHT_RED
        LOCATE 29, 1: PRINT history_line$
        line_count = line_count + 1
        IF line_count > 27 THEN wait_seconds .4
    LOOP
    CLOSE #2
    CALL report_wait_key
END SUB

SUB report_wait_key
    COLOR COLOR_YELLOW: LOCATE 29, 29: PRINT "press a key";
    CALL wait_key("F")
END SUB

' Utility, Chk Links: gives every road of the map a way back and lists what it found.
SUB check_map_links
    DIM unresolved AS INTEGER: DIM fixed AS INTEGER: DIM n AS INTEGER: DIM count AS INTEGER
    DIM added(MAX_CITIES * MAX_ROADS) AS INTEGER: DIM from_city(MAX_CITIES * MAX_ROADS) AS INTEGER: DIM to_city(MAX_CITIES * MAX_ROADS) AS INTEGER
    CLS
    COLOR COLOR_WHITE
    CALL city_fix_return_routes(count, added(), from_city(), to_city())
    unresolved = 0
    fixed = 0
    FOR n = 1 TO count
        IF added(n) = 1 THEN PRINT "+ Adding return route from "; city_name$(from_city(n)); " to "; city_name$(to_city(n)): fixed = fixed + 1
        IF added(n) = 0 THEN unresolved = unresolved + 1: PRINT "Error in CITIES.GRD entry for city #"; to_city(n); city_name$(from_city(n)); ": no return route to "; city_name$(to_city(n)): wait_seconds 1
    NEXT n
    IF unresolved + fixed = 0 THEN PRINT "ALL MAP LINKS ARE OK": EXIT SUB
    IF fixed > 0 THEN PRINT "* "; fixed; " fixes made to provide RETURN ROUTES"
    IF unresolved > 0 THEN PRINT "** "; unresolved; " UNRESOLVED RETURN ROUTES"
END SUB
