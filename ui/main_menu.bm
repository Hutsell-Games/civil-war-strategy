' The main menu and its own entries: Railroad, End Turn and Inform. The menus of the other
' entries are in ui/orders.bm, ui/options.bm and ui/files.bm.

' Shows the main menu and leaves the choice in menu_choice. start is the row it starts on, as
' MENU_START + row. An entry that cannot be chosen shows as "-". Troops as "-" sets the start
' to Moves, and a start on a "-" entry from Moves to Railroad moves a row down.
SUB menu_main (start)
	CALL draw_top_bar
	CALL turn_check_commands
	menu_highlight = COLOR_LIGHT_CYAN
	menu_color = COLOR_RED
	menu_col = PANEL_COL: menu_row = 13
	menu_text$(0) = "Main"
	menu_text$(1) = "Troops": IF turn_recruit_state < 0 OR side_cash(current_side) < COST_RECRUIT THEN menu_text$(1) = "-": start = 23
	menu_text$(2) = "Moves": IF turn_moves_done > 0 THEN menu_text$(2) = "-": IF start = 23 THEN start = 24
	menu_text$(3) = "Ships": IF turn_navy_done > 0 THEN menu_text$(3) = "-": IF start = 24 THEN start = 25
	menu_text$(4) = "Railroad": IF train_army(current_side) > 0 THEN menu_text$(4) = "-": IF start = 25 THEN start = 26
	menu_text$(5) = "END TURN"
	menu_text$(6) = "Inform"
	menu_text$(7) = "COMMANDS"
	menu_text$(8) = "UTILITY"
	menu_text$(9) = "Files"
	menu_item_count = 9
	menu_choice = start
	CALL menu_select(MENU_PLAIN): CALL clear_right_panel
END SUB

' Railroad: the train's picture and its capacity, then the move (railroad_move, ui/railroad.bm).
' With an army on the train already, it says so.
SUB menu_main_railroad
DIM x AS INTEGER: DIM y AS INTEGER: DIM z AS INTEGER: DIM limit AS INTEGER
	IF train_army(current_side) = 0 THEN
		COLOR COLOR_WHITE: LOCATE 4, 68: PRINT "RAILROAD MOVE"
		PSET (550, 20), 0
		DRAW "C15S6" + TRAIN_OUTLINE$ + "U9L2U5R1BF4"
		z = 9: IF current_side = SIDE_REBEL THEN z = 7
		x = POINT(0): y = POINT(1)
		PAINT (x, y), z, 15
		COLOR COLOR_WHITE: IF current_side = SIDE_UNION THEN COLOR COLOR_LIGHT_CYAN
		limit = railroad_capacity(current_side)
		CALL clear_bottom_line: PRINT "Railroad capacity ="; RTRIM$(STR$(limit)); "00";
		CALL railroad_move(current_side)
	ELSE
		CALL clear_bottom_line: COLOR COLOR_LIGHT_CYAN: PRINT "Railroad is already carrying "; army_name$(train_army(current_side)); " to "; city_name$(army_order(train_army(current_side)));
	END IF
END SUB

' END TURN: Yes or NOT YET. ended is 1 on Yes.
SUB menu_main_end_turn (ended)
	menu_col = PANEL_COL: menu_row = 15
	menu_highlight = COLOR_WHITE: menu_color = COLOR_CYAN: menu_choice = MENU_START + 2
	menu_text$(0) = "End Turn"
	menu_text$(1) = "Yes"
	menu_text$(2) = "NOT YET"
	menu_item_count = 2: CALL menu_select(MENU_PLAIN): CALL clear_right_panel
	ended = 0: IF menu_choice = 1 THEN ended = 1
END SUB

' Inform: the reports, then the lines of the armies' moves drawn again on the map.
SUB menu_main_inform
DIM i AS INTEGER: DIM star AS INTEGER: DIM fin AS INTEGER
	CALL menu_report((current_side))
	star = side_first_army(current_side): fin = side_last_army(current_side)
	FOR i = star TO fin
	IF army_order(i) > 0 THEN CALL draw_map_marker(army_city(i), army_order(i), MARK_MOVE_LINE)
	NEXT i
END SUB
