' The Commands menu. The menus of its entries are in ui/army.bm and ui/city.bm.
' After a command is carried out it shows again, on that command's row.
' A command that is refused or given up goes back to the main menu, as MAIN MENU and Esc do.
SUB menu_commands
    DIM row AS INTEGER
    DIM again AS INTEGER
    DIM picked AS INTEGER
    DIM found AS INTEGER
    DIM drilled AS INTEGER
    row = 1
    DO
        menu_col = PANEL_COL
        menu_row = 13
        COLOR COLOR_LIGHT_CYAN
        LOCATE menu_row - 2, menu_col
        PRINT "esc=Main Menu"
        menu_highlight = COLOR_WHITE
        menu_color = COLOR_CYAN
        menu_text$(0) = "Commands"
        menu_text$(1) = "Cancel"
        menu_text$(2) = "Fortify"
        IF NOT fort_affordable(current_side) THEN
            menu_text$(2) = "-"
        END IF
        menu_text$(3) = "Join"
        menu_text$(4) = "Supply"
        menu_text$(5) = "Capital"
        IF NOT capital_can_move(current_side) THEN
            menu_text$(5) = "-"
        END IF
        menu_text$(6) = "Detach"
        IF NOT side_can_detach(current_side) THEN
            menu_text$(6) = "-"
        END IF
        menu_text$(7) = "Army Drill"
        menu_text$(8) = "Relieve"
        menu_text$(9) = "MAIN MENU"
        menu_item_count = 9
        menu_choice = MENU_START + row
        CALL menu_select(MENU_PLAIN)
        CALL clear_right_panel
        row = menu_choice
        SELECT CASE row
            CASE 1
                CALL menu_army_cancel(current_side)
                CALL turn_set_moves_done(0)
            CASE 2
                IF NOT fort_affordable(current_side) THEN
                    COLOR COLOR_LIGHT_CYAN
                    CALL clear_bottom_line
                    PRINT "Not enough money for fort";
                    EXIT SUB
                END IF
                CALL menu_city_fortify(picked)
                IF NOT fort_affordable(current_side) THEN
                    EXIT SUB
                END IF
            CASE 3
                CALL menu_army_combine(current_side, found)
                IF found = 0 THEN
                    CALL clear_bottom_line
                    COLOR COLOR_LIGHT_CYAN
                    PRINT "No eligible armies in same city to combine";
                    CALL draw_stack_markers(current_side)
                    EXIT SUB
                END IF
            CASE 4
                CALL menu_supply(picked)
                IF picked = 0 THEN
                    EXIT SUB
                END IF
            CASE 5
                CALL menu_move_capital(picked)
                IF picked = 0 THEN
                    EXIT SUB
                END IF
                ' The menu comes back on Fortify: the Enter that picked the capital was row 2 of the
                ' city picker (menu_city_select), and the main module added that row to MENU_START.
                row = 2
            CASE 6
                CALL menu_army_detach(again)
                IF again = 0 THEN
                    EXIT SUB
                END IF
            CASE 7
                CALL menu_army_drill(again, drilled)
                IF again = 0 THEN
                    EXIT SUB
                END IF
                ' An army that cannot drill further: the menu comes back on its first row.
                IF drilled = 0 THEN
                    row = 1
                END IF
            CASE 8
                CALL menu_army_relieve(current_side)
            CASE ELSE
                EXIT SUB
        END SELECT
    LOOP
END SUB
