' What raising, supplying and combining armies show. The rules are in rules/army.bm.

SUB army_combine (side)
DIM fin AS INTEGER
DIM target AS INTEGER: DIM star AS INTEGER: DIM i AS INTEGER: DIM j AS INTEGER: DIM best AS INTEGER: DIM joined AS INTEGER: DIM status AS INTEGER
	menu_color = COLOR_CYAN: target = 0: menu_highlight = COLOR_CYAN
	menu_col = PANEL_COL: menu_row = 2
	star = side_first_army(side): fin = side_last_army(side)
	menu_item_count = 0
	FOR i = 1 TO MAX_CITIES
		IF city_owner(i) = side AND city_army(i) > 0 THEN
			FOR j = star TO fin
			IF army_city(j) = i AND city_army(i) <> j AND army_order(j) = ORDER_NONE THEN menu_item_count = menu_item_count + 1: menu_text$(menu_item_count) = city_name$(i): menu_value(menu_item_count) = i: EXIT FOR
			NEXT j
		END IF
	NEXT i
	
	IF menu_item_count = 0 THEN side = -1: EXIT SUB
	CALL menu_bubble_sort(menu_item_count)

	IF side <> current_side THEN menu_choice = 1 + INT(menu_item_count * RND): GOTO join
	menu_text$(0) = "Join"
		menu_choice = MENU_START + 10: menu_highlight = COLOR_LIGHT_CYAN
		CALL menu_select(MENU_CITY_POINTER): CALL clear_right_panel
join:
		IF menu_choice < 1 GOTO nocity2
		target = menu_value(menu_choice)
		CALL clear_bottom_line: PRINT "Combining "; side_name$(side); " armies in "; city_name$(target); :  CALL wait_seconds(opt_pause!)

		CALL army_combine_start(target)
'...........................................................................
		best = 0: joined = 0
		FOR j = star TO fin
		CALL army_combine_add(j, target, best, status)
		IF status = 1 THEN CALL clear_bottom_line: PRINT "Cannot combine "; army_name$(j); "... TOO LARGE"; : CALL wait_seconds(opt_pause!)
		IF status = 2 THEN
			joined = joined + 1
			CALL clear_bottom_line: PRINT army_name$(j); " is combining his "; : CALL print_army_size(j): PRINT " forces"; : CALL wait_seconds(opt_pause!)
			CALL army_combine_absorb(j)
		END IF
		NEXT j

		CALL clear_bottom_line
		IF side <> current_side AND joined = 0 THEN EXIT SUB
		IF joined = 0 THEN
				PRINT "No valid armies to combine at this time in "; city_name$(target);
				wait_seconds opt_pause!
				EXIT SUB
		END IF
		CALL army_combine_finish(target, best, joined)
		IF joined > 1 THEN
		PRINT "New army "; best; " of "; : CALL print_army_size(best): PRINT " is commanded by "; army_name$(best);
		ELSE
		PRINT "Only 1 eligible army -- cannot combine at this time";
		END IF
		IF side = current_side THEN CALL wait_seconds(opt_pause!)
		IF opt_sound >= SOUND_EFFECTS THEN SOUND 4000, .7
	       
		CALL draw_cities
		CALL draw_army_flag(best)
		CALL draw_map_marker(target, 0, MARK_FLASH_FRAME)
		CALL draw_stack_markers(side)
nocity2:
END SUB

SUB army_new (side, slot, city)
	CALL army_raise(side, slot, city)
	COLOR COLOR_LIGHT_RED: CALL clear_bottom_line: PRINT "Placing NEW army "; slot; army_name$(slot); " in "; city_name$(city);
	PRINT " Size = "; : CALL print_army_size(slot)
	IF opt_sound >= SOUND_EFFECTS THEN SOUND 2222, .5
	CALL draw_army_flag(slot)
	CALL wait_seconds(opt_pause! - .5)
END SUB

SUB army_get_commander (side, slot)
	CALL army_pick_commander(side, slot)
	IF slot = 0 THEN CALL clear_bottom_line: PRINT "No more "; side_name$(side); " commanders available"; : CALL wait_seconds(opt_pause!)
END SUB

SUB army_resupply (army)
DIM result AS INTEGER
		CALL army_buy_supply(army, result)
		IF result < 0 THEN EXIT SUB
		IF result = 0 THEN CALL clear_bottom_line: PRINT "Not enough funds in the Treasury to supply "; army_name$(army); 
		IF result = 1 THEN CALL clear_bottom_line: PRINT army_name$(army); " has received supplies "; : IF opt_sound >= SOUND_EFFECTS THEN SOUND 4500, .5
		CALL wait_seconds(opt_pause!)
END SUB

' Raises men in a city for 100: a new army under the next commander, or more men for the
' army already there. raised is 0 when a new army was needed and no commander is left.
SUB army_recruit (side, city, raised)
DIM empty AS INTEGER: DIM i AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER: DIM from AS INTEGER: DIM isolated AS INTEGER
	raised = 1
	empty = 0
	CALL city_update_occupier(city)
	IF city_army(city) > 0 THEN i = city_army(city): GOTO add2
	CALL army_get_commander((side), empty)
       
	IF empty = 0 THEN raised = 0: EXIT SUB
	CALL army_place_new(empty, city)
	CALL army_new(side, empty, city)
	EXIT SUB
add2:
	CALL army_add_recruits(side, i, isolated)
	from = army_city(i): x = city_x(from) - 12: y = city_y(from) - 11
	GET (x - 9, y - 7)-(x + 9, y + 6), saved_under_army
	CALL draw_map_marker(army_city(i), 0, MARK_RECRUIT)
	IF opt_sound >= SOUND_EFFECTS THEN SOUND 2222, 1
	COLOR COLOR_LIGHT_CYAN: CALL clear_bottom_line: PRINT "Army "; i; army_name$(i); " in "; city_name$(army_city(i)); " strength increased to "; : CALL print_army_size(i)
	IF isolated = 1 THEN PRINT " ISOLATED !";
	PUT (x - 9, y - 7), saved_under_army, PSET
	CALL wait_seconds(opt_pause! - .5)
END SUB
