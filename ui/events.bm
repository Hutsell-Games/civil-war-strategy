' The special events as the player sees them: the message of each, and its tune. The rules are
' in rules/events.bm. The events and their texts come from scenarios/EVENTS.DAT (load_events).

SUB special_events
    DIM event AS INTEGER
    DIM variant AS INTEGER
    DIM event_side AS INTEGER
    DIM k AS INTEGER
    DIM raid_before AS INTEGER
    raid_before = raiding_side
    CALL event_roll(event, variant, event_side)
    IF event = EVENT_NONE THEN
        EXIT SUB
    END IF
    ' An announcement: its text on the bottom line, and an alarm.
    IF event_before(event) THEN
        COLOR COLOR_YELLOW
        CALL clear_bottom_line
        PRINT event_message$(event_text$(event, variant));
        IF opt_sound >= SOUND_EFFECTS THEN
            FOR k = 1 TO 5
                SOUND 140, 1
                SOUND 37, 1
            NEXT k
        END IF
        CALL event_show_then(event, raid_before)
        CALL wait_key("I")
        EXIT SUB
    END IF
    CALL clear_bottom_line
    COLOR COLOR_YELLOW
    PRINT event_banner$;
    IF event_effect(event) = EFFECT_CITY_NEUTRAL THEN
        CALL event_show_city(event, variant)
        CALL event_show_then(event, raid_before)
        EXIT SUB
    END IF
    ' The banner stays for an event good for the Union, and goes for one good for the South,
    ' as in the original.
    IF event_side = SIDE_UNION THEN
        CALL clear_bottom_line
    END IF
    CALL scribe_message(event_message$(event_text$(event, variant)), SHOW_BOX)
    CALL event_show_then(event, raid_before)

    ' The tune of the side the event is good for: the side whose events were tried. It stays
    ' so when a "for" line gives the effect to the other side.
    IF opt_sound = SOUND_MUSIC THEN
        CALL play_side_tune(other_side(event_side))
    END IF
    IF event_side = SIDE_UNION THEN
        CALL wait_key("S")
    ELSE
        CALL wait_key("N")
    END IF
END SUB

' An event that turned a city neutral: its text on the bottom line, the cities drawn again,
' then its outcome in a box. Nothing is shown when no city was found.
SUB event_show_city (event, variant)
    IF event_city = 0 THEN
        EXIT SUB
    END IF
    CALL clear_bottom_line
    COLOR COLOR_WHITE
    PRINT event_message$(event_text$(event, variant));
    CALL draw_cities
    CALL wait_seconds(opt_pause!)
    CALL clear_bottom_line
    CALL show_message_box(event_message$(event_outcome$(event)), COLOR_RED)
    CALL wait_seconds(opt_pause!)
END SUB

' What every kind of event shows after its own message: the text of its "then" event in a box,
' then the map or the fleets drawn again when the event or its "then" event asks for it.
' raid_before is raiding_side before the event.
SUB event_show_then (event, raid_before)
    DIM redraw AS INTEGER
    redraw = event_redraw(event)
    IF event_then(event) <> 0 THEN
        CALL scribe_message(event_message$(event_text$(event_then(event), 0)), SHOW_BOX)
        ' REDRAW_MAP is the largest: the map holds the fleets.
        IF event_redraw(event_then(event)) > redraw THEN
            redraw = event_redraw(event_then(event))
        END IF
    END IF
    ' An event that brought a raiding fleet into port (G52) draws the whole map again, so that
    ' the COMMERCE banner and the fleet at sea go. Drawing the fleets alone would leave them.
    IF raiding_side <> raid_before THEN
        redraw = REDRAW_MAP
    END IF
    SELECT CASE redraw
        CASE REDRAW_FLEETS
            CALL draw_fleets
        CASE REDRAW_MAP
            CALL draw_map
    END SELECT
END SUB

' An event's text with {city} and {army} filled in: the city of a riot and the army that was
' reinforced (event_city and event_army, set by event_roll).
FUNCTION event_message$ (text$)
    DIM message$
    message$ = text$
    message$ = text_replace$(message$, "{city}", city_name$(event_city))
    message$ = text_replace$(message$, "{army}", army_name$(event_army))
    event_message$ = message$
END FUNCTION

' text$ with with$ in place of every find$.
FUNCTION text_replace$ (text$, find$, with$)
    DIM at AS INTEGER
    DIM result$
    result$ = text$
    at = INSTR(result$, find$)
    DO WHILE at > 0
        result$ = LEFT$(result$, at - 1) + with$ + MID$(result$, at + LEN(find$))
        at = INSTR(at + LEN(with$), result$, find$)
    LOOP
    text_replace$ = result$
END FUNCTION
