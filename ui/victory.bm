' The end of the game as the player sees it: the warnings, the victory screens and the Hall of
' Fame. The rules are in rules/victory.bm.

SUB hall_of_fame
    DIM i AS INTEGER
    DIM side AS INTEGER
    DIM k AS INTEGER
    DIM commander$
    DIM hall_name$(2, 5)
    DIM hall_score(2, 5)
    COLOR COLOR_YELLOW
    LOCATE 28, 1
    PRINT "press a key";
    CALL wait_key("H")
    SCREEN 0
    COLOR COLOR_YELLOW, COLOR_MAGENTA
    CLS
    COLOR COLOR_LIGHT_CYAN, COLOR_BLACK

    LOCATE 2, 7
    PRINT STRING$(57, "²")
    LOCATE 9, 7
    PRINT STRING$(57, "²")
    FOR i = 1 TO 6
        LOCATE 2 + i, 7
        PRINT "²"; SPACE$(55); "²"
    NEXT i

    CALL hall_of_fame_load(hall_name$(), hall_score())
    FOR side = SIDE_UNION TO SIDE_REBEL
        COLOR COLOR_YELLOW, COLOR_RED
        LOCATE 3, 30 * (side - 1) + 10
        PRINT side_name$(side); " HALL of FAME"
        COLOR COLOR_WHITE, COLOR_BLACK
        FOR i = 1 TO 5
            LOCATE 3 + i, 30 * (side - 1) + 8
            PRINT i, hall_name$(side, i), hall_score(side, i)
        NEXT i
    NEXT side

    FOR side = SIDE_UNION TO SIDE_REBEL
        i = hall_of_fame_place(side, hall_score())
        IF i = 0 THEN
            _CONTINUE
        END IF
        COLOR COLOR_WHITE, COLOR_BLUE
        IF side = SIDE_REBEL THEN
            COLOR COLOR_RED, COLOR_GRAY
        END IF
        FOR k = 12 TO 14
            LOCATE k, 1
            PRINT SPACE$(80);
        NEXT k
        LOCATE 12, 1
        PRINT "Congratulations ! Score of"; side_victory_points(side)
        PRINT "New Entry into "; side_name$(side); " HALL of FAME in place "; i
        IF opt_players = PLAYERS_ONE AND side <> current_side THEN
            commander$ = "COMPUTER"
            PRINT commander$; " was "; side_name$(side); " commander"
        ELSE
            DO
                PRINT "What is name of "; side_name$(side); " commander";
                CALL script_mark_key_wait(4, "")
                INPUT commander$
            LOOP WHILE commander$ = ""
        END IF
        CALL hall_of_fame_insert(side, i, commander$, hall_name$(), hall_score())
    NEXT side

    CALL hall_of_fame_save(hall_name$(), hall_score())
    PRINT "Game Over"
    CALL wait_key("G")
END SUB

SUB check_victory_conditions
    DIM union_troops AS INTEGER
    DIM rule AS INTEGER
    DIM rebel_troops AS INTEGER
    DIM message$
    DIM side AS INTEGER
    CALL victory_forces(union_troops, rebel_troops)

    CALL clear_bottom_line
    COLOR COLOR_YELLOW
    IF victory_time_near = 1 THEN
        message$ = "Time almost expired (" + month_name$(victory_rule(VICTORY_MONTH)) + "," + STR$(victory_rule(VICTORY_YEAR)) + ")"
        CALL show_message_box(message$, COLOR_RED)
    END IF
    FOR side = SIDE_UNION TO SIDE_REBEL
        CALL victory_rule_met(side, union_troops, rebel_troops, rule)
        IF rule > 0 THEN
            CALL end_game(side, rule)
            EXIT SUB
        END IF
        CALL victory_warnings(side, union_troops, rebel_troops)
    NEXT side
END SUB

' Warns when a side is close to a victory rule: cities, income or army strength. union_men is the
' Union's men and rebel_men the Rebels'.
SUB victory_warnings (side, union_troops, rebel_troops)
    DIM message$
    CALL clear_bottom_line
    COLOR COLOR_YELLOW
    IF victory_near_cities(side) = 1 THEN
        message$ = side_name$(side) + " side almost controls" + STR$(victory_rule(VICTORY_CITIES)) + " cities"
        CALL show_message_box(message$, COLOR_RED)
    END IF

    IF victory_near_income(side) = 1 THEN
        message$ = side_name$(side) + " side close to" + STR$(victory_rule(VICTORY_INCOME)) + " % of total income"
        CALL show_message_box(message$, COLOR_RED)
    END IF

    IF victory_near_force(side, union_troops, rebel_troops) = 1 THEN
        message$ = side_name$(side) + "side close to" + STR$(victory_rule(VICTORY_FORCE_RATIO)) + ":1 strength ratio"
        CALL show_message_box(message$, COLOR_RED)
    END IF
END SUB

' A side has met the victory rule in rule (2 to 6), or wiped out the enemy (7). The player may play
' on, which raises the rule's number or turns the capital rule off. Otherwise the game ends:
' the battle summary, the victory screen and the Hall of Fame.
SUB end_game (side, rule)
    DIM reason$
    DIM message$
    DIM side_color AS INTEGER
    SELECT CASE rule
        CASE IS < VICTORY_CITIES
            reason$ = "TIME EXPIRED"
        CASE VICTORY_CITIES
            reason$ = STR$(2.5 * victory_rule(VICTORY_CITIES)) + "% CITIES CONTROLLED"
        CASE VICTORY_INCOME
            reason$ = STR$(victory_rule(VICTORY_INCOME)) + " % OF TOTAL INCOME"
        CASE VICTORY_CAPITAL
            reason$ = "CAPITAL CAPTURED"
        CASE VICTORY_FORCE_RATIO
            reason$ = STR$(victory_rule(VICTORY_FORCE_RATIO)) + ":1 ARMY STRENGTH RATIO"
        CASE VICTORY_WIPED_OUT
            reason$ = "ENEMY ANNIHILATED"
    END SELECT
    CLS
    side_color = 1
    IF side = 2 THEN
        side_color = 7
    END IF
    LINE (0, 0)-(639, 479), 4, BF
    LINE (0, 40)-(550, 460), 0, BF
    CALL draw_map
    LINE (70, 140)-(485, 265), 0, BF
    LINE (50, 120)-(465, 250), side_color, BF
    LINE (50, 120)-(465, 250), 4, B
    COLOR COLOR_YELLOW
    message$ = side_name$(side) + " SIDE IS WINNING"
    IF rule = VICTORY_YEAR THEN
        CALL print_centered(10, "Confederates will win a technical victory")
    ELSE
        CALL print_centered(10, message$)
    END IF

    COLOR COLOR_WHITE
    message$ = "END GAME VICTORY CONDITION" + STR$(rule - 1) + " REACHED"
    CALL print_centered(12, message$)
    CALL print_centered(14, reason$)

    menu_text$(0) = "End Game"
    menu_text$(1) = "Yes"
    menu_text$(2) = "No-Override"
    menu_item_count = 2
    menu_color = COLOR_RED
    menu_col = 27
    menu_row = 18
    menu_highlight = COLOR_WHITE
    IF rule = VICTORY_WIPED_OUT THEN
        menu_item_count = 1
    END IF
    CALL menu_select(MENU_PLAIN)

    IF menu_choice <> 1 AND rule < VICTORY_WIPED_OUT THEN
        CALL end_game_play_on(rule)
        EXIT SUB
    END IF
    menu_text$(0) = "Options"
    menu_text$(1) = "Quit this Game"
    menu_text$(2) = "Play More"
    IF opt_players = PLAYERS_ONE THEN
        menu_text$(2) = "No - Press Onward to " + city_name$(side_capital(other_side(current_side)))
    END IF
    menu_item_count = 2
    menu_color = COLOR_DARK_GRAY
    menu_col = 27
    menu_row = 18
    IF rule <> VICTORY_WIPED_OUT THEN
        CALL menu_select(MENU_PLAIN)
        IF menu_choice <> 1 THEN
            CALL end_game_play_on(rule)
            EXIT SUB
        END IF
    END IF

    CALL victory_won(side, rule)
    CALL draw_map
    CALL save_battle_summary
    CALL report_battle_summary
    IF rule = VICTORY_YEAR THEN
        CALL victory_technical_points
        CALL draw_rebel_victory
    ELSEIF side = SIDE_UNION THEN
        CALL draw_union_victory
        COLOR COLOR_WHITE
        LOCATE 2, 27
        message$ = "UNION VICTORY  VP's=" + STR$(side_victory_points(SIDE_UNION))
        PRINT message$
    ELSEIF side = SIDE_REBEL THEN
        CALL draw_rebel_victory
        COLOR COLOR_WHITE
        LOCATE 2, 27
        message$ = "REBEL VICTORY  VP's=" + STR$(side_victory_points(SIDE_REBEL))
        PRINT message$
    END IF
    COLOR COLOR_YELLOW
    LOCATE 4, 40 - .5 * LEN(reason$)
    IF opt_history > 0 THEN
        CALL scribe_message(message$, SHOW_HISTORY_ONLY)
        CALL scribe_message(reason$, SHOW_HISTORY_ONLY)
    END IF
    PRINT reason$
    CALL hall_of_fame
END SUB

' The player plays on after a victory rule was met: the rule is raised or turned off, and
' the map is drawn again.
SUB end_game_play_on (rule)
    CALL victory_play_on(rule)
    CLS
    CALL draw_map
END SUB
