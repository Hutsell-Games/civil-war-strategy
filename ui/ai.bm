' The computer's messages, in the order its decisions in ai/ai.bm call them.

' A fort the computer built.
SUB draw_ai_fort (target)
	CALL clear_bottom_line: PRINT city_name$(target); " fortifications increased to "; city_fort(target);
	CALL draw_map_marker(target, 0, MARK_FLASH_FRAME)
	CALL draw_cities
END SUB

' An army's move order: its line and a pointer on the map, and a message when the pause is long.
SUB draw_ai_plan (i, text_color)
	IF opt_pause! > 1 THEN
		COLOR text_color: CALL clear_bottom_line
		PRINT army_name$(i); " plans to move from "; city_name$(army_city(i)); " to "; city_name$(army_order(i));
	END IF
		CALL draw_map_marker(army_city(i), army_order(i), MARK_MOVE_LINE)
		CALL draw_map_marker(army_city(i), army_order(i), MARK_POINTER)
	CALL wait_seconds(opt_pause! - 1)
	PUT (city_x(army_city(i)) - 20, city_y(army_city(i)) - 19), saved_under_marker, PSET
END SUB

' An army that drilled.
SUB draw_ai_drill (i)
		IF opt_pause! > 1 THEN
		CALL clear_bottom_line
			PRINT army_name$(i); " has drilled to reach experience level "; army_experience(i);
		END IF
		CALL wait_seconds(opt_pause! - 1)
END SUB

' Before the computer picks a city to recruit in: its funds, when the player may see them, and
' the menu's place. The cursor is left where the pick's loop over the list used to leave it.
SUB draw_ai_funds (side)
	IF (side = current_side) OR (opt_players = PLAYERS_TWO) THEN CALL clear_bottom_line: PRINT side_name$(side); " funds available "; side_cash(side);
	menu_col = PANEL_COL: menu_row = 12: menu_color = COLOR_CYAN
	IF menu_item_count > 0 THEN LOCATE 14 + menu_item_count, 69
END SUB

' The color of the fleet's messages on the bottom line, set before the computer's fleet
' carries out an order.
SUB draw_ai_navy_color
	COLOR COLOR_LIGHT_CYAN
END SUB
