' The Files menu and the menus of saved games. The file work is in io/files.bm.

' The Files menu: Load, Save, New Game and Quit. action tells the main module what
' follows: the main menu (FILES_BACK), a new game or the program's end. Load with no saved
' game, the "-" row, shows the menu again.
SUB menu_files (action)
    DIM again AS INTEGER
    DIM start_row AS INTEGER
    action = FILES_BACK
    CALL saved_games_check
    DO
        start_row = 2
        IF turn_year = FIRST_YEAR THEN
            start_row = 1
        END IF
        menu_text$(0) = "Options"
        menu_text$(1) = "Load"
        IF NOT saves_exist THEN
            menu_text$(1) = "-"
            start_row = 2
        END IF
        menu_text$(2) = "Save"
        menu_text$(3) = "New Game"
        menu_text$(4) = "Quit"
        menu_item_count = 4
        menu_col = PANEL_COL
        menu_row = 15
        CALL menu_select(MENU_PLAIN, start_row)
        CALL clear_right_panel
        again = FALSE
        SELECT CASE menu_choice
            CASE 1
                IF saves_exist THEN
                    CALL menu_load_game
                ELSE
                    again = TRUE
                END IF
            CASE 2
                CALL menu_save_game
            CASE 3
                CALL config_write(current_side)
                CLS
                action = FILES_NEW_GAME
            CASE 4
                CALL menu_quit(action)
        END SELECT
    LOOP WHILE again
END SUB

' Load, and the title menu's Resume Saved Game: the player picks a saved game, and the map is
' drawn with it. With no saved game, or one whose scenario is not in the list, it loads
' nothing. A game loaded opens the month's Troops, Moves and Ships again.
SUB menu_load_game
    DIM k AS INTEGER
    DIM file$
    DIM problem$
    IF NOT any_saved_game THEN
        menu_choice = MENU_ESCAPED
        EXIT SUB
    END IF
    menu_text$(0) = "Load"
    menu_item_count = 0
    FOR k = 1 TO 9
        file$ = save_file_name$(k)
        IF _FILEEXISTS(file$) THEN
            CALL menu_add_row(LTRIM$(STR$(k)) + " " + file$, k)
        END IF
    NEXT k
    menu_col = PANEL_COL
    menu_row = 14 - .5 * menu_item_count
    CALL menu_select(MENU_PLAIN, 1)
    CALL clear_right_panel
    IF menu_choice < 1 THEN
        EXIT SUB
    END IF
    COLOR COLOR_LIGHT_CYAN
    CALL clear_bottom_line
    PRINT "Loading";
    CALL load_game(menu_value(menu_choice), problem$)
    IF problem$ <> "" THEN
        CALL clear_bottom_line
        COLOR COLOR_YELLOW
        PRINT problem$;
        CALL wait_seconds(PAUSE_LONG)
        CALL clear_bottom_line
        menu_choice = MENU_ESCAPED
        EXIT SUB
    END IF
    PRINT STRING$(MAX_CITIES, ".");
    CLS
    CALL draw_map
    CALL clear_bottom_line
    CALL turn_reset_commands
END SUB

' Save: the player picks one of nine slots, by its number or the arrows. A slot with a saved
' game has a mark after its name. A row has at most 11 characters, as the right panel has room
' for no more.
SUB menu_save_game
    DIM k AS INTEGER
    DIM slot AS INTEGER
    menu_text$(0) = "Save Game"
    FOR k = 1 TO 9
        menu_text$(k) = LTRIM$(STR$(k)) + " " + save_file_name$(k)
        IF _FILEEXISTS(save_file_name$(k)) THEN
            menu_text$(k) = menu_text$(k) + "û"
        END IF
    NEXT k
    menu_col = PANEL_COL
    menu_item_count = 9
    CALL menu_select(MENU_PLAIN, 1)
    IF menu_choice < 1 THEN
        clear_right_panel: EXIT SUB
    END IF
    slot = menu_choice
    COLOR COLOR_LIGHT_CYAN
    CALL clear_bottom_line
    PRINT "Saving";
    CALL save_game(slot)
    PRINT STRING$(MAX_CITIES, ".");
    CLS
    CALL draw_map
END SUB

' Quit: Yes or No. action becomes FILES_QUIT on Yes, and cws.cfg keeps the battle totals of all
' games, with the battles fought since it was last written.
SUB menu_quit (action)
    CALL menu_set_two("Quit", "Yes", "No")
    menu_color = COLOR_MAGENTA
    menu_col = PANEL_COL
    menu_row = 15
    CALL menu_select(MENU_PLAIN, 2)
    CALL clear_right_panel
    IF menu_choice = 1 THEN
        action = FILES_QUIT
        CALL config_write_totals
    END IF
END SUB
