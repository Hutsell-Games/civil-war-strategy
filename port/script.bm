' ===========================================================================
' port\script.bm - hooks for the whole-game scripts of tests\play.py.
' Included at the end of cws.bas. See tests\README.md.
'
' A program started with the environment variable CWS_SEED set is
' "scripted":
'   - RANDOMIZE takes that number instead of TIMER, so every run is the same;
'   - each wait for a key is announced in bytes &H4F0 to &H4F2 of memory,
'     which QB64 does not use, so that a keys file gives each key only when
'     the program waits for it (QB64Rust's tools\screen\README.md, "Prompts");
'   - a timed pause (wait_seconds of less than 99 seconds) returns at once, and a
'     longer one, which the game uses as "press a key", waits for a key;
'   - PLAY and SOUND are silent (PLAY "V0"): they take their time, unheard;
'   - the random numbers of special_events can be given (CWS_DICE);
'   - the history file holds the date 01-01-2000 instead of today's;
'   - the history file is copied in BASIC, not by SHELL "copy ...".
' A program started without it plays as before: script_mark_key_wait does nothing.
' ===========================================================================

' Seeds the random numbers, from CWS_SEED when it is set, else from TIMER.
SUB script_start
DIM seed$
seed$ = ENVIRON$("CWS_SEED")
IF seed$ = "" THEN RANDOMIZE TIMER: EXIT SUB
scripted = 1
RANDOMIZE VAL(seed$)
script_dice$ = ENVIRON$("CWS_DICE")
END SUB

' Makes PLAY and SOUND silent when the program is scripted. Called once, before the title
' tune, which plays before script_start seeds the random numbers.
SUB script_mute
IF ENVIRON$("CWS_SEED") <> "" THEN PLAY "V0"
END SUB

' Forced dice for special_events. CWS_DICE holds groups of numbers, as in
' "0,.05,.95;0,.9": the groups are parted by ";" and the numbers by ",".
' Each call of special_events takes the next group (script_dice_next), and
' each of its random draws takes the group's next number (script_rnd!). An
' "r" in place of a number, and every draw after the group's last number,
' is a real RND. Without CWS_DICE every draw is RND, in the same order as
' before, so a normal game and a script without dice play as they did.
SUB script_dice_next
DIM cut AS INTEGER
script_dice_now$ = ""
IF script_dice$ = "" THEN EXIT SUB
cut = INSTR(script_dice$, ";")
IF cut = 0 THEN script_dice_now$ = script_dice$: script_dice$ = "": EXIT SUB
script_dice_now$ = LEFT$(script_dice$, cut - 1): script_dice$ = MID$(script_dice$, cut + 1)
END SUB

FUNCTION script_rnd!
DIM cut AS INTEGER: DIM item$
IF script_dice_now$ = "" THEN script_rnd! = RND: EXIT FUNCTION
cut = INSTR(script_dice_now$, ",")
IF cut = 0 THEN
	item$ = script_dice_now$: script_dice_now$ = ""
ELSE
	item$ = LEFT$(script_dice_now$, cut - 1): script_dice_now$ = MID$(script_dice_now$, cut + 1)
END IF
IF item$ = "r" THEN script_rnd! = RND ELSE script_rnd! = VAL(item$)
END FUNCTION

' The date the history file starts with: today, or a fixed one when the
' program is scripted, so that the file is the same in every run.
FUNCTION script_date$
IF scripted THEN script_date$ = "01-01-2000" ELSE script_date$ = DATE$
END FUNCTION

' wait_seconds's pause when the program is scripted. Gives 0 when it is not, and
' wait_seconds then pauses as before. A pause of 99 seconds or more is how the game
' says "press a key" (the map's links, "There are still defenders"), so a
' script waits there for a key; a shorter one returns at once.
FUNCTION script_tick% (seconds!)
script_tick% = 0
IF scripted = 0 THEN EXIT FUNCTION
script_tick% = -1
IF seconds! < 99 THEN EXIT FUNCTION
CALL script_mark_key_wait(1, "L")
DO WHILE INKEY$ = "": LOOP
END FUNCTION

' SHELL cmd$, or under a script the same work done in BASIC. The game runs
' "copy <from> <to>" (the history file of the game before). A SHELL starts
' cmd.exe, whose console window shows on the user's desktop even when the
' program runs on a hidden one, so the scripts must not run it. Copy
' replaces <to>, as copy does.
SUB script_shell (cmd$)
DIM space_at AS INTEGER: DIM contents$
DIM trimmed$: DIM args$: DIM verb$: DIM from$: DIM file_num AS INTEGER: DIM into$
IF scripted = 0 THEN SHELL cmd$: EXIT SUB
trimmed$ = LTRIM$(RTRIM$(cmd$))
space_at = INSTR(trimmed$, " "): verb$ = LCASE$(LEFT$(trimmed$, space_at - 1)): args$ = LTRIM$(MID$(trimmed$, space_at + 1))
space_at = INSTR(args$, " "): from$ = LEFT$(args$, space_at - 1): into$ = LTRIM$(MID$(args$, space_at + 1))
IF verb$ <> "copy" THEN SHELL cmd$: EXIT SUB
IF NOT _FILEEXISTS(from$) THEN EXIT SUB
file_num = FREEFILE: OPEN from$ FOR BINARY AS #file_num
contents$ = SPACE$(LOF(file_num)): GET #file_num, , contents$: CLOSE #file_num
IF _FILEEXISTS(into$) THEN KILL into$
file_num = FREEFILE: OPEN into$ FOR BINARY AS #file_num: PUT #file_num, , contents$: CLOSE #file_num
END SUB

' Says that the program is about to wait for a key. place names the kind of
' wait (1 to 255) and letter$ narrows it (its first character, or ""):
'   1  a pause that any key ends; letter$ says which:
'        R  the Random Events menu's "press a key" (menu_option_events)
'        T  a player's turn begins, in a two-player game (draw_player_turn)
'        P  a battle: the odds are shown, before the picture (calculate_battle)
'        B  a battle: "hit any key to continue" (calculate_battle)
'        U  the month's update: "press any key for ... events" (turn_resolve)
'        K  the month's update ends, in a two-player game: "press a key"
'        I  the special development: ironclad ships (special_events)
'        N  a special event good for the Union (special_events)
'        S  a special event good for the South (special_events)
'        H  the game is over: "press a key" before the Hall of Fame (hall_of_fame)
'        G  "Game Over" (hall_of_fame)
'        F  a report: "press a key" (report_wait_key)
'        L  wait_seconds of 99 seconds or more
'   2  a menu; letter$ is the first letter of the menu's title
'   4  a line of text: the name of the commander for the Hall of Fame
' Byte &H4F1 holds the place, &H4F2 the letter, and &H4F0 counts the waits.
SUB script_mark_key_wait (place, letter$)
DIM code AS INTEGER
IF scripted = 0 THEN EXIT SUB
code = 0
IF letter$ <> "" THEN code = ASC(UCASE$(letter$))
DEF SEG = 0
POKE &H4F1, place
POKE &H4F2, code
POKE &H4F0, (PEEK(&H4F0) + 1) AND 255
DEF SEG
END SUB
