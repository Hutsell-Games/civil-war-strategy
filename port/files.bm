' Reads scenarios/SCENARIOS.LST: each scenario's folder and title, up to MAX_SCENARIOS.
SUB load_scenario_list
    scenario_count = 0
    OPEN "I", 1, SCNDIR + "scenarios.lst"
    DO WHILE NOT EOF(1) AND scenario_count < MAX_SCENARIOS
        scenario_count = scenario_count + 1
        INPUT #1, scenario_folder$(scenario_count), scenario_title$(scenario_count)
    LOOP
    CLOSE #1
END SUB

' The row of SCENARIOS.LST whose folder is folder$, whatever its case; -1 when none is. The
' scenario the game is on (scenario_now) is found first, so that a game with no list (the unit
' tests: row 0, folder "") finds its own.
FUNCTION scenario_find (folder$)
    DIM k AS INTEGER
    scenario_find = -1
    IF LCASE$(folder$) = LCASE$(scenario_folder$(scenario_now)) THEN
        scenario_find = scenario_now
        EXIT FUNCTION
    END IF
    FOR k = 1 TO scenario_count
        IF LCASE$(folder$) = LCASE$(scenario_folder$(k)) THEN
            scenario_find = k
            EXIT FUNCTION
        END IF
    NEXT k
END FUNCTION

' The path of one of the files of the scenario the game is on (scenario_now).
FUNCTION scenario_file$ (name$)
    scenario_file$ = SCNDIR + scenario_folder$(scenario_now) + "/" + name$
END FUNCTION

SUB load_scenario
    DIM k AS INTEGER
    DIM i AS INTEGER
    OPEN "I", 1, scenario_file$("cwslead.dat")
    FOR i = 1 TO MAX_LEADERS
        INPUT #1, leader_name$(i), leader_rating(i)
    NEXT i
    CLOSE #1
    OPEN "I", 1, scenario_file$("cws.ini")
    FOR i = 0 TO 2
        INPUT #1, side_name$(i)
    NEXT i
    FOR i = 1 TO MONTHS_PER_YEAR
        INPUT #1, month_name$(i)
    NEXT i
    INPUT #1, turn_month, turn_year
    '               set end game conditions
    FOR i = 1 TO 6
        INPUT #1, victory_rule(i)
    NEXT i
    victory_rule(VICTORY_CITIES) = .4 * victory_rule(VICTORY_CITIES)
    CALL load_scenario_armies(SIDE_UNION)
    CALL load_scenario_armies(SIDE_REBEL)
    FOR i = SIDE_UNION TO SIDE_REBEL
        INPUT #1, side_cash(i)
    NEXT i
    INPUT #1, rule_attack_loss, rule_defend_loss, rule_strength_cap
    INPUT #1, fleet_ships$(SIDE_UNION), fleet_city(SIDE_UNION), fleet_ships$(SIDE_REBEL), fleet_city(SIDE_REBEL)
    FOR k = SIDE_UNION TO SIDE_REBEL
        fleet_size(k) = LEN(fleet_ships$(k))
    NEXT k
    INPUT #1, side_capital(SIDE_UNION), side_capital(SIDE_REBEL)

    FOR i = 1 TO 8
        INPUT #1, flag_star_x(i), flag_star_y(i)
    NEXT i ' star locations on flag
    CLOSE #1
    CALL config_read(current_side)
END SUB

' Reads one side's armies from cws.ini, open as #1: their count, then each army's city, men,
' experience and supplies. Army i takes leader i of cwslead.dat, who leaves the free leaders.
SUB load_scenario_armies (side)
    DIM army_count AS INTEGER
    DIM first_army AS INTEGER
    DIM i AS INTEGER
    INPUT #1, army_count
    first_army = side_first_army(side)
    FOR i = first_army TO first_army + army_count - 1
        INPUT #1, army_city(i), army_size(i), army_experience(i), army_supply(i)
        city_army(army_city(i)) = i
        CALL army_appoint(i, i)
    NEXT i
END SUB

' Reads the map's cities and roads from cities.grd. Adds each city to its owner's count,
' victory points and cash.
SUB load_cities
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM unused AS INTEGER
    DIM owner AS INTEGER
    city_name$(0) = "NONE"
    OPEN "I", 1, scenario_file$("cities.grd")
    total_income = union_income_bonus + 200
    FOR i = 1 TO MAX_CITIES
        INPUT #1, unused, city_x(i), city_y(i), city_name$(i), city_owner(i), city_value(i)
        city_first_owner(i) = city_owner(i)
        CALL city_update_occupier(i)
        FOR j = 1 TO MAX_ROADS
            INPUT #1, city_road(i, j)
        NEXT j
        INPUT #1, city_port_type(i), city_fort(i)
        IF city_owner(i) > 0 THEN
            owner = city_owner(i)
            side_city_count(owner) = side_city_count(owner) + 1
            side_victory_points(owner) = side_victory_points(owner) + city_value(i)
        END IF
        IF city_owner(i) > 0 THEN
            side_cash(city_owner(i)) = side_cash(city_owner(i)) + city_value(i)
        END IF
        total_income = total_income + city_value(i)
    NEXT i
    CLOSE #1
END SUB

' Reads the saved game cws<slot>.sav: the scenario, the date, the armies, the cities, the sides,
' and the side that plays. A save of another scenario than the one loaded reads that scenario's
' leaders and map first. A leader who commands an army leaves the free leaders. Then it reads
' the settings of cws.cfg. problem$ is "" when the game was loaded; otherwise it says why not,
' and nothing was changed. The menu of saved games is menu_load_game (ui/files.bm).
SUB load_game (slot, problem$)
    DIM last_army AS INTEGER
    DIM k AS INTEGER
    DIM side AS INTEGER
    DIM first_army AS INTEGER
    DIM config_side AS INTEGER
    DIM i AS INTEGER
    DIM saved_side AS INTEGER
    DIM unused AS INTEGER
    DIM row AS INTEGER
    DIM file$
    DIM text$
    DIM folder$
    DIM named AS INTEGER
    problem$ = ""
    file$ = save_file_name$(slot)
    ' The scenario first. The file is closed again, because load_scenario and load_cities read
    ' their files as #1 too.
    OPEN "I", 1, file$
    LINE INPUT #1, text$
    CLOSE #1
    named = (LEFT$(text$, 1) = CHR$(34))
    IF named THEN
        folder$ = MID$(text$, 2, LEN(text$) - 2)
    ELSE
        ' A game saved before saves named their scenario: the first scenario's.
        folder$ = scenario_folder$(1)
    END IF
    row = scenario_find(folder$)
    IF row < 0 THEN
        problem$ = file$ + " is a game of the scenario " + CHR$(34) + folder$ + CHR$(34) + ", which is not in SCENARIOS.LST"
        EXIT SUB
    END IF
    IF row <> scenario_now THEN
        scenario_now = row
        CALL load_scenario
        CALL load_cities
    END IF
    OPEN "I", 1, file$
    IF named THEN
        LINE INPUT #1, text$
    END IF
    INPUT #1, turn_month, turn_year, union_income_bonus, saved_side
    FOR i = 1 TO MAX_ARMIES
        INPUT #1, army_name$(i), army_size(i), army_leader_rating(i), army_city(i), army_experience(i), army_supply(i), army_order(i)
        IF army_exists(i) THEN
            IF army_name$(i) = leader_name$(i) THEN
                leader_name$(i) = ""
            ELSE
                side = army_side(i)
                first_army = side_first_army(side)
                last_army = side_last_army(side)
                FOR k = first_army TO last_army
                    IF army_name$(i) = leader_name$(k) THEN
                        leader_name$(k) = ""
                        EXIT FOR
                    END IF
                NEXT k
            END IF
        END IF
    NEXT i
    FOR i = 1 TO MAX_CITIES
        INPUT #1, city_army(i), city_owner(i), city_fort(i)
    NEXT i
    FOR i = SIDE_UNION TO SIDE_REBEL
        INPUT #1, side_cash(i), side_city_count(i), side_income(i), side_victory_points(i), side_capital(i)
        INPUT #1, fleet_ships$(i), fleet_city(i), unused, train_army(i), train_city(i)
        fleet_size(i) = LEN(fleet_ships$(i))
    NEXT i

    CLOSE #1
    CALL config_read(config_side)
    current_side = saved_side
END SUB

' Writes the game to cws<slot>.sav, and the settings to cws.cfg. The file's first line is the
' scenario's folder. The menu of the slots is menu_save_game (ui/files.bm).
SUB save_game (slot)
    DIM i AS INTEGER
    DIM config_side AS INTEGER
    OPEN "O", 1, save_file_name$(slot)
    WRITE #1, scenario_folder$(scenario_now)
    WRITE #1, turn_month, turn_year, union_income_bonus, current_side
    FOR i = 1 TO MAX_ARMIES
        WRITE #1, army_name$(i), army_size(i), army_leader_rating(i), army_city(i), army_experience(i), army_supply(i), army_order(i)
    NEXT i
    FOR i = 1 TO MAX_CITIES
        WRITE #1, city_army(i), city_owner(i), city_fort(i)
    NEXT i
    FOR i = SIDE_UNION TO SIDE_REBEL
        WRITE #1, side_cash(i), side_city_count(i), side_income(i), side_victory_points(i), side_capital(i)
        WRITE #1, fleet_ships$(i), fleet_city(i), 0, train_army(i), train_city(i)
    NEXT i
    CLOSE #1

    config_side = current_side
    IF config_side < 1 OR config_side > 2 THEN
        config_side = 1
    END IF
    CALL config_write(config_side)
END SUB

' Notes whether a saved game is on the disk, so that the Files menu shows Load, or "-" when
' there is none.
SUB saved_games_check
    saves_exist = 0
    IF any_saved_game THEN
        saves_exist = 1
    END IF
END SUB

' Whether one of the nine save slots, cws1.sav to cws9.sav, holds a saved game.
FUNCTION any_saved_game
    DIM k AS INTEGER
    FOR k = 1 TO 9
        IF _FILEEXISTS(save_file_name$(k)) THEN
            any_saved_game = -1
            EXIT FUNCTION
        END IF
    NEXT k
END FUNCTION

' The name of save slot slot's file: cws1.sav to cws9.sav.
FUNCTION save_file_name$ (slot)
    save_file_name$ = "cws" + LTRIM$(STR$(slot)) + ".sav"
END FUNCTION

SUB config_read (side)
    OPEN "I", 1, "cws.cfg"
    INPUT #1, side, opt_graphics, opt_sound, opt_difficulty, opt_players, opt_pause!, opt_event_balance, train_capacity(SIDE_UNION), train_capacity(SIDE_REBEL), opt_winter_campaigns, opt_realism, side_battles_won(SIDE_UNION), side_battles_won(SIDE_REBEL), side_casualties&(SIDE_UNION), side_casualties&(SIDE_REBEL), opt_history, opt_ai_aggression
    CLOSE #1
END SUB

SUB config_write (side)
    OPEN "O", 1, "cws.cfg"
    WRITE #1, side, opt_graphics, opt_sound, opt_difficulty, opt_players, opt_pause!, opt_event_balance, train_capacity(SIDE_UNION), train_capacity(SIDE_REBEL), opt_winter_campaigns, opt_realism, side_battles_won(SIDE_UNION), side_battles_won(SIDE_REBEL), side_casualties&(SIDE_UNION), side_casualties&(SIDE_REBEL), opt_history, opt_ai_aggression
    CLOSE #1
END SUB

SUB save_battle_summary
    DIM k AS INTEGER
    DIM winner_mark$
    IF opt_history > 0 THEN
        OPEN "O", #1, "battsumm"
        PRINT #1, " SIDE      BATTLES WON       LOSSES"
        FOR k = SIDE_UNION TO SIDE_REBEL
            winner_mark$ = " "
            IF victory_reason = k THEN
                winner_mark$ = "*"
            END IF
            PRINT #1, winner_mark$; side_name$(k), side_battles_won(k), 100 * side_casualties&(k)
        NEXT k
        CLOSE #1
    END IF
END SUB

' Reads the Hall of Fame: five names and scores for each side.
SUB hall_of_fame_load (names$(), scores())
    DIM side AS INTEGER
    DIM i AS INTEGER
    OPEN "I", 1, "hiscore.cws"
    FOR side = SIDE_UNION TO SIDE_REBEL
        FOR i = 1 TO 5
            INPUT #1, names$(side, i), scores(side, i)
        NEXT i
    NEXT side
    CLOSE #1
END SUB

SUB hall_of_fame_save (names$(), scores())
    DIM side AS INTEGER
    DIM i AS INTEGER
    OPEN "O", 1, "hiscore.cws"
    FOR side = SIDE_UNION TO SIDE_REBEL
        FOR i = 1 TO 5
            WRITE #1, names$(side, i), scores(side, i)
        NEXT i
    NEXT side
    CLOSE #1
END SUB

' Starts the history file cws.his with the date. The history of the game before is kept as
' oldhist.ory.
SUB history_start
    IF _FILEEXISTS("cws.his") THEN
        CALL script_shell("copy cws.his oldhist.ory")
    END IF
    OPEN "O", 2, "cws.his"
    PRINT #2, TAB(20); "[ HISTORY OF GAME BEGUN "; script_date$; " ]"
    CLOSE #2
END SUB
