' The computer's decisions. They draw nothing themselves: their messages are SUBs of ui/ai.bm,
' and they carry out an order through the same SUBs as the player's menus: the commands of
' commands/navy.bm, commands/army.bm and commands/railroad.bm.

' The computer supplies each of its armies that has none.
SUB ai_resupply (who)
DIM star AS INTEGER: DIM fin AS INTEGER: DIM i AS INTEGER
star = side_first_army(who): fin = side_last_army(who)
FOR i = star TO fin: IF army_city(i) > 0 AND army_supply(i) < 1 THEN CALL army_resupply(i)
NEXT i
END SUB

' The computer fortifies its capital, or a city of its own that the enemy near it outnumbers.
' side_cash without an index is a local that is always 0, as in the original.
SUB ai_fortify (who)
DIM side_cash AS INTEGER: DIM cost AS INTEGER: DIM target AS INTEGER: DIM x AS INTEGER
cost = COST_FORT
IF cost > sides(who).cash THEN EXIT SUB

target = 0: IF city_army(sides(who).capital) = 0 OR city_fort(sides(who).capital) > 1 GOTO city2
target = sides(who).capital
IF city_owner(target) = who GOTO capital ELSE GOTO city2
IF target > 0 GOTO capital

city2:
CALL ai_fortify_pick(who, target)

capital:
	IF target = 0 THEN EXIT SUB
	IF city_fort(target) >= MAX_FORT THEN EXIT SUB
	city_fort(target) = city_fort(target) + 1
	x = city_army(target): army_order(x) = ORDER_BUSY
	sides(who).cash = sides(who).cash - cost
	CALL draw_ai_fort(target)
	IF who = SIDE_UNION AND fleets(SIDE_UNION).size < 1 AND RND > .5 AND side_cash < 222 THEN EXIT SUB
	IF 3 * RND > 1 + ai_strength_ratio! AND sides(who).cash >= cost GOTO city2
END SUB

' The computer's choice of a city to fortify: one of its armies' cities whose enemy near it
' outnumbers the army. target is 0 when it fortifies none.
SUB ai_fortify_pick (who, target)
DIM star AS INTEGER: DIM fin AS INTEGER: DIM i AS INTEGER: DIM x AS INTEGER: DIM defend AS INTEGER
star = side_first_army(who): fin = side_last_army(who)
target = 0
IF 1 + RND < opt_ai_aggression + ai_strength_ratio! THEN EXIT SUB
target = 0: FOR i = star TO fin
x = army_city(i): IF x = 0 OR army_order(city_army(x)) < 0 OR army_order(i) < 0 GOTO endlook
IF city_fort(x) >= MAX_FORT GOTO endlook
	defend = city_nearby_enemy_strength(x): IF defend > army_size(i) THEN target = army_city(i): GOTO picked
endlook:
NEXT i
picked:
END SUB

' The computer builds the Union's first ship, then recruits unless it has armies enough. It
' keeps the price of a ship back from the recruiting when its fleet is small and in port.
SUB ai_raise_forces (who)
DIM slush AS INTEGER: DIM x AS INTEGER
IF who = SIDE_UNION AND fleets(SIDE_UNION).size < 1 AND sides(SIDE_UNION).cash > COST_SHIP THEN CALL ai_navy_orders(SIDE_UNION, NAVY_BUILD): IF sides(who).cash < COST_RECRUIT GOTO isok
x = ai_count_armies(who)
IF x > 2 + 3 * current_side + 3 * RND GOTO isok
IF fleets(who).size < 5 AND sides(who).cash > COST_SHIP AND fleets(who).city <> FLEET_AT_SEA THEN IF city_owner(fleets(who).city) = who THEN slush = slush + COST_SHIP: sides(who).cash = sides(who).cash - COST_SHIP: IF sides(who).cash < COST_RECRUIT GOTO isok
CALL ai_recruit(who)
isok:
	sides(who).cash = sides(who).cash + slush
END SUB

' How many armies the computer's side has. Two fewer when the other side has more men, and
' none when it has more than twice as many, so that the computer recruits.
FUNCTION ai_count_armies (who)
DIM star AS INTEGER: DIM fin AS INTEGER: DIM i AS INTEGER
DIM x AS INTEGER: DIM y AS INTEGER: DIM z AS INTEGER
star = side_first_army(other_side(who)): fin = side_last_army(other_side(who))
FOR i = star TO fin
	IF army_city(i) > 0 THEN y = y + .1 * army_size(i)
NEXT i
star = side_first_army(who): fin = side_last_army(who)
x = 0: z = 0: FOR i = star TO fin: IF army_city(i) > 0 THEN x = x + 1: z = z + .1 * army_size(i)
NEXT i
IF y > z THEN x = x - 2
IF y > 2 * z THEN x = 0
ai_count_armies = x
END FUNCTION

' The computer's fleet: builds a ship, sails, or attacks the port it lies off.
SUB ai_fleet_orders (who)
	IF current_side = SIDE_REBEL AND fleets(SIDE_UNION).city = 0 AND fleets(SIDE_UNION).size < 1 AND city_owner(30) = SIDE_UNION AND sides(SIDE_UNION).cash > COST_SHIP THEN fleets(SIDE_UNION).city = 30: CALL ai_navy_orders(SIDE_UNION, NAVY_BUILD): GOTO movenavy
	IF fleets(who).city = FLEET_AT_SEA THEN
		IF RND < .9 THEN CALL ai_navy_orders(who, NAVY_SAIL)
		EXIT SUB
	END IF
	IF sides(who).cash < COST_SHIP OR fleets(who).size >= MAX_FLEET_SHIPS OR city_owner(fleets(who).city) <> who GOTO movenavy
	CALL ai_navy_orders(who, NAVY_BUILD)
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
movenavy:
	IF fleets(who).size = 0 THEN fleets(who).city = 0
	IF fleets(who).city = 0 THEN EXIT SUB
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
'                     move ships & prohibit further action this turn
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	IF fleets(who).city <> FLEET_AT_SEA THEN
		IF city_owner(fleets(who).city) = who THEN CALL ai_navy_orders(who, NAVY_SAIL): EXIT SUB   'move ships & prohibit further action this turn
		IF city_owner(fleets(who).city) = SIDE_NONE THEN CALL ai_navy_orders(who, NAVY_SAIL): EXIT SUB
	ELSE
		IF RND < .5 THEN CALL ai_navy_orders(who, NAVY_SAIL)
		EXIT SUB
	END IF

	IF city_owner(fleets(who).city) <> who THEN
		IF city_army(fleets(who).city) = 0 OR RND > .3 THEN
			CALL ai_navy_orders(who, NAVY_ATTACK) 'attack
		ELSE
			CALL ai_navy_orders(who, NAVY_SAIL) 'move
		END IF
	END IF
END SUB

' The computer gives each of its armies a move order, or leaves it where it is. c is the
' color of its messages.
SUB ai_army_orders (who, c)
DIM star AS INTEGER: DIM fin AS INTEGER: DIM i AS INTEGER: DIM ordered AS INTEGER
star = side_first_army(who): fin = side_last_army(who)
FOR i = star TO fin
CALL ai_army_order(who, i, ordered)
IF ordered = 0 GOTO deadman
	CALL draw_ai_plan(i, c)
deadman:
NEXT i
END SUB

' The computer's move order for an army, or none (ordered is 0).
SUB ai_army_order (who, army, ordered)
DIM target AS INTEGER: DIM x AS INTEGER
DIM defend AS INTEGER: DIM j AS INTEGER: DIM k AS INTEGER: DIM flag AS INTEGER: DIM best AS INTEGER: DIM y AS INTEGER
ordered = 0
target = army_city(army)
IF army_city(army) < 1 OR army_order(army) < 0 GOTO deadman
x = army_size(army): IF army_supply(army) < 1 AND RND > .1 GOTO deadman

menu_choice = 0

defend = city_nearby_enemy_strength(target)

IF defend > 0 AND target = sides(who).capital AND city_army(target) = army GOTO deadman   'hold capital
IF target <> sides(who).capital GOTO nocap
IF victory_rule(VICTORY_CAPITAL) = 0 GOTO nocap
	FOR j = 1 TO MAX_ROADS
	k = city_road(target, j): IF j = 0 GOTO nocap
	flag = city_nearby_enemy_strength(k): IF flag > 0 GOTO deadman
	NEXT j
nocap:
CALL ai_evaluate_move(army, best): IF best = 0 GOTO deadman
move9:
	IF best = 0 THEN menu_choice = 1 + INT((j - 1) * RND)
	IF menu_choice = 0 THEN menu_choice = best
	army_order(army) = city_road(target, menu_choice)

	IF city_owner(army_order(army)) = who THEN y = city_army(army_order(army)): IF y > 0 THEN IF army_order(y) = x THEN army_order(army) = ORDER_NONE: GOTO deadman  ' eliminate crossing moves
	IF turn_month = 1 AND opt_winter_campaigns = 0 AND city_owner(army_order(army)) <> who THEN army_order(army) = ORDER_NONE: GOTO deadman
ordered = 1
deadman:
END SUB

' The computer drills each army that has no order and can still improve.
SUB ai_drill (who)
DIM star AS INTEGER: DIM fin AS INTEGER: DIM i AS INTEGER
star = side_first_army(who): fin = side_last_army(who)
	FOR i = star TO fin
	IF army_order(i) = ORDER_NONE AND army_experience(i) < 6 AND army_experience(i) < army_leader_rating(i) THEN
		CALL army_drill(i)

		CALL draw_ai_drill(i)
	END IF
	NEXT i
END SUB

SUB ai_evaluate_move (army, x)
DIM max AS INTEGER: DIM m AS INTEGER
DIM from AS INTEGER: DIM defend AS INTEGER: DIM best AS INTEGER: DIM j AS INTEGER: DIM a AS INTEGER: DIM y AS INTEGER: DIM k AS INTEGER: DIM c AS INTEGER: DIM x1 AS INTEGER: DIM odds!
from = army_city(army)
x = 200: IF ai_strength_ratio! > 1.5 THEN x = 80: IF ai_strength_ratio! > 2 THEN x = 20: IF ai_strength_ratio! > 3 THEN x = 5
defend = city_nearby_enemy_strength(from): IF defend = 0 THEN x = 0
IF opt_ai_aggression > 1 THEN x = .5 * x

best = army_size(army)

FOR j = 1 TO MAX_ROADS: menu_value(j) = -1
a = city_road(from, j): IF a > 0 THEN IF city_army(a) > 0 THEN best = best - army_size(city_army(a)): y = 1
NEXT j: best = .01 * best
IF opt_ai_aggression > 0 THEN best = best + 20 * opt_ai_aggression


FOR j = 1 TO MAX_ROADS
	y = -1: a = city_road(from, j): IF a = 0 THEN max = j - 1: GOTO alleval
      
	c = city_army(a)
	FOR k = side_first_army(other_side(current_side)) TO side_last_army(other_side(current_side)): IF army_city(k) > 0 THEN IF army_order(k) = a AND c = 0 GOTO alle
	NEXT k
	
	y = best - x * city_fort(from) - city_value(from) + 30 * RND
	IF city_fort(from) > 0 THEN IF army = city_army(from) THEN y = y - 25: IF opt_realism >= REALISM_ON THEN y = y - 50
	IF a = sides(current_side).capital THEN IF victory_rule(VICTORY_CAPITAL) > 0 THEN y = y + 200
	IF city_owner(a) <> other_side(current_side) THEN y = y + 5 * city_value(a) + 10 * city_fort(a)
	IF city_owner(a) <> current_side GOTO ourn
	   IF c = 0 THEN y = y + 10 * city_value(a): GOTO ourn
	   x1 = 1: IF city_fort(a) = 1 THEN x1 = 2: IF city_fort(a) = 3 THEN x1 = 3

	   IF army_size(c) > 0 THEN
		odds! = army_size(army) / (x1 * army_size(c))
		IF opt_realism >= REALISM_HIGH THEN odds! = .8 * odds!
	   ELSE
		odds! = 5
	   END IF

	   IF army_size(army) < 15 THEN y = y - 300: odds! = .1
	   IF opt_ai_aggression < 3 AND army_size(army) < 40 AND odds! < .8 THEN y = 0
	   IF opt_realism >= REALISM_ON THEN y = y - 15
	   IF odds! < .5 THEN y = y - 200
	   IF opt_ai_aggression = 0 AND RND > .9 THEN y = y + 10 * (army_leader_rating(army) - army_leader_rating(c) + army_experience(army) - army_leader_rating(army))
	   IF army_supply(army) < 1 THEN y = y - 100
	   SELECT CASE odds! + .5 * opt_ai_aggression
		CASE IS < .3
		y = -9999
		CASE IS < .5
		y = y - 300
		CASE IS <= .8
		y = y - 20
		CASE .8 TO 1.2
		y = y - 5
		CASE 1.2 TO 1.5
		y = y + 10
		CASE ELSE
		y = y + .5 * (army_size(army) - army_size(c)) + 50 * RND
	   END SELECT
ourn:
	IF city_owner(a) = other_side(current_side) AND c > 0 AND army_order(c) = ORDER_NONE THEN y = y - army_size(c)
	IF current_side = SIDE_UNION AND city_y(a) < city_y(from) THEN y = y + 2
	IF current_side = SIDE_REBEL AND city_y(a) > city_y(from) THEN y = y + 2
'---------------------------------------------------------------------------
	FOR k = 1 TO MAX_ROADS: m = city_road(a, k): IF m = 0 GOTO tally3
	IF city_owner(m) = SIDE_NONE THEN y = y + 3 * city_value(m) + 4 * city_fort(m)
	IF city_owner(m) = current_side THEN y = y + 3 * city_value(m) + 4 * city_fort(m)
	IF city_owner(m) = current_side AND c > 0 THEN
		odds! = 5 - 4 * RND
		IF army_size(c) > 0 THEN odds! = army_size(army) / army_size(c) ELSE odds! = 5
		IF odds! < 1 THEN y = y - 2
	END IF
	IF city_owner(m) = sides(current_side).capital THEN y = y + 50
tally3:
	NEXT k
'---------------------------------------------------------------------------
	menu_value(j) = y
alle:
NEXT j: max = 6
alleval:
x = 0: best = 0
FOR j = 1 TO max
IF menu_value(j) < 0 GOTO allof
	IF menu_value(j) > x THEN x = menu_value(j): best = j
allof:
NEXT j
	IF defend > army_size(army) AND menu_value(best) < 50 THEN best = 0
	x = best
END SUB

' The player's strength near city a: in full in the cities next to it, a tenth two roads away. The sum is an
' INTEGER, rounded at each step, as it was when it was a SUB's parameter.
FUNCTION city_nearby_enemy_strength (a)
DIM j AS INTEGER: DIM x AS INTEGER: DIM k AS INTEGER: DIM m AS INTEGER: DIM y AS INTEGER
  y = 0
FOR j = 1 TO MAX_ROADS
  x = city_road(a, j): IF x = 0 GOTO tally5
  IF city_owner(x) = current_side AND city_army(x) > 0 THEN y = y + army_size(city_army(x))
	FOR k = 1 TO MAX_ROADS: m = city_road(x, k): IF m = 0 OR m = a GOTO tally4
	IF city_owner(m) = current_side AND city_army(m) > 0 THEN y = y + .1 * army_size(city_army(m))
tally4:
	NEXT k
NEXT j
tally5:
city_nearby_enemy_strength = y
END FUNCTION

' The computer recruits: it picks a city from its list and raises men there, while the money
' lasts and it has a commander for a new army.
SUB ai_recruit (side)
DIM city AS INTEGER: DIM raised AS INTEGER
	IF sides(side).cash < COST_RECRUIT THEN EXIT SUB
	CALL menu_recruit_cities(side)
	IF menu_item_count = 0 THEN EXIT SUB
	DO
	IF sides(side).cash < COST_RECRUIT THEN EXIT SUB
	CALL draw_ai_funds(side)
	CALL ai_recruit_pick(side)
	city = menu_value(menu_choice)
	CALL army_recruit(side, city, raised)
	IF raised = 0 THEN EXIT SUB
	LOOP
END SUB

' The computer's pick from the recruiting list, left in menu_choice.
SUB ai_recruit_pick (side)
DIM x AS INTEGER: DIM i AS INTEGER: DIM target AS INTEGER: DIM y AS INTEGER: DIM a AS INTEGER
		menu_choice = 0: x = 0
		FOR i = 1 TO menu_item_count
		target = menu_value(i)
		x = city_army(target)
		IF x = 0 XOR army_size(x) < 155 THEN menu_choice = i
		NEXT i

	IF menu_choice = 0 THEN menu_choice = 1 + INT(RND * menu_item_count)
	IF opt_realism >= REALISM_ON THEN
		x = 0
		FOR i = 1 TO menu_item_count
		target = menu_value(i)
		IF city_army(target) = 0 THEN
			y = 3 * city_value(target) + 33
			a = city_is_connected(side, target)
			IF a < 1 THEN y = y \ 3
		ELSE
			y = 2 * city_value(target) + 20
			a = city_is_connected(side, target)
			IF a < 1 THEN y = y \ 3
		END IF
		IF y > x AND RND > .5 THEN x = y: menu_choice = i
		NEXT i
	END IF
	IF sides(side).cash < COST_RECRUIT THEN menu_choice = menu_item_count
END SUB

' The computer combines the armies in one of the cities where armies can combine, picked at
' random.
SUB ai_combine (side)
DIM city AS INTEGER: DIM best AS INTEGER: DIM joined AS INTEGER
	CALL army_list_combine_cities(side)
	IF menu_item_count = 0 THEN EXIT SUB
	menu_choice = 1 + INT(menu_item_count * RND)
	city = menu_value(menu_choice)
	CALL army_combine_gather(side, city, best, joined)
	IF joined = 0 THEN EXIT SUB
	CALL army_combine_done(side, city, best, joined)
	CALL army_combine_redraw(side, city, best)
END SUB

' 1 when the computer's army razes the fort of a city it takes without a battle: under the
' Realism setting, in the lower part of the map.
FUNCTION ai_razes_fort (city)
	ai_razes_fort = 0
	IF opt_realism >= REALISM_ON AND city_y(city) > 150 THEN ai_razes_fort = 1
END FUNCTION

' The computer's train. With an army aboard, it arrives. With none, the computer may send one
' (ai_railroad).
SUB ai_railroad_orders (side)
DIM army AS INTEGER: DIM city AS INTEGER
SELECT CASE trains(side).army
	CASE 0
	CALL ai_railroad(side, army, city)
	IF army > 0 THEN CALL railroad_start(side, army, city)
	CASE IS > 0
	CALL railroad_arrive(side)
END SELECT
	CALL railroad_finish
END SUB

' The computer's train: an army that is far from the enemy, and a city of its own that the
' enemy threatens. army and city are 0 when it sends no train.
SUB ai_railroad (side, army, city)
DIM max AS INTEGER: DIM index AS INTEGER: DIM i AS INTEGER: DIM x AS INTEGER: DIM j AS INTEGER
DIM from AS INTEGER: DIM defend AS INTEGER: DIM limit AS INTEGER: DIM x1 AS INTEGER: DIM target AS INTEGER
	army = 0: city = 0
	max = 32767
	index = 0
	FOR i = side_first_army(side) TO side_last_army(side): IF army_city(i) = 0 OR army_order(i) <> ORDER_NONE GOTO puter
	x = 0: FOR j = 1 TO MAX_ROADS: from = city_road(army_city(i), j): IF from > 0 AND city_owner(from) <> side THEN x = x + 1
	NEXT j
	IF city_army(sides(side).capital) > 0 AND x > 1 GOTO puter
	defend = city_nearby_enemy_strength(army_city(i))
	IF victory_rule(VICTORY_CAPITAL) > 0 AND city_army(sides(side).capital) = 0 THEN IF defend > max THEN defend = max - 1
	IF defend < max THEN target = army_city(i): x = railroad_route_count(side, target): IF x > 1 THEN max = defend: index = i
puter:  NEXT i
	IF index = 0 OR max > .3 * army_size(index) THEN EXIT SUB
	limit = railroad_capacity(side)
	IF army_size(index) > limit THEN EXIT SUB
	from = army_city(index)
	x1 = 0: FOR i = 1 TO MAX_CITIES: IF city_owner(i) <> side GOTO puted
	defend = city_nearby_enemy_strength(i): IF defend = 0 OR defend > 3 * army_size(index) GOTO puted
	IF city_army(i) > 0 GOTO puted
	target = i
	x = railroad_route_count(side, target): IF x = 0 GOTO puted
	IF current_side = SIDE_UNION AND city_y(i) < city_y(from) THEN x1 = i
	IF current_side = SIDE_REBEL AND city_y(i) > city_y(from) THEN x1 = i
	IF city_fort(i) > 0 AND city_army(i) = 0 THEN x1 = i: EXIT FOR
puted:  NEXT i
	IF victory_rule(VICTORY_CAPITAL) > 0 AND city_army(sides(side).capital) = 0 THEN
		x = railroad_route_count(side, target)
		IF x > 0 THEN
			defend = city_nearby_enemy_strength(sides(side).capital)
			IF defend > 0 THEN x1 = sides(side).capital
		END IF
	END IF
	IF x1 > 0 THEN army = index: city = x1
END SUB

' The computer's choice of a port to sail to, from the menu's list. It is left in
' menu_choice.
SUB ai_pick_port (side)
DIM best AS INTEGER: DIM x AS INTEGER: DIM i AS INTEGER: DIM target AS INTEGER
	best = 0: x = 0
	FOR i = 1 TO menu_item_count
	target = menu_value(i)
	IF city_owner(target) = SIDE_NONE GOTO neutral

	IF target = fleets(other_side(side)).city THEN IF fleets(side).size >= fleets(other_side(side)).size AND RND > .1 THEN menu_choice = i: EXIT SUB
	IF city_owner(target) <> side THEN
		best = i: x = x + 1
		IF RND > .8 THEN menu_choice = best: EXIT SUB
	END IF
neutral:
	NEXT i
	IF best = 0 THEN
		menu_choice = 1 + INT(RND * menu_item_count)
	ELSE
		menu_choice = best
	END IF

	IF side = SIDE_REBEL AND fleets(SIDE_REBEL).city = 30 THEN IF RND > .5 THEN menu_choice = 30: EXIT SUB
END SUB

' The computer's fleet carries out an order: NAVY_BUILD, NAVY_ATTACK or NAVY_SAIL. The order
' is first changed to what the fleet's state calls for (ai_navy), and looked at again before
' each action (ai_navy_adjust). An action may ask for another, for example after a ship is
' built.
SUB ai_navy_orders (side, order)
DIM action AS INTEGER: DIM quit AS INTEGER: DIM again AS INTEGER
action = order
CALL ai_navy(side, action)
CALL draw_ai_navy_color
DO
	CALL navy_mark_side(side)
	quit = 0
	CALL ai_navy_adjust(side, action, quit)
	IF quit > 0 THEN EXIT SUB
	again = 0
	SELECT CASE menu_choice
		CASE 1: CALL ai_navy_build(side, again)
		CASE 2: CALL ai_navy_attack(side, action, again)
		CASE 3: CALL ai_navy_sail(side, again)
		CASE 4: CALL ai_navy_raid(side, again)
		CASE 5: CALL ai_navy_invade(side, action)
	END SELECT
LOOP WHILE again > 0
END SUB

' Build, for the computer. It may decide against a ship, the more so the larger its fleet.
' With the money for two ships it builds an ironclad, at a wooden ship's price. A new fleet
' starts in one of its sea ports, picked at random. again is 1 when a ship was built, or when
' the cash or a fleet at sea prevented it.
SUB ai_navy_build (side, again)
DIM cost AS INTEGER: DIM ship$
	again = 0
	cost = COST_SHIP
	IF sides(side).cash < cost OR fleets(side).city = FLEET_AT_SEA THEN again = 1: EXIT SUB
	IF fleets(side).size >= MAX_FLEET_SHIPS THEN EXIT SUB
	IF RND < .07 * fleets(side).size THEN EXIT SUB
	ship$ = "W"

	IF navy_has_ironclads = 1 AND sides(side).cash >= 2 * cost THEN
		' The place and color of the player's Type menu, set here too as before.
		menu_col = PANEL_COL: menu_row = 12: menu_color = COLOR_LIGHT_BLUE
		ship$ = "I"
	END IF

	CALL navy_add_ship(side, ship$, cost)
	IF fleets(side).size > 1 THEN CALL navy_ship_joins(side, ship$): again = 1: EXIT SUB
	CALL navy_list_shipyards(side)
	menu_choice = 1 + INT(menu_item_count * RND)
	IF menu_item_count < 1 THEN CALL navy_cancel_new_fleet(side): EXIT SUB
	CALL navy_fleet_founded(side, menu_value(menu_choice), ship$, cost)
	again = 1
END SUB

' Attack, for the computer: the fleet bombards the enemy city it lies off. Off a neutral
' city the order becomes NAVY_SAIL and again is 1.
SUB ai_navy_attack (side, action, again)
	again = 0
	IF fleets(side).city = FLEET_AT_SEA THEN again = 1: EXIT SUB
	IF city_owner(fleets(side).city) = side THEN EXIT SUB
	IF city_army(fleets(side).city) > 0 AND RND > .5 THEN
		' The computer thinks of sailing instead of attacking an army. It attacks all the same
		' when the city is the enemy's. The second look at the order drew another number.
		action = NAVY_SAIL
		CALL random_discard
	ELSE
		IF city_owner(fleets(side).city) = SIDE_NONE THEN action = NAVY_SAIL: again = 1: EXIT SUB
	END IF
	IF fleets(side).city < 1 THEN EXIT SUB
	IF city_owner(fleets(side).city) <> other_side(side) THEN again = 1: EXIT SUB
	CALL navy_bombard(side)
END SUB

' Sail, for the computer: to the enemy's fleet when it pursues, else to a port it picks
' (ai_pick_port). The fleets fight if they meet.
SUB ai_navy_sail (side, again)
DIM sailed AS INTEGER
	again = 0
	CALL navy_count_ships(side)
	IF fleets(side).size < 1 THEN EXIT SUB
	IF fleets(side).city < 1 THEN CALL navy_say_no_ships: again = 1: EXIT SUB

	CALL navy_list_ports(side)
	IF menu_item_count = 0 THEN EXIT SUB
	IF fleet_pursuit > 0 THEN
		menu_choice = 1: menu_value(1) = fleets(other_side(side)).city
	ELSE
		CALL ai_pick_port(side): IF menu_choice <= 0 THEN EXIT SUB
	END IF
	CALL navy_sail_to(side, menu_value(menu_choice), sailed)
	IF sailed = 0 THEN EXIT SUB
	IF fleets(SIDE_UNION).city = fleets(SIDE_REBEL).city THEN CALL navy_combat_auto(side)
	CALL navy_finish_move
END SUB

' Raid, for the computer: the fleet goes to sea to raid commerce. The fleets fight if the
' enemy's is at sea too.
SUB ai_navy_raid (side, again)
	again = 0
	CALL navy_count_ships(side)
	IF fleets(side).size < 1 THEN EXIT SUB
	IF raiding_side = side THEN again = 1: EXIT SUB

	CALL navy_start_raid(side)
	IF fleets(SIDE_UNION).city = fleets(SIDE_REBEL).city THEN CALL navy_combat_auto(side): CALL navy_finish_move: EXIT SUB
	CALL navy_redraw_map
END SUB

' Invasion, for the computer: a ship lands a new army. With no commander left it asks for
' one again and again (TODO.md).
SUB ai_navy_invade (side, action)
DIM slot AS INTEGER
	DO
		CALL army_get_commander((side), slot)
		IF slot = 0 THEN action = NAVY_SAIL
	LOOP WHILE slot = 0
	CALL navy_land_army(side, slot)
END SUB

' The computer's order for its fleet, changed to what the fleet's state calls for: build
' with no fleet, raid back when the enemy's raiders sank commerce, sail after the enemy's fleet.
SUB ai_navy (side, action)
IF fleets(side).city < 1 THEN
	action = NAVY_BUILD
ELSE
	IF raiding_side = other_side(side) AND raid_loss > 0 THEN action = NAVY_RAID
	IF fleet_pursuit > 0 THEN action = NAVY_SAIL
END IF
END SUB

' The computer's order, looked at again before each action. It stops building when the
' money or the fleet's limit is reached (quit is 1). A fleet that is gone builds, not sails.
' It invades when the menu offers Invasion and the enemy near the Union's fleet is weak.
SUB ai_navy_adjust (side, action, quit)
	IF action = NAVY_BUILD THEN
		IF sides(side).cash < COST_SHIP THEN quit = 1: EXIT SUB
		IF fleets(side).size >= MAX_FLEET_SHIPS THEN quit = 1: EXIT SUB
	END IF
	CALL menu_navy_items(side)
	IF fleets(side).city < 1 AND action = NAVY_SAIL THEN action = NAVY_BUILD
	IF menu_item_count = 5 THEN
		IF city_nearby_enemy_strength(fleets(SIDE_UNION).city) < 100 THEN action = NAVY_INVADE
	END IF
	menu_choice = action
END SUB
