' The computer's decisions for its armies: where each one moves, drill, Join, and razing a
' fort. They draw nothing themselves: their messages are SUBs of
' ui/ai.bm, and they carry out an order through the commands of commands/, as the player's
' menus do.

' The computer gives each of its armies a move order, or leaves it where it is. text_color is
' the color of its messages.
SUB ai_army_orders (side, text_color)
    DIM first_army AS INTEGER
    DIM last_army AS INTEGER
    DIM i AS INTEGER
    DIM ordered AS INTEGER
    first_army = side_first_army(side)
    last_army = side_last_army(side)
    FOR i = first_army TO last_army
        CALL ai_army_order(side, i, ordered)
        IF ordered THEN
            CALL draw_ai_plan(i, text_color)
        END IF
    NEXT i
END SUB

' The computer's move order for an army, or none (ordered is FALSE).
SUB ai_army_order (side, army, ordered)
    DIM city AS INTEGER
    DIM enemy_strength AS INTEGER
    DIM j AS INTEGER
    DIM neighbor AS INTEGER
    DIM neighbor_strength AS INTEGER
    DIM best_road AS INTEGER
    DIM other_army AS INTEGER
    ordered = FALSE
    city = army_city(army)
    IF NOT army_exists(army) OR army_has_acted(army) THEN
        EXIT SUB
    END IF
    IF army_supply(army) < 1 AND RND > .1 THEN
        EXIT SUB
    END IF

    enemy_strength = city_nearby_enemy_strength(city)

    ' hold capital
    IF enemy_strength > 0 AND city = side_capital(side) AND city_army(city) = army THEN
        EXIT SUB
    END IF
    ' Any army in the capital stays while an enemy is next to it, when taking the capital wins
    ' the game.
    IF city = side_capital(side) AND victory_rule(VICTORY_CAPITAL) > 0 THEN
        FOR j = 1 TO city_road_count(city)
            neighbor = city_road(city, j)
            neighbor_strength = city_nearby_enemy_strength(neighbor)
            IF neighbor_strength > 0 THEN
                EXIT SUB
            END IF
        NEXT j
    END IF
    CALL ai_evaluate_move(army, best_road)
    IF best_road = 0 THEN
        EXIT SUB
    END IF
    army_order(army) = city_road(city, best_road)

    IF city_owner(army_order(army)) = side THEN
        other_army = city_army(army_order(army))
        IF other_army > 0 THEN
            ' Two armies of the side that would trade cities stay where they are.
            IF army_order(other_army) = city THEN
                army_order(army) = ORDER_NONE
                EXIT SUB
            END IF
        END IF
    END IF
    IF winter_stops_move(side, army_order(army)) THEN
        army_order(army) = ORDER_NONE
        EXIT SUB
    END IF
    ordered = TRUE
END SUB

' The computer drills each army that has no order and can still improve.
SUB ai_drill (side)
    DIM first_army AS INTEGER
    DIM last_army AS INTEGER
    DIM i AS INTEGER
    first_army = side_first_army(side)
    last_army = side_last_army(side)
    FOR i = first_army TO last_army
        IF army_order(i) = ORDER_NONE AND army_can_drill(i) THEN
            CALL army_drill(i)
            CALL draw_ai_drill(i)
        END IF
    NEXT i
END SUB

' The computer's choice of a road for an army: best_road is the road whose city scores best, or 0
' when the army stays. A road's score is what its city is worth, the battle there if the enemy
' holds it (ai_attack_score), and the cities beyond it (ai_beyond_score).
SUB ai_evaluate_move (army, best_road)
    DIM road_count AS INTEGER
    DIM stay_weight AS INTEGER
    DIM best_score AS INTEGER
    DIM from_city AS INTEGER
    DIM enemy_strength AS INTEGER
    DIM own_strength AS INTEGER
    DIM j AS INTEGER
    DIM to_city AS INTEGER
    DIM score AS INTEGER
    DIM occupant AS INTEGER
    DIM own_side AS INTEGER
    DIM enemy_side AS INTEGER
    ' Each road's score; -1 for a road not scored. Entry 0, for no road, stays 0.
    DIM road_score(MAX_ROADS) AS INTEGER
    enemy_side = current_side
    own_side = other_side(enemy_side)
    from_city = army_city(army)
    enemy_strength = city_nearby_enemy_strength(from_city)
    stay_weight = ai_stay_weight(enemy_strength)
    own_strength = ai_move_strength(army)
    FOR j = 1 TO MAX_ROADS
        road_score(j) = -1
    NEXT j

    road_count = city_road_count(from_city)
    FOR j = 1 TO road_count
        to_city = city_road(from_city, j)
        occupant = city_army(to_city)
        ' An empty city that another of the computer's armies already marches to is left to it.
        IF occupant = 0 THEN
            IF ai_city_targeted(own_side, to_city) THEN
                _CONTINUE
            END IF
        END IF

        score = own_strength - stay_weight * city_fort(from_city) - city_value(from_city) + ai_move_spread * RND
        IF city_fort(from_city) > 0 THEN
            IF army = city_army(from_city) THEN
                score = score - ai_leave_fort_penalty
                IF opt_realism = REALISM_ON THEN
                    score = score - ai_leave_fort_realism_penalty
                END IF
            END IF
        END IF
        IF to_city = side_capital(enemy_side) THEN
            IF victory_rule(VICTORY_CAPITAL) > 0 THEN
                score = score + ai_enemy_capital_bonus
            END IF
        END IF
        IF city_owner(to_city) <> own_side THEN
            score = score + ai_target_value * city_value(to_city) + ai_target_fort * city_fort(to_city)
        END IF
        IF city_owner(to_city) = enemy_side AND occupant = 0 THEN
            score = score + ai_empty_enemy_value * city_value(to_city)
        END IF
        IF city_owner(to_city) = enemy_side AND occupant <> 0 THEN
            score = ai_attack_score(army, occupant, to_city, score)
        END IF
        IF city_owner(to_city) = own_side AND occupant > 0 AND army_order(occupant) = ORDER_NONE THEN
            score = score - army_size(occupant)
        END IF
        IF ai_toward_enemy(enemy_side, from_city, to_city) THEN
            score = score + ai_march_direction_bonus
        END IF
        score = score + ai_beyond_score(army, occupant, to_city, enemy_side)

        road_score(j) = score
    NEXT j
    best_score = 0
    best_road = 0
    FOR j = 1 TO road_count
        IF road_score(j) < 0 THEN
            _CONTINUE
        END IF
        IF road_score(j) > best_score THEN
            best_score = road_score(j)
            best_road = j
        END IF
    NEXT j
    IF enemy_strength > army_size(army) AND road_score(best_road) < 50 THEN
        best_road = 0
    END IF
END SUB

' How much a fort holds the computer's army in its city, for each level of the fort. It is 0
' when no enemy is near (enemy_strength is 0). It is less as the computer grows stronger than
' the player, and half for an aggressive computer.
FUNCTION ai_stay_weight (enemy_strength)
    DIM weight AS INTEGER
    weight = ai_stay_weight_even
    IF ai_strength_ratio! > 1.5 THEN
        weight = ai_stay_weight_strong
        IF ai_strength_ratio! > 2 THEN
            weight = ai_stay_weight_stronger
            IF ai_strength_ratio! > 3 THEN
                weight = ai_stay_weight_strongest
            END IF
        END IF
    END IF
    IF enemy_strength = 0 THEN
        weight = 0
    END IF
    IF opt_ai_aggression > 1 THEN
        weight = .5 * weight
    END IF
    ai_stay_weight = weight
END FUNCTION

' The army's urge to move: a hundredth of its size less the armies of either side in the
' cities next to it, plus 20 for each level of the computer's aggression.
FUNCTION ai_move_strength (army)
    DIM strength AS INTEGER
    DIM j AS INTEGER
    DIM to_city AS INTEGER
    strength = army_size(army)
    FOR j = 1 TO city_road_count(army_city(army))
        to_city = city_road(army_city(army), j)
        IF city_army(to_city) > 0 THEN
            strength = strength - army_size(city_army(to_city))
        END IF
    NEXT j
    strength = .01 * strength
    IF opt_ai_aggression > 0 THEN
        strength = strength + ai_aggression_strength * opt_ai_aggression
    END IF
    ai_move_strength = strength
END FUNCTION

' True when an army of the side already has an order to march to the city.
FUNCTION ai_city_targeted (side, city)
    DIM k AS INTEGER
    ai_city_targeted = FALSE
    FOR k = side_first_army(side) TO side_last_army(side)
        IF army_exists(k) THEN
            IF army_order(k) = city THEN
                ai_city_targeted = TRUE
                EXIT FUNCTION
            END IF
        END IF
    NEXT k
END FUNCTION

' The score of a road to a city where the enemy has an army (occupant): score_before, changed
' by the odds of the battle. The odds count the city's fort, the realism setting and the
' computer's aggression.
FUNCTION ai_attack_score (army, occupant, to_city, score_before)
    DIM score AS INTEGER
    DIM fort_factor AS INTEGER
    DIM odds!
    score = score_before
    ' A fort multiplies the defender: 1 with none, 2 with a fort of 1, 3 with a fort of 2. The
    ' original gave a fort of 2 the factor of none (docs/rule-changes.md, G25).
    fort_factor = 1 + city_fort(to_city)

    IF army_size(occupant) > 0 THEN
        odds! = army_size(army) / (fort_factor * army_size(occupant))
    ELSE
        odds! = 5
    END IF

    IF army_size(army) < small_army_size THEN
        score = score - ai_small_army_penalty
        odds! = .1
    END IF
    IF opt_ai_aggression < 3 AND army_size(army) < 40 AND odds! < .8 THEN
        score = 0
    END IF
    IF opt_realism = REALISM_ON THEN
        score = score - ai_realism_penalty
    END IF
    IF odds! < .5 THEN
        score = score - ai_poor_odds_penalty
    END IF
    ' Leader against leader and experience against experience. The original subtracted the
    ' army's own leader in place of the occupant's experience (docs/rule-changes.md, G28).
    IF opt_ai_aggression = 0 AND RND > .9 THEN
        score = score + 10 * (army_leader_rating(army) - army_leader_rating(occupant) + army_experience(army) - army_experience(occupant))
    END IF
    IF army_supply(army) < 1 THEN
        score = score - ai_no_supply_penalty
    END IF
    SELECT CASE odds! + .5 * opt_ai_aggression
        CASE IS < .3
            score = -9999
        CASE IS < .5
            score = score - ai_odds_bad_penalty
        CASE IS <= .8
            score = score - ai_odds_low_penalty
        CASE .8 TO 1.2
            score = score - ai_odds_even_penalty
        CASE 1.2 TO 1.5
            score = score + ai_odds_good_bonus
        CASE ELSE
            score = score + .5 * (army_size(army) - army_size(occupant)) + ai_attack_spread * RND
    END SELECT
    ai_attack_score = score
END FUNCTION

' What the cities one road beyond to_city add to its score: their worth and forts when the
' enemy or no side holds them, and 2 less for each of the enemy's when the army is smaller than
' the one in to_city (occupant), and 50 for the enemy's capital. The original compared a city's
' owner with the capital's number, so its 50 went to no city while the enemy held its capital
' (docs/rule-changes.md, G27).
FUNCTION ai_beyond_score (army, occupant, to_city, enemy_side)
    DIM k AS INTEGER
    DIM far_city AS INTEGER
    DIM odds!
    DIM bonus AS INTEGER
    bonus = 0
    FOR k = 1 TO city_road_count(to_city)
        far_city = city_road(to_city, k)
        IF city_owner(far_city) = SIDE_NONE OR city_owner(far_city) = enemy_side THEN
            bonus = bonus + ai_beyond_value * city_value(far_city) + ai_beyond_fort * city_fort(far_city)
        END IF
        IF city_owner(far_city) = enemy_side AND occupant > 0 THEN
            ' The next line sets odds! again at once, but its RND keeps the random numbers in
            ' step with the original game. Taking it out would change every recorded script.
            odds! = 5 - 4 * RND
            IF army_size(occupant) > 0 THEN
                odds! = army_size(army) / army_size(occupant)
            ELSE
                odds! = 5
            END IF
            IF odds! < 1 THEN
                bonus = bonus - 2
            END IF
        END IF
        IF far_city = side_capital(enemy_side) THEN
            bonus = bonus + ai_capital_road_bonus
        END IF
    NEXT k
    ai_beyond_score = bonus
END FUNCTION

' Whether to_city lies toward enemy_side from from_city: north toward the Union, south toward
' the Rebels. -1 or 0, as a comparison gives.
FUNCTION ai_toward_enemy (enemy_side, from_city, to_city)
    ai_toward_enemy = (enemy_side = SIDE_UNION AND city_y(to_city) < city_y(from_city)) OR (enemy_side = SIDE_REBEL AND city_y(to_city) > city_y(from_city))
END FUNCTION

' The player's strength near a city: in full in the cities next to it, a tenth two roads away. The sum is an
' INTEGER, rounded at each step, as it was when it was a SUB's parameter.
FUNCTION city_nearby_enemy_strength (city)
    DIM j AS INTEGER
    DIM neighbor AS INTEGER
    DIM k AS INTEGER
    DIM far_city AS INTEGER
    DIM strength AS INTEGER
    DIM enemy_side AS INTEGER
    enemy_side = current_side
    strength = 0
    FOR j = 1 TO city_road_count(city)
        neighbor = city_road(city, j)
        IF city_owner(neighbor) = enemy_side AND city_army(neighbor) > 0 THEN
            strength = strength + army_size(city_army(neighbor))
        END IF
        FOR k = 1 TO city_road_count(neighbor)
            far_city = city_road(neighbor, k)
            IF far_city = city THEN
                _CONTINUE
            END IF
            IF city_owner(far_city) = enemy_side AND city_army(far_city) > 0 THEN
                strength = strength + .1 * army_size(city_army(far_city))
            END IF
        NEXT k
    NEXT j
    city_nearby_enemy_strength = strength
END FUNCTION

' The computer combines the armies in one of the cities where armies can combine, picked at
' random.
SUB ai_combine (side)
    DIM city AS INTEGER
    DIM best AS INTEGER
    DIM joined AS INTEGER
    DIM cities(MAX_CITIES) AS INTEGER
    DIM count AS INTEGER
    CALL army_list_combine_cities(side, cities(), count)
    IF count = 0 THEN
        EXIT SUB
    END IF
    city = cities(1 + INT(count * RND))
    CALL army_combine_gather(side, city, best, joined)
    IF joined = 0 THEN
        EXIT SUB
    END IF
    CALL army_combine_done(city, best, joined)
    CALL army_combine_redraw(side, city, best)
END SUB

' TRUE when the computer's army razes the fort of a city it takes without a battle: under the
' Realism setting, in the lower part of the map.
FUNCTION ai_razes_fort (city)
    ai_razes_fort = FALSE
    IF opt_realism = REALISM_ON AND city_y(city) > 150 THEN
        ai_razes_fort = TRUE
    END IF
END FUNCTION
