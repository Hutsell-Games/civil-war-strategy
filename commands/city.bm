' A city is captured: the rule (city_take, rules/city.bm) and what the capture shows. Nothing
' here opens a menu or reads a key.

SUB city_capture (moving_army, city, side, weaken_fort)
    DIM message$
    DIM was_enemy_capital AS INTEGER
    DIM razed AS INTEGER
    was_enemy_capital = 0
    IF city = side_capital(other_side(side)) THEN
        was_enemy_capital = 1
    END IF
    razed = 0
    IF city_fort(city) > 0 AND weaken_fort > 0 THEN
        razed = 1
    END IF
    CALL city_take(city, side, weaken_fort)
    CALL clear_bottom_line
    message$ = army_name$(moving_army) + " has captured " + city_name$(city)
    COLOR COLOR_LIGHT_CYAN
    PRINT message$;
    IF army_side(moving_army) = SIDE_UNION AND opt_sound >= SOUND_MUSIC THEN
        PLAY "MNMFL16o2T120dd.dd.co1b.o2do3g.ab.bb.ag"
    END IF
    IF army_side(moving_army) = SIDE_REBEL AND opt_sound >= SOUND_MUSIC THEN
        PLAY "MNMFT160o2L16geL8ccL16cdefL8ggge"
    END IF
    IF was_enemy_capital = 0 THEN
        CALL animate_city(city)
    END IF
    IF was_enemy_capital = 1 THEN
        message$ = side_name$(other_side(side)) + " CAPITAL captured !"
        CALL scribe_message(message$, SHOW_LINE)
        CALL show_message_box(city_name$(city) + " has fallen!", COLOR_RED)
        CALL animate_city(city)
    END IF
    IF razed = 1 THEN
        CALL city_redraw_fort(city)
    END IF
END SUB

' Fortify, by the player (menu_city_fortify, ui/city.bm) or the computer (ai_fortify): the
' rule (city_build_fort, rules/city.bm), then the message, a flash at the city and the cities
' drawn again.
SUB city_fortify (side, city)
    CALL city_build_fort(side, city)
    CALL clear_bottom_line
    PRINT city_name$(city); " fortifications increased to "; city_fort(city);
    CALL draw_map_marker(city, 0, MARK_FLASH_FRAME)
    CALL draw_cities
END SUB
