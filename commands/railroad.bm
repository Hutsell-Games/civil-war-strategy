' A side's train as the player sees it. The rules are in rules/railroad.bm.

' A side's train. With an army aboard, the train arrives. With none, the player or the
' computer may send one.
SUB railroad_move (side)
DIM army AS INTEGER: DIM city AS INTEGER
SELECT CASE train_army(side)
	CASE 0
	IF side = current_side THEN CALL menu_railroad(side, army, city) ELSE CALL ai_railroad(side, army, city)
	IF army > 0 THEN CALL railroad_start(side, army, city)
	CASE IS > 0
	CALL railroad_arrive(side)
END SELECT
	IF side = current_side THEN CALL wait_seconds(PAUSE_LONG)
	CALL clear_right_panel
	clear_bottom_line
END SUB

' Puts an army on the train for a city. It arrives at the start of next month's moves.
SUB railroad_start (side, army, city)
DIM from AS INTEGER
	from = army_city(army)
	COLOR COLOR_LIGHT_CYAN: CALL clear_bottom_line: PRINT army_name$(army); " is taking the train from "; city_name$(from); " to "; city_name$(city);
	CALL railroad_board(side, army, city)
	CALL draw_train(side, DRAW_SHOW)
	IF opt_sound >= SOUND_EFFECTS THEN SOUND 2222, 1
	CALL draw_train_box

       IF city_army(from) > 0 THEN CALL draw_army_flag(city_army(from))
END SUB

' The train arrives: its army gets off, and takes the city if it is not the side's.
SUB railroad_arrive (side)
DIM index AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER
	CALL draw_train(side, DRAW_ERASE)
	index = train_army(side)
	CALL railroad_unload(side)
	IF city_army(train_from_city(side)) > 0 THEN CALL draw_army_flag(city_army(train_from_city(side)))
	CALL draw_train(side, DRAW_SHOW)

	COLOR COLOR_LIGHT_CYAN: CALL clear_bottom_line: PRINT "Train with "; army_name$(index); " has arrived in "; city_name$(army_city(index)); : IF opt_sound >= SOUND_EFFECTS THEN SOUND 1200, 2
	CALL wait_seconds(opt_pause!)
	x = city_x(army_city(index)) - 12: y = city_y(army_city(index)) - 11
	LINE (x - 9, y - 8)-(x + 10, y + 8), 2, BF
	IF city_owner(army_city(index)) <> side THEN CALL city_capture(index, army_city(index), side, 0)
	CALL draw_army_flag(index)
	IF city_army(army_city(index)) > 0 THEN CALL draw_stack_markers(side): EXIT SUB
	CALL city_update_occupier(army_city(index)): CALL draw_army_flag(index)
END SUB
