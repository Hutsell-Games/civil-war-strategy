' A side's train as its orders are carried out. Each calls the rules (rules/railroad.bm) and
' shows what happened. Nothing here opens a menu or reads a key. The player sends a train from
' the main menu (menu_main_railroad, ui/main_menu.bm) and the computer in ai_railroad_orders
' (ai/ai.bm); a train with an army aboard arrives at the start of the month's moves
' (turn_resolve, ui/turn.bm).

' After a train was sent, was refused or arrived: clears the right panel and the bottom line.
SUB railroad_finish
	CALL clear_right_panel
	clear_bottom_line
END SUB

' Puts an army on the train for a city. It arrives at the start of next month's moves.
SUB railroad_start (side, army, city)
DIM from_city AS INTEGER
	from_city = army_city(army)
	COLOR COLOR_LIGHT_CYAN: CALL clear_bottom_line: PRINT army_name$(army); " is taking the train from "; city_name$(from_city); " to "; city_name$(city);
	CALL railroad_board(side, army, city)
	CALL draw_train(side, DRAW_SHOW)
	IF opt_sound >= SOUND_EFFECTS THEN SOUND 2222, 1
	CALL draw_train_box

       IF city_army(from_city) > 0 THEN CALL draw_army_flag(city_army(from_city))
END SUB

' The train arrives: its army gets off, and takes the city if it is not the side's.
SUB railroad_arrive (side)
DIM army AS INTEGER: DIM x AS INTEGER: DIM y AS INTEGER
	CALL draw_train(side, DRAW_ERASE)
	army = train_army(side)
	CALL railroad_unload(side)
	IF city_army(train_from_city(side)) > 0 THEN CALL draw_army_flag(city_army(train_from_city(side)))
	CALL draw_train(side, DRAW_SHOW)

	COLOR COLOR_LIGHT_CYAN: CALL clear_bottom_line: PRINT "Train with "; army_name$(army); " has arrived in "; city_name$(army_city(army)); : IF opt_sound >= SOUND_EFFECTS THEN SOUND 1200, 2
	CALL wait_seconds(opt_pause!)
	x = city_x(army_city(army)) - 12: y = city_y(army_city(army)) - 11
	LINE (x - 9, y - 8)-(x + 10, y + 8), 2, BF
	IF city_owner(army_city(army)) <> side THEN CALL city_capture(army, army_city(army), side, 0)
	CALL draw_army_flag(army)
	IF city_army(army_city(army)) > 0 THEN CALL draw_stack_markers(side): EXIT SUB
	CALL city_update_occupier(army_city(army)): CALL draw_army_flag(army)
END SUB
